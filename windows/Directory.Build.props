<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <!-- Nino: dosya özelliklerinde görünen şirket ve ürün adı. Telif bildirimi (NOTICE, Hakkında) ayrıca durur. -->
    <Company>Nino</Company>
    <Product>Nino</Product>
    <Copyright>AGPL-3.0. Uses chiaki-ng (AGPL-3.0).</Copyright>
    <!-- WPF projesi Mac'te de derlenebilsin (çalıştırmak için Windows gerekir). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
