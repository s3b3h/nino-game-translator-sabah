<UserControl x:Class="CouchSubs.App.Views.Steps.PsnLoginStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout Title="{t:T 'Sign in with the second account'}"
                  Message="{t:T 'Sign in to PlayStation Network with the second account you just created. Your password goes directly to Sony; Nino only keeps the account ID.'}">
        <StackPanel>
            <TextBlock Text="{t:T 'Signed in'}" Style="{StaticResource DoneText}" Margin="0,0,0,12"
                       Visibility="{Binding HasAccount, Converter={StaticResource VisibleIf}}" />
            <Button x:Name="SignIn" Click="OnSignIn" />
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
            <!-- Uygulama içi giriş Sony'nin "Can't connect to the server" hatasında kalırsa giriş sistem tarayıcısında yapılır,
                 yönlendirme adresi buraya yapıştırılır (panoya kopyalanınca kendiliğinden alınır). -->
            <Button x:Name="ShowBrowser" Content="{t:T 'Sign in in the browser'}" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Margin="0,20,0,0" Click="OnShowBrowser" />
            <StackPanel x:Name="BrowserPanel" Margin="0,20,0,0" Visibility="Collapsed">
                <TextBlock x:Name="BrowserReason" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"
                           Text="{t:T 'Sony\'s sign-in page could not reach its server inside the app, so sign-in moved to your browser.'}" />
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="{t:T 'Sign in with your second account in the browser that opened. When you finish, the browser stays on a remoteplay.dl.playstation.net page that only says redirect. Click the address bar, copy the whole address and come back here. Nino picks up the copied address by itself; if it does not, paste it below and press Save.'}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="BrowserUrl" Width="340" PreviewKeyDown="OnBrowserKeyDown" />
                    <Button Content="{t:T 'Save'}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="OnSaveBrowser" />
                </StackPanel>
                <Button Content="{t:T 'Open the browser again'}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Click="OnOpenBrowser" />
                <TextBlock x:Name="BrowserError" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
            <!-- Sony girişi açılmıyorsa (ör. servis sağlayıcı engelliyor) hesap kimliği elle yazılır. -->
            <Button x:Name="ShowManual" Content="{t:T 'Enter account ID manually'}" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnShowManual" />
            <StackPanel x:Name="Manual" Margin="0,20,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="{t:T 'If Sony\'s sign-in page does not open (some internet providers block it), enter the second account\'s PSN account ID in base64 (12 characters, e.g. AbCdEfGhIjk=).'}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ManualId" Width="240" MaxLength="24" PreviewKeyDown="OnManualKeyDown" />
                    <Button Content="{t:T 'Save'}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="OnSaveManual" />
                </StackPanel>
                <TextBlock x:Name="ManualError" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </c:StepLayout>
</UserControl>
