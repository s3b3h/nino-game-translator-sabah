<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 22621 SDK'sı GraphicsCaptureSession.IsBorderRequired'ı (sarı yakalama çerçevesi) getirir; uygulama yine 19041'de çalışır,
         yeni API'ler ApiInformation ile denetlenir. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CouchSubs</AssemblyName>
    <!-- Nino: Görev Yöneticisi, Windows Güvenlik Duvarı sorusu ve dosya özellikleri bu iki adı gösterir. Dosya adı
         (CouchSubs.exe) değişmez: Velopack, güvenlik duvarı kuralı ve kısayollar ona bağlı. -->
    <AssemblyTitle>Nino</AssemblyTitle>
    <Product>Nino</Product>
    <RootNamespace>CouchSubs.App</RootNamespace>
    <ApplicationIcon>Assets\CouchSubs.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Velopack kurulum ve güncelleme kancaları WPF başlamadan çalışmalı (Program.Main). -->
    <StartupObject>CouchSubs.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Paket sunucusu (server/packs): `dotnet publish -p:CouchSubsPacksUrl=https://…` ile verilir; boşsa paket indirme kapalı (PackUpdater). -->
  <ItemGroup>
    <AssemblyMetadata Include="CouchSubsPacksUrl" Value="$(CouchSubsPacksUrl)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\living-room.png" />
    <!-- Nino: Xbox'lı salon sahnesi; doğrudan Mac'in görselinden (aynı dosya), kopyası tutulmaz. -->
    <Resource Include="..\..\..\mac\CouchSubs\Resources\Assets.xcassets\LivingRoomXbox.imageset\living-room-xbox.png" Link="Assets\living-room-xbox.png" />
    <!-- ShellWindow.xaml pencere simgesi olarak bunu okur; ApplicationIcon yalnız exe simgesidir. -->
    <Resource Include="Assets\CouchSubs.ico" />
    <!-- Nino: altyazı yazı tipleri (Barlow, Barlow Condensed, Nunito; OFL). Lisans metinleri uygulamanın yanına kopyalanır. -->
    <Resource Include="Fonts\*.ttf" />
    <!-- Nino: "Nino'ya Sor" robotu (açık gözlü ve göz kırpan kare); doğrudan design/bot-png'den, kopyası tutulmaz. -->
    <Resource Include="..\..\..\design\bot-png\nino-bot-256.png;..\..\..\design\bot-png\nino-bot-blink-256.png" Link="Assets\Bot\%(Filename)%(Extension)" />
    <Content Include="Fonts\OFL-*.txt" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TV uygulaması paketleri (scripts/package-tv.sh, package-tizen.sh ve Android derlemesi üretir); geliştirici modu açık TV'ye kurulur. -->
  <ItemGroup>
    <Content Include="..\..\..\dist\tv-app\*.ipk;..\..\..\dist\tv-app\*.wgt;..\..\..\dist\tv-app\*.apk" Link="tv-app\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\xbox-bridge\dist\bridge.cjs;..\..\xbox-bridge\dist\player.html;..\..\xbox-bridge\dist\player.js"
             Link="xbox-bridge\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\xbox-bridge\dist\node.exe" Condition="Exists('..\..\xbox-bridge\dist\node.exe')"
             Link="xbox-bridge\node.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\xbox-bridge\dist\licenses\*" Link="xbox-bridge\licenses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CouchSubs.Core\CouchSubs.Core.csproj" />
    <ProjectReference Include="..\CouchSubs.Translation\CouchSubs.Translation.csproj" />
    <ProjectReference Include="..\CouchSubs.RemotePlay\CouchSubs.RemotePlay.csproj" />
    <ProjectReference Include="..\CouchSubs.Shell\CouchSubs.Shell.csproj" />
    <ProjectReference Include="..\CouchSubs.TvInstall\CouchSubs.TvInstall.csproj" />
  </ItemGroup>

</Project>
