{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Start Remote play in the Xbox app or at xbox.com/play. Nino reads that window and shows the translation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ التشغيل عن بُعد في تطبيق Xbox أو على xbox.com/play. يقرأ Nino تلك النافذة ويعرض الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox অ্যাপে বা xbox.com/play-এ Remote play শুরু করুন। Nino সেই উইন্ডোটি পড়ে অনুবাদ দেখায়।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulan ang Remote play sa Xbox app o sa xbox.com/play. Binabasa ng Nino ang window na iyon at ipinapakita ang salin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox ऐप में या xbox.com/play पर रिमोट प्ले शुरू करें। Nino वह विंडो पढ़ता है और अनुवाद दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai Remote play di aplikasi Xbox atau di xbox.com/play. Nino membaca jendela itu dan menampilkan terjemahannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan Remote play dalam apl Xbox atau di xbox.com/play. Nino membaca tetingkap itu dan memaparkan terjemahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Op afstand spelen in de Xbox-app of op xbox.com/play. Nino leest dat venster en toont de vertaling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่ม Remote play ในแอป Xbox หรือที่ xbox.com/play Nino จะอ่านหน้าต่างนั้นและแสดงคำแปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox uygulamasında ya da xbox.com/play'de Uzaktan oynat'ı başlatın. Nino o pencereyi okur ve çeviriyi gösterir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox ایپ میں یا xbox.com/play پر Remote play شروع کریں۔ Nino وہ ونڈو پڑھ کر ترجمہ دکھاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu chơi từ xa trong ứng dụng Xbox hoặc tại xbox.com/play. Nino sẽ đọc cửa sổ đó và hiện bản dịch."
          }
        }
      }
    },
    "Allow camera access in Windows Settings › Privacy & security › Camera, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الكاميرا في إعدادات Windows › الخصوصية والأمان › الكاميرا، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows Settings › Privacy & security › Camera-তে ক্যামেরা অ্যাক্সেসের অনুমতি দিন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang access sa camera sa Windows Settings › Privacy & security › Camera, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows सेटिंग्स › गोपनीयता और सुरक्षा › कैमरा में कैमरा एक्सेस की अनुमति दें, फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses kamera di Pengaturan Windows › Privasi & keamanan › Kamera, lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan akses kamera dalam Tetapan Windows › Privasi & keselamatan › Kamera, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta cameratoegang toe in Windows-instellingen › Privacy en beveiliging › Camera en probeer het opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงกล้องใน การตั้งค่า Windows › ความเป็นส่วนตัวและความปลอดภัย › กล้อง แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows Ayarları › Gizlilik ve güvenlik › Kamera'da kamera erişimine izin verin, sonra yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows Settings › Privacy & security › Camera میں کیمرے تک رسائی کی اجازت دیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép truy cập camera trong Cài đặt Windows › Quyền riêng tư & bảo mật › Camera, rồi thử lại."
          }
        }
      }
    },
    "Capture cards appear as a camera in Windows. In Settings › Privacy & security › Camera, turn on camera access and Let desktop apps access your camera, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر بطاقات الالتقاط في Windows ككاميرا. في الإعدادات › الخصوصية والأمان › الكاميرا، شغّل الوصول إلى الكاميرا والسماح لتطبيقات سطح المكتب بالوصول إليها، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows-এ ক্যাপচার কার্ড ক্যামেরা হিসেবে দেখায়। Settings › Privacy & security › Camera-তে ক্যামেরা অ্যাক্সেস এবং Let desktop apps access your camera চালু করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalabas bilang camera sa Windows ang mga capture card. Sa Settings › Privacy & security › Camera, i-on ang Camera access at Let desktop apps access your camera, saka subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows में कैप्चर कार्ड कैमरे की तरह दिखते हैं। सेटिंग्स › गोपनीयता और सुरक्षा › कैमरा में कैमरा एक्सेस और डेस्कटॉप ऐप्स को कैमरा एक्सेस करने दें चालू करें, फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture card muncul sebagai kamera di Windows. Di Pengaturan › Privasi & keamanan › Kamera, aktifkan akses kamera dan Izinkan aplikasi desktop mengakses kamera, lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tangkapan muncul sebagai kamera dalam Windows. Dalam Tetapan › Privasi & keselamatan › Kamera, hidupkan akses kamera dan Benarkan apl desktop mengakses kamera anda, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnamekaarten verschijnen in Windows als camera. Zet in Instellingen › Privacy en beveiliging › Camera cameratoegang aan en Bureaublad-apps toegang geven tot je camera, en probeer het opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดจับภาพจะแสดงเป็นกล้องใน Windows ใน การตั้งค่า › ความเป็นส่วนตัวและความปลอดภัย › กล้อง ให้เปิดการเข้าถึงกล้อง และ อนุญาตให้แอปเดสก์ท็อปเข้าถึงกล้องของคุณ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Card'lar Windows'ta kamera gibi görünür. Ayarlar › Gizlilik ve güvenlik › Kamera'da kamera erişimini ve masaüstü uygulamalarının kameraya erişmesini açın, sonra yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر کارڈز Windows میں کیمرے کے طور پر نظر آتے ہیں۔ Settings › Privacy & security › Camera میں Camera access اور Let desktop apps access your camera آن کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Card ghi hình hiện dưới dạng camera trong Windows. Trong Cài đặt › Quyền riêng tư & bảo mật › Camera, hãy bật quyền truy cập camera và Cho phép ứng dụng máy tính truy cập camera, rồi thử lại."
          }
        }
      }
    },
    "Plug the card into a USB 3 port on this computer. If you use a hub, try a port on the computer itself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصّل البطاقة بمنفذ USB 3 في هذا الكمبيوتر. إن كنت تستخدم موزّعًا، جرّب منفذ الكمبيوتر نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ডটি এই কম্পিউটারের একটি USB 3 পোর্টে লাগান। হাব ব্যবহার করলে সরাসরি কম্পিউটারের পোর্টে চেষ্টা করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isaksak ang card sa isang USB 3 port ng computer na ito. Kung gumagamit ka ng hub, subukan ang port sa mismong computer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड को इस कंप्यूटर के USB 3 पोर्ट में लगाएँ। अगर आप हब इस्तेमाल करते हैं, तो सीधे कंप्यूटर का पोर्ट आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokkan card ke port USB 3 di komputer ini. Jika Anda memakai hub, coba port yang ada di komputer itu sendiri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Palamkan kad ke port USB 3 pada komputer ini. Jika anda menggunakan hab, cuba port pada komputer itu sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de kaart aan op een USB 3-poort van deze computer. Gebruik je een hub, probeer dan een poort op de computer zelf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียบการ์ดเข้ากับพอร์ต USB 3 ของคอมพิวเตอร์เครื่องนี้ หากใช้ฮับ ให้ลองเสียบพอร์ตบนตัวคอมพิวเตอร์โดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Card'ı bu bilgisayardaki bir USB 3 girişine takın. Çoklayıcı kullanıyorsanız doğrudan bilgisayarın kendi girişini deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ کو اس کمپیوٹر کے USB 3 پورٹ میں لگائیں۔ اگر آپ ہب استعمال کرتے ہیں تو براہِ راست کمپیوٹر کا پورٹ آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm card vào cổng USB 3 trên máy tính này. Nếu bạn dùng hub, hãy thử cổng ngay trên máy tính."
          }
        }
      }
    },
    "A capture card takes the PS5 picture over HDMI and gives it to this computer over USB. No second PSN account or Remote Play needed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأخذ بطاقة الالتقاط صورة PS5 عبر HDMI وتسلّمها لهذا الكمبيوتر عبر USB. لا حاجة إلى حساب PSN ثانٍ أو Remote Play."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ক্যাপচার কার্ড HDMI দিয়ে PS5-এর ছবি নেয় এবং USB দিয়ে এই কম্পিউটারে দেয়। দ্বিতীয় PSN অ্যাকাউন্ট বা Remote Play লাগে না।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinukuha ng capture card ang larawan ng PS5 sa HDMI at ibinibigay ito sa computer na ito sa USB. Hindi kailangan ng pangalawang PSN account o Remote Play."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर कार्ड HDMI से PS5 की तस्वीर लेता है और USB से इस कंप्यूटर को देता है। दूसरे PSN अकाउंट या Remote Play की ज़रूरत नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture card mengambil gambar PS5 lewat HDMI dan meneruskannya ke komputer ini lewat USB. Tidak perlu akun PSN kedua atau Remote Play."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tangkapan mengambil gambar PS5 melalui HDMI dan memberikannya kepada komputer ini melalui USB. Akaun PSN kedua atau Remote Play tidak diperlukan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een opnamekaart neemt het PS5-beeld via HDMI op en geeft het via USB door aan deze computer. Geen tweede PSN-account of Remote Play nodig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดจับภาพรับภาพ PS5 ผ่าน HDMI แล้วส่งให้คอมพิวเตอร์เครื่องนี้ผ่าน USB ไม่ต้องใช้บัญชี PSN บัญชีที่สองหรือ Remote Play"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Card, PS5 görüntüsünü HDMI'dan alır, USB ile bu bilgisayara verir. İkinci PSN hesabı ya da Remote Play gerekmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر کارڈ HDMI کے ذریعے PS5 کی تصویر لے کر USB کے ذریعے اس کمپیوٹر کو دیتا ہے۔ نہ دوسرے PSN اکاؤنٹ کی ضرورت ہے نہ Remote Play کی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Card ghi hình nhận hình ảnh PS5 qua HDMI và truyền vào máy tính này qua USB. Không cần tài khoản PSN phụ hay Remote Play."
          }
        }
      }
    },
    "Nino shows the game full screen on this computer with its sound, and the translation on top. Connect the computer to the screen with HDMI.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض Nino اللعبة بملء الشاشة على هذا الكمبيوتر مع صوتها والترجمة فوقها. وصّل الكمبيوتر بالشاشة عبر HDMI."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino এই কম্পিউটারে গেমটি সাউন্ডসহ ফুল স্ক্রিনে দেখায়, আর ওপরে অনুবাদ। কম্পিউটারটি HDMI দিয়ে স্ক্রিনে সংযোগ করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ng Nino ang laro nang full screen sa computer na ito kasama ang tunog nito, at ang salin sa ibabaw. Ikonekta ang computer sa screen gamit ang HDMI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino इस कंप्यूटर पर गेम को उसकी आवाज़ के साथ फ़ुल स्क्रीन दिखाता है, और ऊपर अनुवाद। कंप्यूटर को HDMI से स्क्रीन से जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino menampilkan game layar penuh di komputer ini beserta suaranya, dengan terjemahan di atasnya. Hubungkan komputer ke layar dengan HDMI."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino memaparkan permainan dalam skrin penuh pada komputer ini bersama bunyinya, dan terjemahan di atasnya. Sambungkan komputer ke skrin dengan HDMI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino toont de game schermvullend op deze computer met geluid, met de vertaling erbovenop. Verbind de computer via HDMI met het scherm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino แสดงเกมเต็มหน้าจอบนคอมพิวเตอร์เครื่องนี้พร้อมเสียง และแสดงคำแปลทับด้านบน เชื่อมต่อคอมพิวเตอร์กับจอด้วย HDMI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino oyunu sesiyle birlikte bu bilgisayarda tam ekran gösterir, çeviri üstünde olur. Bilgisayarı ekrana HDMI ile bağlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino اس کمپیوٹر پر گیم کو آواز کے ساتھ فل اسکرین دکھاتا ہے، اور ترجمہ اوپر۔ کمپیوٹر کو HDMI سے اسکرین سے جوڑیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino hiện game toàn màn hình trên máy tính này kèm âm thanh, và bản dịch nằm phía trên. Hãy nối máy tính với màn hình bằng HDMI."
          }
        }
      }
    },
    "Connect PS5 → card HDMI in, card HDMI out → TV, and the card's USB → this computer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ← مدخل HDMI في البطاقة، مخرج HDMI في البطاقة ← التلفاز، وUSB البطاقة ← هذا الكمبيوتر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ করুন PS5 → কার্ডের HDMI in, কার্ডের HDMI out → TV, এবং কার্ডের USB → এই কম্পিউটার।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonekta ang PS5 → HDMI in ng card, HDMI out ng card → TV, at ang USB ng card → computer na ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 → कार्ड का HDMI in, कार्ड का HDMI out → TV, और कार्ड का USB → यह कंप्यूटर जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan PS5 → HDMI in card, HDMI out card → TV, dan USB card → komputer ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan PS5 → HDMI masuk kad, HDMI keluar kad → TV, dan USB kad → komputer ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind PS5 → HDMI-ingang van de kaart, HDMI-uitgang van de kaart → TV, en de USB van de kaart → deze computer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ PS5 → HDMI in ของการ์ด, HDMI out ของการ์ด → TV และ USB ของการ์ด → คอมพิวเตอร์เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 → Capture Card'ın HDMI girişi, HDMI çıkışı → TV, USB'si → bu bilgisayar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوڑیں: PS5 → کارڈ کا HDMI in، کارڈ کا HDMI out → TV، اور کارڈ کا USB → یہ کمپیوٹر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nối PS5 → cổng HDMI vào của card, cổng HDMI ra của card → TV, và USB của card → máy tính này."
          }
        }
      }
    },
    "Connect PS5 → card HDMI in, and the card's USB → this computer. Then connect this computer to your screen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ← مدخل HDMI في البطاقة، وUSB البطاقة ← هذا الكمبيوتر. ثم وصّل هذا الكمبيوتر بشاشتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ করুন PS5 → কার্ডের HDMI in, এবং কার্ডের USB → এই কম্পিউটার। তারপর এই কম্পিউটারটি আপনার স্ক্রিনে সংযোগ করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonekta ang PS5 → HDMI in ng card, at ang USB ng card → computer na ito. Saka ikonekta ang computer na ito sa iyong screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 → कार्ड का HDMI in, और कार्ड का USB → यह कंप्यूटर जोड़ें। फिर इस कंप्यूटर को अपनी स्क्रीन से जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan PS5 → HDMI in card, dan USB card → komputer ini. Lalu hubungkan komputer ini ke layar Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan PS5 → HDMI masuk kad, dan USB kad → komputer ini. Kemudian sambungkan komputer ini ke skrin anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind PS5 → HDMI-ingang van de kaart, en de USB van de kaart → deze computer. Verbind daarna deze computer met je scherm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ PS5 → HDMI in ของการ์ด และ USB ของการ์ด → คอมพิวเตอร์เครื่องนี้ จากนั้นเชื่อมต่อคอมพิวเตอร์เครื่องนี้กับจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 → Capture Card'ın HDMI girişi, USB'si → bu bilgisayar. Sonra bu bilgisayarı ekranınıza bağlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوڑیں: PS5 → کارڈ کا HDMI in، اور کارڈ کا USB → یہ کمپیوٹر۔ پھر اس کمپیوٹر کو اپنی اسکرین سے جوڑیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nối PS5 → cổng HDMI vào của card, và USB của card → máy tính này. Sau đó nối máy tính này với màn hình."
          }
        }
      }
    },
    "Esc: full screen on or off · Closing this window stops the translation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: تشغيل ملء الشاشة أو إيقافه · إغلاق هذه النافذة يوقف الترجمة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: ফুল স্ক্রিন চালু বা বন্ধ · এই উইন্ডো বন্ধ করলে অনুবাদ থেমে যায়"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: i-on o i-off ang full screen · Ang pagsara sa window na ito ay nagpapahinto sa pagsasalin"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: फ़ुल स्क्रीन चालू या बंद · यह विंडो बंद करने से अनुवाद रुक जाता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: layar penuh aktif atau nonaktif · Menutup jendela ini menghentikan terjemahan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: skrin penuh hidup atau mati · Menutup tetingkap ini menghentikan terjemahan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: schermvullend aan of uit · Als je dit venster sluit, stopt de vertaling"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: เปิดหรือปิดเต็มหน้าจอ · การปิดหน้าต่างนี้จะหยุดการแปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: tam ekranı açar ya da kapatır · Bu pencereyi kapatmak çeviriyi durdurur"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: فل اسکرین آن یا آف · یہ ونڈو بند کرنے سے ترجمہ رک جاتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc: bật hoặc tắt toàn màn hình · Đóng cửa sổ này sẽ dừng dịch"
          }
        }
      }
    },
    "The live preview is off while translating.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعاينة المباشرة متوقفة أثناء الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুবাদ চলার সময় লাইভ প্রিভিউ বন্ধ থাকে।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang live preview habang nagsasalin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुवाद के दौरान लाइव प्रीव्यू बंद रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau langsung nonaktif saat menerjemahkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton langsung dimatikan semasa menterjemah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De live voorvertoning staat uit tijdens het vertalen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพตัวอย่างสดจะปิดระหว่างแปล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri sürerken canlı önizleme kapalıdır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمے کے دوران لائیو پیش نظارہ بند رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trước trực tiếp bị tắt khi đang dịch."
          }
        }
      }
    },
    "Nino needs Windows Firewall permission for incoming connections from the TV.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Nino إلى إذن من جدار حماية Windows للاتصالات الواردة من TV."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV থেকে আসা সংযোগের জন্য Nino-র Windows Firewall অনুমতি দরকার।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng Nino ng pahintulot ng Windows Firewall para sa mga papasok na koneksyon mula sa TV."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV से आने वाले कनेक्शन के लिए Nino को Windows Firewall की अनुमति चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino memerlukan izin Windows Firewall untuk koneksi masuk dari TV."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino memerlukan kebenaran Windows Firewall untuk sambungan masuk daripada TV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino heeft toestemming van Windows Firewall nodig voor inkomende verbindingen van de TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ต้องได้รับอนุญาตจากไฟร์วอลล์ Windows สำหรับการเชื่อมต่อขาเข้าจาก TV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino'nun TV'den gelen bağlantılar için Windows güvenlik duvarı iznine ihtiyacı var."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کو TV سے آنے والے کنکشنز کے لیے Windows Firewall کی اجازت درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino cần quyền của Windows Firewall cho các kết nối đến từ TV."
          }
        }
      }
    },
    "Nino is not affiliated with Microsoft. Xbox is a trademark of Microsoft Corporation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino غير تابع لـ Microsoft. Xbox علامة تجارية لشركة Microsoft Corporation."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino-র সাথে Microsoft-এর কোনো সম্পর্ক নেই। Xbox হলো Microsoft Corporation-এর ট্রেডমার্ক।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang kaugnayan ang Nino sa Microsoft. Ang Xbox ay trademark ng Microsoft Corporation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino का Microsoft से कोई संबंध नहीं है। Xbox, Microsoft Corporation का ट्रेडमार्क है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak berafiliasi dengan Microsoft. Xbox adalah merek dagang Microsoft Corporation."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino tidak bergabung dengan Microsoft. Xbox ialah tanda dagangan Microsoft Corporation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino is niet gelieerd aan Microsoft. Xbox is een handelsmerk van Microsoft Corporation."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino ไม่มีส่วนเกี่ยวข้องกับ Microsoft Xbox เป็นเครื่องหมายการค้าของ Microsoft Corporation"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino, Microsoft ile bağlantılı değildir. Xbox, Microsoft Corporation'ın ticari markasıdır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino کا Microsoft سے کوئی تعلق نہیں۔ Xbox، Microsoft Corporation کا ٹریڈ مارک ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nino không liên kết với Microsoft. Xbox là thương hiệu của Microsoft Corporation."
          }
        }
      }
    },
    "If the TV cannot connect: Windows Firewall may be blocking Nino. Allow it in Settings › Windows Firewall, and set this network to Private in Windows.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تعذّر اتصال TV: قد يكون جدار حماية Windows يحظر Nino. اسمح به من الإعدادات › جدار حماية Windows، واجعل هذه الشبكة «خاصة» في Windows."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TV সংযোগ করতে না পারলে: হয়তো Windows Firewall Nino-কে আটকাচ্ছে। সেটিংস › Windows Firewall-এ অনুমতি দিন, এবং Windows-এ এই নেটওয়ার্কটি Private করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung hindi makakonekta ang TV: baka hinaharangan ng Windows Firewall ang Nino. Payagan ito sa Mga Setting › Windows Firewall, at itakda ang network na ito sa Private sa Windows."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर TV कनेक्ट नहीं हो पाता: हो सकता है Windows Firewall Nino को रोक रहा हो। सेटिंग्स › Windows Firewall में इसकी अनुमति दें, और Windows में इस नेटवर्क को प्राइवेट पर सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika TV tidak dapat terhubung: Windows Firewall mungkin memblokir Nino. Izinkan di Pengaturan › Windows Firewall, dan atur jaringan ini ke Pribadi di Windows."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika TV tidak dapat menyambung: Windows Firewall mungkin menyekat Nino. Benarkannya dalam Tetapan › Windows Firewall, dan tetapkan rangkaian ini kepada Peribadi dalam Windows."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de TV geen verbinding maken? Misschien blokkeert Windows Firewall Nino. Sta het toe via Instellingen › Windows Firewall en stel dit netwerk in Windows in op Privé."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หาก TV เชื่อมต่อไม่ได้: ไฟร์วอลล์ Windows อาจบล็อก Nino อยู่ อนุญาตได้ที่ การตั้งค่า › ไฟร์วอลล์ Windows และตั้งเครือข่ายนี้เป็นส่วนตัวใน Windows"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV bağlanamıyorsa: Windows Güvenlik Duvarı Nino'yu engelliyor olabilir. Ayarlar › Windows Güvenlik Duvarı'ndan izin verin ve bu ağı Windows'ta \"Özel\" yapın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر TV جڑ نہ سکے: ہو سکتا ہے Windows Firewall، Nino کو روک رہا ہو۔ سیٹنگز › Windows Firewall میں اجازت دیں، اور Windows میں اس نیٹ ورک کو Private پر سیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu TV không kết nối được: Windows Firewall có thể đang chặn Nino. Hãy cho phép trong Cài đặt › Windows Firewall, và đặt mạng này thành Riêng tư trong Windows."
          }
        }
      }
    },
    "Draw the area to translate, for example a quest panel. While you play, press its shortcut (%@) to read and translate it once. Choose where the result shows. It works even when Nino is in the background.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم المنطقة المراد ترجمتها، مثل لوحة المهام. أثناء اللعب، اضغط اختصارها (%@) لقراءتها وترجمتها مرة واحدة. اختر مكان ظهور النتيجة. يعمل ذلك حتى عندما يكون Nino في الخلفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুবাদ করার এলাকাটি আঁকুন, যেমন একটি কোয়েস্ট প্যানেল। খেলার সময় এর শর্টকাট (%@) চাপলে এটি একবার পড়ে অনুবাদ করা হবে। ফলাফল কোথায় দেখাবে তা বেছে নিন। Nino ব্যাকগ্রাউন্ডে থাকলেও এটি কাজ করে।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iguhit ang area na isasalin, halimbawa ang panel ng quest. Habang naglalaro, pindutin ang shortcut nito (%@) para basahin at isalin ito nang isang beses. Piliin kung saan lalabas ang resulta. Gumagana ito kahit nasa background ang Nino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुवाद के लिए क्षेत्र बनाएँ, जैसे कोई क्वेस्ट पैनल। खेलते समय उसका शॉर्टकट (%@) दबाएँ, वह एक बार पढ़कर अनुवाद हो जाएगा। चुनें कि नतीजा कहाँ दिखे। Nino बैकग्राउंड में होने पर भी यह काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar area yang ingin diterjemahkan, misalnya panel misi. Saat bermain, tekan pintasannya (%@) untuk membaca dan menerjemahkannya sekali. Pilih tempat hasilnya ditampilkan. Ini berfungsi meski Nino berjalan di latar belakang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis kawasan untuk diterjemah, contohnya panel misi. Semasa bermain, tekan pintasannya (%@) untuk membaca dan menterjemahnya sekali. Pilih tempat hasilnya dipaparkan. Ia berfungsi walaupun Nino berada di latar belakang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken het gebied dat je wilt vertalen, bijvoorbeeld een questpaneel. Druk tijdens het spelen op de sneltoets (%@) om het één keer te lezen en te vertalen. Kies waar het resultaat verschijnt. Het werkt ook als Nino op de achtergrond draait."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาดพื้นที่ที่ต้องการแปล เช่น แผงภารกิจ ระหว่างเล่น ให้กดปุ่มลัดของพื้นที่นั้น (%@) เพื่ออ่านและแปลหนึ่งครั้ง เลือกได้ว่าจะให้ผลลัพธ์แสดงที่ใด ใช้ได้แม้ Nino จะทำงานอยู่เบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrilecek alanı çizin (ör. görev paneli). Oynarken bu alanın kısayoluna (%@) basınca alan bir kez okunup çevrilir. Sonucun nerede görüneceğini seçin. Nino arka plandayken de çalışır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمے کے لیے حصہ بنائیں، مثلاً کوئسٹ پینل۔ کھیلتے ہوئے اس کا شارٹ کٹ (%@) دبائیں تاکہ اسے ایک بار پڑھ کر ترجمہ کیا جائے۔ نتیجہ کہاں دکھے، یہ منتخب کریں۔ یہ Nino کے پس منظر میں ہونے پر بھی کام کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ vùng cần dịch, ví dụ bảng nhiệm vụ. Khi đang chơi, nhấn phím tắt của vùng (%@) để đọc và dịch một lần. Chọn nơi hiển thị kết quả. Tính năng vẫn hoạt động khi Nino chạy nền."
          }
        }
      }
    },
    "Xbox support is in beta. Nino reads the subtitles in the game picture and shows the translation on your TV or computer. You keep playing with your own controller.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعم Xbox تجريبي. يقرأ Nino الترجمة النصية في صورة اللعبة ويعرض الترجمة على TV أو الكمبيوتر. وتواصل اللعب بيد التحكم الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox সাপোর্ট বেটাতে আছে। Nino গেমের ছবিতে সাবটাইটেল পড়ে এবং অনুবাদটি আপনার TV বা কম্পিউটারে দেখায়। আপনি নিজের কন্ট্রোলার দিয়েই খেলতে থাকেন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa beta pa ang suporta sa Xbox. Binabasa ng Nino ang mga subtitle sa larawan ng laro at ipinapakita ang salin sa iyong TV o computer. Tuloy ang paglalaro mo gamit ang sarili mong controller."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox सपोर्ट बीटा में है। Nino गेम की तस्वीर में सबटाइटल पढ़ता है और अनुवाद आपके TV या कंप्यूटर पर दिखाता है। आप अपने कंट्रोलर से खेलते रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dukungan Xbox masih beta. Nino membaca subtitle di gambar game dan menampilkan terjemahan di TV atau komputer Anda. Anda tetap bermain dengan controller sendiri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sokongan Xbox dalam beta. Nino membaca sari kata dalam gambar permainan dan memaparkan terjemahan pada TV atau komputer anda. Anda terus bermain dengan alat kawalan anda sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox-ondersteuning is in bèta. Nino leest de ondertitels in het gamebeeld en toont de vertaling op je TV of computer. Je blijft spelen met je eigen controller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรองรับ Xbox อยู่ในช่วงเบต้า Nino อ่านคำบรรยายจากภาพเกมและแสดงคำแปลบน TV หรือคอมพิวเตอร์ คุณยังเล่นด้วยจอยของคุณเองได้ตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox desteği beta aşamasındadır. Nino oyun görüntüsündeki altyazıları okur ve çeviriyi TV'de ya da bilgisayarda gösterir. Oynamaya kendi kumandanızla devam edersiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox سپورٹ بیٹا میں ہے۔ Nino گیم کی تصویر میں سب ٹائٹلز پڑھ کر ترجمہ آپ کے TV یا کمپیوٹر پر دکھاتا ہے۔ آپ اپنے کنٹرولر سے کھیلتے رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỗ trợ Xbox đang ở bản beta. Nino đọc phụ đề trong hình ảnh game và hiện bản dịch trên TV hoặc máy tính. Bạn vẫn chơi bằng tay cầm của mình."
          }
        }
      }
    },
