    "What happened? Which game, what did you expect?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا حدث؟ في أي لعبة، وماذا كنت تتوقع؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী হয়েছে? কোন গেম, আপনি কী আশা করেছিলেন?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano ang nangyari? Anong laro, ano ang inaasahan mo?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या हुआ? कौन सा गेम, आप क्या उम्मीद कर रहे थे?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang terjadi? Game apa, dan apa yang Anda harapkan?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang berlaku? Permainan apa, apa yang anda jangkakan?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is er gebeurd? Welke game, wat verwachtte je?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดอะไรขึ้น เกมอะไร และคุณคาดว่าจะเป็นอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne oldu? Hangi oyunda, ne bekliyordunuz?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا ہوا؟ کون سی گیم تھی، آپ کیا توقع کر رہے تھے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra chuyện gì? Game nào, bạn mong đợi điều gì?"
          }
        }
      }
    },
