          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versturen…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังส่ง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
