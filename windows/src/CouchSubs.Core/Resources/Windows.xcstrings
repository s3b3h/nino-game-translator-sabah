    "Up to 3 photos. You can also drag images here or paste a screenshot with Ctrl+V.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى 3 صور. يمكنك أيضًا سحب الصور إلى هنا أو لصق لقطة شاشة باستخدام Ctrl+V."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ ৩টি ছবি। এখানে ছবি টেনে আনতে বা Ctrl+V দিয়ে স্ক্রিনশট পেস্ট করতেও পারেন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanggang 3 larawan. Puwede ka ring mag-drag ng mga larawan dito o mag-paste ng screenshot gamit ang Ctrl+V."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा से ज़्यादा 3 फ़ोटो। आप इमेज यहाँ ड्रैग भी कर सकते हैं या Ctrl+V से स्क्रीनशॉट पेस्ट कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga 3 foto. Anda juga bisa menyeret gambar ke sini atau menempel tangkapan layar dengan Ctrl+V."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga 3 foto. Anda juga boleh menyeret imej ke sini atau menampal tangkapan skrin dengan Ctrl+V."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal 3 foto's. Je kunt ook afbeeldingen hierheen slepen of een screenshot plakken met Ctrl+V."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูงสุด 3 รูป คุณยังลากรูปมาวางที่นี่ หรือวางภาพหน้าจอด้วย Ctrl+V ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok 3 fotoğraf. Görüntüleri buraya sürükleyebilir ya da ekran görüntüsünü Ctrl+V ile yapıştırabilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ سے زیادہ 3 تصاویر۔ آپ تصاویر یہاں گھسیٹ بھی سکتے ہیں یا Ctrl+V سے اسکرین شاٹ پیسٹ کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa 3 ảnh. Bạn cũng có thể kéo ảnh vào đây hoặc dán ảnh chụp màn hình bằng Ctrl+V."
          }
        }
      }
    },
