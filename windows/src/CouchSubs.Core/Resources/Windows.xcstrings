          "stringUnit": {
            "state": "translated",
            "value": "แนบบันทึกของแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama günlüğünü ekle"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ لاگ شامل کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đính kèm nhật ký ứng dụng"
          }
        }
      }
    },
    "Helps us find the problem. No passwords or keys are included.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يساعدنا في العثور على المشكلة. لا يتضمن أي كلمات مرور أو مفاتيح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্যা খুঁজে পেতে আমাদের সাহায্য করে। কোনো পাসওয়ার্ড বা কী যুক্ত থাকে না।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakakatulong ito sa amin na mahanap ang problema. Walang kasamang password o key."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समस्या ढूँढने में हमारी मदद करता है। इसमें कोई पासवर्ड या कुंजी शामिल नहीं होती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membantu kami menemukan masalah. Tidak ada kata sandi atau kunci yang disertakan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membantu kami mencari masalah. Tiada kata laluan atau kunci disertakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helpt ons het probleem te vinden. Wachtwoorden of sleutels worden niet meegestuurd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยให้เราหาปัญหาเจอ ไม่มีรหัสผ่านหรือคีย์รวมอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunu bulmamıza yardımcı olur. Parola ya da anahtar eklenmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مسئلہ ڈھونڈنے میں مدد کرتا ہے۔ اس میں کوئی پاس ورڈ یا کی شامل نہیں ہوتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giúp chúng tôi tìm ra sự cố. Không bao gồm mật khẩu hay khóa."
          }
        }
      }
    },
    "Your description, photos and (if on) the app log are sent to Nino's server so we can fix the problem. Don't include passwords.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إرسال وصفك وصورك وسجل التطبيق (إذا كان مفعّلًا) إلى خادم Nino حتى نتمكن من إصلاح المشكلة. لا تكتب كلمات المرور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্যাটি ঠিক করতে আপনার বিবরণ, ছবি এবং (চালু থাকলে) অ্যাপ লগ Nino-র সার্ভারে পাঠানো হয়। পাসওয়ার্ড দেবেন না।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapadala sa server ng Nino ang iyong paglalarawan, mga larawan at (kung naka-on) ang app log para maayos namin ang problema. Huwag maglagay ng password."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका विवरण, फ़ोटो और (चालू हो तो) ऐप लॉग Nino के सर्वर पर भेजे जाते हैं ताकि हम समस्या ठीक कर सकें। पासवर्ड शामिल न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsi, foto, dan (jika aktif) log aplikasi Anda dikirim ke server Nino agar kami bisa memperbaiki masalahnya. Jangan sertakan kata sandi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerangan, foto dan (jika dihidupkan) log apl anda dihantar ke pelayan Nino supaya kami boleh membaiki masalah. Jangan sertakan kata laluan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je beschrijving, foto's en (indien aan) de app-log worden naar de server van Nino gestuurd, zodat we het probleem kunnen oplossen. Voeg geen wachtwoorden toe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำอธิบาย รูปภาพ และบันทึกของแอป (หากเปิดไว้) จะถูกส่งไปยังเซิร์ฟเวอร์ของ Nino เพื่อให้เราแก้ปัญหาได้ อย่าใส่รหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunu giderebilmemiz için açıklamanız, fotoğraflarınız ve (açıksa) uygulama günlüğü Nino'nun sunucusuna gönderilir. Parola yazmayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تفصیل، تصاویر اور (اگر آن ہو) ایپ لاگ Nino کے سرور پر بھیجے جاتے ہیں تاکہ ہم مسئلہ ٹھیک کر سکیں۔ پاس ورڈ شامل نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả, ảnh và (nếu bật) nhật ký ứng dụng sẽ được gửi đến máy chủ của Nino để chúng tôi sửa sự cố. Đừng ghi mật khẩu."
          }
        }
      }
    },
    "Send": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
