          }
        }
      }
    },
    "Thanks! We received your report.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا! لقد تلقينا بلاغك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধন্যবাদ! আমরা আপনার রিপোর্ট পেয়েছি।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Salamat! Natanggap namin ang iyong ulat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद! हमें आपकी रिपोर्ट मिल गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih! Laporan Anda sudah kami terima."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih! Kami telah menerima laporan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt! We hebben je melding ontvangen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณ! เราได้รับรายงานของคุณแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teşekkürler! Bildiriminizi aldık."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شکریہ! ہمیں آپ کی رپورٹ مل گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn! Chúng tôi đã nhận được báo cáo."
          }
        }
      }
    },
    "You've sent many reports today. Please try again tomorrow.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أرسلت بلاغات كثيرة اليوم. يُرجى المحاولة مرة أخرى غدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ আপনি অনেক রিপোর্ট পাঠিয়েছেন। অনুগ্রহ করে আগামীকাল আবার চেষ্টা করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Marami ka nang naipadalang ulat ngayong araw. Pakisubukan ulit bukas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने आज बहुत सारी रिपोर्ट भेजी हैं। कृपया कल फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah mengirim banyak laporan hari ini. Silakan coba lagi besok."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah menghantar banyak laporan hari ini. Sila cuba lagi esok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt vandaag veel meldingen gestuurd. Probeer het morgen opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คุณส่งรายงานไปหลายครั้งแล้ว โปรดลองอีกครั้งพรุ่งนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün çok sayıda bildirim gönderdiniz. Lütfen yarın yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ آج بہت سی رپورٹس بھیج چکے ہیں۔ براہِ کرم کل دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay bạn đã gửi nhiều báo cáo. Hãy thử lại vào ngày mai."
          }
        }
      }
    },
    "The report could not be sent. Check your internet connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إرسال البلاغ. تحقق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোর্টটি পাঠানো যায়নি। আপনার ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maipadala ang ulat. Suriin ang iyong koneksyon sa internet at subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट भेजी नहीं जा सकी। अपना इंटरनेट कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan tidak dapat dikirim. Periksa koneksi internet Anda dan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan tidak dapat dihantar. Semak sambungan internet anda dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De melding kon niet worden verstuurd. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรายงานไม่ได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim gönderilemedi. İnternet bağlantınızı denetleyip yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رپورٹ نہیں بھیجی جا سکی۔ اپنا انٹرنیٹ کنکشن چیک کر کے دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gửi được báo cáo. Hãy kiểm tra kết nối internet và thử lại."
          }
        }
      }
    },
    "The report is too large. Remove a photo and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البلاغ كبير جدًا. أزل صورة وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোর্টটি খুব বড়। একটি ছবি সরিয়ে আবার চেষ্টা করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong malaki ang ulat. Mag-alis ng isang larawan at subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट बहुत बड़ी है। एक फ़ोटो हटाएँ और फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan terlalu besar. Hapus satu foto lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan terlalu besar. Buang satu foto dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De melding is te groot. Verwijder een foto en probeer het opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานมีขนาดใหญ่เกินไป นำรูปภาพออกหนึ่งรูปแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim çok büyük. Bir fotoğrafı kaldırıp yeniden deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رپورٹ بہت بڑی ہے۔ ایک تصویر ہٹا کر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo quá lớn. Hãy bớt một ảnh và thử lại."
          }
        }
      }
    },
    "The report was not accepted. Please check the description and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم قبول البلاغ. يُرجى التحقق من الوصف والمحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোর্টটি গ্রহণ করা হয়নি। অনুগ্রহ করে বিবরণটি দেখে আবার চেষ্টা করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tinanggap ang ulat. Pakisuri ang paglalarawan at subukan ulit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट स्वीकार नहीं हुई। कृपया विवरण जाँचें और फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan tidak diterima. Periksa deskripsinya dan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan tidak diterima. Sila semak penerangan dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De melding is niet geaccepteerd. Controleer de beschrijving en probeer het opnieuw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
