    "The whole text of popular games is already translated. Subtitles come without waiting, even offline. In other games the free translation works." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصوص الألعاب الشائعة مترجمة بالكامل مسبقًا. تظهر الترجمة دون انتظار، حتى دون اتصال بالإنترنت. وفي الألعاب الأخرى تعمل الترجمة المجانية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The whole text of popular games is already translated. Subtitles come without waiting, even offline. In other games the free translation works."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popüler oyunların tüm metni önceden çevrildi. Altyazı internetsiz bile beklemeden gelir. Diğer oyunlarda ücretsiz çeviri devreye girer."
          }
