    "Windows' own Turkish voice: speaks at once, nothing to download. Sounds more mechanical." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صوت Windows التركي المدمج: ينطق فورًا ولا يحتاج إلى تنزيل، لكنه يبدو آليًا أكثر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows-এর নিজস্ব তুর্কি ভয়েস: সঙ্গে সঙ্গে বলে, কিছু ডাউনলোড করতে হয় না। শুনতে বেশি যান্ত্রিক।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows' own Turkish voice: speaks at once, nothing to download. Sounds more mechanical."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sariling Turkish na boses ng Windows: agad na nagsasalita, walang kailangang i-download. Mas mekanikal ang tunog."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows की अपनी तुर्की आवाज़: तुरंत बोलती है, कुछ डाउनलोड नहीं करना। ज़्यादा मशीनी लगती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara Turki bawaan Windows: langsung berbicara, tanpa unduhan. Terdengar lebih mekanis."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara bahasa Turki Windows sendiri: bercakap serta-merta, tiada apa untuk dimuat turun. Bunyinya lebih mekanikal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eigen Turkse stem van Windows: spreekt meteen, niets te downloaden. Klinkt mechanischer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงภาษาตุรกีของ Windows เอง: พูดได้ทันที ไม่ต้องดาวน์โหลด แต่ฟังดูเหมือนเครื่องจักรมากกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows'un kendi Türkçe sesi: hemen konuşur, indirme gerekmez. Daha mekanik duyulur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows کی اپنی ترکی آواز: فوراً بولتی ہے، کچھ ڈاؤن لوڈ نہیں کرنا۔ زیادہ مشینی لگتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giọng Thổ Nhĩ Kỳ có sẵn của Windows: đọc ngay, không cần tải gì. Nghe máy móc hơn."
          }
        }
      }
    },
    "Natural voices, downloaded once. Each line takes a moment to prepare, so the voice can come a little after the subtitle." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصوات طبيعية تُنزَّل مرة واحدة. يحتاج كل سطر إلى لحظة لتجهيزه، لذا قد يتأخر الصوت قليلًا عن الترجمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বাভাবিক ভয়েস, একবার ডাউনলোড হয়। প্রতিটি লাইন প্রস্তুত হতে একটু সময় লাগে, তাই ভয়েস সাবটাইটেলের একটু পরে আসতে পারে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural voices, downloaded once. Each line takes a moment to prepare, so the voice can come a little after the subtitle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga natural na boses, isang beses lang dina-download. Sandaling inihahanda ang bawat linya, kaya puwedeng medyo mahuli ang boses sa subtitle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्राकृतिक आवाज़ें, एक बार डाउनलोड होती हैं। हर लाइन तैयार होने में थोड़ा समय लगता है, इसलिए आवाज़ सबटाइटल के थोड़ी देर बाद आ सकती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara alami, diunduh sekali. Tiap baris perlu waktu sebentar untuk disiapkan, jadi suaranya bisa muncul sedikit setelah subtitle."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara semula jadi, dimuat turun sekali. Setiap baris mengambil sedikit masa untuk disediakan, jadi suara mungkin tiba sedikit selepas sari kata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natuurlijke stemmen, één keer gedownload. Elke regel heeft even voorbereiding nodig, dus de stem kan iets na de ondertitel komen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงที่เป็นธรรมชาติ ดาวน์โหลดเพียงครั้งเดียว แต่ละบรรทัดต้องใช้เวลาเตรียมสักครู่ เสียงจึงอาจมาช้ากว่าคำบรรยายเล็กน้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğal sesler, bir kez indirilir. Her satırın hazırlanması biraz sürer, bu yüzden ses altyazıdan biraz sonra gelebilir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدرتی آوازیں، ایک بار ڈاؤن لوڈ۔ ہر لائن تیار ہونے میں تھوڑا وقت لیتی ہے، اس لیے آواز سب ٹائٹل کے کچھ بعد آ سکتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giọng tự nhiên, tải xuống một lần. Mỗi dòng cần chút thời gian chuẩn bị, nên giọng có thể đến sau phụ đề một chút."
          }
        }
      }
    },
    "Online translation (DeepL)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
