    "The %@–%@ language pack is not downloaded yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُنزَّل حزمة اللغة %@–%@ بعد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
