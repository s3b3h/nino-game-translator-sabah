    "Play in PS Remote Play or chiaki-ng on this computer. Nino reads that window and shows the translation on top of the game. No second account needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العب عبر PS Remote Play أو chiaki-ng على هذا الحاسوب. يقرأ Nino تلك النافذة ويعرض الترجمة فوق اللعبة، دون الحاجة إلى حساب ثانٍ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কম্পিউটারে PS Remote Play বা chiaki-ng-এ খেলুন। Nino সেই উইন্ডোটি পড়ে এবং গেমের ওপরে অনুবাদ দেখায়। দ্বিতীয় অ্যাকাউন্ট লাগবে না।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maglaro sa PS Remote Play o chiaki-ng sa computer na ito. Binabasa ng Nino ang window na iyon at ipinapakita ang salin sa ibabaw ng laro. Hindi kailangan ng pangalawang account."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस कंप्यूटर पर PS Remote Play या chiaki-ng में खेलें। Nino उस विंडो को पढ़ता है और गेम के ऊपर अनुवाद दिखाता है। दूसरे अकाउंट की ज़रूरत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bermainlah di PS Remote Play atau chiaki-ng di komputer ini. Nino membaca jendela tersebut dan menampilkan terjemahan di atas game. Tidak perlu akun kedua."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bermain dalam PS Remote Play atau chiaki-ng pada komputer ini. Nino membaca tetingkap itu dan memaparkan terjemahan di atas permainan. Tidak perlu akaun kedua."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel in PS Remote Play of chiaki-ng op deze computer. Nino leest dat venster en toont de vertaling boven op de game. Geen tweede account nodig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่นใน PS Remote Play หรือ chiaki-ng บนคอมพิวเตอร์เครื่องนี้ Nino จะอ่านหน้าต่างนั้นและแสดงคำแปลซ้อนทับเกม ไม่ต้องใช้บัญชีที่สอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyunu bu bilgisayarda PS Remote Play ya da chiaki-ng ile oyna. Nino o pencereyi okur ve çeviriyi oyunun üstünde gösterir. İkinci hesaba gerek yok."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کمپیوٹر پر PS Remote Play یا chiaki-ng میں کھیلیں۔ Nino وہ ونڈو پڑھتا ہے اور گیم کے اوپر ترجمہ دکھاتا ہے۔ دوسرے اکاؤنٹ کی ضرورت نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chơi bằng PS Remote Play hoặc chiaki-ng trên máy tính này. Nino đọc cửa sổ đó và hiển thị bản dịch trên game. Không cần tài khoản thứ hai."
          }
        }
      }
    },
