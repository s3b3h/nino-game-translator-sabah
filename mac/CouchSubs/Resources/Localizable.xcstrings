    "How to connect the PS5, the card and your screen, and how to turn off HDCP." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيفية توصيل PS5 والبطاقة والشاشة، وكيفية إيقاف HDCP."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5, কার্ড ও আপনার স্ক্রিন কীভাবে সংযোগ করবেন এবং কীভাবে HDCP বন্ধ করবেন।"
          }
        },
        "fil" : {
          "stringUnit" : {
