    "%@ is ready. It connects when you start translating." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ جاهز. سيتصل عند بدء الترجمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ প্রস্তুত। অনুবাদ শুরু করলে এটি সংযুক্ত হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is ready. It connects when you start translating."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handa na ang %@. Kokonekta ito kapag nagsimula kang magsalin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ तैयार है। अनुवाद शुरू करने पर यह कनेक्ट हो जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ siap. Akan terhubung saat Anda mulai menerjemahkan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah sedia. Ia bersambung apabila anda mula menterjemah."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is klaar. De verbinding wordt gemaakt als je begint met vertalen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ พร้อมแล้ว จะเชื่อมต่อเมื่อคุณเริ่มแปล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hazır. Çeviriyi başlattığınızda bağlanır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ تیار ہے۔ ترجمہ شروع کرنے پر یہ جڑ جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã sẵn sàng. Sẽ kết nối khi bạn bắt đầu dịch."
          }
        }
      }
    },
    "The Xbox connection was lost: %@. Restart the Xbox to reconnect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
