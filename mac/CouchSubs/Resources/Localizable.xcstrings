    "Pair this Mac with the 8-digit code from your PS5. It only takes a minute." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربط جهاز Mac هذا بـ PS5 باستخدام الرمز المكوّن من 8 أرقام الذي يظهر على PS5. لن يستغرق ذلك سوى دقيقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার PS5-এর ৮ অঙ্কের কোড দিয়ে এই Mac পেয়ার করুন। মাত্র এক মিনিট লাগে।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
