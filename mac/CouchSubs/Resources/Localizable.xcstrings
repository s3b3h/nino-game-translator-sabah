    "Your password is entered only on Sony's own page; Nino never sees it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكتب كلمة المرور في صفحة Sony فقط، ولا يراها Nino."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার পাসওয়ার্ড শুধু Sony-র নিজস্ব পেজে লেখা হয়; Nino কখনো তা দেখে না।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa sariling page lang ng Sony inilalagay ang iyong password; hindi ito nakikita ng Nino."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पासवर्ड सिर्फ़ Sony के अपने पेज पर डाला जाता है; Nino उसे कभी नहीं देखता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi Anda hanya dimasukkan di halaman milik Sony; Nino tidak pernah melihatnya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata laluan anda dimasukkan hanya pada halaman Sony sendiri; Nino tidak pernah melihatnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wachtwoord voer je alleen in op de eigen pagina van Sony; Nino ziet het nooit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสผ่านของคุณป้อนบนหน้าของ Sony เท่านั้น Nino ไม่เห็นรหัสผ่านเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifrenizi yalnızca Sony'nin kendi sayfasına yazarsınız, Nino şifrenizi görmez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا پاس ورڈ صرف Sony کے اپنے صفحے پر درج ہوتا ہے؛ Nino اسے کبھی نہیں دیکھتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu của bạn chỉ được nhập trên trang của chính Sony; Nino không bao giờ thấy nó."
          }
        }
      }
    },
    "Nino keeps only the account ID, nothing else." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ Nino بمعرّف الحساب فقط، ولا شيء غيره."
