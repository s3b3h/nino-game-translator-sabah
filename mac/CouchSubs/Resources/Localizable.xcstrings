          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op een verkeerd gelezen regel"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รอเมื่ออ่านบรรทัดผิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatalı okunan satır için bekleme"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غلط پڑھی گئی لائن کا انتظار"
          }
        },
