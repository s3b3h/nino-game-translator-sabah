        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu alan çevrilemedi."
          }
        }
      }
    },
    "Create a free account at playstation.com with a different email address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ حسابًا مجانيًا على playstation.com ببريد إلكتروني مختلف."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a free account at playstation.com with a different email address."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "playstation.com'da farklı bir e-posta adresiyle ücretsiz bir hesap açın."
          }
        }
      }
    },
    "Debugging was not allowed on the TV. Try again and choose Allow on the TV." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُسمح بتصحيح الأخطاء على التلفاز. حاول مرة أخرى واختر السماح على التلفاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugging was not allowed on the TV. Try again and choose Allow on the TV."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV'de hata ayıklamaya izin verilmedi. Tekrar deneyin ve TV'de İzin ver'i seçin."
          }
        }
      }
    },
    "Developer Mode is on. One last step to install the TV app:" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع المطوّر مفعّل. خطوة أخيرة لتثبيت تطبيق التلفاز:"
          }
        },
        "en" : {
          "stringUnit" : {
