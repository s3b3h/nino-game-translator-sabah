    "Waiting for the Remote Play window. Open PS Remote Play or chiaki-ng on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في انتظار نافذة Remote Play. افتح PS Remote Play أو chiaki-ng على هذا الـ Mac."
          }
        },
        "bn" : {
