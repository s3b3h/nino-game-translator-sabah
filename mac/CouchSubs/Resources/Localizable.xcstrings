          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کئی کی بورڈز پر Ctrl+Alt دراصل AltGr ہوتا ہے اور # اور { جیسے حروف روک دے گا۔ اس کی جگہ Ctrl+Shift استعمال کریں۔"
