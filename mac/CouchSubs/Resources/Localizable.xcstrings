          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony girişi tamamlamadı. Bir dakika bekleyin, sonra yeniden Giriş yap'a basıp ikinci hesapla giriş yapın."
          }
        }
      }
    },
    "Sony received too many sign-in attempts. Wait about 15 minutes, then sign in again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony received too many sign-in attempts. Wait about 15 minutes, then sign in again."
