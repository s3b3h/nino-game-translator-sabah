    "Debugging was not allowed on the TV. Try again and choose Allow on the TV." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُسمح بتصحيح الأخطاء على التلفاز. حاول مرة أخرى واختر السماح على التلفاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV-তে ডিবাগিংয়ের অনুমতি দেওয়া হয়নি। আবার চেষ্টা করুন এবং TV-তে Allow বেছে নিন।"
          }
