          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breng je Xbox naar deze Mac"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นำ Xbox มาที่ Mac เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox'ınızı Bu Mac'e Getirin"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا Xbox اس Mac پر لائیں"
          }
        },
