    "Choose the console whose subtitles you want translated. You can change it later in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الجهاز الذي تريد ترجمة نصوصه. يمكنك تغييره لاحقًا من الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যে কনসোলের সাবটাইটেল অনুবাদ করতে চান সেটি বেছে নিন। পরে সেটিংসে বদলাতে পারবেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the console whose subtitles you want translated. You can change it later in Settings."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin ang console na gusto mong isalin ang mga subtitle. Puwede mo itong baguhin mamaya sa Mga Setting."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह कंसोल चुनें जिसके सबटाइटल का अनुवाद चाहिए। आप इसे बाद में सेटिंग्स में बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih konsol yang subtitlenya ingin Anda terjemahkan. Anda bisa mengubahnya nanti di Pengaturan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih konsol yang sari katanya ingin anda terjemah. Anda boleh mengubahnya kemudian dalam Tetapan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de console waarvan je de ondertitels wilt vertalen. Je kunt dit later wijzigen in Instellingen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกคอนโซลที่ต้องการแปลคำบรรยาย เปลี่ยนภายหลังได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazısını çevireceğiniz konsolu seçin. Sonra Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ کنسول منتخب کریں جس کے سب ٹائٹلز کا ترجمہ چاہیے۔ آپ اسے بعد میں سیٹنگز میں بدل سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn máy chơi game có phụ đề bạn muốn dịch. Bạn có thể đổi sau trong Cài đặt."
          }
        }
      }
    },
