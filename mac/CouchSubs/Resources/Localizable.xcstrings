    "Later you sign in once with a free Samsung account; Samsung needs it to sign the app for your TV." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لاحقًا ستسجّل الدخول مرة واحدة بحساب Samsung مجاني؛ إذ تحتاجه Samsung لتوقيع التطبيق لتلفازك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরে একবার একটি বিনামূল্যের Samsung অ্যাকাউন্ট দিয়ে সাইন ইন করবেন; আপনার TV-র জন্য অ্যাপ সাইন করতে Samsung-এর এটি দরকার।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Later you sign in once with a free Samsung account; Samsung needs it to sign the app for your TV."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mamaya, magsa-sign in ka nang isang beses gamit ang libreng Samsung account; kailangan ito ng Samsung para pirmahan ang app para sa iyong TV."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाद में आप एक मुफ़्त Samsung अकाउंट से एक बार साइन इन करेंगे; आपके TV के लिए ऐप साइन करने के लिए Samsung को इसकी ज़रूरत होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanti Anda masuk sekali dengan akun Samsung gratis; Samsung memerlukannya untuk menandatangani aplikasi bagi TV Anda."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemudian anda log masuk sekali dengan akaun Samsung percuma; Samsung memerlukannya untuk menandatangani aplikasi bagi TV anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Later log je één keer in met een gratis Samsung-account; Samsung heeft dat nodig om de app voor je TV te ondertekenen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภายหลังคุณจะต้องลงชื่อเข้าด้วยบัญชี Samsung ฟรีหนึ่งครั้ง Samsung ต้องใช้บัญชีนี้เพื่อลงนามแอปสำหรับ TV ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonra ücretsiz bir Samsung hesabıyla bir kez giriş yaparsınız. Samsung, uygulamayı TV'nize özel imzalamak için buna ihtiyaç duyar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد میں آپ ایک بار مفت Samsung اکاؤنٹ سے سائن اِن کریں گے؛ Samsung کو آپ کے TV کے لیے ایپ سائن کرنے کے لیے اس کی ضرورت ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau đó bạn đăng nhập một lần bằng tài khoản Samsung miễn phí; Samsung cần tài khoản này để ký ứng dụng cho TV của bạn."
          }
        }
      }
    },
