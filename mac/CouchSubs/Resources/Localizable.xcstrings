        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De firewallregel is niet toegevoegd. Probeer het opnieuw en kies Ja als Windows het vraagt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้เพิ่มกฎไฟร์วอลล์ โปรดลองอีกครั้งและเลือก ใช่ เมื่อ Windows ถาม"
