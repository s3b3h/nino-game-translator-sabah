    "Still as the new user, go to Settings › System › Remote Play and turn on Enable Remote Play." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وأنت على الحساب الجديد، افتح الإعدادات › النظام › التشغيل عن بُعد وفعّل «تمكين التشغيل عن بُعد»."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন ইউজার থাকা অবস্থাতেই Settings › System › Remote Play-তে যান এবং Enable Remote Play চালু করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still as the new user, go to Settings › System › Remote Play and turn on Enable Remote Play."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilang bagong user pa rin, pumunta sa Settings › System › Remote Play at i-on ang Enable Remote Play."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए यूज़र के रूप में ही, Settings › System › Remote Play पर जाएँ और Enable Remote Play चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masih sebagai pengguna baru, buka Pengaturan › Sistem › Remote Play dan aktifkan Aktifkan Remote Play."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masih sebagai pengguna baharu, pergi ke Settings › System › Remote Play dan hidupkan Enable Remote Play."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga, nog steeds als de nieuwe gebruiker, naar Instellingen › Systeem › Remote Play en zet Remote Play inschakelen aan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขณะยังเป็นผู้ใช้ใหม่ ให้ไปที่ การตั้งค่า › ระบบ › Remote Play แล้วเปิด เปิดใช้งาน Remote Play"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni hesaptayken Ayarlar › Sistem › Uzaktan Oynama'da Uzaktan Oynama'yı Etkinleştir'i açın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نئے یوزر ہی کے طور پر Settings › System › Remote Play میں جائیں اور Enable Remote Play آن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn ở người dùng mới, vào Cài đặt › Hệ thống › Remote Play và bật Bật Remote Play."
          }
