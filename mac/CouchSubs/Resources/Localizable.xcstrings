          }
        }
      }
    },
    "Use this key with Ctrl+Shift, Alt or Alt+Shift, so typing in other apps isn't affected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم هذا المفتاح مع Ctrl+Shift أو Alt أو Alt+Shift، حتى لا تتأثر الكتابة في التطبيقات الأخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কী-টি Ctrl+Shift, Alt বা Alt+Shift-এর সাথে ব্যবহার করুন, যাতে অন্য অ্যাপে টাইপ করায় সমস্যা না হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this key with Ctrl+Shift, Alt or Alt+Shift, so typing in other apps isn't affected."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang key na ito kasama ng Ctrl+Shift, Alt o Alt+Shift, para hindi maapektuhan ang pagta-type sa ibang app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस कुंजी को Ctrl+Shift, Alt या Alt+Shift के साथ इस्तेमाल करें, ताकि दूसरे ऐप्स में टाइपिंग पर असर न पड़े।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan tombol ini dengan Ctrl+Shift, Alt atau Alt+Shift, agar mengetik di aplikasi lain tidak terganggu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan kekunci ini bersama Ctrl+Shift, Alt atau Alt+Shift supaya menaip dalam apl lain tidak terjejas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik deze toets met Ctrl+Shift, Alt of Alt+Shift, zodat typen in andere apps niet wordt beïnvloed."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ปุ่มนี้ร่วมกับ Ctrl+Shift, Alt หรือ Alt+Shift เพื่อไม่ให้รบกวนการพิมพ์ในแอปอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer uygulamalarda yazmayı bozmasın diye bu tuşu Ctrl+Shift, Alt ya da Alt+Shift ile birlikte kullanın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ کی Ctrl+Shift، Alt یا Alt+Shift کے ساتھ استعمال کریں، تاکہ دوسری ایپس میں ٹائپنگ متاثر نہ ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng phím này với Ctrl+Shift, Alt hoặc Alt+Shift để không ảnh hưởng đến việc gõ phím trong ứng dụng khác."
          }
        }
      }
    },
    "Ctrl+Alt is AltGr on many keyboards and would block characters like # and {. Use Ctrl+Shift instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt هو AltGr في كثير من لوحات المفاتيح، وقد يمنع كتابة رموز مثل # و{. استخدم Ctrl+Shift بدلًا منه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনেক কীবোর্ডে Ctrl+Alt হলো AltGr, এবং এটি # ও { এর মতো অক্ষর আটকে দেবে। এর বদলে Ctrl+Shift ব্যবহার করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt is AltGr on many keyboards and would block characters like # and {. Use Ctrl+Shift instead."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa maraming keyboard, ang Ctrl+Alt ay AltGr at haharangin nito ang mga character tulad ng # at {. Gamitin na lang ang Ctrl+Shift."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कई कीबोर्ड पर Ctrl+Alt ही AltGr होता है और # और { जैसे अक्षर रोक देगा। इसकी जगह Ctrl+Shift इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt adalah AltGr di banyak keyboard dan akan memblokir karakter seperti # dan {. Gunakan Ctrl+Shift saja."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt ialah AltGr pada banyak papan kekunci dan akan menyekat aksara seperti # dan {. Gunakan Ctrl+Shift."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt is op veel toetsenborden AltGr en zou tekens als # en { blokkeren. Gebruik in plaats daarvan Ctrl+Shift."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl+Alt คือ AltGr ในแป้นพิมพ์หลายแบบ และจะบล็อกอักขระอย่าง # และ { ใช้ Ctrl+Shift แทน"
          }
        },
        "tr" : {
          "stringUnit" : {
