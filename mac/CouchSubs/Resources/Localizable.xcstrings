    "No subtitles yet. Lines translated in this and earlier sessions appear here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد ترجمات بعد. تظهر هنا الأسطر المترجمة في هذه الجلسة والجلسات السابقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনো কোনো সাবটাইটেল নেই। এই ও আগের সেশনে অনুবাদ হওয়া লাইন এখানে দেখাবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No subtitles yet. Lines translated in this and earlier sessions appear here."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala pang subtitle. Lalabas dito ang mga linyang naisalin sa session na ito at sa mga nauna."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई सबटाइटल नहीं। इस और पिछले सेशन में अनुवादित लाइनें यहाँ दिखती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada subtitle. Baris yang diterjemahkan di sesi ini dan sesi sebelumnya muncul di sini."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada sari kata. Baris yang diterjemah dalam sesi ini dan sesi terdahulu dipaparkan di sini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen ondertitels. Regels die in deze en eerdere sessies zijn vertaald, verschijnen hier."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีคำบรรยาย บรรทัดที่แปลในเซสชันนี้และเซสชันก่อนหน้าจะแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz altyazı yok. Bu ve önceki oturumlarda çevrilen satırlar burada görünür."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابھی کوئی سب ٹائٹل نہیں۔ اس اور پچھلے سیشنز میں ترجمہ شدہ لائنیں یہاں دکھائی دیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có phụ đề. Các dòng được dịch trong phiên này và các phiên trước sẽ hiện ở đây."
          }
        }
      }
    },
    "The last %lld translated lines are kept on this computer." : {
