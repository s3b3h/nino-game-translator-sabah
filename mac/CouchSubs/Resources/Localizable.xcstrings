    "Install the Nino TV app on this TV using the guide and open it. It finds this computer by itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت تطبيق Nino للتلفاز على هذا التلفاز باتباع الدليل ثم افتحه. سيعثر على هذا الكمبيوتر تلقائيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গাইড দেখে এই TV-তে Nino TV অ্যাপ ইনস্টল করুন এবং খুলুন। এটি নিজে থেকেই এই কম্পিউটার খুঁজে নেয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install the Nino TV app on this TV using the guide and open it. It finds this computer by itself."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-install ang Nino TV app sa TV na ito gamit ang gabay at buksan ito. Kusa nitong hahanapin ang computer na ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गाइड की मदद से इस TV पर Nino TV ऐप इंस्टॉल करें और उसे खोलें। वह इस कंप्यूटर को अपने-आप ढूँढ लेता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instal aplikasi Nino TV di TV ini dengan mengikuti panduan, lalu buka. Aplikasi akan menemukan komputer ini dengan sendirinya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasang aplikasi Nino TV pada TV ini menggunakan panduan dan bukanya. Ia akan menemui komputer ini dengan sendirinya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeer de Nino TV-app op deze TV met de gids en open hem. Hij vindt deze computer vanzelf."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตั้งแอป Nino สำหรับ TV บน TV เครื่องนี้ตามคู่มือแล้วเปิดแอป แอปจะค้นหาคอมพิวเตอร์เครื่องนี้เอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV uygulamasını rehberdeki adımlarla bu TV'ye kurun ve açın. Uygulama bu bilgisayarı kendisi bulur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گائیڈ کی مدد سے اس TV پر Nino TV ایپ انسٹال کریں اور کھولیں۔ یہ اس کمپیوٹر کو خود ڈھونڈ لیتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài ứng dụng Nino TV lên TV này theo hướng dẫn và mở nó. Ứng dụng sẽ tự tìm máy tính này."
          }
        }
      }
    },
