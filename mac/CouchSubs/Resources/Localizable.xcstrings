    "Sony did not complete the sign-in. Wait a minute, then press Sign in again and sign in with the second account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُكمل Sony تسجيل الدخول. انتظر دقيقة، ثم اضغط «تسجيل الدخول» مجددًا وسجّل الدخول بالحساب الثاني."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony did not complete the sign-in. Wait a minute, then press Sign in again and sign in with the second account."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony girişi tamamlamadı. Bir dakika bekleyin, sonra yeniden Giriş yap'a basıp ikinci hesapla giriş yapın."
          }
        }
      }
    },
    "Sony received too many sign-in attempts. Wait about 15 minutes, then sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلقت Sony محاولات تسجيل دخول كثيرة جدًا. انتظر نحو 15 دقيقة، ثم سجّل الدخول مجددًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony received too many sign-in attempts. Wait about 15 minutes, then sign in again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony çok fazla giriş denemesi aldı. Yaklaşık 15 dakika bekleyip yeniden giriş yapın."
          }
        }
      }
    },
    "Sony's sign-in server returned an error. Wait a few minutes, then sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعاد خادم تسجيل الدخول لدى Sony خطأً. انتظر بضع دقائق، ثم سجّل الدخول مجددًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony's sign-in server returned an error. Wait a few minutes, then sign in again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony'nin giriş sunucusu hata verdi. Birkaç dakika bekleyip yeniden giriş yapın."
          }
        }
      }
    },
    "Could not reach Sony's sign-in server. Check the internet connection, then sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى خادم تسجيل الدخول لدى Sony. تحقق من الاتصال بالإنترنت، ثم سجّل الدخول مجددًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reach Sony's sign-in server. Check the internet connection, then sign in again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony'nin giriş sunucusuna ulaşılamadı. İnternet bağlantınızı kontrol edip yeniden giriş yapın."
          }
        }
      }
    },
    "Sony's answer could not be read. Sign in again; if it keeps happening, update Nino." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة رد Sony. سجّل الدخول مجددًا؛ وإذا تكرر ذلك، فحدّث Nino."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony's answer could not be read. Sign in again; if it keeps happening, update Nino."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony'nin yanıtı okunamadı. Yeniden giriş yapın; sorun sürerse Nino'yu güncelleyin."
          }
        }
      }
    },
    "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُغلقت نافذة تسجيل الدخول قبل اكتماله. اضغط «تسجيل الدخول» وأكمل تسجيل الدخول في النافذة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş penceresi, giriş bitmeden kapandı. Giriş yap'a basın ve girişi pencerede tamamlayın."
          }
        }
      }
    },
    "Sony's sign-in page could not be loaded. Check the internet connection, then sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل صفحة تسجيل الدخول لدى Sony. تحقق من الاتصال بالإنترنت، ثم سجّل الدخول مجددًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony's sign-in page could not be loaded. Check the internet connection, then sign in again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony'nin giriş sayfası yüklenemedi. İnternet bağlantınızı kontrol edip yeniden giriş yapın."
          }
        }
      }
    },
    "Paired with %@. Connects when you start translating." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الإقران مع %@. يتصل عند بدء الترجمة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paired with %@. Connects when you start translating."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ile eşleşti. Çeviriyi başlattığınızda bağlanır."
          }
        }
      }
    },
    "PS5 not found at %@. Make sure it is on and on the same network. Reconnecting…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على PS5 في %@. تأكد من أنه يعمل وعلى الشبكة نفسها. جارٍ إعادة الاتصال…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 not found at %@. Make sure it is on and on the same network. Reconnecting…"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5, %@ adresinde bulunamadı. Açık ve aynı ağda olduğundan emin olun. Yeniden bağlanılıyor…"
          }
        }
      }
    },
    "Can't reach the PS5. Reconnecting…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى PS5. جارٍ إعادة الاتصال…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach the PS5. Reconnecting…"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5'e ulaşılamıyor. Yeniden bağlanılıyor…"
          }
        }
      }
    },
    "Reconnecting… (%@)" : {
      "localizations" : {
        "ar" : {
