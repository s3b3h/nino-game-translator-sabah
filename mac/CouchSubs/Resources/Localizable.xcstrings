        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस एड्रेस पर कोई PS5 नहीं मिला। PS5 का IP एड्रेस Settings › Network › Connection Status में जाँचें।"
          }
        },
        "id" : {
          "stringUnit" : {
