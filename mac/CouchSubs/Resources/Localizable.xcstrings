    "Subtitles appear in a window over the game or PS Remote Play. You can connect a TV later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الترجمة في نافذة فوق اللعبة أو PS Remote Play. يمكنك الاتصال بتلفاز لاحقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাবটাইটেল গেম বা PS Remote Play-র ওপরে একটি উইন্ডোতে দেখায়। TV পরে সংযোগ করতে পারবেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitles appear in a window over the game or PS Remote Play. You can connect a TV later."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lalabas ang mga subtitle sa isang window sa ibabaw ng laro o ng PS Remote Play. Puwede kang magkonekta ng TV mamaya."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबटाइटल गेम या PS Remote Play के ऊपर एक विंडो में दिखते हैं। TV आप बाद में कनेक्ट कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitle muncul di jendela di atas game atau PS Remote Play. Anda bisa menghubungkan TV nanti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sari kata muncul dalam tetingkap di atas permainan atau PS Remote Play. Anda boleh menyambungkan TV kemudian."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondertitels verschijnen in een venster over de game of PS Remote Play. Je kunt later een TV verbinden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำบรรยายจะแสดงในหน้าต่างซ้อนทับเกมหรือ PS Remote Play คุณเชื่อมต่อ TV ภายหลังได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazı oyunun üstünde bir pencerede görünür. TV'yi sonra da bağlayabilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سب ٹائٹلز گیم یا PS Remote Play کے اوپر ایک ونڈو میں دکھائی دیتے ہیں۔ TV بعد میں جوڑا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ đề hiện trong một cửa sổ phía trên game hoặc PS Remote Play. Bạn có thể kết nối TV sau."
          }
        }
      }
    },
