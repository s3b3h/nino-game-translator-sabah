        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları › Gizlilik ve Güvenlik › Ekran Kaydı'nda Nino'ya izin ver, sonra Nino'yu yeniden aç."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Settings › Privacy & Security › Screen Recording میں Nino کو اجازت دیں، پھر Nino دوبارہ کھولیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho phép Nino trong Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Ghi màn hình, rồi mở lại Nino."
          }
        }
