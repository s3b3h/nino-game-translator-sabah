    },
    "Nino is not affiliated with Sony Interactive Entertainment. PlayStation and PS5 are trademarks of Sony Interactive Entertainment Inc." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino غير تابع لشركة Sony Interactive Entertainment. ‏PlayStation و PS5 علامتان تجاريتان لشركة Sony Interactive Entertainment Inc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino is not affiliated with Sony Interactive Entertainment. PlayStation and PS5 are trademarks of Sony Interactive Entertainment Inc."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, Sony Interactive Entertainment ile bağlantılı değildir. PlayStation ve PS5, Sony Interactive Entertainment Inc.'in ticari markalarıdır."
          }
        }
      }
    },
    "Nino reads the English subtitles of your PS5 games and shows a Turkish translation on your TV, on top of the game. You keep playing on the TV with your own controller." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Nino النصوص الإنجليزية في ألعاب PS5 ويعرض ترجمتها على التلفاز فوق اللعبة، وتواصل اللعب على التلفاز بيد التحكم الخاصة بك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino reads the English subtitles of your PS5 games and shows a Turkish translation on your TV, on top of the game. You keep playing on the TV with your own controller."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, PS5 oyunlarının İngilizce altyazılarını okur ve Türkçe çevirisini TV'de oyunun üstünde gösterir. Siz de TV'de kendi joystick'inizle oynamaya devam edersiniz."
          }
        }
      }
    },
    "Nino translates on this computer, without the internet. The English–Turkish model (about 530 MB) is downloaded once and kept on this computer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يترجم Nino على هذا الكمبيوتر دون اتصال بالإنترنت. يُنزَّل نموذج الترجمة من الإنجليزية إلى التركية (نحو 530 MB) مرة واحدة ويُحفظ على هذا الكمبيوتر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino translates on this computer, without the internet. The English–Turkish model (about 530 MB) is downloaded once and kept on this computer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino çeviriyi bu bilgisayarda, internetsiz yapar. İngilizce–Türkçe model (yaklaşık 530 MB) bir kez indirilir ve bu bilgisayarda kalır."
          }
        }
      }
    },
    "Nino watches the game through Remote Play. If it used your own account, the PS5 would turn off your controller. With a second account you keep playing undisturbed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتابع Nino اللعبة عبر Remote Play. لو استخدم حسابك أنت، لأوقف PS5 يد التحكم الخاصة بك. أما مع حساب ثانٍ فتواصل اللعب دون انقطاع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino watches the game through Remote Play. If it used your own account, the PS5 would turn off your controller. With a second account you keep playing undisturbed."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino oyunu Remote Play ile izler. Kendi hesabınızı kullansaydı PS5 joystick'inizi kapatırdı. İkinci bir hesapla oyununuz hiç bölünmez."
          }
        }
      }
    },
    "Nino will send a sample subtitle to your TV. It should appear at the bottom of the screen, on top of the game." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيرسل Nino ترجمة تجريبية إلى التلفاز. يُفترض أن تظهر أسفل الشاشة فوق اللعبة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino will send a sample subtitle to your TV. It should appear at the bottom of the screen, on top of the game."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV'nize örnek bir altyazı gönderecek. Altyazı ekranın altında, oyunun üstünde görünmeli."
          }
        }
      }
    },
    "Could not download %@. Check the internet connection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تنزيل %@. تحقق من الاتصال بالإنترنت وحاول مرة أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not download %@. Check the internet connection and try again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ indirilemedi. İnternet bağlantınızı kontrol edip tekrar deneyin."
          }
        }
      }
    },
    "Could not translate this area." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت ترجمة هذه المنطقة."
          }
