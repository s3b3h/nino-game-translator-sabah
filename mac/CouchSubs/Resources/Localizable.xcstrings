    "Press %@ while playing: every text on the screen is translated once and shown on the TV in its own place. Press again to remove the translations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط %@ أثناء اللعب: تُترجم كل النصوص على الشاشة مرة واحدة وتظهر على TV في أماكنها. اضغط مرة أخرى لإزالة الترجمات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খেলার সময় %@ চাপুন: স্ক্রিনের সব লেখা একবার অনুবাদ হয়ে TV-তে নিজ নিজ জায়গায় দেখাবে। অনুবাদগুলো সরাতে আবার চাপুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press %@ while playing: every text on the screen is translated once and shown on the TV in its own place. Press again to remove the translations."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindutin ang %@ habang naglalaro: isasalin nang isang beses ang bawat text sa screen at ipapakita ito sa TV sa sarili nitong puwesto. Pindutin ulit para alisin ang mga salin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खेलते समय %@ दबाएँ: स्क्रीन का हर टेक्स्ट एक बार अनुवाद होकर TV पर अपनी ही जगह दिखेगा। अनुवाद हटाने के लिए फिर से दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan %@ saat bermain: semua teks di layar diterjemahkan sekali dan ditampilkan di TV pada tempatnya masing-masing. Tekan lagi untuk menghapus terjemahan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan %@ semasa bermain: setiap teks pada skrin diterjemah sekali dan dipaparkan pada TV di tempatnya sendiri. Tekan sekali lagi untuk membuang terjemahan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk tijdens het spelen op %@: alle tekst op het scherm wordt één keer vertaald en op de eigen plek op de TV getoond. Druk nogmaals om de vertalingen te verwijderen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด %@ ระหว่างเล่น: ข้อความทั้งหมดบนหน้าจอจะถูกแปลหนึ่งครั้งและแสดงบน TV ในตำแหน่งเดิมของแต่ละข้อความ กดอีกครั้งเพื่อนำคำแปลออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynarken %@ kısayoluna basın: ekrandaki bütün yazılar bir kez çevrilir ve TV'de her biri kendi yerinde gösterilir. Çevirileri kaldırmak için yeniden basın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھیلتے ہوئے %@ دبائیں: اسکرین پر موجود ہر تحریر کا ایک بار ترجمہ ہو کر TV پر اسی جگہ دکھایا جائے گا۔ ترجمے ہٹانے کے لیے دوبارہ دبائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn %@ khi đang chơi: mọi chữ trên màn hình được dịch một lần và hiện trên TV ngay tại vị trí của nó. Nhấn lần nữa để gỡ bản dịch."
          }
        }
      }
    },
    "Press %@ while playing: the picture freezes on the PC, drag over any part of it to translate that part once. Esc closes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط %@ أثناء اللعب: تتجمد الصورة على الكمبيوتر، اسحب فوق أي جزء منها لترجمته مرة واحدة. يغلقها Esc."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খেলার সময় %@ চাপুন: PC-তে ছবিটি থেমে যাবে, যেকোনো অংশের ওপর টেনে সেই অংশটি একবার অনুবাদ করুন। Esc চাপলে বন্ধ হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press %@ while playing: the picture freezes on the PC, drag over any part of it to translate that part once. Esc closes."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindutin ang %@ habang naglalaro: titigil ang larawan sa PC, i-drag sa anumang bahagi nito para isalin ang bahaging iyon nang isang beses. Isinasara ito ng Esc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खेलते समय %@ दबाएँ: PC पर तस्वीर रुक जाएगी, किसी भी हिस्से पर ड्रैग करें और उसका एक बार अनुवाद होगा। Esc से बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan %@ saat bermain: gambar membeku di PC, seret di atas bagian mana pun untuk menerjemahkan bagian itu sekali. Esc untuk menutup."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan %@ semasa bermain: gambar dibekukan pada PC, seret di atas mana-mana bahagian untuk menterjemah bahagian itu sekali. Esc untuk menutup."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk tijdens het spelen op %@: het beeld bevriest op de pc. Sleep over een deel ervan om dat deel één keer te vertalen. Esc sluit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด %@ ระหว่างเล่น: ภาพบนพีซีจะหยุดนิ่ง ลากครอบส่วนใดก็ได้เพื่อแปลส่วนนั้นหนึ่งครั้ง กด Esc เพื่อปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynarken %@ kısayoluna basın: görüntü bilgisayarda donar, çevirmek istediğiniz yeri fareyle seçin, o kısım bir kez çevrilir. Esc kapatır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھیلتے ہوئے %@ دبائیں: PC پر تصویر رک جائے گی، جس حصے کا ترجمہ چاہیں اس پر ماؤس گھسیٹیں، اس کا ایک بار ترجمہ ہو جائے گا۔ Esc سے بند کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn %@ khi đang chơi: hình ảnh trên máy tính dừng lại, kéo chọn bất kỳ phần nào để dịch phần đó một lần. Esc để đóng."
          }
        }
      }
    },
    "%@ pauses or resumes the live subtitle translation, which helps when you translate areas." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف %@ الترجمة المباشرة للترجمة النصية أو يستأنفها، وهذا مفيد عند ترجمة المناطق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ লাইভ সাবটাইটেল অনুবাদ থামায় বা আবার চালু করে, এলাকা অনুবাদ করার সময় এটি কাজে লাগে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pauses or resumes the live subtitle translation, which helps when you translate areas."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang %@ ay nagpo-pause o nagpapatuloy sa live na pagsasalin ng subtitle, na nakakatulong kapag nagsasalin ka ng mga area."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ लाइव सबटाइटल अनुवाद को रोकता या फिर से शुरू करता है, जो क्षेत्रों का अनुवाद करते समय काम आता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menjeda atau melanjutkan terjemahan subtitle langsung, berguna saat Anda menerjemahkan area."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menjeda atau menyambung terjemahan sari kata langsung, berguna semasa anda menterjemah kawasan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met %@ pauzeer of hervat je de live ondertitelvertaling. Handig als je gebieden vertaalt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ใช้หยุดชั่วคราวหรือเล่นต่อการแปลคำบรรยายสด ช่วยได้เมื่อคุณแปลพื้นที่ต่างๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kısayolu canlı altyazı çevirisini duraklatır ya da devam ettirir; alan çevirirken işe yarar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ براہِ راست سب ٹائٹل ترجمہ روکتا یا دوبارہ شروع کرتا ہے، جو حصوں کا ترجمہ کرتے وقت مددگار ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tạm dừng hoặc tiếp tục dịch phụ đề trực tiếp, rất tiện khi bạn dịch các vùng."
          }
        }
      }
    },
    "Draw the area to translate, for example a quest panel. While you play, press its shortcut (%@) to read and translate it once. Choose where the result shows. It works even when Nino is in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارسم المنطقة المراد ترجمتها، مثل لوحة المهام. أثناء اللعب، اضغط اختصارها (%@) لقراءتها وترجمتها مرة واحدة. اختر مكان ظهور النتيجة. يعمل ذلك حتى عندما يكون Nino في الخلفية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুবাদ করার এলাকাটি আঁকুন, যেমন একটি কোয়েস্ট প্যানেল। খেলার সময় এর শর্টকাট (%@) চাপলে এটি একবার পড়ে অনুবাদ করা হবে। ফলাফল কোথায় দেখাবে তা বেছে নিন। Nino ব্যাকগ্রাউন্ডে থাকলেও এটি কাজ করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw the area to translate, for example a quest panel. While you play, press its shortcut (%@) to read and translate it once. Choose where the result shows. It works even when Nino is in the background."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iguhit ang area na isasalin, halimbawa ang panel ng quest. Habang naglalaro, pindutin ang shortcut nito (%@) para basahin at isalin ito nang isang beses. Piliin kung saan lalabas ang resulta. Gumagana ito kahit nasa background ang Nino."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुवाद के लिए क्षेत्र बनाएँ, जैसे कोई क्वेस्ट पैनल। खेलते समय उसका शॉर्टकट (%@) दबाएँ, वह एक बार पढ़कर अनुवाद हो जाएगा। चुनें कि नतीजा कहाँ दिखे। Nino बैकग्राउंड में होने पर भी यह काम करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar area yang ingin diterjemahkan, misalnya panel misi. Saat bermain, tekan pintasannya (%@) untuk membaca dan menerjemahkannya sekali. Pilih tempat hasilnya ditampilkan. Ini berfungsi meski Nino berjalan di latar belakang."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukis kawasan untuk diterjemah, contohnya panel misi. Semasa bermain, tekan pintasannya (%@) untuk membaca dan menterjemahnya sekali. Pilih tempat hasilnya dipaparkan. Ia berfungsi walaupun Nino berada di latar belakang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teken het gebied dat je wilt vertalen, bijvoorbeeld een questpaneel. Druk tijdens het spelen op de sneltoets (%@) om het één keer te lezen en te vertalen. Kies waar het resultaat verschijnt. Het werkt ook als Nino op de achtergrond draait."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วาดพื้นที่ที่ต้องการแปล เช่น แผงภารกิจ ระหว่างเล่น ให้กดปุ่มลัดของพื้นที่นั้น (%@) เพื่ออ่านและแปลหนึ่งครั้ง เลือกได้ว่าจะให้ผลลัพธ์แสดงที่ใด ใช้ได้แม้ Nino จะทำงานอยู่เบื้องหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrilecek alanı çizin (ör. görev paneli). Oynarken bu alanın kısayoluna (%@) basınca alan bir kez okunup çevrilir. Sonucun nerede görüneceğini seçin. Nino arka plandayken de çalışır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجمے کے لیے حصہ بنائیں، مثلاً کوئسٹ پینل۔ کھیلتے ہوئے اس کا شارٹ کٹ (%@) دبائیں تاکہ اسے ایک بار پڑھ کر ترجمہ کیا جائے۔ نتیجہ کہاں دکھے، یہ منتخب کریں۔ یہ Nino کے پس منظر میں ہونے پر بھی کام کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẽ vùng cần dịch, ví dụ bảng nhiệm vụ. Khi đang chơi, nhấn phím tắt của vùng (%@) để đọc và dịch một lần. Chọn nơi hiển thị kết quả. Tính năng vẫn hoạt động khi Nino chạy nền."
          }
        }
      }
    },
    "When on, clicks go through to the window below. Press %@ to turn it off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التشغيل، تمر النقرات إلى النافذة التي تحتها. اضغط %@ لإيقافه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালু থাকলে ক্লিকগুলো নিচের উইন্ডোতে চলে যায়। বন্ধ করতে %@ চাপুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, clicks go through to the window below. Press %@ to turn it off."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag naka-on, tatagos ang mga click sa window sa ilalim. Pindutin ang %@ para i-off ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चालू होने पर क्लिक नीचे वाली विंडो तक जाते हैं। बंद करने के लिए %@ दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika aktif, klik diteruskan ke jendela di bawahnya. Tekan %@ untuk menonaktifkannya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila dihidupkan, klik akan melalui ke tetingkap di bawah. Tekan %@ untuk mematikannya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit aan staat, gaan klikken door naar het venster eronder. Druk op %@ om het uit te zetten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดอยู่ การคลิกจะทะลุไปยังหน้าต่างด้านล่าง กด %@ เพื่อปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıkken tıklamalar alttaki pencereye geçer. Kapatmak için %@ kısayoluna basın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آن ہونے پر کلکس نیچے والی ونڈو تک پہنچتے ہیں۔ بند کرنے کے لیے %@ دبائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, các cú nhấp sẽ đi xuyên xuống cửa sổ bên dưới. Nhấn %@ để tắt."
          }
        }
      }
    },
    "No shortcut is set for this. You can set one under Keyboard shortcuts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعيَّن اختصار لهذا الإجراء. يمكنك تعيينه من اختصارات لوحة المفاتيح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর জন্য কোনো শর্টকাট সেট করা নেই। কীবোর্ড শর্টকাট অংশে একটি সেট করতে পারেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No shortcut is set for this. You can set one under Keyboard shortcuts."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala pang shortcut para dito. Puwede kang magtakda sa Mga keyboard shortcut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके लिए कोई शॉर्टकट सेट नहीं है। आप कीबोर्ड शॉर्टकट में एक सेट कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada pintasan untuk ini. Anda bisa mengaturnya di Pintasan keyboard."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada pintasan ditetapkan untuk ini. Anda boleh menetapkannya di bawah Pintasan papan kekunci."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiervoor is geen sneltoets ingesteld. Je kunt er een instellen bij Toetscombinaties."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้ตั้งปุ่มลัดสำหรับรายการนี้ ตั้งได้ที่ ปุ่มลัดแป้นพิมพ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun için kısayol atanmamış. Ayarlar › Kısayollar bölümünden atayabilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کے لیے کوئی شارٹ کٹ مقرر نہیں۔ آپ کی بورڈ شارٹ کٹس میں ایک مقرر کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa đặt phím tắt cho mục này. Bạn có thể đặt trong Phím tắt."
          }
        }
      }
    },
    "The shortcuts work only while translating, so the keys stay free in other apps. Keep Num Lock on for the Num keys. You can change them under Keyboard shortcuts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل الاختصارات أثناء الترجمة فقط، فتبقى المفاتيح متاحة في التطبيقات الأخرى. أبقِ Num Lock مفعّلًا لمفاتيح Num. يمكنك تغييرها من اختصارات لوحة المفاتيح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শর্টকাটগুলো শুধু অনুবাদ চলার সময় কাজ করে, তাই অন্য অ্যাপে কী-গুলো মুক্ত থাকে। Num কী-এর জন্য Num Lock চালু রাখুন। কীবোর্ড শর্টকাট অংশে এগুলো বদলাতে পারেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shortcuts work only while translating, so the keys stay free in other apps. Keep Num Lock on for the Num keys. You can change them under Keyboard shortcuts."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagana lang ang mga shortcut habang nagsasalin, kaya malaya ang mga key sa ibang app. Panatilihing naka-on ang Num Lock para sa mga Num key. Puwede mo itong baguhin sa Mga keyboard shortcut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शॉर्टकट सिर्फ़ अनुवाद के दौरान काम करते हैं, ताकि दूसरे ऐप्स में कुंजियाँ खाली रहें। Num कुंजियों के लिए Num Lock चालू रखें। आप इन्हें कीबोर्ड शॉर्टकट में बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintasan hanya berfungsi saat menerjemahkan, jadi tombolnya tetap bebas di aplikasi lain. Biarkan Num Lock aktif untuk tombol Num. Anda bisa mengubahnya di Pintasan keyboard."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintasan hanya berfungsi semasa menterjemah, jadi kekunci kekal bebas dalam apl lain. Pastikan Num Lock dihidupkan untuk kekunci Num. Anda boleh mengubahnya di bawah Pintasan papan kekunci."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sneltoetsen werken alleen tijdens het vertalen, zodat de toetsen in andere apps vrij blijven. Houd Num Lock aan voor de Num-toetsen. Je kunt ze wijzigen bij Toetscombinaties."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปุ่มลัดใช้ได้เฉพาะระหว่างแปล ปุ่มจึงยังว่างให้ใช้ในแอปอื่น เปิด Num Lock ไว้สำหรับปุ่ม Num เปลี่ยนได้ที่ ปุ่มลัดแป้นพิมพ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayollar yalnız çeviri açıkken çalışır; böylece tuşlar diğer uygulamalarda serbest kalır. Num tuşları için Num Lock açık olmalı. Kısayolları Ayarlar › Kısayollar bölümünden değiştirebilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارٹ کٹس صرف ترجمے کے دوران کام کرتے ہیں، اس لیے دوسری ایپس میں کیز آزاد رہتی ہیں۔ Num کیز کے لیے Num Lock آن رکھیں۔ آپ انہیں کی بورڈ شارٹ کٹس میں بدل سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím tắt chỉ hoạt động khi đang dịch, nên các phím vẫn dùng bình thường trong ứng dụng khác. Hãy bật Num Lock để dùng phím Num. Bạn có thể đổi trong Phím tắt."
          }
        }
      }
    },
    "Keyboard shortcuts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختصارات لوحة المفاتيح"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কীবোর্ড শর্টকাট"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard shortcuts"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga keyboard shortcut"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीबोर्ड शॉर्टकट"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintasan keyboard"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintasan papan kekunci"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toetscombinaties"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปุ่มลัดแป้นพิมพ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayollar"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کی بورڈ شارٹ کٹس"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím tắt"
          }
        }
      }
    },
    "Each action has two shortcuts, so it also works on keyboards without a numeric keypad. Click a shortcut and press the new keys. Backspace removes it, Esc cancels." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل إجراء اختصاران، ليعمل أيضًا على لوحات المفاتيح التي لا تحتوي على لوحة أرقام. انقر على اختصار واضغط المفاتيح الجديدة. Backspace يحذفه، وEsc يلغي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি কাজের দুটি শর্টকাট আছে, তাই নিউমেরিক কীপ্যাড ছাড়া কীবোর্ডেও কাজ করে। একটি শর্টকাটে ক্লিক করে নতুন কী চাপুন। Backspace মুছে দেয়, Esc বাতিল করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each action has two shortcuts, so it also works on keyboards without a numeric keypad. Click a shortcut and press the new keys. Backspace removes it, Esc cancels."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May dalawang shortcut ang bawat aksyon, kaya gumagana rin ito sa mga keyboard na walang numeric keypad. I-click ang isang shortcut at pindutin ang mga bagong key. Inaalis ito ng Backspace, kinakansela ng Esc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर काम के दो शॉर्टकट हैं, ताकि बिना न्यूमेरिक कीपैड वाले कीबोर्ड पर भी चले। किसी शॉर्टकट पर क्लिक करें और नई कुंजियाँ दबाएँ। Backspace उसे हटाता है, Esc रद्द करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap tindakan punya dua pintasan, jadi tetap berfungsi di keyboard tanpa tombol numerik. Klik pintasan lalu tekan tombol baru. Backspace menghapusnya, Esc membatalkan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap tindakan mempunyai dua pintasan, jadi ia juga berfungsi pada papan kekunci tanpa pad angka. Klik pintasan dan tekan kekunci baharu. Backspace membuangnya, Esc membatalkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke actie heeft twee sneltoetsen, zodat het ook werkt op toetsenborden zonder numeriek deel. Klik op een sneltoets en druk op de nieuwe toetsen. Backspace verwijdert hem, Esc annuleert."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละการทำงานมีปุ่มลัดสองชุด จึงใช้ได้กับแป้นพิมพ์ที่ไม่มีแป้นตัวเลขด้วย คลิกปุ่มลัดแล้วกดปุ่มใหม่ Backspace เพื่อลบ Esc เพื่อยกเลิก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her işin iki kısayolu var; böylece sayı tuş takımı olmayan klavyelerde de çalışır. Bir kısayola tıklayıp yeni tuşlara basın. Geri silme tuşu kısayolu kaldırır, Esc vazgeçer."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر کام کے دو شارٹ کٹس ہیں، تاکہ یہ عددی کی پیڈ کے بغیر کی بورڈ پر بھی چلے۔ کسی شارٹ کٹ پر کلک کریں اور نئی کیز دبائیں۔ Backspace اسے ہٹاتا ہے، Esc منسوخ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi thao tác có hai phím tắt, nên vẫn dùng được trên bàn phím không có bàn phím số. Nhấp vào một phím tắt rồi nhấn tổ hợp phím mới. Backspace để xóa, Esc để hủy."
          }
        }
      }
    },
    "The shortcuts work only while translating, even when Nino is in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل الاختصارات أثناء الترجمة فقط، حتى عندما يكون Nino في الخلفية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শর্টকাটগুলো শুধু অনুবাদ চলার সময় কাজ করে, Nino ব্যাকগ্রাউন্ডে থাকলেও।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shortcuts work only while translating, even when Nino is in the background."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagana lang ang mga shortcut habang nagsasalin, kahit nasa background ang Nino."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शॉर्टकट सिर्फ़ अनुवाद के दौरान काम करते हैं, Nino बैकग्राउंड में हो तब भी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintasan hanya berfungsi saat menerjemahkan, meski Nino berjalan di latar belakang."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintasan hanya berfungsi semasa menterjemah, walaupun Nino berada di latar belakang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sneltoetsen werken alleen tijdens het vertalen, ook als Nino op de achtergrond draait."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปุ่มลัดใช้ได้เฉพาะระหว่างแปล แม้ Nino จะทำงานอยู่เบื้องหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayollar yalnız çeviri açıkken çalışır; Nino arka plandayken de."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارٹ کٹس صرف ترجمے کے دوران کام کرتے ہیں، چاہے Nino پس منظر میں ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím tắt chỉ hoạt động khi đang dịch, kể cả khi Nino chạy nền."
          }
        }
      }
    },
