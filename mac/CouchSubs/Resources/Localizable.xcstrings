      }
    },
    "A capture card takes the PS5 picture over HDMI and gives it to this Mac over USB. No second PSN account or Remote Play needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأخذ بطاقة الالتقاط صورة PS5 عبر HDMI وتسلّمها لهذا الـ Mac عبر USB. لا حاجة إلى حساب PSN ثانٍ أو Remote Play."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্যাপচার কার্ড HDMI দিয়ে PS5-এর ছবি নেয় এবং USB দিয়ে এই Mac-এ দেয়। দ্বিতীয় PSN অ্যাকাউন্ট বা Remote Play লাগবে না।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinukuha ng capture card ang larawan ng PS5 sa HDMI at ibinibigay ito sa Mac na ito sa USB. Hindi kailangan ng pangalawang PSN account o Remote Play."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैप्चर कार्ड PS5 की तस्वीर HDMI से लेता है और USB से इस Mac को देता है। दूसरे PSN अकाउंट या Remote Play की ज़रूरत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture card mengambil gambar PS5 lewat HDMI dan mengirimkannya ke Mac ini lewat USB. Tidak perlu akun PSN kedua atau Remote Play."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad tangkapan mengambil gambar PS5 melalui HDMI dan memberikannya kepada Mac ini melalui USB. Tidak perlu akaun PSN kedua atau Remote Play."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een capturekaart neemt het PS5-beeld via HDMI op en geeft het via USB aan deze Mac. Geen tweede PSN-account of Remote Play nodig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การ์ดแคปเจอร์รับภาพจาก PS5 ผ่าน HDMI แล้วส่งให้ Mac เครื่องนี้ผ่าน USB ไม่ต้องใช้บัญชี PSN บัญชีที่สองหรือ Remote Play"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture Card, PS5 görüntüsünü HDMI'dan alır, USB ile bu Mac'e verir. İkinci PSN hesabı ya da Remote Play gerekmez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیپچر کارڈ PS5 کی تصویر HDMI سے لیتا ہے اور USB کے ذریعے اس Mac کو دیتا ہے۔ دوسرے PSN اکاؤنٹ یا Remote Play کی ضرورت نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture card nhận hình ảnh PS5 qua HDMI và truyền tới máy Mac này qua USB. Không cần tài khoản PSN thứ hai hay Remote Play."
          }
        }
      }
    },
    "Monitor or a TV without apps" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاشة أو تلفاز بلا تطبيقات"
