          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس اکاؤنٹ پر کوئی Xbox نہیں ملا۔ اپنے Xbox پر اسی اکاؤنٹ سے سائن ان کریں اور remote features آن کریں۔"
          }
