    "Start Remote play in the Xbox app, Greenlight or xbox.com/play. Nino reads that window and sends the translation to your TV." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ اللعب عن بُعد في تطبيق Xbox أو Greenlight أو xbox.com/play. يقرأ Nino تلك النافذة ويرسل الترجمة إلى التلفاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox অ্যাপ, Greenlight বা xbox.com/play-তে Remote play শুরু করুন। Nino সেই উইন্ডোটি পড়ে এবং অনুবাদ আপনার TV-তে পাঠায়।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulan ang Remote play sa Xbox app, Greenlight o xbox.com/play. Binabasa ng Nino ang window na iyon at ipinapadala ang salin sa iyong TV."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox ऐप, Greenlight या xbox.com/play में Remote play शुरू करें। Nino उस विंडो को पढ़ता है और अनुवाद आपके TV पर भेजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai Remote play di aplikasi Xbox, Greenlight, atau xbox.com/play. Nino membaca jendela tersebut dan mengirim terjemahan ke TV Anda."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulakan Remote play dalam aplikasi Xbox, Greenlight atau xbox.com/play. Nino membaca tetingkap itu dan menghantar terjemahan ke TV anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start Remote Play in de Xbox-app, Greenlight of xbox.com/play. Nino leest dat venster en stuurt de vertaling naar je TV."
