    "Another app is using %@. It may not work while that app is open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق آخر يستخدم %@. قد لا يعمل ما دام ذلك التطبيق مفتوحًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অন্য একটি অ্যাপ %@ ব্যবহার করছে। সেই অ্যাপ খোলা থাকলে এটি কাজ নাও করতে পারে।"
          }
