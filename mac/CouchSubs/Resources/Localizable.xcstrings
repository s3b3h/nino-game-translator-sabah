    "This month's DeepL limit is used up. Until it renews, the translation model on this computer translates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفد حد DeepL لهذا الشهر. وإلى أن يتجدد، يتولى نموذج الترجمة على هذا الكمبيوتر المهمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই মাসের DeepL সীমা শেষ। নবায়ন না হওয়া পর্যন্ত এই কম্পিউটারের অনুবাদ মডেল অনুবাদ করবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This month's DeepL limit is used up. Until it renews, the translation model on this computer translates."
