    "It shows for a few seconds at the bottom of the screen. Send it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر لبضع ثوانٍ أسفل الشاشة. أرسلها مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি স্ক্রিনের নিচে কয়েক সেকেন্ড দেখায়। আবার পাঠান।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumalabas ito nang ilang segundo sa ibaba ng screen. Ipadala itong muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्क्रीन के नीचे कुछ सेकंड के लिए दिखता है। फिर से भेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitle tampil beberapa detik di bagian bawah layar. Kirim lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia dipaparkan selama beberapa saat di bahagian bawah skrin. Hantar semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij wordt een paar seconden onderaan het scherm getoond. Stuur hem opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำบรรยายจะแสดงสองสามวินาทีที่ด้านล่างของหน้าจอ โปรดส่งอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazı birkaç saniye ekranın altında görünür. Tekrar gönderin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ اسکرین کے نیچے چند سیکنڈ کے لیے دکھائی دیتا ہے۔ دوبارہ بھیجیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ đề hiện vài giây ở cuối màn hình. Hãy gửi lại."
          }
        }
      }
    },
    "Make sure the TV is on and the Nino TV app is open, then send it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن التلفاز يعمل وأن تطبيق Nino للتلفاز مفتوح، ثم أرسلها مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিশ্চিত করুন TV চালু আছে এবং Nino TV অ্যাপ খোলা আছে, তারপর আবার পাঠান।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiyaking naka-on ang TV at bukas ang Nino TV app, saka ipadala itong muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पक्का करें कि TV चालू है और Nino TV ऐप खुला है, फिर से भेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan TV menyala dan aplikasi Nino TV terbuka, lalu kirim lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan TV dihidupkan dan aplikasi Nino TV dibuka, kemudian hantar semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer of de TV aan staat en de Nino TV-app open is, en stuur hem dan opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดตรวจสอบว่า TV เปิดอยู่และแอป Nino บน TV เปิดอยู่ แล้วส่งอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV'nin açık ve Nino TV uygulamasının çalışıyor olduğundan emin olun, sonra tekrar gönderin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یقینی بنائیں کہ TV آن ہے اور Nino TV ایپ کھلی ہے، پھر دوبارہ بھیجیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đảm bảo TV đang bật và ứng dụng Nino TV đang mở, rồi gửi lại."
          }
        }
      }
    },
