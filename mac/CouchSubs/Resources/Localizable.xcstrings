        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebenaran rangkaian setempat sudah sedia untuk Nino pada rangkaian Peribadi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming voor het lokale netwerk is klaar voor Nino op privénetwerken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิทธิ์เครือข่ายภายในพร้อมสำหรับ Nino บนเครือข่ายส่วนตัวแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino için Özel ağda yerel bağlantı izni hazır."
