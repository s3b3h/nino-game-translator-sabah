    "Open the Developer Mode app on the TV, turn on Key Server and keep the app on screen. Type the Passphrase it shows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح تطبيق Developer Mode على التلفاز، وشغّل Key Server وأبقِ التطبيق ظاهرًا على الشاشة. اكتب عبارة المرور التي يعرضها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV-তে Developer Mode অ্যাপ খুলুন, Key Server চালু করুন এবং অ্যাপটি স্ক্রিনে রাখুন। এটি যে Passphrase দেখায় তা লিখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the Developer Mode app on the TV, turn on Key Server and keep the app on screen. Type the Passphrase it shows."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buksan ang Developer Mode app sa TV, i-on ang Key Server at panatilihing nasa screen ang app. I-type ang Passphrase na ipinapakita nito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV पर Developer Mode ऐप खोलें, Key Server चालू करें और ऐप को स्क्रीन पर खुला रखें। वह जो Passphrase दिखाए, उसे टाइप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka aplikasi Developer Mode di TV, aktifkan Key Server, dan biarkan aplikasi tetap di layar. Ketik Passphrase yang ditampilkannya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka aplikasi Developer Mode pada TV, hidupkan Key Server dan biarkan aplikasi itu terpapar pada skrin. Taipkan Passphrase yang dipaparkannya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open de Developer Mode-app op de TV, zet Key Server aan en houd de app op het scherm. Typ de Passphrase die wordt getoond."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดแอป Developer Mode บน TV เปิด Key Server และเปิดแอปค้างไว้บนหน้าจอ แล้วพิมพ์ Passphrase ที่แสดง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV'de Developer Mode uygulamasını açın, Key Server'ı etkinleştirin ve uygulamayı ekranda bırakın. Gösterilen Passphrase'i buraya yazın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV پر Developer Mode ایپ کھولیں، Key Server آن کریں اور ایپ اسکرین پر کھلی رکھیں۔ جو Passphrase دکھے وہ لکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
