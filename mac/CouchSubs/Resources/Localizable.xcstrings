    "Menu names differ a little by brand. If the app is already on the TV, you can skip this step." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تختلف أسماء القوائم قليلًا حسب العلامة التجارية. إذا كان التطبيق موجودًا على التلفاز بالفعل، يمكنك تخطي هذه الخطوة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্র্যান্ড অনুযায়ী মেনুর নাম একটু আলাদা হয়। অ্যাপটি আগে থেকেই TV-তে থাকলে এই ধাপ বাদ দিতে পারেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu names differ a little by brand. If the app is already on the TV, you can skip this step."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medyo iba-iba ang mga pangalan ng menu depende sa brand. Kung nasa TV na ang app, puwede mong laktawan ang hakbang na ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेन्यू के नाम ब्रांड के हिसाब से थोड़े अलग होते हैं। अगर ऐप पहले से TV पर है, तो आप यह स्टेप छोड़ सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama menu sedikit berbeda tiap merek. Jika aplikasi sudah ada di TV, Anda bisa melewati langkah ini."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama menu sedikit berbeza mengikut jenama. Jika aplikasi sudah ada pada TV, anda boleh melangkau langkah ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunamen verschillen een beetje per merk. Als de app al op de TV staat, kun je deze stap overslaan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชื่อเมนูอาจแตกต่างกันเล็กน้อยตามยี่ห้อ หากมีแอปบน TV อยู่แล้ว คุณข้ามขั้นตอนนี้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü adları markaya göre biraz değişebilir. Uygulama TV'de zaten kuruluysa bu adımı geçebilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مینیو کے نام برانڈ کے لحاظ سے تھوڑے مختلف ہوتے ہیں۔ اگر ایپ پہلے سے TV پر ہے تو یہ قدم چھوڑ سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên menu hơi khác nhau tùy hãng. Nếu ứng dụng đã có trên TV, bạn có thể bỏ qua bước này."
          }
        }
      }
    },
