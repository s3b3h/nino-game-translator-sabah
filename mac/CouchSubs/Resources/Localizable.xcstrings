    "Nino works with LG (webOS 4+), Samsung (Tizen, 2019+) and Android TV / Google TV. Type the TV's IP address, or choose Android TV: its Nino app finds this phone by itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Nino مع LG (webOS 4+) وSamsung (Tizen، 2019+) وAndroid TV / Google TV. اكتب عنوان IP للتلفاز، أو اختر Android TV: فتطبيق Nino عليه يعثر على هذا الهاتف تلقائيًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino works with LG (webOS 4+), Samsung (Tizen, 2019+) and Android TV / Google TV. Type the TV's IP address, or choose Android TV: its Nino app finds this phone by itself."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino; LG (webOS 4 ve üstü), Samsung (Tizen, 2019 ve sonrası) ve Android TV / Google TV ile çalışır. TV'nin IP adresini yazın ya da Android TV'yi seçin: oradaki Nino uygulaması bu telefonu kendisi bulur."
          }
        }
      }
    },
    "The pack is chosen by itself when the game opens. Lines not in the pack are translated with the engine you chose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُختار الحزمة تلقائيًا عند فتح اللعبة. وتُترجم الأسطر غير الموجودة في الحزمة بمحرك الترجمة الذي اخترته."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pack is chosen by itself when the game opens. Lines not in the pack are translated with the engine you chose."
          }
        },
        "tr" : {
