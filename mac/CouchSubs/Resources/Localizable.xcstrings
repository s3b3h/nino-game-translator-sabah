            "value" : "De gratis vertaling werkt niet op deze telefoon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแปลฟรีใช้กับโทรศัพท์เครื่องนี้ไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz çeviri bu telefonda çalışmıyor."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفت ترجمہ اس فون پر کام نہیں کرتا۔"
          }
        },
        "vi" : {
