    "Start translation and play for a few minutes; Nino measures the connection while you play." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start translation and play for a few minutes; Nino measures the connection while you play."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çeviriyi başlatıp birkaç dakika oynayın; Nino bağlantıyı siz oynarken ölçer."
          }
        }
      }
    },
    "Subtitles are not sent to a TV" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitles are not sent to a TV"
