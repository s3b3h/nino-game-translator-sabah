        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino दोनों के साथ काम करता है। आप इसे बाद में सेटिंग्स में बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
