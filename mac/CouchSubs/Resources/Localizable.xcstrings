    "Windows' OpenSSH Client is missing. Add it in Settings › System › Optional features and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عميل OpenSSH في Windows مفقود. أضفه من الإعدادات › النظام › الميزات الاختيارية وحاول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows-এর OpenSSH Client নেই। Settings › System › Optional features-এ এটি যোগ করে আবার চেষ্টা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows' OpenSSH Client is missing. Add it in Settings › System › Optional features and try again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawawala ang OpenSSH Client ng Windows. Idagdag ito sa Settings › System › Optional features at subukang muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows का OpenSSH Client मौजूद नहीं है। उसे Settings › System › Optional features में जोड़ें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenSSH Client Windows tidak ada. Tambahkan di Pengaturan › Sistem › Fitur opsional dan coba lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenSSH Client Windows tiada. Tambahkannya dalam Settings › System › Optional features dan cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De OpenSSH-client van Windows ontbreekt. Voeg hem toe in Instellingen › Systeem › Optionele onderdelen en probeer het opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบ OpenSSH Client ของ Windows โปรดเพิ่มใน การตั้งค่า › ระบบ › ฟีเจอร์เสริม แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows'un OpenSSH İstemcisi eksik. Ayarlar › Sistem › İsteğe bağlı özellikler'den ekleyin ve tekrar deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows کا OpenSSH Client موجود نہیں۔ اسے Settings › System › Optional features میں شامل کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiếu OpenSSH Client của Windows. Hãy thêm nó trong Cài đặt › Hệ thống › Tính năng tùy chọn và thử lại."
          }
        }
      }
    },
