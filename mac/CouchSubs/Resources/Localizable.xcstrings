    "Drag the frame to move it, or drag its corner to resize it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب الإطار لتحريكه، أو اسحب زاويته لتغيير حجمه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সরাতে ফ্রেমটি টানুন, আকার বদলাতে এর কোণ টানুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the frame to move it, or drag its corner to resize it."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-drag ang frame para ilipat ito, o i-drag ang sulok nito para baguhin ang laki."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्रेम को हिलाने के लिए ड्रैग करें, या साइज़ बदलने के लिए उसका कोना ड्रैग करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret bingkai untuk memindahkannya, atau seret sudutnya untuk mengubah ukuran."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret bingkai untuk mengalihkannya, atau seret sudutnya untuk mengubah saiz."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep het kader om het te verplaatsen, of sleep aan de hoek om het formaat te wijzigen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากกรอบเพื่อย้าย หรือลากมุมเพื่อปรับขนาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taşımak için çerçeveyi, boyutlandırmak için köşesini sürükleyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فریم ہلانے کے لیے ڈریگ کریں، یا سائز بدلنے کے لیے اس کا کونا ڈریگ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo khung để di chuyển, hoặc kéo góc để đổi kích thước."
          }
        }
      }
    },
