    "If you don't see it, send it again. It shows for a few seconds at the bottom of the screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم ترها، فأرسلها مجددًا. تظهر لبضع ثوانٍ أسفل الشاشة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দেখতে না পেলে আবার পাঠান। এটি স্ক্রিনের নিচে কয়েক সেকেন্ড দেখায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you don't see it, send it again. It shows for a few seconds at the bottom of the screen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung hindi mo ito nakikita, ipadala itong muli. Lumalabas ito nang ilang segundo sa ibaba ng screen."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर नहीं दिखता, तो फिर से भेजें। यह स्क्रीन के नीचे कुछ सेकंड के लिए दिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tidak terlihat, kirim lagi. Subtitle tampil beberapa detik di bagian bawah layar."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda tidak melihatnya, hantar semula. Ia dipaparkan selama beberapa saat di bahagian bawah skrin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie je het niet? Stuur het dan opnieuw. Het wordt een paar seconden onderaan het scherm getoond."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่เห็น โปรดส่งอีกครั้ง คำบรรยายจะแสดงสองสามวินาทีที่ด้านล่างของหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görmüyorsanız yeniden gönderin. Altyazı ekranın altında birkaç saniye görünür."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر نظر نہ آئے تو دوبارہ بھیجیں۔ یہ اسکرین کے نیچے چند سیکنڈ کے لیے دکھائی دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không thấy, hãy gửi lại. Phụ đề hiện vài giây ở cuối màn hình."
          }
        }
      }
    },
