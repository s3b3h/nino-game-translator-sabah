    "Your Xbox must be on and on the same network as this computer. Turn on remote play in the Xbox settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون Xbox قيد التشغيل وعلى الشبكة نفسها التي يتصل بها هذا الكمبيوتر. فعّل اللعب عن بُعد في إعدادات Xbox."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার Xbox চালু থাকতে হবে এবং এই কম্পিউটারের একই নেটওয়ার্কে থাকতে হবে। Xbox সেটিংসে রিমোট প্লে চালু করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Xbox must be on and on the same network as this computer. Turn on remote play in the Xbox settings."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapat naka-on ang iyong Xbox at nasa parehong network ng computer na ito. I-on ang remote play sa settings ng Xbox."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका Xbox चालू होना चाहिए और इसी कंप्यूटर वाले नेटवर्क पर होना चाहिए। Xbox सेटिंग्स में रिमोट प्ले चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox Anda harus menyala dan berada di jaringan yang sama dengan komputer ini. Aktifkan remote play di pengaturan Xbox."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox anda mesti dihidupkan dan berada pada rangkaian yang sama dengan komputer ini. Hidupkan main jauh dalam tetapan Xbox."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Xbox moet aan staan en op hetzelfde netwerk zitten als deze computer. Zet op afstand spelen aan in de Xbox-instellingen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox ต้องเปิดอยู่และอยู่ในเครือข่ายเดียวกับคอมพิวเตอร์เครื่องนี้ เปิดการเล่นระยะไกลในการตั้งค่า Xbox"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox'ınız açık ve bilgisayarla aynı ağda olmalı. Xbox ayarlarından uzaktan oynatmayı etkinleştirin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا Xbox آن ہونا چاہیے اور اسی نیٹ ورک پر ہونا چاہیے جس پر یہ کمپیوٹر ہے۔ Xbox کی سیٹنگز میں ریموٹ پلے آن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox phải đang bật và cùng mạng với máy tính này. Hãy bật chơi từ xa trong cài đặt Xbox."
