    "Sony did not complete the sign-in. Wait a minute, then press Sign in again and sign in with the second account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُكمل Sony تسجيل الدخول. انتظر دقيقة، ثم اضغط «تسجيل الدخول» مجددًا وسجّل الدخول بالحساب الثاني."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony সাইন-ইন সম্পূর্ণ করেনি। এক মিনিট অপেক্ষা করুন, তারপর আবার Sign in চাপুন এবং দ্বিতীয় অ্যাকাউন্ট দিয়ে সাইন ইন করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony did not complete the sign-in. Wait a minute, then press Sign in again and sign in with the second account."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi tinapos ng Sony ang pag-sign in. Maghintay ng isang minuto, saka pindutin muli ang Mag-sign in at mag-sign in gamit ang pangalawang account."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony ने साइन-इन पूरा नहीं किया। एक मिनट रुकें, फिर साइन इन करें दबाएँ और दूसरे अकाउंट से साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony tidak menyelesaikan proses masuk. Tunggu sebentar, lalu tekan Masuk lagi dan masuk dengan akun kedua."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony tidak menyelesaikan log masuk. Tunggu seminit, kemudian tekan Log masuk semula dan log masuk dengan akaun kedua."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony heeft het inloggen niet voltooid. Wacht een minuut, druk dan opnieuw op Log in en log in met het tweede account."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony ไม่ได้ดำเนินการลงชื่อเข้าให้เสร็จ โปรดรอสักครู่ แล้วกด ลงชื่อเข้า อีกครั้งและลงชื่อเข้าด้วยบัญชีที่สอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony girişi tamamlamadı. Bir dakika bekleyin, sonra yeniden Giriş yap'a basıp ikinci hesapla giriş yapın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony نے سائن اِن مکمل نہیں کیا۔ ایک منٹ انتظار کریں، پھر دوبارہ Sign in دبائیں اور دوسرے اکاؤنٹ سے سائن اِن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony chưa hoàn tất đăng nhập. Hãy chờ một phút, rồi bấm Đăng nhập lại và đăng nhập bằng tài khoản thứ hai."
          }
        }
      }
    },
    "Sony received too many sign-in attempts. Wait about 15 minutes, then sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلقت Sony محاولات تسجيل دخول كثيرة جدًا. انتظر نحو 15 دقيقة، ثم سجّل الدخول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony অনেক বেশি সাইন-ইন চেষ্টা পেয়েছে। প্রায় ১৫ মিনিট অপেক্ষা করুন, তারপর আবার সাইন ইন করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony received too many sign-in attempts. Wait about 15 minutes, then sign in again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masyadong maraming pagtatangkang mag-sign in ang natanggap ng Sony. Maghintay nang mga 15 minuto, saka mag-sign in muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony को बहुत ज़्यादा साइन-इन कोशिशें मिलीं। लगभग 15 मिनट रुकें, फिर से साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony menerima terlalu banyak percobaan masuk. Tunggu sekitar 15 menit, lalu masuk lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony menerima terlalu banyak percubaan log masuk. Tunggu kira-kira 15 minit, kemudian log masuk semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony heeft te veel inlogpogingen ontvangen. Wacht ongeveer 15 minuten en log dan opnieuw in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony ได้รับการพยายามลงชื่อเข้ามากเกินไป โปรดรอประมาณ 15 นาที แล้วลงชื่อเข้าอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony çok fazla giriş denemesi aldı. Yaklaşık 15 dakika bekleyip yeniden giriş yapın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony کو بہت زیادہ سائن اِن کوششیں موصول ہوئیں۔ تقریباً 15 منٹ انتظار کریں، پھر دوبارہ سائن اِن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony đã nhận quá nhiều lần thử đăng nhập. Hãy chờ khoảng 15 phút rồi đăng nhập lại."
          }
        }
      }
    },
    "Sony's sign-in server returned an error. Wait a few minutes, then sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعاد خادم تسجيل الدخول لدى Sony خطأً. انتظر بضع دقائق، ثم سجّل الدخول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony-র সাইন-ইন সার্ভার একটি ত্রুটি দেখিয়েছে। কয়েক মিনিট অপেক্ষা করুন, তারপর আবার সাইন ইন করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony's sign-in server returned an error. Wait a few minutes, then sign in again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagbalik ng error ang sign-in server ng Sony. Maghintay ng ilang minuto, saka mag-sign in muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony के साइन-इन सर्वर ने एरर दी। कुछ मिनट रुकें, फिर से साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server masuk Sony mengembalikan kesalahan. Tunggu beberapa menit, lalu masuk lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelayan log masuk Sony mengembalikan ralat. Tunggu beberapa minit, kemudian log masuk semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De inlogserver van Sony gaf een fout. Wacht een paar minuten en log dan opnieuw in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซิร์ฟเวอร์ลงชื่อเข้าของ Sony แจ้งข้อผิดพลาด โปรดรอสักครู่ แล้วลงชื่อเข้าอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony'nin giriş sunucusu hata verdi. Birkaç dakika bekleyip yeniden giriş yapın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony کے سائن اِن سرور نے خرابی دکھائی۔ چند منٹ انتظار کریں، پھر دوبارہ سائن اِن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ đăng nhập của Sony báo lỗi. Hãy chờ vài phút rồi đăng nhập lại."
          }
        }
      }
    },
    "Could not reach Sony's sign-in server. Check the internet connection, then sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى خادم تسجيل الدخول لدى Sony. تحقق من الاتصال بالإنترنت، ثم سجّل الدخول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony-র সাইন-ইন সার্ভারে পৌঁছানো যায়নি। ইন্টারনেট সংযোগ দেখুন, তারপর আবার সাইন ইন করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reach Sony's sign-in server. Check the internet connection, then sign in again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi maabot ang sign-in server ng Sony. Tingnan ang koneksyon sa internet, saka mag-sign in muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony के साइन-इन सर्वर तक नहीं पहुँचा जा सका। इंटरनेट कनेक्शन जाँचें, फिर से साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menjangkau server masuk Sony. Periksa koneksi internet, lalu masuk lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat mencapai pelayan log masuk Sony. Semak sambungan internet, kemudian log masuk semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de inlogserver van Sony niet bereiken. Controleer de internetverbinding en log dan opnieuw in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อเซิร์ฟเวอร์ลงชื่อเข้าของ Sony ไม่ได้ โปรดตรวจสอบการเชื่อมต่ออินเทอร์เน็ต แล้วลงชื่อเข้าอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony'nin giriş sunucusuna ulaşılamadı. İnternet bağlantınızı kontrol edip yeniden giriş yapın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony کے سائن اِن سرور تک رسائی نہیں ہو سکی۔ انٹرنیٹ کنکشن چیک کریں، پھر دوبارہ سائن اِن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không kết nối được máy chủ đăng nhập của Sony. Hãy kiểm tra kết nối internet rồi đăng nhập lại."
          }
        }
      }
    },
    "Sony's answer could not be read. Sign in again; if it keeps happening, update Nino." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة رد Sony. سجّل الدخول مجددًا؛ وإذا تكرر ذلك، فحدّث Nino."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony-র উত্তর পড়া যায়নি। আবার সাইন ইন করুন; বারবার হলে Nino আপডেট করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony's answer could not be read. Sign in again; if it keeps happening, update Nino."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mabasa ang sagot ng Sony. Mag-sign in muli; kung patuloy itong nangyayari, i-update ang Nino."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony का जवाब पढ़ा नहीं जा सका। फिर से साइन इन करें; अगर ऐसा बार-बार हो, तो Nino अपडेट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban Sony tidak dapat dibaca. Masuk lagi; jika terus terjadi, perbarui Nino."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawapan Sony tidak dapat dibaca. Log masuk semula; jika ini terus berlaku, kemas kini Nino."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het antwoord van Sony kon niet worden gelezen. Log opnieuw in; blijft het gebeuren, werk Nino dan bij."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านคำตอบจาก Sony ไม่ได้ โปรดลงชื่อเข้าอีกครั้ง หากยังเกิดขึ้นอยู่ โปรดอัปเดต Nino"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony'nin yanıtı okunamadı. Yeniden giriş yapın; sorun sürerse Nino'yu güncelleyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony کا جواب پڑھا نہیں جا سکا۔ دوبارہ سائن اِن کریں؛ اگر یہ بار بار ہو تو Nino اپ ڈیٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đọc được phản hồi của Sony. Hãy đăng nhập lại; nếu vẫn lỗi, hãy cập nhật Nino."
          }
        }
      }
    },
    "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُغلقت نافذة تسجيل الدخول قبل اكتماله. اضغط «تسجيل الدخول» وأكمل تسجيل الدخول في النافذة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাইন-ইন শেষ হওয়ার আগেই উইন্ডোটি বন্ধ হয়ে গেছে। Sign in চাপুন এবং উইন্ডোতে সাইন ইন শেষ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naisara ang sign-in window bago natapos ang pag-sign in. Pindutin ang Mag-sign in at tapusin ang pag-sign in sa window."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन-इन पूरा होने से पहले साइन-इन विंडो बंद हो गई। साइन इन करें दबाएँ और विंडो में साइन इन पूरा करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jendela masuk ditutup sebelum proses masuk selesai. Tekan Masuk dan selesaikan proses masuk di jendela tersebut."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetingkap log masuk ditutup sebelum log masuk selesai. Tekan Log masuk dan selesaikan log masuk dalam tetingkap tersebut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het inlogvenster is gesloten voordat het inloggen klaar was. Druk op Log in en rond het inloggen af in het venster."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าต่างลงชื่อเข้าถูกปิดก่อนลงชื่อเข้าเสร็จ โปรดกด ลงชื่อเข้า แล้วลงชื่อเข้าในหน้าต่างให้เสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş penceresi, giriş bitmeden kapandı. Giriş yap'a basın ve girişi pencerede tamamlayın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سائن اِن مکمل ہونے سے پہلے سائن اِن ونڈو بند ہو گئی۔ Sign in دبائیں اور ونڈو میں سائن اِن مکمل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ đăng nhập đã bị đóng trước khi đăng nhập xong. Bấm Đăng nhập và hoàn tất đăng nhập trong cửa sổ."
          }
        }
      }
    },
