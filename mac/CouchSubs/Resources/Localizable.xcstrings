          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen Xbox gevonden op dit account. Log op je Xbox in met hetzelfde account en zet externe functies aan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบ Xbox ในบัญชีนี้ ลงชื่อเข้าใช้บน Xbox ด้วยบัญชีเดียวกัน แล้วเปิด Remote features"
