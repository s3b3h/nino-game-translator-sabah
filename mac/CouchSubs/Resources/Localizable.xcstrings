          "stringUnit" : {
            "state" : "translated",
            "value" : "यह एक टेस्ट सबटाइटल है। क्या आपको यह गेम के ऊपर दिख रहा है?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini adalah subtitle uji. Apakah Anda bisa melihatnya di atas game?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini ialah sari kata ujian. Bolehkah anda melihatnya di atas permainan?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is een testondertitel. Zie je hem boven op de game?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่คือคำบรรยายทดสอบ คุณเห็นซ้อนทับเกมไหม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bir deneme altyazısı. Oyunun üstünde görüyor musunuz?"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ ایک ٹیسٹ سب ٹائٹل ہے۔ کیا یہ آپ کو گیم کے اوپر نظر آ رہا ہے؟"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là phụ đề thử. Bạn có thấy nó trên game không?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a test subtitle. Can you see it on top of the game?"
          }
        }
      }
    },
    "Tick “Always allow from this computer” and choose Allow. The app then installs by itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّد «السماح دائمًا من هذا الكمبيوتر» واختر «سماح». بعدها يُثبَّت التطبيق تلقائيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Always allow from this computer”-এ টিক দিন এবং Allow বেছে নিন। এরপর অ্যাপটি নিজে থেকেই ইনস্টল হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tick “Always allow from this computer” and choose Allow. The app then installs by itself."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagyan ng tsek ang “Always allow from this computer” at piliin ang Allow. Kusa nang mai-install ang app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Always allow from this computer” पर टिक करें और Allow चुनें। फिर ऐप अपने-आप इंस्टॉल हो जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centang “Selalu izinkan dari komputer ini” dan pilih Izinkan. Aplikasi lalu terinstal dengan sendirinya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tandakan “Always allow from this computer” dan pilih Allow. Aplikasi kemudian dipasang dengan sendirinya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vink ‘Altijd toestaan vanaf deze computer’ aan en kies Sta toe. De app installeert zich daarna vanzelf."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำเครื่องหมาย “อนุญาตจากคอมพิวเตอร์เครื่องนี้เสมอ” แล้วเลือก อนุญาต จากนั้นแอปจะติดตั้งเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Bu bilgisayardan her zaman izin ver” kutusunu işaretleyin ve İzin ver'i seçin. Uygulama ardından kendiliğinden kurulur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Always allow from this computer” پر نشان لگائیں اور Allow منتخب کریں۔ پھر ایپ خود انسٹال ہو جائے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh dấu “Luôn cho phép từ máy tính này” và chọn Cho phép. Ứng dụng sẽ tự cài đặt."
          }
        }
      }
    },
