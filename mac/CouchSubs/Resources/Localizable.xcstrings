    "A game pack with this ID already exists. Replacing it will overwrite the installed pack." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد بالفعل حزمة لعبة بهذا المعرّف. سيؤدي الاستبدال إلى الكتابة فوق الحزمة المثبّتة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ID-র একটি গেম প্যাক আগে থেকেই আছে। প্রতিস্থাপন করলে ইনস্টল করা প্যাকটির ওপর লেখা হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A game pack with this ID already exists. Replacing it will overwrite the installed pack."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May game pack na may ganitong ID. Kapag pinalitan ito, mapapatungan ang naka-install na pack."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ID वाला गेम पैक पहले से मौजूद है। बदलने पर इंस्टॉल किया पैक ओवरराइट हो जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket game dengan ID ini sudah ada. Menggantinya akan menimpa paket yang terpasang."
          }
        },
        "ms" : {
          "stringUnit" : {
