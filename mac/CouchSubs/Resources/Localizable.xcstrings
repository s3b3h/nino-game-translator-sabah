          "stringUnit" : {
            "state" : "translated",
            "value" : "شیشے کا سوئچ سلائیڈ کریں؛ TV لائیو سب ٹائٹل کے ساتھ نیچے آ جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trượt công tắc kính; TV sẽ hạ xuống cùng phụ đề trực tiếp."
          }
        }
      }
    },
