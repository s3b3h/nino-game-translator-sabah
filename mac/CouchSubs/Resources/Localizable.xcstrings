    "Nino can read only the OBS projector or game window you select in Settings › Picture source. No second PSN account or additional capture app is needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ Nino قراءة عارض OBS أو نافذة اللعبة التي تحددها في الإعدادات › مصدر الصورة فقط. لا حاجة إلى حساب PSN ثانٍ أو تطبيق التقاط إضافي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেটিংস › ছবির উৎস-এ আপনি যে OBS প্রজেক্টর বা গেম উইন্ডো বেছে নেন, Nino শুধু সেটিই পড়তে পারে। দ্বিতীয় PSN অ্যাকাউন্ট বা আলাদা ক্যাপচার অ্যাপের দরকার নেই।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino can read only the OBS projector or game window you select in Settings › Picture source. No second PSN account or additional capture app is needed."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayang basahin ng Nino ang OBS projector o game window lang na pinili mo sa Mga Setting › Pinagmulan ng larawan. Hindi kailangan ng pangalawang PSN account o dagdag na capture app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino सिर्फ़ वही OBS प्रोजेक्टर या गेम विंडो पढ़ सकता है जो आप सेटिंग्स › तस्वीर का सोर्स में चुनते हैं। दूसरे PSN अकाउंट या किसी और कैप्चर ऐप की ज़रूरत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino dapat membaca hanya projector OBS atau jendela game yang Anda pilih di Pengaturan › Sumber gambar. Tidak perlu akun PSN kedua atau aplikasi tangkapan tambahan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino boleh membaca hanya projektor OBS atau tetingkap permainan yang anda pilih dalam Tetapan › Sumber gambar. Akaun PSN kedua atau apl tangkapan tambahan tidak diperlukan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino kan alleen de OBS-projector of het gamevenster lezen dat je kiest in Instellingen › Beeldbron. Geen tweede PSN-account of extra opname-app nodig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino อ่านได้เฉพาะโปรเจกเตอร์ OBS หรือหน้าต่างเกมที่คุณเลือกใน การตั้งค่า › แหล่งภาพ ไม่ต้องใช้บัญชี PSN บัญชีที่สองหรือแอปจับภาพเพิ่มเติม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, Ayarlar › Görüntü kaynağı bölümünde seçtiğiniz OBS projektörünü veya oyun penceresini okuyabilir. İkinci PSN hesabı ya da ek yakalama uygulaması gerekmez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino صرف وہی OBS پروجیکٹر یا گیم ونڈو پڑھ سکتا ہے جو آپ سیٹنگز › تصویر کا ذریعہ میں منتخب کریں۔ نہ دوسرے PSN اکاؤنٹ کی ضرورت ہے نہ کسی اضافی کیپچر ایپ کی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino có thể chỉ đọc cửa sổ projector OBS hoặc cửa sổ game bạn chọn trong Cài đặt › Nguồn hình ảnh. Không cần tài khoản PSN phụ hay ứng dụng ghi hình nào khác."
          }
        }
      }
    },
