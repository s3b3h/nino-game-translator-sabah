    "Your phone reads the English subtitles in the game, translates them and shows them on the TV or on its own screen. You keep playing without putting the controller down." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ هاتفك النصوص الإنجليزية في اللعبة ويترجمها ويعرضها على التلفاز أو على شاشته. وتواصل اللعب دون أن تترك يد التحكم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your phone reads the English subtitles in the game, translates them and shows them on the TV or on its own screen. You keep playing without putting the controller down."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonunuz oyundaki İngilizce altyazıyı okur, çevirir ve TV'de ya da kendi ekranında gösterir. Siz de joystick'i bırakmadan oynamaya devam edersiniz."
          }
        }
      }
    },
