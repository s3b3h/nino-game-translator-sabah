    },
    "Only the game's English text is sent, anonymously. It is used to make better Turkish translations for everyone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُرسَل سوى النصوص الإنجليزية للعبة، دون الكشف عن هويتك. وتُستخدم لإعداد ترجمات تركية أفضل للجميع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু গেমের ইংরেজি লেখা পরিচয় গোপন রেখে পাঠানো হয়। এটি সবার জন্য আরও ভালো তুর্কি অনুবাদ তৈরিতে ব্যবহার হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the game's English text is sent, anonymously. It is used to make better Turkish translations for everyone."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang English na text lang ng laro ang ipinapadala, nang anonymous. Ginagamit ito para gumawa ng mas mahusay na Turkish na salin para sa lahat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ गेम का अंग्रेज़ी टेक्स्ट गुमनाम रूप से भेजा जाता है। इससे सबके लिए बेहतर तुर्की अनुवाद बनते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya teks bahasa Inggris dari game yang dikirim, secara anonim. Data ini digunakan untuk membuat terjemahan bahasa Turki yang lebih baik bagi semua orang."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya teks bahasa Inggeris permainan yang dihantar, tanpa nama. Ia digunakan untuk menghasilkan terjemahan bahasa Turki yang lebih baik untuk semua."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de Engelse tekst van de game wordt anoniem verstuurd. Die wordt gebruikt om voor iedereen betere Turkse vertalingen te maken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบบจะส่งเฉพาะข้อความภาษาอังกฤษของเกมแบบไม่ระบุตัวตน เพื่อใช้ทำคำแปลภาษาตุรกีที่ดีขึ้นสำหรับทุกคน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca oyunun İngilizce metni anonim olarak gönderilir. Herkes için daha iyi Türkçe çeviriler hazırlamakta kullanılır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف گیم کا انگریزی متن، گمنام طور پر بھیجا جاتا ہے۔ اسے سب کے لیے بہتر ترکی ترجمے بنانے میں استعمال کیا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ gửi chữ tiếng Anh của game, ẩn danh. Dữ liệu được dùng để làm bản dịch tiếng Thổ Nhĩ Kỳ tốt hơn cho mọi người."
          }
        }
      }
    },
    "Nino sends the English subtitles it reads to a shared pool, anonymously, to make better Turkish translations for everyone. You can turn this off in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل Nino النصوص الإنجليزية التي يقرؤها إلى مستودع مشترك دون الكشف عن هويتك، لإعداد ترجمات تركية أفضل للجميع. يمكنك إيقاف ذلك من الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সবার জন্য আরও ভালো তুর্কি অনুবাদ তৈরি করতে Nino যে ইংরেজি সাবটাইটেল পড়ে তা পরিচয় গোপন রেখে একটি শেয়ার্ড পুলে পাঠায়। Settings-এ এটি বন্ধ করতে পারেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino sends the English subtitles it reads to a shared pool, anonymously, to make better Turkish translations for everyone. You can turn this off in Settings."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipinapadala ng Nino ang mga English na subtitle na nababasa nito sa isang shared pool, nang anonymous, para gumawa ng mas mahusay na Turkish na salin para sa lahat. Puwede mo itong i-off sa Mga Setting."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino जो अंग्रेज़ी सबटाइटल पढ़ता है, उन्हें गुमनाम रूप से एक साझा पूल में भेजता है, ताकि सबके लिए बेहतर तुर्की अनुवाद बनें। आप इसे सेटिंग्स में बंद कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino mengirim subtitle bahasa Inggris yang dibacanya ke kumpulan bersama secara anonim, untuk membuat terjemahan bahasa Turki yang lebih baik bagi semua orang. Anda bisa menonaktifkannya di Pengaturan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino menghantar sari kata bahasa Inggeris yang dibacanya ke kumpulan kongsi, tanpa nama, untuk menghasilkan terjemahan bahasa Turki yang lebih baik untuk semua. Anda boleh mematikannya dalam Tetapan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino stuurt de Engelse ondertitels die het leest anoniem naar een gedeelde pool, om voor iedereen betere Turkse vertalingen te maken. Je kunt dit uitzetten in Instellingen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino จะส่งคำบรรยายภาษาอังกฤษที่อ่านได้ไปยังคลังส่วนรวมแบบไม่ระบุตัวตน เพื่อทำคำแปลภาษาตุรกีที่ดีขึ้นสำหรับทุกคน คุณปิดได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, okuduğu İngilizce altyazıları herkes için daha iyi Türkçe çeviriler hazırlamak üzere anonim olarak ortak havuza gönderir. Bunu Ayarlar'dan kapatabilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino پڑھے گئے انگریزی سب ٹائٹلز گمنام طور پر مشترکہ پول میں بھیجتا ہے، تاکہ سب کے لیے بہتر ترکی ترجمے بنیں۔ آپ اسے Settings میں بند کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino gửi phụ đề tiếng Anh đã đọc vào một kho chung, ẩn danh, để làm bản dịch tiếng Thổ Nhĩ Kỳ tốt hơn cho mọi người. Bạn có thể tắt tính năng này trong Cài đặt."
          }
        }
      }
    },
    "No PS5 found. Make sure it is on and on the same network, or enter its IP address. Nino must also be allowed in System Settings › Privacy & Security › Local Network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على PS5. تأكد من أنه يعمل وعلى الشبكة نفسها، أو أدخل عنوان IP الخاص به. يجب أيضًا السماح لـ Nino في إعدادات النظام › الخصوصية والأمن › الشبكة المحلية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো PS5 পাওয়া যায়নি। নিশ্চিত করুন এটি চালু আছে এবং একই নেটওয়ার্কে আছে, অথবা এর IP ঠিকানা লিখুন। System Settings › Privacy & Security › Local Network-এ Nino-কেও অনুমতি দিতে হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No PS5 found. Make sure it is on and on the same network, or enter its IP address. Nino must also be allowed in System Settings › Privacy & Security › Local Network."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang nahanap na PS5. Tiyaking naka-on ito at nasa parehong network, o ilagay ang IP address nito. Dapat ding payagan ang Nino sa System Settings › Privacy & Security › Local Network."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई PS5 नहीं मिला। पक्का करें कि वह चालू है और उसी नेटवर्क पर है, या उसका IP एड्रेस डालें। सिस्टम सेटिंग्स › गोपनीयता और सुरक्षा › लोकल नेटवर्क में Nino को अनुमति भी होनी चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 tidak ditemukan. Pastikan PS5 menyala dan berada di jaringan yang sama, atau masukkan alamat IP-nya. Nino juga harus diizinkan di Pengaturan Sistem › Privasi & Keamanan › Jaringan Lokal."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada PS5 ditemui. Pastikan ia dihidupkan dan berada pada rangkaian yang sama, atau masukkan alamat IPnya. Nino juga mesti dibenarkan dalam System Settings › Privacy & Security › Local Network."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen PS5 gevonden. Controleer of hij aan staat en op hetzelfde netwerk zit, of voer het IP-adres in. Nino moet ook zijn toegestaan in Systeeminstellingen › Privacy en beveiliging › Lokaal netwerk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบ PS5 โปรดตรวจสอบว่าเปิดอยู่และอยู่ในเครือข่ายเดียวกัน หรือป้อนที่อยู่ IP นอกจากนี้ต้องอนุญาต Nino ใน การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › เครือข่ายเฉพาะที่ ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 bulunamadı. Açık ve aynı ağda olduğundan emin olun ya da IP adresini girin. Ayrıca Sistem Ayarları › Gizlilik ve Güvenlik › Yerel Ağ'da Nino'ya izin verilmiş olmalı."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی PS5 نہیں ملا۔ یقینی بنائیں کہ وہ آن ہے اور اسی نیٹ ورک پر ہے، یا اس کا IP ایڈریس درج کریں۔ System Settings › Privacy & Security › Local Network میں Nino کو اجازت بھی ہونی چاہیے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy PS5. Hãy đảm bảo máy đang bật và cùng mạng, hoặc nhập địa chỉ IP của máy. Nino cũng phải được cho phép trong Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Mạng cục bộ."
          }
        }
      }
    },
    "Connecting to the PS5… This can take up to 30 seconds." : {
      "localizations" : {
