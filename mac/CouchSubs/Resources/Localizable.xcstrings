        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan debugging nirkabel, ketik juga port TV: “IP address & Port” di bagian atas layar Wireless debugging TV (mis. 192.168.1.20:41235)."
