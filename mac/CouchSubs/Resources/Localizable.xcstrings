    "With home streaming and your own Microsoft account. No second account needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عبر البث المنزلي وحساب Microsoft الخاص بك. لا حاجة إلى حساب ثانٍ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হোম স্ট্রিমিং এবং আপনার নিজের Microsoft অ্যাকাউন্টসহ। দ্বিতীয় অ্যাকাউন্টের দরকার নেই।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With home streaming and your own Microsoft account. No second account needed."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamit ang home streaming at sarili mong Microsoft account. Hindi kailangan ng pangalawang account."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम स्ट्रीमिंग और आपके अपने Microsoft अकाउंट के साथ। दूसरे अकाउंट की ज़रूरत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan streaming rumah dan akun Microsoft Anda sendiri. Tidak perlu akun kedua."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan penstriman rumah dan akaun Microsoft anda sendiri. Akaun kedua tidak diperlukan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met thuisstreaming en je eigen Microsoft-account. Geen tweede account nodig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้การสตรีมในบ้านและบัญชี Microsoft ของคุณเอง ไม่ต้องใช้บัญชีที่สอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev yayınıyla, kendi Microsoft hesabınızla. İkinci hesap gerekmez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہوم اسٹریمنگ اور آپ کے اپنے Microsoft اکاؤنٹ کے ساتھ۔ دوسرے اکاؤنٹ کی ضرورت نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng tính năng phát trực tuyến tại nhà và tài khoản Microsoft của bạn. Không cần tài khoản phụ."
          }
        }
      }
    },
    "Xbox support is in Beta. If something goes wrong, tell us and we'll fix it as soon as we can." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دعم Xbox تجريبي. إن واجهت مشكلة، أخبرنا وسنصلحها في أقرب وقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox সাপোর্ট বেটাতে আছে। কোনো সমস্যা হলে আমাদের জানান, আমরা যত দ্রুত সম্ভব ঠিক করব।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox support is in Beta. If something goes wrong, tell us and we'll fix it as soon as we can."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasa Beta pa ang suporta sa Xbox. Kung may magkaproblema, sabihin sa amin at aayusin namin ito sa lalong madaling panahon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox सपोर्ट बीटा में है। कुछ गड़बड़ हो तो हमें बताएँ, हम जल्द से जल्द ठीक करेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dukungan Xbox masih Beta. Jika ada masalah, beri tahu kami dan kami akan segera memperbaikinya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sokongan Xbox dalam Beta. Jika ada masalah, beritahu kami dan kami akan membaikinya secepat mungkin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox-ondersteuning is in bèta. Gaat er iets mis, laat het ons weten, dan lossen we het zo snel mogelijk op."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรองรับ Xbox อยู่ในช่วงเบต้า หากมีปัญหา บอกเราได้เลย เราจะแก้ไขให้เร็วที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox desteği Beta. Sorun olursa bize yazın; ilk fırsatta düzeltiriz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox سپورٹ بیٹا میں ہے۔ اگر کچھ غلط ہو تو ہمیں بتائیں، ہم جلد از جلد ٹھیک کر دیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỗ trợ Xbox đang ở bản Beta. Nếu có lỗi, hãy báo cho chúng tôi để sửa sớm nhất có thể."
          }
        }
      }
    },
    "Sign in with Microsoft" : {
      "localizations" : {
