        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने PS5 के 8 अंकों वाले कोड से इस Mac को पेयर करें। इसमें बस एक मिनट लगता है।"
          }
        },
        "id" : {
          "stringUnit" : {
