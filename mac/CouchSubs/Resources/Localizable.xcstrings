          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 ने सेशन शुरू नहीं किया। कोई दूसरा Remote Play ऐप (PS Remote Play) खुला हो सकता है, या PS5 किसी दूसरे सेशन में हो सकता है। PS Remote Play बंद करें, PS5 रीस्टार्ट करें, फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 tidak memulai sesi. Mungkin ada aplikasi Remote Play lain (PS Remote Play) yang terbuka, atau PS5 sedang dalam sesi lain. Tutup PS Remote Play, mulai ulang PS5, lalu coba lagi."
          }
        },
        "ms" : {
