    "When off, each new line replaces the previous one. Needs TV app 0.9.16 or later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف، يحل كل سطر جديد محل السابق. يتطلب تطبيق التلفاز 0.9.16 أو أحدث."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, each new line replaces the previous one. Needs TV app 0.9.16 or later."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken her yeni satır öncekinin yerini alır. TV uygulamasının 0.9.16 veya sonraki sürümü gerekir."
          }
        }
      }
    },
    "Advanced" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متقدم"
          }
        },
        "en" : {
