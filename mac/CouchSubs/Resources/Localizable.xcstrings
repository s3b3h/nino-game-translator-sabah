          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تفعيله، تمر النقرات إلى النافذة التي تحتها. اضغط ⌥⌘L أو استخدم شريط القائمة لإيقافه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
