    "Drag to move, drag the edges to resize." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب للتحريك، واسحب الحواف لتغيير الحجم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সরাতে টানুন, আকার বদলাতে কিনারা টানুন।"
