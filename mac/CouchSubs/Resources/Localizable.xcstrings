          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قابلِ اعتماد Private نیٹ ورک پر TV اور PS5 کنکشنز کے لیے لوکل نیٹ ورک کی اجازت ترتیب دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cấu hình quyền mạng cục bộ cho kết nối TV và PS5 trên một mạng Riêng tư đáng tin cậy."
          }
        }
      }
    },
    "Permission applies only to Private networks. If this is your trusted home network, set it to Private in Windows Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسري الإذن على الشبكات الخاصة فقط. إذا كانت هذه شبكتك المنزلية الموثوقة، فاجعلها «خاصة» في إعدادات Windows."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুমতি শুধু Private নেটওয়ার্কে প্রযোজ্য। এটি আপনার বিশ্বস্ত বাড়ির নেটওয়ার্ক হলে Windows Settings-এ এটি Private করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission applies only to Private networks. If this is your trusted home network, set it to Private in Windows Settings."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa mga Private network lang gumagana ang pahintulot. Kung ito ang pinagkakatiwalaan mong home network, itakda ito sa Private sa Windows Settings."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति सिर्फ़ प्राइवेट नेटवर्क पर लागू होती है। अगर यह आपका भरोसेमंद होम नेटवर्क है, तो Windows सेटिंग्स में इसे प्राइवेट पर सेट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin hanya berlaku untuk jaringan Pribadi. Jika ini jaringan rumah tepercaya Anda, atur ke Pribadi di Pengaturan Windows."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebenaran hanya terpakai pada rangkaian Peribadi. Jika ini rangkaian rumah anda yang dipercayai, tetapkannya kepada Peribadi dalam Tetapan Windows."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toestemming geldt alleen voor privénetwerken. Is dit je vertrouwde thuisnetwerk, stel het dan in op Privé in de Windows-instellingen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิทธิ์นี้ใช้กับเครือข่ายส่วนตัวเท่านั้น หากนี่คือเครือข่ายในบ้านที่คุณเชื่อถือ ให้ตั้งเป็นส่วนตัวในการตั้งค่า Windows"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin yalnız Özel ağlarda geçerlidir. Bu, güvendiğiniz ev ağıysa Windows Ayarları içinden ağ profilini Özel yapın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجازت صرف Private نیٹ ورکس پر لاگو ہوتی ہے۔ اگر یہ آپ کا قابلِ اعتماد گھریلو نیٹ ورک ہے تو Windows Settings میں اسے Private پر سیٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền chỉ áp dụng cho mạng Riêng tư. Nếu đây là mạng gia đình đáng tin cậy, hãy đặt thành Riêng tư trong Cài đặt Windows."
          }
        }
      }
    },
