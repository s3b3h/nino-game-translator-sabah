    "Open the downloaded zip and drag Nino into Applications, replacing the old one. Your settings stay." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح ملف zip الذي تم تنزيله واسحب Nino إلى مجلد التطبيقات ليحل محل الإصدار القديم. ستبقى إعداداتك كما هي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডাউনলোড করা zip খুলুন এবং Nino-কে Applications-এ টেনে আনুন, পুরোনোটির জায়গায়। আপনার সেটিংস থেকে যাবে।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buksan ang na-download na zip at i-drag ang Nino sa Applications, papalitan ang luma. Mananatili ang iyong mga setting."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड की गई zip खोलें और Nino को Applications में ड्रैग करें, पुराने की जगह। आपकी सेटिंग्स बनी रहेंगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka file zip yang diunduh dan seret Nino ke Aplikasi untuk menggantikan versi lama. Pengaturan Anda tetap tersimpan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka zip yang dimuat turun dan seret Nino ke Applications, menggantikan yang lama. Tetapan anda kekal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open het gedownloade zip-bestand en sleep Nino naar Apps, ter vervanging van de oude. Je instellingen blijven bewaard."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดไฟล์ zip ที่ดาวน์โหลดมา แล้วลาก Nino ไปไว้ใน Applications แทนที่เวอร์ชันเก่า การตั้งค่าของคุณจะยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnen zip dosyasını açın ve Nino'yu Uygulamalar klasörüne sürükleyip eskisinin yerine koyun. Ayarlarınız kalır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈاؤن لوڈ شدہ zip کھولیں اور Nino کو Applications میں ڈریگ کریں، پرانے کی جگہ۔ آپ کی سیٹنگز برقرار رہیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở tệp zip đã tải và kéo Nino vào Applications, thay thế bản cũ. Cài đặt của bạn vẫn được giữ."
          }
        }
      }
    },
