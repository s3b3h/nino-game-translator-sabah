        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halos puno na ang disk (%.1f GB ang libre). Kailangan ng macOS ng libreng espasyo para magbasa ng text; magbakante ng ilang GB at simulang muli ang pagsasalin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क लगभग भर गई है (%.1f GB खाली)। टेक्स्ट पढ़ने के लिए macOS को खाली जगह चाहिए; कुछ GB खाली करें और अनुवाद फिर से शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk hampir penuh (tersisa %.1f GB). macOS memerlukan ruang kosong untuk membaca teks; kosongkan beberapa GB dan mulai terjemahan lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cakera hampir penuh (%.1f GB kosong). macOS memerlukan ruang kosong untuk membaca teks; kosongkan beberapa GB dan mulakan terjemahan semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De schijf is bijna vol (%.1f GB vrij). macOS heeft vrije ruimte nodig om tekst te lezen; maak een paar GB vrij en start de vertaling opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดิสก์ใกล้เต็มแล้ว (ว่าง %.1f GB) macOS ต้องใช้พื้นที่ว่างในการอ่านข้อความ โปรดเพิ่มพื้นที่ว่างสักสองสาม GB แล้วเริ่มแปลอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk neredeyse dolu (%.1f GB boş). macOS'in yazıyı okuyabilmesi için boş alan gerekiyor; birkaç GB yer açıp çeviriyi yeniden başlatın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈسک تقریباً بھر گئی ہے (%.1f GB خالی)۔ متن پڑھنے کے لیے macOS کو خالی جگہ چاہیے؛ چند GB خالی کریں اور ترجمہ دوبارہ شروع کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ổ đĩa gần đầy (còn trống %.1f GB). macOS cần dung lượng trống để đọc chữ; hãy giải phóng vài GB và bắt đầu dịch lại."
          }
        }
      }
    },
