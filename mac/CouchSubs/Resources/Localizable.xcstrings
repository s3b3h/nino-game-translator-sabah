            "value" : "1. Cipta akaun pembangun LG percuma di webostv.developer.lge.com."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Maak een gratis LG-ontwikkelaarsaccount aan op webostv.developer.lge.com."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. สร้างบัญชีนักพัฒนา LG ฟรีที่ webostv.developer.lge.com"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. webostv.developer.lge.com'da ücretsiz LG geliştirici hesabı açın."
          }
        },
        "ur" : {
          "stringUnit" : {
