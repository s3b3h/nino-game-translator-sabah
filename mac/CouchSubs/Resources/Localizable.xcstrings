        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika nonaktif, setiap baris baru menggantikan baris sebelumnya. Memerlukan aplikasi TV 0.9.16 atau lebih baru."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila dimatikan, setiap baris baharu menggantikan baris sebelumnya. Memerlukan aplikasi TV 0.9.16 atau lebih baharu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit uit staat, vervangt elke nieuwe regel de vorige. Vereist TV-app 0.9.16 of nieuwer."
