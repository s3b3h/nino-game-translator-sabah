            "state" : "translated",
            "value" : "Verbind je Xbox"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อ Xbox ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox'ı Bağla"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا Xbox جوڑیں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối Xbox"
          }
        }
      }
    },
    "Nino checks each step by itself and moves on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق Nino من كل خطوة بنفسه وينتقل إلى التالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino প্রতিটি ধাপ নিজে থেকেই যাচাই করে এগিয়ে যায়।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusang sinusuri ng Nino ang bawat hakbang at nagpapatuloy."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino हर स्टेप अपने-आप जाँचता है और आगे बढ़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino memeriksa setiap langkah dengan sendirinya lalu berlanjut."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino menyemak setiap langkah dengan sendirinya dan meneruskan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino controleert elke stap zelf en gaat verder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino ตรวจสอบแต่ละขั้นตอนเองแล้วไปต่อให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino her adımı kendisi kontrol eder ve sıradakine geçer."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino ہر قدم خود چیک کرتا ہے اور آگے بڑھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino tự kiểm tra từng bước và chuyển tiếp."
          }
        }
      }
    },
    "Nino checks each step by itself and moves on. You only set this up once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق Nino من كل خطوة بنفسه وينتقل إلى التالية. تقوم بهذا مرة واحدة فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino প্রতিটি ধাপ নিজে থেকেই যাচাই করে এগিয়ে যায়। এটি আপনাকে একবারই সেট আপ করতে হবে।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusang sinusuri ng Nino ang bawat hakbang at nagpapatuloy. Isang beses mo lang ito ise-set up."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino हर स्टेप अपने-आप जाँचता है और आगे बढ़ता है। यह सेटअप सिर्फ़ एक बार करना होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino memeriksa setiap langkah dengan sendirinya lalu berlanjut. Anda cukup menyiapkannya sekali."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino menyemak setiap langkah dengan sendirinya dan meneruskan. Anda hanya perlu menyediakannya sekali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino controleert elke stap zelf en gaat verder. Je stelt dit maar één keer in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino ตรวจสอบแต่ละขั้นตอนเองแล้วไปต่อให้ ตั้งค่าเพียงครั้งเดียวเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino her adımı kendisi kontrol eder ve sıradakine geçer. Bunu yalnızca bir kez yaparsınız."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino ہر قدم خود چیک کرتا ہے اور آگے بڑھتا ہے۔ یہ سیٹ اپ صرف ایک بار کرنا ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino tự kiểm tra từng bước và chuyển tiếp. Bạn chỉ cần thiết lập một lần."
          }
        }
      }
    },
    "Start your Xbox in Greenlight. Press Connect Your Xbox if you need help." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل جهاز Xbox في Greenlight. اضغط اربط جهاز Xbox إذا احتجت مساعدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight-এ আপনার Xbox চালু করুন। সাহায্য লাগলে আপনার Xbox সংযোগ করুন চাপুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulan ang iyong Xbox sa Greenlight. Pindutin ang Ikonekta ang Iyong Xbox kung kailangan mo ng tulong."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight में अपना Xbox शुरू करें। मदद चाहिए तो अपना Xbox कनेक्ट करें दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai Xbox Anda di Greenlight. Tekan Hubungkan Xbox Anda jika perlu bantuan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulakan Xbox anda dalam Greenlight. Tekan Sambungkan Xbox Anda jika anda memerlukan bantuan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start je Xbox in Greenlight. Druk op Verbind je Xbox als je hulp nodig hebt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่ม Xbox ของคุณใน Greenlight กด เชื่อมต่อ Xbox ของคุณ หากต้องการความช่วยเหลือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox'ınızı Greenlight'ta başlatın. Yardım için Xbox'ı Bağla'ya basın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight میں اپنا Xbox شروع کریں۔ مدد چاہیے تو اپنا Xbox جوڑیں دبائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khởi động Xbox trong Greenlight. Bấm Kết nối Xbox nếu bạn cần trợ giúp."
          }
        }
      }
    },
    "Nino reads the English subtitles of your PS5 games and shows them in your language on your TV, on top of the game. You keep playing on the TV with your own controller." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Nino الترجمة الإنجليزية لألعاب PS5 ويعرضها بلغتك على التلفاز فوق اللعبة. وتواصل اللعب على التلفاز بيد التحكم الخاصة بك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino আপনার PS5 গেমের ইংরেজি সাবটাইটেল পড়ে এবং গেমের ওপরে আপনার TV-তে আপনার ভাষায় দেখায়। আপনি নিজের কন্ট্রোলার দিয়ে TV-তে খেলা চালিয়ে যান।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabasa ng Nino ang mga English na subtitle ng iyong mga PS5 game at ipinapakita ang mga ito sa iyong wika sa iyong TV, sa ibabaw ng laro. Patuloy kang naglalaro sa TV gamit ang sarili mong controller."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino आपके PS5 गेम्स के अंग्रेज़ी सबटाइटल पढ़ता है और गेम के ऊपर आपके TV पर उन्हें आपकी भाषा में दिखाता है। आप अपने कंट्रोलर से TV पर खेलते रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca subtitle bahasa Inggris dari game PS5 Anda dan menampilkannya dalam bahasa Anda di TV, di atas game. Anda tetap bermain di TV dengan kontroler Anda sendiri."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca sari kata bahasa Inggeris permainan PS5 anda dan memaparkannya dalam bahasa anda pada TV anda, di atas permainan. Anda terus bermain pada TV dengan alat kawalan anda sendiri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino leest de Engelse ondertitels van je PS5-games en toont ze in jouw taal op je TV, boven op de game. Je blijft op de TV spelen met je eigen controller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino อ่านคำบรรยายภาษาอังกฤษจากเกม PS5 ของคุณ แล้วแสดงเป็นภาษาของคุณบน TV ซ้อนทับเกม คุณเล่นต่อบน TV ด้วยคอนโทรลเลอร์ของคุณเองได้ตามปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, PS5 oyunlarınızın İngilizce altyazısını okur ve kendi dilinizde TV'nizde, oyunun üstünde gösterir. Siz TV'de kendi kolunuzla oynamaya devam edersiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino آپ کے PS5 گیمز کے انگریزی سب ٹائٹلز پڑھتا ہے اور گیم کے اوپر آپ کے TV پر آپ کی زبان میں دکھاتا ہے۔ آپ اپنے کنٹرولر سے TV پر کھیلتے رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino đọc phụ đề tiếng Anh trong các game PS5 của bạn và hiển thị bằng ngôn ngữ của bạn trên TV, ngay trên game. Bạn vẫn chơi trên TV bằng tay cầm của mình."
          }
        }
      }
    },
    "Game packs, the term list and dubbing work only for Turkish. Other languages come from the translation engine you chose (Apple's free translation, Gemini, ChatGPT, Claude, DeepL or a local model). Urdu, Bengali and Filipino need an AI engine; Gemini is free." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حزم الألعاب وقائمة المصطلحات والدبلجة تعمل مع التركية فقط. أما اللغات الأخرى فتأتي من محرك الترجمة الذي اخترته (ترجمة Apple المجانية أو Gemini أو ChatGPT أو Claude أو DeepL أو نموذج محلي). الأردية والبنغالية والفلبينية تحتاج إلى محرك ذكاء اصطناعي؛ و Gemini مجاني."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গেম প্যাক, শব্দ তালিকা ও ডাবিং শুধু তুর্কির জন্য কাজ করে। অন্য ভাষা আসে আপনার বেছে নেওয়া অনুবাদ ইঞ্জিন থেকে (Apple-এর বিনামূল্যের অনুবাদ, Gemini, ChatGPT, Claude, DeepL বা একটি লোকাল মডেল)। উর্দু, বাংলা ও ফিলিপিনোর জন্য একটি AI ইঞ্জিন দরকার; Gemini বিনামূল্যে।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para sa Turkish lang gumagana ang mga game pack, listahan ng termino at dubbing. Ang ibang wika ay galing sa translation engine na pinili mo (ang libreng salin ng Apple, Gemini, ChatGPT, Claude, DeepL o isang lokal na model). Kailangan ng AI engine para sa Urdu, Bengali at Filipino; libre ang Gemini."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गेम पैक, शब्द-सूची और डबिंग सिर्फ़ तुर्की के लिए काम करते हैं। दूसरी भाषाएँ आपके चुने हुए अनुवाद इंजन से आती हैं (Apple का मुफ़्त अनुवाद, Gemini, ChatGPT, Claude, DeepL या लोकल मॉडल)। उर्दू, बंगाली और फ़िलिपिनो के लिए AI इंजन चाहिए; Gemini मुफ़्त है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket game, daftar istilah, dan sulih suara hanya untuk bahasa Turki. Bahasa lain berasal dari mesin terjemahan yang Anda pilih (terjemahan gratis Apple, Gemini, ChatGPT, Claude, DeepL, atau model lokal). Urdu, Bengali, dan Filipino memerlukan mesin AI; Gemini gratis."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pek permainan, senarai istilah dan alih suara hanya berfungsi untuk bahasa Turki. Bahasa lain datang daripada enjin terjemahan yang anda pilih (terjemahan percuma Apple, Gemini, ChatGPT, Claude, DeepL atau model setempat). Bahasa Urdu, Bengali dan Filipino memerlukan enjin AI; Gemini adalah percuma."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamepakketten, de termenlijst en nasynchronisatie werken alleen voor Turks. Andere talen komen van de vertaalmachine die je hebt gekozen (de gratis vertaling van Apple, Gemini, ChatGPT, Claude, DeepL of een lokaal model). Urdu, Bengaals en Filipijns vereisen een AI-vertaalmachine; Gemini is gratis."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แพ็กเกม รายการคำศัพท์ และการพากย์เสียง ใช้ได้กับภาษาตุรกีเท่านั้น ภาษาอื่นมาจากเอนจินแปลที่คุณเลือก (การแปลฟรีของ Apple, Gemini, ChatGPT, Claude, DeepL หรือโมเดลในเครื่อง) ภาษาอูรดู เบงกาลี และฟิลิปิโน ต้องใช้เอนจิน AI โดย Gemini ใช้ได้ฟรี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyun paketleri, terim listesi ve dublaj yalnız Türkçede çalışır. Öbür dillerdeki altyazı seçtiğiniz çeviri motorundan gelir (Apple'ın ücretsiz çevirisi, Gemini, ChatGPT, Claude, DeepL ya da yerel model). Urduca, Bengalce ve Filipince için yapay zekâ motoru gerekir; Gemini ücretsizdir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گیم پیکس، اصطلاحات کی فہرست اور ڈبنگ صرف ترکی کے لیے کام کرتی ہیں۔ دوسری زبانیں آپ کے منتخب کردہ ترجمہ انجن سے آتی ہیں (Apple کا مفت ترجمہ، Gemini، ChatGPT، Claude، DeepL یا لوکل ماڈل)۔ اردو، بنگالی اور فلپائنی کے لیے AI انجن درکار ہے؛ Gemini مفت ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói game, danh sách thuật ngữ và lồng tiếng chỉ hoạt động với tiếng Thổ Nhĩ Kỳ. Các ngôn ngữ khác dùng công cụ dịch bạn đã chọn (bản dịch miễn phí của Apple, Gemini, ChatGPT, Claude, DeepL hoặc mô hình cục bộ). Tiếng Urdu, Bengal và Filipino cần công cụ AI; Gemini miễn phí."
          }
        }
      }
    },
    "Packs are used only when the translation language is Turkish." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم الحزم فقط عندما تكون لغة الترجمة التركية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুবাদের ভাষা তুর্কি হলেই শুধু প্যাক ব্যবহার হয়।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit lang ang mga pack kapag Turkish ang wika ng salin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैक सिर्फ़ तब इस्तेमाल होते हैं जब अनुवाद की भाषा तुर्की हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket hanya digunakan jika bahasa terjemahannya bahasa Turki."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pek hanya digunakan apabila bahasa terjemahan ialah bahasa Turki."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakketten worden alleen gebruikt als de vertaaltaal Turks is."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะใช้แพ็กเฉพาะเมื่อภาษาที่แปลเป็นภาษาตุรกีเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paketler yalnız çeviri dili Türkçeyken kullanılır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیکس صرف اسی وقت استعمال ہوتے ہیں جب ترجمے کی زبان ترکی ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói chỉ được dùng khi ngôn ngữ dịch là tiếng Thổ Nhĩ Kỳ."
          }
        }
      }
    },
    "Apple's free translation doesn't support this language yet. Turn on AI translation in Settings › Translation; Gemini is free." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجمة Apple المجانية لا تدعم هذه اللغة بعد. فعّل ترجمة الذكاء الاصطناعي من الإعدادات › الترجمة؛ و Gemini مجاني."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-এর বিনামূল্যের অনুবাদ এখনো এই ভাষা সমর্থন করে না। Settings › Translation-এ AI অনুবাদ চালু করুন; Gemini বিনামূল্যে।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pa sinusuportahan ng libreng salin ng Apple ang wikang ito. I-on ang AI na pagsasalin sa Mga Setting › Pagsasalin; libre ang Gemini."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple का मुफ़्त अनुवाद अभी इस भाषा को सपोर्ट नहीं करता। सेटिंग्स › अनुवाद में AI अनुवाद चालू करें; Gemini मुफ़्त है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan gratis Apple belum mendukung bahasa ini. Aktifkan terjemahan AI di Pengaturan › Terjemahan; Gemini gratis."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan percuma Apple belum menyokong bahasa ini. Hidupkan terjemahan AI dalam Tetapan › Terjemahan; Gemini adalah percuma."
