        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyahpepijatan mesti dihidupkan dalam pilihan pembangun TV. Anda boleh mematikannya selepas pemasangan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foutopsporing moet aan staan in de ontwikkelaarsopties van de TV. Je kunt het na de installatie uitzetten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องเปิดการแก้ไขข้อบกพร่องในตัวเลือกสำหรับนักพัฒนาของ TV ปิดได้หลังติดตั้งเสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV'nin geliştirici seçeneklerinde hata ayıklama açık olmalı. Kurulumdan sonra kapatabilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV کے ڈیولپر آپشنز میں ڈیبگنگ آن ہونی چاہیے۔ انسٹالیشن کے بعد آپ اسے بند کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phải bật gỡ lỗi trong tùy chọn nhà phát triển của TV. Bạn có thể tắt sau khi cài."
          }
        }
      }
    },
    "Needs LG's Developer Mode app on the TV and a free LG developer account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
