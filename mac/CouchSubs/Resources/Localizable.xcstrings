    "Tap after you open the game on the PS5. The phone takes the picture, reads the subtitles and translates them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط بعد فتح اللعبة على PS5. يلتقط الهاتف الصورة ويقرأ النصوص الإنجليزية ويترجمها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5-এ গেম খোলার পর ট্যাপ করুন। ফোন ছবি নেয়, সাবটাইটেল পড়ে এবং অনুবাদ করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap after you open the game on the PS5. The phone takes the picture, reads the subtitles and translates them."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-tap pagkatapos mong buksan ang laro sa PS5. Kinukuha ng telepono ang larawan, binabasa ang mga subtitle at isinasalin ang mga ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 पर गेम खोलने के बाद टैप करें। फ़ोन तस्वीर लेता है, सबटाइटल पढ़ता है और उनका अनुवाद करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk setelah Anda membuka game di PS5. Ponsel mengambil gambar, membaca subtitle, dan menerjemahkannya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik selepas anda membuka permainan pada PS5. Telefon mengambil gambar, membaca sari kata dan menterjemahkannya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik nadat je de game op de PS5 hebt geopend. De telefoon neemt het beeld op, leest de ondertitels en vertaalt ze."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะหลังจากเปิดเกมบน PS5 แล้ว โทรศัพท์จะรับภาพ อ่านคำบรรยาย และแปลให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5'te oyunu açtıktan sonra dokunun. Telefon görüntüyü alır, altyazıyı okuyup çevirir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 پر گیم کھولنے کے بعد ٹیپ کریں۔ فون تصویر لیتا ہے، سب ٹائٹلز پڑھتا ہے اور ان کا ترجمہ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm sau khi mở game trên PS5. Điện thoại sẽ nhận hình ảnh, đọc phụ đề và dịch chúng."
          }
        }
      }
    },
