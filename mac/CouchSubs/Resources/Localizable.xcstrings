    "Look at the TV: it asks whether to allow debugging from this computer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انظر إلى التلفاز: سيسألك عن السماح بتصحيح الأخطاء من هذا الكمبيوتر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV-র দিকে তাকান: এটি জিজ্ঞেস করছে এই কম্পিউটার থেকে ডিবাগিংয়ের অনুমতি দেবেন কিনা।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at the TV: it asks whether to allow debugging from this computer."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan ang TV: itinatanong nito kung papayagan ang debugging mula sa computer na ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV की ओर देखें: वह पूछ रहा है कि क्या इस कंप्यूटर से डीबगिंग की अनुमति दी जाए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat TV: TV menanyakan apakah debugging dari komputer ini diizinkan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat pada TV: ia bertanya sama ada mahu membenarkan penyahpepijatan daripada komputer ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk naar de TV: daar wordt gevraagd of foutopsporing vanaf deze computer is toegestaan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูที่ TV: TV จะถามว่าอนุญาตการแก้ไขข้อบกพร่องจากคอมพิวเตอร์เครื่องนี้หรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV'ye bakın: bu bilgisayardan hata ayıklamaya izin verilsin mi diye soruyor."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV دیکھیں: وہ پوچھ رہا ہے کہ کیا اس کمپیوٹر سے debugging کی اجازت دی جائے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nhìn TV: TV sẽ hỏi có cho phép gỡ lỗi từ máy tính này không."
          }
        }
      }
    },
