          "stringUnit" : {
            "state" : "translated",
            "value" : "بطاقة الالتقاط"
          }
        }
      }
    },
    "Reads the capture card" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture Card'ı okur"
          }
        },
