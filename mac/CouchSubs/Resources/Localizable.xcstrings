        }
      }
    },
    "Results of the last translation session. They are measured again when you start translation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نتائج آخر جلسة ترجمة. يُعاد قياسها عند بدء الترجمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেষ অনুবাদ সেশনের ফলাফল। অনুবাদ শুরু করলে আবার মাপা হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Results of the last translation session. They are measured again when you start translation."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga resulta ng huling session ng pagsasalin. Susukatin muli ang mga ito kapag sinimulan mo ang pagsasalin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले अनुवाद सेशन के नतीजे। अनुवाद शुरू करने पर इन्हें फिर से मापा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil sesi terjemahan terakhir. Akan diukur lagi saat Anda memulai terjemahan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil sesi terjemahan terakhir. Ia diukur semula apabila anda memulakan terjemahan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultaten van de laatste vertaalsessie. Ze worden opnieuw gemeten als je begint met vertalen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผลจากเซสชันการแปลล่าสุด จะวัดใหม่อีกครั้งเมื่อคุณเริ่มแปล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son çeviri oturumunun sonuçları. Çeviriyi başlatınca yeniden ölçülür."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخری ترجمہ سیشن کے نتائج۔ ترجمہ شروع کرنے پر یہ دوبارہ ناپے جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết quả của phiên dịch gần nhất. Chúng sẽ được đo lại khi bạn bắt đầu dịch."
          }
        }
      }
    },
