        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlar kaydedilemedi."
          }
        }
      }
    },
    "The second account has a PS5 login passcode. Remove it on the PS5." : {
      "localizations" : {
