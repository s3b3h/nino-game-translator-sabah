    "Local-network permission is ready for Private networks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذن الشبكة المحلية جاهز للشبكات الخاصة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private নেটওয়ার্কের জন্য লোকাল নেটওয়ার্ক অনুমতি প্রস্তুত।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local-network permission is ready for Private networks."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handa na ang pahintulot sa local network para sa mga Private network."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्राइवेट नेटवर्क के लिए लोकल नेटवर्क अनुमति तैयार है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin jaringan lokal siap untuk jaringan Pribadi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebenaran rangkaian setempat sudah sedia untuk rangkaian Peribadi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming voor het lokale netwerk is klaar voor privénetwerken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิทธิ์เครือข่ายภายในพร้อมสำหรับเครือข่ายส่วนตัวแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel ağda yerel bağlantı izni hazır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرائیویٹ نیٹ ورکس کے لیے لوکل نیٹ ورک کی اجازت تیار ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền mạng cục bộ đã sẵn sàng cho mạng Riêng tư."
          }
        }
      }
    },
    "Local-network permission could not be verified. Approve the Windows prompt, or review existing blocking rules in Windows Firewall." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحقق من إذن الشبكة المحلية. وافق على طلب Windows، أو راجع قواعد الحظر الحالية في جدار حماية Windows."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লোকাল নেটওয়ার্ক অনুমতি যাচাই করা যায়নি। Windows-এর প্রম্পটে অনুমতি দিন, অথবা Windows Firewall-এ আগে থেকে থাকা ব্লকিং নিয়মগুলো দেখে নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local-network permission could not be verified. Approve the Windows prompt, or review existing blocking rules in Windows Firewall."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ma-verify ang pahintulot sa local network. Aprubahan ang prompt ng Windows, o suriin ang mga kasalukuyang blocking rule sa Windows Firewall."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोकल नेटवर्क अनुमति की पुष्टि नहीं हो सकी। Windows का प्रॉम्प्ट मंज़ूर करें, या Windows Firewall में मौजूदा ब्लॉक करने वाले नियम देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin jaringan lokal tidak dapat diverifikasi. Setujui permintaan Windows, atau tinjau aturan pemblokiran yang ada di Windows Firewall."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebenaran rangkaian setempat tidak dapat disahkan. Luluskan gesaan Windows, atau semak peraturan sekatan sedia ada dalam Windows Firewall."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming voor het lokale netwerk kon niet worden gecontroleerd. Keur de melding van Windows goed of bekijk bestaande blokkeerregels in Windows Firewall."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนยันสิทธิ์เครือข่ายภายในไม่ได้ อนุมัติข้อความแจ้งของ Windows หรือตรวจสอบกฎการบล็อกที่มีอยู่ในไฟร์วอลล์ Windows"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel bağlantı izni doğrulanamadı. Windows onayını verin veya Güvenlik Duvarı içindeki mevcut engelleme kurallarını kontrol edin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوکل نیٹ ورک کی اجازت کی تصدیق نہیں ہو سکی۔ Windows کا پیغام منظور کریں، یا Windows Firewall میں موجود روکنے والے اصول دیکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không xác minh được quyền mạng cục bộ. Hãy chấp nhận thông báo của Windows, hoặc kiểm tra các quy tắc chặn hiện có trong Windows Firewall."
          }
        }
      }
    },
    "Picture mode (Android TV)" : {
