    "Sign in with the Microsoft account you use on your Xbox. The phone watches your Xbox home stream; your game keeps running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول بحساب Microsoft الذي تستخدمه على Xbox. يتابع الهاتف البث المنزلي لجهاز Xbox، وتستمر لعبتك في العمل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox-এ যে Microsoft অ্যাকাউন্ট ব্যবহার করেন সেটি দিয়ে সাইন ইন করুন। ফোন আপনার Xbox হোম স্ট্রিম দেখে; আপনার গেম চলতেই থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with the Microsoft account you use on your Xbox. The phone watches your Xbox home stream; your game keeps running."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-sign in gamit ang Microsoft account na ginagamit mo sa Xbox. Pinapanood ng phone ang home stream ng iyong Xbox; tuloy-tuloy ang laro mo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने Xbox वाले Microsoft अकाउंट से साइन इन करें। फ़ोन आपके Xbox की होम स्ट्रीम देखता है; आपका गेम चलता रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk dengan akun Microsoft yang Anda pakai di Xbox. Ponsel memantau streaming rumah Xbox Anda; game tetap berjalan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log masuk dengan akaun Microsoft yang anda gunakan pada Xbox. Telefon menonton strim rumah Xbox anda; permainan anda terus berjalan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met het Microsoft-account dat je op je Xbox gebruikt. De telefoon kijkt mee met de thuisstream van je Xbox; je game blijft gewoon draaien."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงชื่อเข้าใช้ด้วยบัญชี Microsoft ที่คุณใช้บน Xbox โทรศัพท์จะรับสตรีมในบ้านจาก Xbox ส่วนเกมของคุณยังเล่นต่อได้ตามปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox'ta kullandığınız Microsoft hesabıyla giriş yapın. Telefon Xbox'ın ev yayınını izler; oyununuz kesilmez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس Microsoft اکاؤنٹ سے سائن ان کریں جو آپ Xbox پر استعمال کرتے ہیں۔ فون آپ کے Xbox کی ہوم اسٹریم دیکھتا ہے؛ آپ کی گیم چلتی رہتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập bằng tài khoản Microsoft bạn dùng trên Xbox. Điện thoại sẽ xem luồng phát tại nhà của Xbox; game của bạn vẫn tiếp tục chạy."
          }
        }
      }
    },
