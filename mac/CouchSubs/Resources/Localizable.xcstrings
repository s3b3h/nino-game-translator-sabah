          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. webostv.developer.lge.com पर एक मुफ़्त LG डेवलपर अकाउंट बनाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Buat akun pengembang LG gratis di webostv.developer.lge.com."
          }
        },
        "ms" : {
          "stringUnit" : {
