    "Link your Xbox account with a Microsoft device code, as in Greenlight. The sign-in page opens in your default browser." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربط حساب Xbox برمز جهاز من Microsoft، كما في Greenlight. تُفتح صفحة تسجيل الدخول في متصفحك الافتراضي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight-এর মতো একটি Microsoft ডিভাইস কোড দিয়ে আপনার Xbox অ্যাকাউন্ট লিংক করুন। সাইন-ইন পেজটি আপনার ডিফল্ট ব্রাউজারে খোলে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link your Xbox account with a Microsoft device code, as in Greenlight. The sign-in page opens in your default browser."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-link ang iyong Xbox account gamit ang Microsoft device code, gaya sa Greenlight. Bubukas ang sign-in page sa iyong default na browser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight की तरह, Microsoft डिवाइस कोड से अपना Xbox अकाउंट जोड़ें। साइन-इन पेज आपके डिफ़ॉल्ट ब्राउज़र में खुलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan akun Xbox Anda dengan kode perangkat Microsoft, seperti di Greenlight. Halaman masuk terbuka di browser bawaan Anda."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pautkan akaun Xbox anda dengan kod peranti Microsoft, seperti dalam Greenlight. Halaman log masuk dibuka dalam pelayar lalai anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel je Xbox-account met een Microsoft-apparaatcode, zoals in Greenlight. De inlogpagina opent in je standaardbrowser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมบัญชี Xbox ด้วยรหัสอุปกรณ์ของ Microsoft เหมือนใน Greenlight หน้าลงชื่อเข้าใช้จะเปิดในเบราว์เซอร์เริ่มต้นของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox hesabınızı Greenlight'taki gibi Microsoft cihaz koduyla bağlayın. Giriş sayfası varsayılan tarayıcınızda açılır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا Xbox اکاؤنٹ Microsoft ڈیوائس کوڈ سے جوڑیں، جیسے Greenlight میں۔ سائن ان صفحہ آپ کے ڈیفالٹ براؤزر میں کھلتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liên kết tài khoản Xbox bằng mã thiết bị Microsoft, giống như trong Greenlight. Trang đăng nhập sẽ mở trên trình duyệt mặc định."
          }
        }
      }
