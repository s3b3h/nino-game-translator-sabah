    "The TV did not respond. Make sure the TV is on and on the same Wi-Fi as this phone, and that Dev Mode Status is on in the Developer Mode app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يستجب TV. تأكد أن TV قيد التشغيل وعلى شبكة Wi‑Fi نفسها التي يتصل بها هذا الهاتف، وأن Dev Mode Status مفعّل في تطبيق Developer Mode."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV সাড়া দেয়নি। নিশ্চিত করুন TV চালু এবং এই ফোনের একই Wi-Fi-তে আছে, আর Developer Mode অ্যাপে Dev Mode Status চালু আছে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV did not respond. Make sure the TV is on and on the same Wi-Fi as this phone, and that Dev Mode Status is on in the Developer Mode app."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi sumagot ang TV. Tiyaking naka-on ang TV at nasa parehong Wi-Fi ng phone na ito, at naka-on ang Dev Mode Status sa Developer Mode app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV ने जवाब नहीं दिया। पक्का करें कि TV चालू है और इस फ़ोन वाले Wi-Fi पर है, और Developer Mode ऐप में Dev Mode Status चालू है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV tidak merespons. Pastikan TV menyala dan di Wi-Fi yang sama dengan ponsel ini, dan Dev Mode Status aktif di aplikasi Developer Mode."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV tidak bertindak balas. Pastikan TV dihidupkan dan pada Wi-Fi yang sama dengan telefon ini, dan Dev Mode Status dihidupkan dalam apl Developer Mode."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De TV reageerde niet. Zorg dat de TV aan staat en op hetzelfde wifinetwerk zit als deze telefoon, en dat Dev Mode Status aan staat in de app Developer Mode."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV ไม่ตอบสนอง ตรวจสอบว่า TV เปิดอยู่และอยู่ใน Wi-Fi เดียวกับโทรศัพท์เครื่องนี้ และเปิด Dev Mode Status ในแอป Developer Mode แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV yanıt vermedi. TV'nin açık ve bu telefonla aynı Wi-Fi'da olduğundan, Developer Mode uygulamasında Dev Mode Status'un açık olduğundan emin olun."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV نے جواب نہیں دیا۔ یقینی بنائیں کہ TV آن ہے اور اس فون والے Wi-Fi پر ہے، اور Developer Mode ایپ میں Dev Mode Status آن ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV không phản hồi. Hãy chắc chắn TV đang bật và cùng mạng Wi-Fi với điện thoại này, và Dev Mode Status đang bật trong ứng dụng Developer Mode."
          }
        }
      }
    },
