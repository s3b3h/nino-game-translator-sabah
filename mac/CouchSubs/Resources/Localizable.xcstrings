    "The card is working. You can see the PS5 picture." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة تعمل. صورة PS5 ظاهرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কার্ড কাজ করছে। আপনি PS5-এর ছবি দেখতে পাচ্ছেন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagana ang card. Nakikita mo ang larawan ng PS5."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड काम कर रहा है। आपको PS5 की तस्वीर दिख रही है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card berfungsi. Anda bisa melihat gambar PS5."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad berfungsi. Anda boleh melihat gambar PS5."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart werkt. Je ziet het PS5-beeld."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การ์ดทำงานแล้ว คุณเห็นภาพจาก PS5"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture Card çalışıyor. PS5 görüntüsü geliyor."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارڈ کام کر رہا ہے۔ آپ PS5 کی تصویر دیکھ سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card đang hoạt động. Bạn có thể thấy hình ảnh PS5."
          }
        }
      }
    },
    "The card is connected but the picture is black. Turn the PS5 on and turn off HDCP (previous step)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة موصولة لكن الصورة سوداء. شغّل PS5 وأوقف HDCP (الخطوة السابقة)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কার্ড সংযুক্ত কিন্তু ছবি কালো। PS5 চালু করুন এবং HDCP বন্ধ করুন (আগের ধাপ)।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakakonekta ang card pero itim ang larawan. I-on ang PS5 at i-off ang HDCP (naunang hakbang)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड कनेक्टेड है लेकिन तस्वीर काली है। PS5 चालू करें और HDCP बंद करें (पिछला स्टेप)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card terhubung tetapi gambarnya hitam. Nyalakan PS5 dan matikan HDCP (langkah sebelumnya)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad disambungkan tetapi gambar hitam. Hidupkan PS5 dan matikan HDCP (langkah sebelumnya)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart is aangesloten, maar het beeld is zwart. Zet de PS5 aan en zet HDCP uit (vorige stap)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การ์ดเชื่อมต่อแล้วแต่ภาพเป็นสีดำ โปรดเปิด PS5 และปิด HDCP (ขั้นตอนก่อนหน้า)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture Card bağlı ama görüntü siyah. PS5'i açın ve HDCP'yi kapatın (önceki adım)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارڈ جُڑا ہے مگر تصویر کالی ہے۔ PS5 آن کریں اور HDCP بند کریں (پچھلا مرحلہ)۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card đã kết nối nhưng hình ảnh bị đen. Hãy bật PS5 và tắt HDCP (bước trước)."
          }
        }
      }
    },
    "Capture cards appear as a camera on the Mac. Allow Nino in System Settings › Privacy & Security › Camera, then reopen Nino." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر بطاقات الالتقاط على Mac ككاميرا. اسمح لـ Nino في إعدادات النظام › الخصوصية والأمن › الكاميرا، ثم أعد فتح Nino."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-এ ক্যাপচার কার্ড ক্যামেরা হিসেবে দেখায়। System Settings › Privacy & Security › Camera-তে Nino-কে অনুমতি দিন, তারপর Nino আবার খুলুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumalabas bilang camera sa Mac ang mga capture card. Payagan ang Nino sa System Settings › Privacy & Security › Camera, saka buksan muli ang Nino."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac पर कैप्चर कार्ड कैमरे के रूप में दिखते हैं। सिस्टम सेटिंग्स › गोपनीयता और सुरक्षा › कैमरा में Nino को अनुमति दें, फिर Nino दोबारा खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture card muncul sebagai kamera di Mac. Izinkan Nino di Pengaturan Sistem › Privasi & Keamanan › Kamera, lalu buka ulang Nino."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad tangkapan muncul sebagai kamera pada Mac. Benarkan Nino dalam System Settings › Privacy & Security › Camera, kemudian buka semula Nino."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturekaarten verschijnen op de Mac als camera. Sta Nino toe in Systeeminstellingen › Privacy en beveiliging › Camera en open Nino dan opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การ์ดแคปเจอร์จะแสดงเป็นกล้องบน Mac โปรดอนุญาต Nino ใน การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › กล้อง แล้วเปิด Nino ใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture Card'lar Mac'te kamera gibi görünür. Sistem Ayarları › Gizlilik ve Güvenlik › Kamera'da Nino'ya izin verin, sonra Nino'yu yeniden açın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac پر کیپچر کارڈ کیمرہ کے طور پر دکھائی دیتے ہیں۔ System Settings › Privacy & Security › Camera میں Nino کو اجازت دیں، پھر Nino دوبارہ کھولیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture card hiện như một camera trên máy Mac. Hãy cho phép Nino trong Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Camera, rồi mở lại Nino."
          }
        }
      }
    },
    "Plug the card into a USB 3 port on this Mac. If you use a hub, try a port on the Mac itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصّل البطاقة بمنفذ USB 3 في هذا الـ Mac. إن كنت تستخدم موزّعًا، جرّب منفذ الـ Mac نفسه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কার্ডটি এই Mac-এর একটি USB 3 পোর্টে লাগান। হাব ব্যবহার করলে Mac-এর নিজস্ব পোর্টে চেষ্টা করুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isaksak ang card sa USB 3 port ng Mac na ito. Kung gumagamit ka ng hub, subukan ang port mismo ng Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड को इस Mac के USB 3 पोर्ट में लगाएँ। अगर आप हब इस्तेमाल करते हैं, तो Mac के अपने पोर्ट में आज़माएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colokkan card ke port USB 3 di Mac ini. Jika Anda memakai hub, coba port di Mac itu sendiri."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palamkan kad ke port USB 3 pada Mac ini. Jika anda menggunakan hab, cuba port pada Mac itu sendiri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steek de kaart in een USB 3-poort op deze Mac. Gebruik je een hub, probeer dan een poort op de Mac zelf."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียบการ์ดเข้ากับพอร์ต USB 3 บน Mac เครื่องนี้ หากใช้ฮับ ให้ลองใช้พอร์ตบนตัว Mac โดยตรง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture Card'ı bu Mac'teki bir USB 3 girişine takın. Çoklayıcı kullanıyorsanız doğrudan Mac'in kendi girişini deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارڈ کو اس Mac کے USB 3 پورٹ میں لگائیں۔ اگر ہب استعمال کر رہے ہیں تو Mac کا اپنا پورٹ آزمائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cắm card vào cổng USB 3 trên máy Mac này. Nếu dùng hub, hãy thử cổng trên chính máy Mac."
          }
        }
      }
    },
