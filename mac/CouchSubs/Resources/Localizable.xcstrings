        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật tính năng từ xa trên Xbox"
          }
        }
      }
    },
    "Settings › Devices & connections › Remote features. Set Xbox app preferences to allow connections from any device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعدادات › الأجهزة والاتصالات › الميزات عن بُعد. في تفضيلات تطبيق Xbox اختر السماح بالاتصال من أي جهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings › Devices & connections › Remote features। Xbox app preferences-এ যেকোনো ডিভাইস থেকে সংযোগের অনুমতি দিন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings › Devices & connections › Remote features. Itakda ang Xbox app preferences para payagan ang mga koneksyon mula sa anumang device."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings › Devices & connections › Remote features. Xbox app preferences में किसी भी डिवाइस से कनेक्शन की अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan › Perangkat & koneksi › Fitur jarak jauh. Atur preferensi aplikasi Xbox agar mengizinkan koneksi dari perangkat apa pun."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings › Devices & connections › Remote features. Tetapkan keutamaan aplikasi Xbox untuk membenarkan sambungan daripada mana-mana peranti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen › Apparaten en verbindingen › Externe functies. Stel de voorkeuren van de Xbox-app in op verbindingen vanaf elk apparaat toestaan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตั้งค่า › อุปกรณ์และการเชื่อมต่อ › ฟีเจอร์ระยะไกล ตั้งค่ากำหนดแอป Xbox ให้อนุญาตการเชื่อมต่อจากอุปกรณ์ใดก็ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar › Cihazlar ve bağlantılar › Uzak özellikler. Xbox uygulaması tercihlerinde “Herhangi bir cihazdan bağlantılara izin ver”i seçin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings › Devices & connections › Remote features۔ Xbox app preferences کو کسی بھی ڈیوائس سے کنکشن کی اجازت پر سیٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt › Thiết bị & kết nối › Tính năng từ xa. Đặt tùy chọn ứng dụng Xbox thành cho phép kết nối từ mọi thiết bị."
          }
        }
      }
    },
