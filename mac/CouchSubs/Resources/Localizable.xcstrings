    "Nino reads the subtitles from the Greenlight window." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Nino الترجمة من نافذة Greenlight."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, Greenlight উইন্ডো থেকে সাবটাইটেল পড়ে।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabasa ng Nino ang mga subtitle mula sa window ng Greenlight."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, Greenlight विंडो से सबटाइटल पढ़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca subtitle dari jendela Greenlight."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca sari kata daripada tetingkap Greenlight."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino leest de ondertitels uit het Greenlight-venster."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino อ่านคำบรรยายจากหน้าต่าง Greenlight"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino altyazıyı Greenlight penceresinden okuyor."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino، Greenlight ونڈو سے سب ٹائٹلز پڑھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino đọc phụ đề từ cửa sổ Greenlight."
          }
        }
      }
    },
    "In Greenlight, pick your Xbox and press Start. If it keeps spinning, close other Xbox streams and allow Greenlight in Privacy & Security › Local Network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في Greenlight اختر جهاز Xbox واضغط ابدأ. إذا استمر التحميل، أغلق أي بث آخر لـ Xbox واسمح لـ Greenlight في الخصوصية والأمن › الشبكة المحلية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight-এ আপনার Xbox বেছে নিন এবং Start চাপুন। শুধু ঘুরতে থাকলে অন্য Xbox স্ট্রিম বন্ধ করুন এবং Privacy & Security › Local Network-এ Greenlight-কে অনুমতি দিন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa Greenlight, piliin ang iyong Xbox at pindutin ang Start. Kung patuloy itong umiikot, isara ang ibang Xbox stream at payagan ang Greenlight sa Privacy & Security › Local Network."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight में अपना Xbox चुनें और Start दबाएँ। अगर यह घूमता ही रहे, तो दूसरी Xbox स्ट्रीम बंद करें और गोपनीयता और सुरक्षा › लोकल नेटवर्क में Greenlight को अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di Greenlight, pilih Xbox Anda dan tekan Start. Jika terus berputar, tutup streaming Xbox lainnya dan izinkan Greenlight di Privasi & Keamanan › Jaringan Lokal."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam Greenlight, pilih Xbox anda dan tekan Start. Jika ia terus berpusing, tutup strim Xbox lain dan benarkan Greenlight dalam Privacy & Security › Local Network."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies in Greenlight je Xbox en druk op Start. Blijft hij laden, sluit dan andere Xbox-streams en sta Greenlight toe in Privacy en beveiliging › Lokaal netwerk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใน Greenlight ให้เลือก Xbox ของคุณแล้วกด Start หากยังหมุนค้างอยู่ ให้ปิดการสตรีม Xbox อื่นๆ และอนุญาต Greenlight ใน ความเป็นส่วนตัวและความปลอดภัย › เครือข่ายเฉพาะที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight'ta Xbox'ınızı seçip Başlat'a basın. Sürekli dönüyorsa başka Xbox yayınlarını kapatın ve Gizlilik ve Güvenlik › Yerel Ağ'da Greenlight'a izin verin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight میں اپنا Xbox چنیں اور Start دبائیں۔ اگر یہ گھومتا رہے تو دوسری Xbox اسٹریمز بند کریں اور Privacy & Security › Local Network میں Greenlight کو اجازت دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong Greenlight, chọn Xbox của bạn và bấm Start. Nếu cứ xoay mãi, hãy đóng các luồng Xbox khác và cho phép Greenlight trong Quyền riêng tư & Bảo mật › Mạng cục bộ."
          }
        }
      }
    },
