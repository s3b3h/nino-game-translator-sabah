      }
    },
    "This is not a valid account ID. It is 12 characters in base64, e.g. AbCdEfGhIjk=." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا ليس معرّف حساب صالحًا. يتكوّن من 12 حرفًا بصيغة base64، مثل AbCdEfGhIjk=."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি সঠিক অ্যাকাউন্ট আইডি নয়। এটি base64-এ ১২ অক্ষরের, যেমন AbCdEfGhIjk=।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not a valid account ID. It is 12 characters in base64, e.g. AbCdEfGhIjk=."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ito valid na account ID. Ito ay 12 character sa base64, hal. AbCdEfGhIjk=."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह मान्य अकाउंट ID नहीं है। यह base64 में 12 अक्षरों की होती है, जैसे AbCdEfGhIjk=।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID akun ini tidak valid. Panjangnya 12 karakter dalam base64, mis. AbCdEfGhIjk=."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini bukan ID akaun yang sah. Ia terdiri daripada 12 aksara dalam base64, cth. AbCdEfGhIjk=."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is geen geldige account-ID. Die bestaat uit 12 tekens in base64, bijv. AbCdEfGhIjk=."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID บัญชีนี้ไม่ถูกต้อง ต้องเป็น base64 จำนวน 12 ตัวอักษร เช่น AbCdEfGhIjk="
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu geçerli bir hesap kimliği değil. Kimlik base64 biçiminde 12 karakterdir, ör. AbCdEfGhIjk=."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ درست اکاؤنٹ ID نہیں ہے۔ یہ base64 میں 12 حروف کی ہوتی ہے، مثلاً AbCdEfGhIjk=۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây không phải ID tài khoản hợp lệ. ID gồm 12 ký tự base64, ví dụ AbCdEfGhIjk=."
          }
        }
      }
    },
    "To restart a Samsung TV fully, hold the power button on the remote for about 2 seconds until it turns off; a short press only puts it on standby." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإعادة تشغيل تلفاز Samsung بالكامل، اضغط مطولًا على زر التشغيل في جهاز التحكم عن بُعد نحو ثانيتين حتى ينطفئ؛ فالضغطة القصيرة تضعه في وضع الاستعداد فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung TV পুরোপুরি রিস্টার্ট করতে রিমোটের পাওয়ার বোতাম প্রায় ২ সেকেন্ড ধরে রাখুন যতক্ষণ না বন্ধ হয়; ছোট চাপে শুধু স্ট্যান্ডবাইতে যায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To restart a Samsung TV fully, hold the power button on the remote for about 2 seconds until it turns off; a short press only puts it on standby."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para tuluyang ma-restart ang Samsung TV, pindutin nang matagal ang power button sa remote nang mga 2 segundo hanggang mamatay ito; ang maikling pindot ay naglalagay lang dito sa standby."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung TV को पूरी तरह रीस्टार्ट करने के लिए रिमोट का पावर बटन लगभग 2 सेकंड तक दबाए रखें जब तक वह बंद न हो जाए; छोटा प्रेस उसे सिर्फ़ स्टैंडबाय में डालता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memulai ulang TV Samsung sepenuhnya, tahan tombol daya pada remote sekitar 2 detik hingga TV mati; tekan singkat hanya membuatnya siaga."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memulakan semula TV Samsung sepenuhnya, tahan butang kuasa pada alat kawalan jauh selama kira-kira 2 saat sehingga ia dimatikan; tekanan singkat hanya meletakkannya dalam mod siap sedia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om een Samsung-TV volledig opnieuw op te starten, houd je de aan-uitknop op de afstandsbediening ongeveer 2 seconden ingedrukt tot hij uitgaat; kort drukken zet hem alleen op stand-by."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการรีสตาร์ท TV Samsung อย่างสมบูรณ์ ให้กดปุ่มเปิด/ปิดบนรีโมทค้างไว้ประมาณ 2 วินาทีจนกว่าจะดับ การกดสั้นๆ จะเป็นเพียงการเข้าโหมดสแตนด์บาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung TV'yi tamamen yeniden başlatmak için TV kapanana kadar kumandanın güç tuşunu yaklaşık 2 saniye basılı tutun. Kısa basarsanız TV yalnızca bekleme moduna geçer."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung TV کو مکمل طور پر دوبارہ شروع کرنے کے لیے ریموٹ کا پاور بٹن تقریباً 2 سیکنڈ دبائے رکھیں یہاں تک کہ وہ بند ہو جائے؛ ہلکا سا دبانے سے صرف اسٹینڈ بائی ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để khởi động lại hoàn toàn TV Samsung, hãy giữ nút nguồn trên điều khiển khoảng 2 giây cho đến khi TV tắt; bấm nhanh chỉ đưa TV về chế độ chờ."
          }
        }
      }
    },
