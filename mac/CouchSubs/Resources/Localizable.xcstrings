    "This is not a valid IP address. Type it like 192.168.1.20, without http:// or a port number." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا ليس عنوان IP صالحًا. اكتبه بهذا الشكل 192.168.1.20، دون http:// أو رقم منفذ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি সঠিক IP ঠিকানা নয়। 192.168.1.20 এভাবে লিখুন, http:// বা পোর্ট নম্বর ছাড়া।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not a valid IP address. Type it like 192.168.1.20, without http:// or a port number."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ito valid na IP address. I-type ito nang ganito: 192.168.1.20, walang http:// o port number."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सही IP पता नहीं है। इसे 192.168.1.20 की तरह लिखें, बिना http:// या पोर्ट नंबर के।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini bukan alamat IP yang valid. Ketik seperti 192.168.1.20, tanpa http:// atau nomor port."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini bukan alamat IP yang sah. Taipkannya seperti 192.168.1.20, tanpa http:// atau nombor port."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is geen geldig IP-adres. Typ het zoals 192.168.1.20, zonder http:// of poortnummer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่อยู่ IP นี้ไม่ถูกต้อง พิมพ์ในรูปแบบ 192.168.1.20 โดยไม่ต้องมี http:// หรือหมายเลขพอร์ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu geçerli bir IP adresi değil. 192.168.1.20 gibi, http:// ve port numarası olmadan yazın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ درست IP ایڈریس نہیں۔ اسے 192.168.1.20 کی طرح لکھیں، http:// یا پورٹ نمبر کے بغیر۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây không phải địa chỉ IP hợp lệ. Hãy nhập dạng 192.168.1.20, không có http:// hoặc số cổng."
          }
        }
      }
    },
    "Type the model name as the server shows it. In Ollama, download it first: ollama pull qwen2.5:7b (downloaded models: ollama list). In LM Studio, load the model and start the local server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب اسم النموذج كما يعرضه الخادم. في Ollama، نزّله أولًا: ollama pull qwen2.5:7b (النماذج المنزّلة: ollama list). في LM Studio، حمّل النموذج وشغّل الخادم المحلي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সার্ভার যেভাবে দেখায় সেভাবে মডেলের নাম লিখুন। Ollama-তে আগে এটি ডাউনলোড করুন: ollama pull qwen2.5:7b (ডাউনলোড করা মডেল: ollama list)। LM Studio-তে মডেলটি লোড করে লোকাল সার্ভার চালু করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type the model name as the server shows it. In Ollama, download it first: ollama pull qwen2.5:7b (downloaded models: ollama list). In LM Studio, load the model and start the local server."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-type ang pangalan ng model gaya ng ipinapakita ng server. Sa Ollama, i-download muna ito: ollama pull qwen2.5:7b (mga na-download na model: ollama list). Sa LM Studio, i-load ang model at simulan ang local server."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मॉडल का नाम वैसे ही लिखें जैसे सर्वर दिखाता है। Ollama में पहले उसे डाउनलोड करें: ollama pull qwen2.5:7b (डाउनलोड किए मॉडल: ollama list)। LM Studio में मॉडल लोड करें और लोकल सर्वर शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik nama model seperti yang ditampilkan server. Di Ollama, unduh dulu: ollama pull qwen2.5:7b (model yang sudah diunduh: ollama list). Di LM Studio, muat model lalu jalankan server lokal."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taip nama model seperti yang ditunjukkan oleh pelayan. Dalam Ollama, muat turunnya dahulu: ollama pull qwen2.5:7b (model yang dimuat turun: ollama list). Dalam LM Studio, muatkan model dan mulakan pelayan setempat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ de modelnaam zoals de server die toont. Download hem in Ollama eerst: ollama pull qwen2.5:7b (gedownloade modellen: ollama list). Laad in LM Studio het model en start de lokale server."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พิมพ์ชื่อโมเดลตามที่เซิร์ฟเวอร์แสดง ใน Ollama ให้ดาวน์โหลดก่อน: ollama pull qwen2.5:7b (ดูโมเดลที่ดาวน์โหลดแล้ว: ollama list) ใน LM Studio ให้โหลดโมเดลแล้วเริ่มเซิร์ฟเวอร์ภายในเครื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model adını sunucunun gösterdiği gibi yazın. Ollama'da önce indirin: ollama pull qwen2.5:7b (indirilen modeller: ollama list). LM Studio'da modeli yükleyip yerel sunucuyu başlatın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماڈل کا نام ویسے ہی لکھیں جیسے سرور دکھاتا ہے۔ Ollama میں پہلے اسے ڈاؤن لوڈ کریں: ollama pull qwen2.5:7b (ڈاؤن لوڈ شدہ ماڈلز: ollama list)۔ LM Studio میں ماڈل لوڈ کریں اور لوکل سرور شروع کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập tên mô hình đúng như máy chủ hiển thị. Trong Ollama, hãy tải về trước: ollama pull qwen2.5:7b (các mô hình đã tải: ollama list). Trong LM Studio, hãy nạp mô hình và khởi động máy chủ cục bộ."
          }
        }
      }
    },
    "The PS5 asks for this account's login passcode. Enter it in Settings, or turn off this account's login passcode on the PS5." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب PS5 رمز دخول هذا الحساب. أدخله في الإعدادات، أو أوقف رمز الدخول لهذا الحساب على PS5."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 এই অ্যাকাউন্টের লগইন পাসকোড চাইছে। সেটিংসে এটি লিখুন, অথবা PS5-এ এই অ্যাকাউন্টের লগইন পাসকোড বন্ধ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PS5 asks for this account's login passcode. Enter it in Settings, or turn off this account's login passcode on the PS5."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinihingi ng PS5 ang login passcode ng account na ito. Ilagay ito sa Mga Setting, o i-off ang login passcode ng account na ito sa PS5."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 इस अकाउंट का लॉगिन पासकोड माँग रहा है। इसे सेटिंग्स में डालें, या PS5 पर इस अकाउंट का लॉगिन पासकोड बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 meminta kode sandi masuk akun ini. Masukkan di Pengaturan, atau nonaktifkan kode sandi masuk akun ini di PS5."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 meminta kod laluan log masuk akaun ini. Masukkannya dalam Tetapan, atau matikan kod laluan log masuk akaun ini pada PS5."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De PS5 vraagt om de inlogtoegangscode van dit account. Voer die in bij Instellingen, of zet de inlogtoegangscode van dit account uit op de PS5."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 ขอรหัสผ่านเข้าสู่ระบบของบัญชีนี้ ป้อนรหัสในการตั้งค่า หรือปิดรหัสผ่านเข้าสู่ระบบของบัญชีนี้บน PS5"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 bu hesap için giriş şifresi istiyor. Ayarlar'dan şifreyi girin ya da PS5'te bu hesabın giriş şifresini kapatın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 اس اکاؤنٹ کا لاگ ان پاس کوڈ مانگ رہا ہے۔ اسے سیٹنگز میں درج کریں، یا PS5 پر اس اکاؤنٹ کا لاگ ان پاس کوڈ بند کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 yêu cầu mã đăng nhập của tài khoản này. Hãy nhập trong Cài đặt, hoặc tắt mã đăng nhập của tài khoản này trên PS5."
          }
        }
      }
    },
    "The PS5 didn't accept the login passcode in Settings. Correct it, or turn off this account's login passcode on the PS5." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل PS5 رمز الدخول الموجود في الإعدادات. صحّحه، أو أوقف رمز الدخول لهذا الحساب على PS5."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 সেটিংসে দেওয়া লগইন পাসকোডটি গ্রহণ করেনি। এটি ঠিক করুন, অথবা PS5-এ এই অ্যাকাউন্টের লগইন পাসকোড বন্ধ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PS5 didn't accept the login passcode in Settings. Correct it, or turn off this account's login passcode on the PS5."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi tinanggap ng PS5 ang login passcode sa Mga Setting. Itama ito, o i-off ang login passcode ng account na ito sa PS5."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 ने सेटिंग्स में दिया लॉगिन पासकोड नहीं माना। उसे ठीक करें, या PS5 पर इस अकाउंट का लॉगिन पासकोड बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 tidak menerima kode sandi masuk di Pengaturan. Perbaiki, atau nonaktifkan kode sandi masuk akun ini di PS5."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 tidak menerima kod laluan log masuk dalam Tetapan. Betulkannya, atau matikan kod laluan log masuk akaun ini pada PS5."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De PS5 accepteerde de inlogtoegangscode uit Instellingen niet. Corrigeer die, of zet de inlogtoegangscode van dit account uit op de PS5."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 ไม่ยอมรับรหัสผ่านเข้าสู่ระบบในการตั้งค่า แก้ไขรหัสให้ถูกต้อง หรือปิดรหัสผ่านเข้าสู่ระบบของบัญชีนี้บน PS5"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5, Ayarlar'daki giriş şifresini kabul etmedi. Şifreyi düzeltin ya da PS5'te bu hesabın giriş şifresini kapatın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 نے سیٹنگز میں موجود لاگ ان پاس کوڈ قبول نہیں کیا۔ اسے درست کریں، یا PS5 پر اس اکاؤنٹ کا لاگ ان پاس کوڈ بند کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 không chấp nhận mã đăng nhập trong Cài đặt. Hãy sửa lại, hoặc tắt mã đăng nhập của tài khoản này trên PS5."
          }
        }
      }
    },
