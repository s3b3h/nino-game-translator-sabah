          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi tumugon ang TV. Tiyaking naka-on ito at nasa parehong network."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV ने जवाब नहीं दिया। पक्का करें कि वह चालू है और उसी नेटवर्क पर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV tidak merespons. Pastikan TV menyala dan berada di jaringan yang sama."
          }
        },
        "ms" : {
          "stringUnit" : {
