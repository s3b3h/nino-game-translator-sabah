    "If OBS runs on another computer, use this Mac's network address instead of localhost. The overlay only shows subtitles while the translation is running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان OBS يعمل على كمبيوتر آخر، فاستخدم عنوان شبكة هذا الـ Mac بدلًا من localhost. لا تعرض الطبقة الترجمة إلا أثناء تشغيل الترجمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBS অন্য কম্পিউটারে চললে localhost-এর বদলে এই Mac-এর নেটওয়ার্ক ঠিকানা ব্যবহার করুন। অনুবাদ চলার সময়ই শুধু ওভারলে সাবটাইটেল দেখায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If OBS runs on another computer, use this Mac's network address instead of localhost. The overlay only shows subtitles while the translation is running."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung tumatakbo ang OBS sa ibang computer, gamitin ang network address ng Mac na ito sa halip na localhost. Nagpapakita lang ng mga subtitle ang overlay habang tumatakbo ang pagsasalin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर OBS किसी दूसरे कंप्यूटर पर चल रहा है, तो localhost की जगह इस Mac का नेटवर्क एड्रेस इस्तेमाल करें। ओवरले सिर्फ़ अनुवाद चलने के दौरान सबटाइटल दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika OBS berjalan di komputer lain, gunakan alamat jaringan Mac ini, bukan localhost. Overlay hanya menampilkan subtitle saat terjemahan berjalan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika OBS berjalan pada komputer lain, gunakan alamat rangkaian Mac ini dan bukannya localhost. Tindanan hanya memaparkan sari kata semasa terjemahan sedang berjalan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draait OBS op een andere computer, gebruik dan het netwerkadres van deze Mac in plaats van localhost. De overlay toont alleen ondertitels terwijl de vertaling loopt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หาก OBS ทำงานบนคอมพิวเตอร์อีกเครื่อง ให้ใช้ที่อยู่เครือข่ายของ Mac เครื่องนี้แทน localhost โอเวอร์เลย์จะแสดงคำบรรยายเฉพาะขณะกำลังแปลเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBS başka bir bilgisayardaysa localhost yerine bu Mac'in ağ adresini kullanın. Katman yalnızca çeviri çalışırken altyazı gösterir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر OBS کسی دوسرے کمپیوٹر پر چل رہا ہے تو localhost کے بجائے اس Mac کا نیٹ ورک ایڈریس استعمال کریں۔ اوورلے صرف ترجمہ چلنے کے دوران سب ٹائٹلز دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu OBS chạy trên máy tính khác, hãy dùng địa chỉ mạng của máy Mac này thay cho localhost. Lớp phủ chỉ hiện phụ đề khi đang dịch."
          }
        }
      }
    },
    "If OBS runs on another computer, use the network address of this PC instead of localhost. The overlay only shows subtitles while the translation is running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
