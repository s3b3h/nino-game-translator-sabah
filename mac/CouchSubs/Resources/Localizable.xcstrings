    "Sign in to PlayStation Network with the second account you just created. Your password goes directly to Sony; Nino only keeps the account ID." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول إلى PlayStation Network بالحساب الثاني الذي أنشأته للتو. تذهب كلمة المرور مباشرةً إلى Sony؛ ولا يحتفظ Nino إلا بمعرّف الحساب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এইমাত্র খোলা দ্বিতীয় অ্যাকাউন্ট দিয়ে PlayStation Network-এ সাইন ইন করুন। আপনার পাসওয়ার্ড সরাসরি Sony-র কাছে যায়; Nino শুধু অ্যাকাউন্ট আইডি রাখে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to PlayStation Network with the second account you just created. Your password goes directly to Sony; Nino only keeps the account ID."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-sign in sa PlayStation Network gamit ang pangalawang account na kagagawa mo lang. Direktang napupunta sa Sony ang iyong password; ang account ID lang ang itinatago ng Nino."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी बनाए गए दूसरे अकाउंट से PlayStation Network में साइन इन करें। आपका पासवर्ड सीधे Sony को जाता है; Nino सिर्फ़ अकाउंट ID रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk ke PlayStation Network dengan akun kedua yang baru saja Anda buat. Kata sandi Anda langsung dikirim ke Sony; Nino hanya menyimpan ID akun."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log masuk ke PlayStation Network dengan akaun kedua yang baru anda cipta. Kata laluan anda terus dihantar kepada Sony; Nino hanya menyimpan ID akaun."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in bij PlayStation Network met het tweede account dat je net hebt aangemaakt. Je wachtwoord gaat rechtstreeks naar Sony; Nino bewaart alleen de account-ID."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงชื่อเข้า PlayStation Network ด้วยบัญชีที่สองที่คุณเพิ่งสร้าง รหัสผ่านจะส่งตรงไปยัง Sony โดย Nino เก็บไว้เพียง ID บัญชี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az önce açtığınız 2. PSN hesabıyla giriş yapın. Nino altyazıyı bu hesap üzerinden okur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابھی بنائے گئے دوسرے اکاؤنٹ سے PlayStation Network میں سائن اِن کریں۔ آپ کا پاس ورڈ سیدھا Sony کو جاتا ہے؛ Nino صرف اکاؤنٹ ID رکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập PlayStation Network bằng tài khoản thứ hai bạn vừa tạo. Mật khẩu được gửi thẳng tới Sony; Nino chỉ lưu ID tài khoản."
          }
        }
      }
    },
