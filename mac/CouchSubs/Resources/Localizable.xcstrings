      }
    },
    "The code is wrong or has expired. Open Pair Device again on the PS5 and enter the new code." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرمز غير صحيح أو انتهت صلاحيته. افتح «إقران الجهاز» مجددًا على PS5 وأدخل الرمز الجديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোডটি ভুল বা মেয়াদ শেষ। PS5-এ আবার Pair Device খুলে নতুন কোড লিখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code is wrong or has expired. Open Pair Device again on the PS5 and enter the new code."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mali o expired na ang code. Buksan muli ang Pair Device sa PS5 at ilagay ang bagong code."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोड ग़लत है या उसकी समय-सीमा ख़त्म हो गई है। PS5 पर Pair Device फिर से खोलें और नया कोड डालें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode salah atau sudah kedaluwarsa. Buka Pasangkan Perangkat lagi di PS5 dan masukkan kode baru."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod salah atau telah tamat tempoh. Buka Pair Device semula pada PS5 dan masukkan kod baharu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De code is onjuist of verlopen. Open Apparaat koppelen opnieuw op de PS5 en voer de nieuwe code in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสไม่ถูกต้องหรือหมดอายุแล้ว โปรดเปิด จับคู่อุปกรณ์ บน PS5 อีกครั้งแล้วป้อนรหัสใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod yanlış ya da süresi dolmuş. PS5'te Cihazı Eşleştir'i yeniden açın ve yeni kodu girin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوڈ غلط ہے یا اس کی مدت ختم ہو گئی ہے۔ PS5 پر Pair Device دوبارہ کھولیں اور نیا کوڈ درج کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã sai hoặc đã hết hạn. Hãy mở lại Ghép nối thiết bị trên PS5 và nhập mã mới."
          }
        }
      }
    },
    "The PS5 received the request but did not answer in time. Open Pair Device again on the PS5 and enter the new code." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلقى PS5 الطلب لكنه لم يردّ في الوقت المحدد. افتح «إقران الجهاز» مجددًا على PS5 وأدخل الرمز الجديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 অনুরোধ পেয়েছে কিন্তু সময়মতো সাড়া দেয়নি। PS5-এ আবার Pair Device খুলে নতুন কোড লিখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PS5 received the request but did not answer in time. Open Pair Device again on the PS5 and enter the new code."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natanggap ng PS5 ang request pero hindi sumagot sa oras. Buksan muli ang Pair Device sa PS5 at ilagay ang bagong code."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 को अनुरोध मिला, लेकिन उसने समय पर जवाब नहीं दिया। PS5 पर Pair Device फिर से खोलें और नया कोड डालें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 menerima permintaan tetapi tidak merespons tepat waktu. Buka Pasangkan Perangkat lagi di PS5 dan masukkan kode baru."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 menerima permintaan tetapi tidak menjawab tepat pada masanya. Buka Pair Device semula pada PS5 dan masukkan kod baharu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De PS5 heeft het verzoek ontvangen maar niet op tijd gereageerd. Open Apparaat koppelen opnieuw op de PS5 en voer de nieuwe code in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 ได้รับคำขอแต่ไม่ตอบกลับทันเวลา โปรดเปิด จับคู่อุปกรณ์ บน PS5 อีกครั้งแล้วป้อนรหัสใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 isteği aldı ama zamanında yanıt vermedi. PS5'te Cihazı Eşleştir'i yeniden açın ve yeni kodu girin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 کو درخواست ملی مگر اس نے بروقت جواب نہیں دیا۔ PS5 پر Pair Device دوبارہ کھولیں اور نیا کوڈ درج کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 đã nhận yêu cầu nhưng không phản hồi kịp. Hãy mở lại Ghép nối thiết bị trên PS5 và nhập mã mới."
          }
        }
      }
    },
    "No PS5 found at this address. Check the PS5's IP address under Settings › Network › Connection Status." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على PS5 في هذا العنوان. تحقق من عنوان IP الخاص بـ PS5 في الإعدادات › الشبكة › حالة الاتصال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ঠিকানায় কোনো PS5 পাওয়া যায়নি। Settings › Network › Connection Status-এ PS5-এর IP ঠিকানা দেখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
