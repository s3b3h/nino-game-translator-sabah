    "Your Microsoft sign-in expired. Sign in again in Settings › Console." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية تسجيل الدخول إلى Microsoft. سجّل الدخول مجددًا من الإعدادات › الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার Microsoft সাইন-ইনের মেয়াদ শেষ। সেটিংস › কনসোল-এ আবার সাইন ইন করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Microsoft sign-in expired. Sign in again in Settings › Console."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nag-expire na ang iyong Microsoft sign-in. Mag-sign in ulit sa Mga Setting › Console."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका Microsoft साइन-इन खत्म हो गया। सेटिंग्स › कंसोल में फिर से साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi masuk Microsoft Anda kedaluwarsa. Masuk lagi di Pengaturan › Konsol."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log masuk Microsoft anda telah tamat tempoh. Log masuk semula dalam Tetapan › Konsol."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Microsoft-login is verlopen. Log opnieuw in via Instellingen › Console."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลงชื่อเข้าใช้ Microsoft หมดอายุแล้ว ลงชื่อเข้าใช้อีกครั้งที่ การตั้งค่า › คอนโซล"
