            "value" : "Sira ang na-download na Greenlight file. Pakisubukang muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड की गई Greenlight फ़ाइल ख़राब थी। कृपया फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File Greenlight yang diunduh rusak. Silakan coba lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fail Greenlight yang dimuat turun rosak. Sila cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gedownloade Greenlight-bestand was beschadigd. Probeer het opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
