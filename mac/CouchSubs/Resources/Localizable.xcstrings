            "value" : "Sony'nin yanıtı okunamadı. Yeniden giriş yapın; sorun sürerse Nino'yu güncelleyin."
          }
        }
      }
    },
    "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
