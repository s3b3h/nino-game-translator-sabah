    },
    "Nino also checks for a new version by itself when it opens and tells you on the main screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق Nino أيضًا من وجود إصدار جديد تلقائيًا عند فتحه، ويُعلمك بذلك في الشاشة الرئيسية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino খোলার সময় নিজে থেকেও নতুন সংস্করণ খোঁজে এবং মূল স্ক্রিনে আপনাকে জানায়।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusa ring tinitingnan ng Nino kung may bagong bersyon kapag bumubukas ito at sasabihin sa iyo sa main screen."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino खुलते समय अपने-आप नया वर्ज़न भी जाँचता है और मुख्य स्क्रीन पर बताता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino juga memeriksa versi baru dengan sendirinya saat dibuka dan memberi tahu Anda di layar utama."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino juga menyemak versi baharu dengan sendirinya apabila dibuka dan memberitahu anda pada skrin utama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino zoekt ook zelf naar een nieuwe versie als het opent en laat het je weten op het hoofdscherm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino ยังตรวจหาเวอร์ชันใหม่เองเมื่อเปิดแอป และจะแจ้งให้คุณทราบที่หน้าจอหลัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino açılırken yeni sürümü kendisi de denetler ve ana ekranda haber verir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھلتے وقت Nino نئے ورژن کو خود بھی چیک کرتا ہے اور مین اسکرین پر آپ کو بتاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino cũng tự kiểm tra phiên bản mới mỗi khi mở và báo cho bạn trên màn hình chính."
          }
        }
      }
    },
