    "Without it Windows reads the subtitles with your system language and the translation turns into nonsense. Install it once; Windows asks for permission." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدونه يقرأ Windows النصوص الإنجليزية بلغة نظامك فتصبح الترجمة بلا معنى. ثبّته مرة واحدة؛ وسيطلب Windows الإذن."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without it Windows reads the subtitles with your system language and the translation turns into nonsense. Install it once; Windows asks for permission."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu olmadan Windows altyazıyı sistem dilinizle okur ve çeviri anlamsız olur. Bir kez kurmanız yeter; Windows izin ister."
          }
        }
      }
    },
