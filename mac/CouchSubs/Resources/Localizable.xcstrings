    "Key Server is off. Turn it on in the Developer Mode app and keep the app on screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server متوقف. شغّله في تطبيق Developer Mode وأبقِ التطبيق ظاهرًا على الشاشة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server বন্ধ আছে। Developer Mode অ্যাপে এটি চালু করুন এবং অ্যাপটি স্ক্রিনে রাখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server is off. Turn it on in the Developer Mode app and keep the app on screen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-off ang Key Server. I-on ito sa Developer Mode app at panatilihing nasa screen ang app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server बंद है। Developer Mode ऐप में इसे चालू करें और ऐप को स्क्रीन पर खुला रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server nonaktif. Aktifkan di aplikasi Developer Mode dan biarkan aplikasi tetap di layar."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server dimatikan. Hidupkannya dalam aplikasi Developer Mode dan biarkan aplikasi itu terpapar pada skrin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server staat uit. Zet hem aan in de Developer Mode-app en houd de app op het scherm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server ปิดอยู่ โปรดเปิดในแอป Developer Mode และเปิดแอปค้างไว้บนหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server kapalı. Developer Mode uygulamasından açın ve uygulamayı ekranda bırakın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server بند ہے۔ Developer Mode ایپ میں اسے آن کریں اور ایپ اسکرین پر کھلی رکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key Server đang tắt. Hãy bật nó trong ứng dụng Developer Mode và giữ ứng dụng trên màn hình."
          }
        }
      }
    },
