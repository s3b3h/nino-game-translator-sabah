    "No LG or Samsung TV found. Make sure the TV is on and on the same network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على تلفاز LG أو Samsung. تأكد من أن التلفاز يعمل ومتصل بالشبكة نفسها."
          }
        },
