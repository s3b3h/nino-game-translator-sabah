        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể dùng phím này làm phím tắt."
          }
        }
      }
    },
    "When you turn on the controller to play, choose your MAIN account on the PS5. Don't play with the second account Nino signs in with, or the controller won't work in the game." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل يد التحكم للعب، اختر حسابك الأساسي على PS5. لا تلعب بالحساب الثاني الذي يسجّل Nino الدخول به، وإلا فلن تعمل يد التحكم في اللعبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খেলার জন্য কন্ট্রোলার চালু করলে PS5-এ আপনার মূল অ্যাকাউন্টটি বেছে নিন। Nino যে দ্বিতীয় অ্যাকাউন্ট দিয়ে সাইন ইন করে সেটি দিয়ে খেলবেন না, নইলে গেমে কন্ট্রোলার কাজ করবে না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you turn on the controller to play, choose your MAIN account on the PS5. Don't play with the second account Nino signs in with, or the controller won't work in the game."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag binuksan mo ang controller para maglaro, piliin ang iyong PANGUNAHING account sa PS5. Huwag maglaro gamit ang pangalawang account na ginagamit ng Nino, kung hindi ay hindi gagana ang controller sa laro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खेलने के लिए कंट्रोलर चालू करते समय PS5 पर अपना मुख्य अकाउंट चुनें। Nino जिस दूसरे अकाउंट से साइन इन करता है उससे न खेलें, वरना गेम में कंट्रोलर काम नहीं करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda menyalakan controller untuk bermain, pilih akun UTAMA Anda di PS5. Jangan bermain dengan akun kedua yang dipakai Nino untuk masuk, atau controller tidak akan berfungsi di game."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila anda menghidupkan alat kawalan untuk bermain, pilih akaun UTAMA anda pada PS5. Jangan bermain dengan akaun kedua yang digunakan Nino untuk log masuk, atau alat kawalan tidak akan berfungsi dalam permainan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies bij het aanzetten van de controller je HOOFDaccount op de PS5. Speel niet met het tweede account waarmee Nino inlogt, anders werkt de controller niet in de game."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดจอยเพื่อเล่น ให้เลือกบัญชีหลักของคุณบน PS5 อย่าเล่นด้วยบัญชีที่สองที่ Nino ใช้ลงชื่อเข้าใช้ ไม่เช่นนั้นจอยจะใช้ในเกมไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynamak için joystick'i açınca PS5'te ANA hesabını seç. Nino'nun giriş yaptığı ikinci hesapla oynama, yoksa joystick oyunda çalışmaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کھیلنے کے لیے کنٹرولر آن کریں تو PS5 پر اپنا اصل اکاؤنٹ منتخب کریں۔ اس دوسرے اکاؤنٹ سے نہ کھیلیں جس سے Nino سائن ان کرتا ہے، ورنہ کنٹرولر گیم میں کام نہیں کرے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật tay cầm để chơi, hãy chọn tài khoản CHÍNH của bạn trên PS5. Đừng chơi bằng tài khoản phụ mà Nino dùng để đăng nhập, nếu không tay cầm sẽ không hoạt động trong game."
          }
        }
      }
    },
    "Tap the button to get a code. The Microsoft sign-in page doesn't open inside the app: you enter the code at microsoft.com/link in your browser." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط الزر للحصول على رمز. صفحة تسجيل الدخول إلى Microsoft لا تُفتح داخل التطبيق: أدخل الرمز في microsoft.com/link من متصفحك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি কোড পেতে বোতামটি ট্যাপ করুন। Microsoft সাইন-ইন পেজ অ্যাপের ভেতরে খোলে না: ব্রাউজারে microsoft.com/link-এ গিয়ে কোডটি লিখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the button to get a code. The Microsoft sign-in page doesn't open inside the app: you enter the code at microsoft.com/link in your browser."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-tap ang button para makakuha ng code. Hindi bumubukas sa loob ng app ang sign-in page ng Microsoft: ilalagay mo ang code sa microsoft.com/link sa iyong browser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोड पाने के लिए बटन पर टैप करें। Microsoft का साइन-इन पेज ऐप के अंदर नहीं खुलता: आप कोड अपने ब्राउज़र में microsoft.com/link पर डालते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk tombol untuk mendapatkan kode. Halaman masuk Microsoft tidak terbuka di dalam aplikasi: Anda memasukkan kode di microsoft.com/link pada browser."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik butang untuk mendapatkan kod. Halaman log masuk Microsoft tidak dibuka di dalam apl: anda masukkan kod di microsoft.com/link dalam pelayar anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de knop om een code te krijgen. De inlogpagina van Microsoft opent niet in de app: je voert de code in op microsoft.com/link in je browser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะปุ่มเพื่อรับรหัส หน้าลงชื่อเข้าใช้ Microsoft จะไม่เปิดในแอป ให้ป้อนรหัสที่ microsoft.com/link ในเบราว์เซอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düğmeye basınca bir kod alırsınız. Microsoft giriş sayfası uygulamada açılmaz: kodu tarayıcıda microsoft.com/link sayfasına yazarsınız."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوڈ حاصل کرنے کے لیے بٹن پر ٹیپ کریں۔ Microsoft کا سائن ان صفحہ ایپ کے اندر نہیں کھلتا: کوڈ اپنے براؤزر میں microsoft.com/link پر درج کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn nút để lấy mã. Trang đăng nhập Microsoft không mở trong ứng dụng: bạn nhập mã tại microsoft.com/link trên trình duyệt."
          }
        }
      }
    },
