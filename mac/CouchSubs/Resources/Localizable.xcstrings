        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private نیٹ ورکس پر Nino کے لیے لوکل نیٹ ورک کی اجازت تیار ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền mạng cục bộ đã sẵn sàng cho Nino trên mạng Riêng tư."
          }
        }
      }
    },
    "Configure local-network permission for TV and PS5 connections on a trusted Private network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط إذن الشبكة المحلية لاتصالات TV وPS5 على شبكة خاصة موثوقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিশ্বস্ত Private নেটওয়ার্কে TV ও PS5 সংযোগের জন্য লোকাল নেটওয়ার্ক অনুমতি সেট করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
