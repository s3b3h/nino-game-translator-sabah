    "Tap after you open the game on the PS5. The phone takes the picture, reads the subtitles and translates them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط بعد فتح اللعبة على PS5. يلتقط الهاتف الصورة ويقرأ النصوص الإنجليزية ويترجمها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap after you open the game on the PS5. The phone takes the picture, reads the subtitles and translates them."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5'te oyunu açtıktan sonra dokunun. Telefon görüntüyü alır, altyazıyı okuyup çevirir."
          }
        }
      }
    },
