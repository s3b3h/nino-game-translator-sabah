          }
        }
      }
    },
    "Developer mode stays on for at most 1000 hours. Nino extends it by itself once a day while the phone can reach the TV." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى وضع المطوّر مفعّلًا 1000 ساعة على الأكثر. يمدّده Nino تلقائيًا مرة يوميًا ما دام الهاتف قادرًا على الوصول إلى TV."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডেভেলপার মোড সর্বোচ্চ 1000 ঘণ্টা চালু থাকে। ফোন TV-তে পৌঁছাতে পারলে Nino দিনে একবার নিজেই এটি বাড়িয়ে দেয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Developer mode stays on for at most 1000 hours. Nino extends it by itself once a day while the phone can reach the TV."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nananatiling naka-on ang developer mode nang hanggang 1000 oras. Kusa itong pinapahaba ng Nino isang beses kada araw habang naaabot ng phone ang TV."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेवलपर मोड ज़्यादा से ज़्यादा 1000 घंटे चालू रहता है। जब तक फ़ोन TV तक पहुँच सकता है, Nino इसे दिन में एक बार अपने आप बढ़ा देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode pengembang aktif paling lama 1000 jam. Nino memperpanjangnya sendiri sekali sehari selama ponsel dapat menjangkau TV."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod pembangun kekal hidup selama paling lama 1000 jam. Nino melanjutkannya dengan sendirinya sekali sehari selagi telefon dapat mencapai TV."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ontwikkelaarsmodus blijft maximaal 1000 uur aan. Nino verlengt hem vanzelf één keer per dag zolang de telefoon de TV kan bereiken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหมดนักพัฒนาเปิดได้นานสุด 1000 ชั่วโมง Nino จะต่ออายุให้เองวันละครั้งเมื่อโทรศัพท์เชื่อมต่อ TV ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geliştirici modu en çok 1000 saat açık kalır. Telefon TV'ye ulaşabildiği sürece Nino bunu günde bir kez kendisi uzatır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈیولپر موڈ زیادہ سے زیادہ 1000 گھنٹے آن رہتا ہے۔ جب تک فون TV تک پہنچ سکے، Nino روزانہ ایک بار اسے خود بڑھا دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ nhà phát triển chỉ bật tối đa 1000 giờ. Nino sẽ tự gia hạn mỗi ngày một lần khi điện thoại kết nối được với TV."
          }
        }
      }
    },
