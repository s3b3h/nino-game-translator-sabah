    "No LG or Samsung TV found. Make sure the TV is on and on the same network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على تلفاز LG أو Samsung. تأكد من أن التلفاز يعمل ومتصل بالشبكة نفسها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো LG বা Samsung TV পাওয়া যায়নি। নিশ্চিত করুন TV চালু আছে এবং একই নেটওয়ার্কে আছে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No LG or Samsung TV found. Make sure the TV is on and on the same network."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang nahanap na LG o Samsung TV. Tiyaking naka-on ang TV at nasa parehong network."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई LG या Samsung TV नहीं मिला। पक्का करें कि TV चालू है और उसी नेटवर्क पर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada TV LG atau Samsung yang ditemukan. Pastikan TV menyala dan berada di jaringan yang sama."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada TV LG atau Samsung ditemui. Pastikan TV dihidupkan dan berada pada rangkaian yang sama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen LG- of Samsung-TV gevonden. Controleer of de TV aan staat en op hetzelfde netwerk zit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบ TV LG หรือ Samsung โปรดตรวจสอบว่า TV เปิดอยู่และอยู่ในเครือข่ายเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LG ya da Samsung TV bulunamadı. TV'nin açık ve aynı ağda olduğundan emin olun."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی LG یا Samsung TV نہیں ملا۔ یقینی بنائیں کہ TV آن ہے اور اسی نیٹ ورک پر ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy TV LG hoặc Samsung. Hãy đảm bảo TV đang bật và cùng mạng."
          }
        }
      }
    },
    "No PS5 found. Make sure it is on and on the same network, or enter its IP address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على PS5. تأكد من أنه يعمل ومتصل بالشبكة نفسها، أو أدخل عنوان IP الخاص به."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো PS5 পাওয়া যায়নি। নিশ্চিত করুন এটি চালু আছে এবং একই নেটওয়ার্কে আছে, অথবা এর IP ঠিকানা লিখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No PS5 found. Make sure it is on and on the same network, or enter its IP address."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang nahanap na PS5. Tiyaking naka-on ito at nasa parehong network, o ilagay ang IP address nito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई PS5 नहीं मिला। पक्का करें कि वह चालू है और उसी नेटवर्क पर है, या उसका IP एड्रेस डालें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 tidak ditemukan. Pastikan PS5 menyala dan berada di jaringan yang sama, atau masukkan alamat IP-nya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada PS5 ditemui. Pastikan ia dihidupkan dan berada pada rangkaian yang sama, atau masukkan alamat IPnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen PS5 gevonden. Controleer of hij aan staat en op hetzelfde netwerk zit, of voer het IP-adres in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบ PS5 โปรดตรวจสอบว่าเปิดอยู่และอยู่ในเครือข่ายเดียวกัน หรือป้อนที่อยู่ IP"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 bulunamadı. Açık ve aynı ağda olduğundan emin olun ya da IP adresini girin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی PS5 نہیں ملا۔ یقینی بنائیں کہ وہ آن ہے اور اسی نیٹ ورک پر ہے، یا اس کا IP ایڈریس درج کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy PS5. Hãy đảm bảo máy đang bật và cùng mạng, hoặc nhập địa chỉ IP của máy."
          }
        }
      }
    },
    "No account? You can create a free one on the same page. If the browser asks to allow access to devices on your network, allow it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لديك حساب؟ يمكنك إنشاء حساب مجاني من الصفحة نفسها. إذا طلب المتصفح السماح بالوصول إلى الأجهزة على شبكتك، فاسمح بذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাকাউন্ট নেই? একই পেজে বিনামূল্যে একটি খুলতে পারেন। ব্রাউজার আপনার নেটওয়ার্কের ডিভাইসে অ্যাক্সেসের অনুমতি চাইলে অনুমতি দিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account? You can create a free one on the same page. If the browser asks to allow access to devices on your network, allow it."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang account? Puwede kang gumawa ng libre sa parehong page. Kung hihingi ang browser ng pahintulot na i-access ang mga device sa iyong network, payagan ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अकाउंट नहीं है? आप उसी पेज पर मुफ़्त में बना सकते हैं। अगर ब्राउज़र आपके नेटवर्क के डिवाइस तक पहुँच की अनुमति माँगे, तो अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum punya akun? Anda bisa membuat akun gratis di halaman yang sama. Jika browser meminta izin mengakses perangkat di jaringan Anda, izinkan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada akaun? Anda boleh mencipta akaun percuma pada halaman yang sama. Jika pelayar meminta kebenaran untuk mengakses peranti pada rangkaian anda, benarkannya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen account? Je kunt op dezelfde pagina gratis een account aanmaken. Als de browser vraagt om toegang tot apparaten in je netwerk, sta het dan toe."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีบัญชีใช่ไหม คุณสร้างบัญชีฟรีได้ในหน้าเดียวกัน หากเบราว์เซอร์ขออนุญาตเข้าถึงอุปกรณ์ในเครือข่ายของคุณ ให้อนุญาต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız yok mu? Aynı sayfada ücretsiz açabilirsiniz. Tarayıcı ağınızdaki cihazlara erişim izni isterse izin verin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکاؤنٹ نہیں ہے؟ اسی صفحے پر مفت اکاؤنٹ بنا سکتے ہیں۔ اگر براؤزر آپ کے نیٹ ورک کے آلات تک رسائی کی اجازت مانگے تو اجازت دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có tài khoản? Bạn có thể tạo miễn phí ngay trên trang đó. Nếu trình duyệt xin quyền truy cập thiết bị trong mạng, hãy cho phép."
          }
        }
      }
    },
