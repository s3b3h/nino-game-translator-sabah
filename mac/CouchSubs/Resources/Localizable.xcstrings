    "The code is valid for 5 minutes. If something goes wrong, the reason is shown here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرمز صالح لمدة 5 دقائق. إذا حدث خطأ ما، فسيظهر السبب هنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোডটি ৫ মিনিট বৈধ থাকে। কোনো সমস্যা হলে কারণ এখানে দেখানো হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
