    "About 220 MB. Nino downloads it, puts it in Applications and opens it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حوالي 220 ميغابايت. يقوم Nino بتنزيله ووضعه في التطبيقات وفتحه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রায় 220 MB। Nino এটি ডাউনলোড করে, Applications-এ রাখে এবং খোলে।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga 220 MB. Dina-download ito ng Nino, inilalagay sa Applications at binubuksan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगभग 220 MB. Nino इसे डाउनलोड करता है, Applications में रखता है और खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekitar 220 MB. Nino mengunduhnya, menaruhnya di Aplikasi, dan membukanya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kira-kira 220 MB. Nino memuat turunnya, meletakkannya dalam Applications dan membukanya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeveer 220 MB. Nino downloadt het, zet het in Apps en opent het."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประมาณ 220 MB Nino จะดาวน์โหลด ใส่ไว้ใน Applications และเปิดให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık 220 MB. Nino indirir, Uygulamalar'a koyar ve açar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقریباً 220 MB۔ Nino اسے ڈاؤن لوڈ کر کے Applications میں رکھتا ہے اور کھول دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoảng 220 MB. Nino tải xuống, đặt vào Applications và mở nó."
          }
        }
      }
    },
    "Couldn't find Greenlight's latest version. Check your internet connection." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر العثور على أحدث إصدار من Greenlight. تحقّق من اتصال الإنترنت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight-এর সর্বশেষ সংস্করণ পাওয়া যায়নি। ইন্টারনেট সংযোগ দেখুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mahanap ang pinakabagong bersyon ng Greenlight. Tingnan ang iyong koneksyon sa internet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight का नया वर्ज़न नहीं मिला। अपना इंटरनेट कनेक्शन जाँचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menemukan versi terbaru Greenlight. Periksa koneksi internet Anda."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat mencari versi terkini Greenlight. Semak sambungan internet anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de nieuwste versie van Greenlight niet vinden. Controleer je internetverbinding."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบ Greenlight เวอร์ชันล่าสุด โปรดตรวจสอบการเชื่อมต่ออินเทอร์เน็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight'ın son sürümü bulunamadı. İnternet bağlantınızı kontrol edin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight کا تازہ ترین ورژن نہیں ملا۔ اپنا انٹرنیٹ کنکشن چیک کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy phiên bản mới nhất của Greenlight. Hãy kiểm tra kết nối internet."
          }
        }
      }
    },
    "Greenlight couldn't be downloaded. Check your internet connection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تنزيل Greenlight. تحقّق من اتصال الإنترنت وحاول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight ডাউনলোড করা যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ma-download ang Greenlight. Tingnan ang iyong koneksyon sa internet at subukang muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight डाउनलोड नहीं हो सका। अपना इंटरनेट कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight tidak dapat diunduh. Periksa koneksi internet Anda dan coba lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight tidak dapat dimuat turun. Semak sambungan internet anda dan cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight kon niet worden gedownload. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดาวน์โหลด Greenlight ไม่ได้ โปรดตรวจสอบการเชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight indirilemedi. İnternet bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight ڈاؤن لوڈ نہیں ہو سکا۔ اپنا انٹرنیٹ کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tải được Greenlight. Hãy kiểm tra kết nối internet và thử lại."
          }
        }
      }
    },
    "The downloaded Greenlight file was damaged. Please try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف Greenlight الذي تم تنزيله تالف. يرجى المحاولة مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
