    "Still as the new user, turn on Settings › System › Remote Play › Enable Remote Play and turn off the last option on that screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على الحساب الجديد، فعّل التشغيل عن بُعد من الإعدادات › النظام، وأوقف خيار الإشعار الأخير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন ইউজার থাকা অবস্থাতেই Settings › System › Remote Play › Enable Remote Play চালু করুন এবং সেই স্ক্রিনের শেষ অপশনটি বন্ধ করুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilang bagong user pa rin, i-on ang Settings › System › Remote Play › Enable Remote Play at i-off ang huling opsyon sa screen na iyon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए यूज़र के रूप में ही, Settings › System › Remote Play › Enable Remote Play चालू करें और उस स्क्रीन का आख़िरी विकल्प बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masih sebagai pengguna baru, aktifkan Pengaturan › Sistem › Remote Play › Aktifkan Remote Play dan matikan opsi terakhir di layar itu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masih sebagai pengguna baharu, hidupkan Settings › System › Remote Play › Enable Remote Play dan matikan pilihan terakhir pada skrin itu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet, nog steeds als de nieuwe gebruiker, Instellingen › Systeem › Remote Play › Remote Play inschakelen aan en zet de laatste optie op dat scherm uit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขณะยังเป็นผู้ใช้ใหม่ ให้เปิด การตั้งค่า › ระบบ › Remote Play › เปิดใช้งาน Remote Play และปิดตัวเลือกสุดท้ายบนหน้าจอนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni hesapta Ayarlar › Sistem › Uzaktan Oynama'da Uzaktan Oynama'yı Etkinleştir'i ve en alttaki Bağlantı Durumunu Gizle'yi açın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نئے یوزر ہی کے طور پر Settings › System › Remote Play › Enable Remote Play آن کریں اور اسی اسکرین کا آخری آپشن بند کر دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn ở người dùng mới, hãy bật Cài đặt › Hệ thống › Remote Play › Bật Remote Play và tắt tùy chọn cuối cùng trên màn hình đó."
          }
        }
      }
    },
    "Which console do you play on?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على أي جهاز ألعاب تلعب؟"
