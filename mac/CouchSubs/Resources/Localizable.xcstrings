    },
    "Your devices, PSN account and translation settings are here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنا أجهزتك وحساب PSN وإعدادات الترجمة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
