    "Keeps the character's name in front of the translation (ARTHUR: …). The name itself is never translated." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي اسم الشخصية قبل الترجمة (ARTHUR: …). لا يُترجم الاسم نفسه أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুবাদের সামনে চরিত্রের নাম রাখে (ARTHUR: …)। নামটি কখনো অনুবাদ করা হয় না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the character's name in front of the translation (ARTHUR: …). The name itself is never translated."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapanatili ang pangalan ng karakter sa unahan ng salin (ARTHUR: …). Hindi kailanman isinasalin ang pangalan mismo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुवाद के आगे किरदार का नाम रखता है (ARTHUR: …)। नाम का खुद कभी अनुवाद नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan nama karakter di depan terjemahan (ARTHUR: …). Nama itu sendiri tidak pernah diterjemahkan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengekalkan nama watak di hadapan terjemahan (ARTHUR: …). Nama itu sendiri tidak pernah diterjemah."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt de naam van het personage voor de vertaling (ARTHUR: …). De naam zelf wordt nooit vertaald."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงชื่อตัวละครไว้หน้าคำแปล (ARTHUR: …) ชื่อจะไม่ถูกแปล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karakterin adı çevirinin başında kalır (ARTHUR: …). Adın kendisi hiçbir zaman çevrilmez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کردار کا نام ترجمے سے پہلے رکھتا ہے (ARTHUR: …)۔ نام کا خود کبھی ترجمہ نہیں ہوتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
