    "The free Xbox app for Mac. It gives the sharpest picture, so subtitles are read best." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق Xbox مجاني للماك. يعطي أوضح صورة، فتُقرأ الترجمة بأفضل شكل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-এর জন্য বিনামূল্যের Xbox অ্যাপ। এটি সবচেয়ে স্পষ্ট ছবি দেয়, তাই সাবটাইটেল সবচেয়ে ভালো পড়া যায়।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang libreng Xbox app para sa Mac. Ito ang nagbibigay ng pinakamalinaw na larawan, kaya pinakamahusay nababasa ang mga subtitle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac के लिए मुफ़्त Xbox ऐप। यह सबसे साफ़ तस्वीर देता है, इसलिए सबटाइटल सबसे अच्छे से पढ़े जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi Xbox gratis untuk Mac. Gambarnya paling tajam, jadi subtitle terbaca paling baik."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi Xbox percuma untuk Mac. Ia memberikan gambar paling tajam, jadi sari kata dibaca dengan paling baik."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gratis Xbox-app voor Mac. Die geeft het scherpste beeld, zodat ondertitels het best gelezen worden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอป Xbox ฟรีสำหรับ Mac ให้ภาพที่คมชัดที่สุด จึงอ่านคำบรรยายได้ดีที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac için ücretsiz Xbox uygulaması. Görüntüyü en net hâliyle verir, altyazı en doğru böyle okunur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac کے لیے مفت Xbox ایپ۔ یہ سب سے صاف تصویر دیتی ہے، اس لیے سب ٹائٹلز بہترین پڑھے جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng Xbox miễn phí cho Mac. Cho hình ảnh nét nhất, nên phụ đề được đọc tốt nhất."
          }
        }
      }
    },
