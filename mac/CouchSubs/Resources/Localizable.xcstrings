    "The saved PS5, account and TV connection are removed and setup starts from the beginning." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف بيانات PS5 والحساب واتصال التلفاز المحفوظة، ويبدأ الإعداد من جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত PS5, অ্যাকাউন্ট ও TV সংযোগ মুছে যাবে এবং সেটআপ আবার শুরু থেকে হবে।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aalisin ang naka-save na PS5, account at koneksyon sa TV, at magsisimula muli ang setup."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव किया गया PS5, अकाउंट और TV कनेक्शन हटा दिए जाएँगे और सेटअप शुरू से शुरू होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5, akun, dan koneksi TV yang tersimpan akan dihapus, lalu penyiapan dimulai dari awal."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5, akaun dan sambungan TV yang disimpan akan dialih keluar dan persediaan bermula semula dari awal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bewaarde PS5, het account en de TV-verbinding worden verwijderd en de configuratie begint opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 บัญชี และการเชื่อมต่อ TV ที่บันทึกไว้จะถูกลบ และการตั้งค่าจะเริ่มใหม่ตั้งแต่ต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı PS5, hesap ve TV bağlantısı silinir; kurulum en baştan başlar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ شدہ PS5، اکاؤنٹ اور TV کنکشن ہٹا دیے جائیں گے اور سیٹ اپ شروع سے ہوگا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5, tài khoản và kết nối TV đã lưu sẽ bị xóa và quá trình thiết lập bắt đầu lại từ đầu."
          }
        }
      }
    },
    "Connect your TV first, then plug in" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربط التلفاز أولًا، ثم أدخل القابس"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রথমে আপনার TV সংযোগ করুন, তারপর প্লাগ ইন করুন"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikonekta muna ang iyong TV, saka isaksak"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले अपना TV कनेक्ट करें, फिर प्लग इन करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan TV Anda terlebih dahulu, lalu colokkan"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan TV anda dahulu, kemudian palamkan"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind eerst je TV en sluit dan aan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อ TV ก่อน แล้วจึงเสียบสาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce TV'nizi bağlayın, sonra fişi takın"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے اپنا TV جوڑیں، پھر پلگ لگائیں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kết nối TV trước, rồi cắm vào"
          }
        }
      }
    },
    "Bring Your Xbox to This Mac" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض جهاز Xbox على جهاز Mac هذا"
