        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওয়্যারলেস ডিবাগিংয়ে TV-র পোর্টও লিখুন: TV-র Wireless debugging স্ক্রিনের ওপরে থাকা “IP address & Port” (যেমন 192.168.1.20:41235)।"
          }
        },
        "en" : {
          "stringUnit" : {
