    "The Xboxes on your account. On the Xbox, turn on Settings › Devices & connections › Remote features." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجهزة Xbox في حسابك. على Xbox، فعّل الإعدادات › الأجهزة والاتصالات › الميزات عن بُعد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অ্যাকাউন্টের Xbox-গুলো। Xbox-এ Settings › Devices & connections › Remote features চালু করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Xboxes on your account. On the Xbox, turn on Settings › Devices & connections › Remote features."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga Xbox sa iyong account. Sa Xbox, i-on ang Settings › Devices & connections › Remote features."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके अकाउंट के Xbox। Xbox पर सेटिंग्स › डिवाइस और कनेक्शन › रिमोट फ़ीचर्स चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox di akun Anda. Di Xbox, aktifkan Settings › Devices & connections › Remote features."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox pada akaun anda. Pada Xbox, hidupkan Settings › Devices & connections › Remote features."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Xboxen op je account. Zet op de Xbox Instellingen › Apparaten en verbindingen › Externe functies aan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox ในบัญชีของคุณ บน Xbox ให้เปิด Settings › Devices & connections › Remote features"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızdaki Xbox'lar. Xbox'ta Ayarlar › Cihazlar ve bağlantılar › Uzak özellikler'i açın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے اکاؤنٹ پر موجود Xbox۔ Xbox پر Settings › Devices & connections › Remote features آن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các máy Xbox trong tài khoản của bạn. Trên Xbox, hãy bật Settings › Devices & connections › Remote features."
          }
        }
      }
    },
    "No Xbox found on this account. Sign in on your Xbox with the same account and turn on remote features." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على Xbox في هذا الحساب. سجّل الدخول على Xbox بالحساب نفسه وفعّل الميزات عن بُعد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অ্যাকাউন্টে কোনো Xbox পাওয়া যায়নি। একই অ্যাকাউন্ট দিয়ে Xbox-এ সাইন ইন করে রিমোট ফিচার চালু করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Xbox found on this account. Sign in on your Xbox with the same account and turn on remote features."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang nakitang Xbox sa account na ito. Mag-sign in sa Xbox gamit ang parehong account at i-on ang remote features."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस अकाउंट पर कोई Xbox नहीं मिला। अपने Xbox पर इसी अकाउंट से साइन इन करें और रिमोट फ़ीचर्स चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada Xbox di akun ini. Masuk di Xbox Anda dengan akun yang sama dan aktifkan fitur jarak jauh."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
