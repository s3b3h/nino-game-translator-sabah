        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino ikisiyle de çalışır. Sonra Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino دونوں کے ساتھ کام کرتا ہے۔ آپ اسے بعد میں Settings میں بدل سکتے ہیں۔"
