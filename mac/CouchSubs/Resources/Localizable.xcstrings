    "Start translation and play for a few minutes; Nino measures the connection while you play." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ الترجمة والعب لبضع دقائق؛ يقيس Nino الاتصال أثناء لعبك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুবাদ শুরু করে কয়েক মিনিট খেলুন; আপনি খেলার সময় Nino সংযোগ মাপে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start translation and play for a few minutes; Nino measures the connection while you play."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulan ang pagsasalin at maglaro nang ilang minuto; sinusukat ng Nino ang koneksyon habang naglalaro ka."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुवाद शुरू करें और कुछ मिनट खेलें; आपके खेलते समय Nino कनेक्शन मापता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai terjemahan dan bermainlah beberapa menit; Nino mengukur koneksi selama Anda bermain."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulakan terjemahan dan bermain selama beberapa minit; Nino mengukur sambungan semasa anda bermain."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin met vertalen en speel een paar minuten; Nino meet de verbinding terwijl je speelt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มแปลแล้วเล่นสักสองสามนาที Nino จะวัดการเชื่อมต่อขณะคุณเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çeviriyi başlatıp birkaç dakika oynayın; Nino bağlantıyı siz oynarken ölçer."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجمہ شروع کریں اور چند منٹ کھیلیں؛ Nino کھیلنے کے دوران کنکشن ناپتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy bắt đầu dịch và chơi vài phút; Nino sẽ đo kết nối trong lúc bạn chơi."
          }
        }
      }
    },
