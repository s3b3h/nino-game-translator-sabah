    "Online engines translate English games only. For other game languages the free translation is used." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تترجم المحركات عبر الإنترنت الألعاب الإنجليزية فقط. أما الألعاب بلغات أخرى فتُستخدم لها الترجمة المجانية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনলাইন ইঞ্জিন শুধু ইংরেজি গেম অনুবাদ করে। অন্য ভাষার গেমের জন্য বিনামূল্যের অনুবাদ ব্যবহার হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online engines translate English games only. For other game languages the free translation is used."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga English na laro lang ang isinasalin ng mga online engine. Para sa ibang wika ng laro, ginagamit ang libreng salin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑनलाइन इंजन सिर्फ़ अंग्रेज़ी गेम्स का अनुवाद करते हैं। दूसरी गेम भाषाओं के लिए मुफ़्त अनुवाद इस्तेमाल होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesin online hanya menerjemahkan game berbahasa Inggris. Untuk bahasa game lain, terjemahan gratis yang digunakan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjin dalam talian hanya menterjemah permainan bahasa Inggeris. Untuk bahasa permainan lain, terjemahan percuma digunakan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online vertaalmachines vertalen alleen Engelstalige games. Voor andere gametalen wordt de gratis vertaling gebruikt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
