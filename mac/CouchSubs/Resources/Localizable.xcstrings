          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-configure ang pahintulot sa local network para sa mga koneksyon sa TV at PS5 sa isang pinagkakatiwalaang Private network."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भरोसेमंद प्राइवेट नेटवर्क पर TV और PS5 कनेक्शन के लिए लोकल नेटवर्क अनुमति सेट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur izin jaringan lokal untuk koneksi TV dan PS5 di jaringan Pribadi yang tepercaya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurasikan kebenaran rangkaian setempat untuk sambungan TV dan PS5 pada rangkaian Peribadi yang dipercayai."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel toestemming voor het lokale netwerk in voor verbindingen met TV en PS5 op een vertrouwd privénetwerk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่าสิทธิ์เครือข่ายภายในสำหรับการเชื่อมต่อ TV และ PS5 บนเครือข่ายส่วนตัวที่เชื่อถือได้"
