    "No second account needed. Nino reads the game from the card and shows it with the translation on top." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا حاجة إلى حساب ثانٍ. يقرأ Nino اللعبة من البطاقة ويعرضها مع الترجمة فوقها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দ্বিতীয় অ্যাকাউন্ট লাগবে না। Nino কার্ড থেকে গেম পড়ে এবং ওপরে অনুবাদসহ দেখায়।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi kailangan ng pangalawang account. Binabasa ng Nino ang laro mula sa card at ipinapakita ito kasama ang salin sa ibabaw."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे अकाउंट की ज़रूरत नहीं। Nino कार्ड से गेम पढ़ता है और उसे ऊपर अनुवाद के साथ दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak perlu akun kedua. Nino membaca game dari card dan menampilkannya dengan terjemahan di atasnya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak perlu akaun kedua. Nino membaca permainan daripada kad dan memaparkannya bersama terjemahan di atasnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen tweede account nodig. Nino leest de game van de kaart en toont hem met de vertaling erbovenop."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องใช้บัญชีที่สอง Nino จะอ่านเกมจากการ์ดและแสดงพร้อมคำแปลซ้อนทับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkinci hesap gerekmez. Nino oyunu Capture Card'dan okur ve çeviriyle birlikte gösterir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوسرے اکاؤنٹ کی ضرورت نہیں۔ Nino کارڈ سے گیم پڑھتا ہے اور اوپر ترجمے کے ساتھ دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần tài khoản thứ hai. Nino đọc game từ card và hiển thị kèm bản dịch phía trên."
          }
        }
      }
    },
