            "value" : "ভুল পড়া লাইনের জন্য অপেক্ষা"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for a misread line"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintayin ang maling nabasang linya"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग़लत पढ़ी गई लाइन का इंतज़ार"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
