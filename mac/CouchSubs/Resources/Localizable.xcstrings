    "Translation is slow. Choose the Free engine in Settings › Translation and see whether it gets faster." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترجمة بطيئة. اختر المحرك المجاني من الإعدادات › الترجمة ولاحظ ما إذا كانت ستصبح أسرع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুবাদ ধীর। Settings › Translation-এ Free ইঞ্জিন বেছে নিন এবং দেখুন দ্রুত হয় কিনা।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
