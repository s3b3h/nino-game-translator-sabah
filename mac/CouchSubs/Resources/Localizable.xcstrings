            "value" : "कोई दूसरा ऐप %@ इस्तेमाल कर रहा है। वह ऐप खुला रहने तक यह शायद काम न करे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi lain sedang menggunakan %@. Mungkin tidak berfungsi selama aplikasi itu terbuka."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apl lain sedang menggunakan %@. Ia mungkin tidak berfungsi semasa apl itu dibuka."
          }
        },
