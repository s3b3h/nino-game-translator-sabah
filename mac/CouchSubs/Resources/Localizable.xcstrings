    "The sign-in window needs Microsoft's WebView2 component, which is missing on this computer. Install it from the page that just opened, then press Sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج نافذة تسجيل الدخول إلى مكوّن WebView2 من Microsoft، وهو غير موجود على هذا الكمبيوتر. ثبّته من الصفحة التي فُتحت للتو، ثم اضغط «تسجيل الدخول» مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাইন-ইন উইন্ডোর জন্য Microsoft-এর WebView2 কম্পোনেন্ট দরকার, যা এই কম্পিউটারে নেই। এইমাত্র খোলা পেজ থেকে এটি ইনস্টল করুন, তারপর আবার Sign in চাপুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in window needs Microsoft's WebView2 component, which is missing on this computer. Install it from the page that just opened, then press Sign in again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan ng sign-in window ang WebView2 component ng Microsoft, na wala sa computer na ito. I-install ito mula sa page na kabubukas lang, saka pindutin muli ang Mag-sign in."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन-इन विंडो को Microsoft का WebView2 कंपोनेंट चाहिए, जो इस कंप्यूटर पर नहीं है। अभी खुले पेज से उसे इंस्टॉल करें, फिर साइन इन करें फिर से दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jendela masuk memerlukan komponen WebView2 dari Microsoft, yang tidak ada di komputer ini. Instal dari halaman yang baru terbuka, lalu tekan Masuk lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetingkap log masuk memerlukan komponen WebView2 Microsoft, yang tiada pada komputer ini. Pasangnya daripada halaman yang baru dibuka, kemudian tekan Log masuk semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het inlogvenster heeft het WebView2-onderdeel van Microsoft nodig, dat op deze computer ontbreekt. Installeer het via de pagina die net is geopend en druk dan opnieuw op Log in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าต่างลงชื่อเข้าต้องใช้คอมโพเนนต์ WebView2 ของ Microsoft ซึ่งไม่มีในคอมพิวเตอร์เครื่องนี้ โปรดติดตั้งจากหน้าที่เพิ่งเปิดขึ้น แล้วกด ลงชื่อเข้า อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş penceresi için Microsoft'un WebView2 bileşeni gerekiyor ama bu bilgisayarda yok. Az önce açılan sayfadan kurun, sonra yeniden Giriş yap'a basın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سائن اِن ونڈو کو Microsoft کا WebView2 جزو درکار ہے، جو اس کمپیوٹر پر موجود نہیں۔ ابھی کھلنے والے صفحے سے اسے انسٹال کریں، پھر دوبارہ Sign in دبائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ đăng nhập cần thành phần WebView2 của Microsoft, nhưng máy tính này chưa có. Hãy cài từ trang vừa mở, rồi bấm Đăng nhập lại."
          }
        }
      }
    },
