        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بند ہونے پر ہر نئی لائن پچھلی کی جگہ لے لیتی ہے۔ TV ایپ 0.9.16 یا نیا ورژن درکار ہے۔"
