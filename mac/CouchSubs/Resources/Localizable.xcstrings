    "The sign-in window needs Microsoft's WebView2 component, which is missing on this computer. Install it from the page that just opened, then press Sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج نافذة تسجيل الدخول إلى مكوّن WebView2 من Microsoft، وهو غير موجود على هذا الكمبيوتر. ثبّته من الصفحة التي فُتحت للتو، ثم اضغط «تسجيل الدخول» مجددًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in window needs Microsoft's WebView2 component, which is missing on this computer. Install it from the page that just opened, then press Sign in again."
          }
