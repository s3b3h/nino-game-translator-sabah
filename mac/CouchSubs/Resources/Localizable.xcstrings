      }
    },
    "Sony's answer could not be read. Sign in again; if it keeps happening, update Nino." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sony's answer could not be read. Sign in again; if it keeps happening, update Nino."
