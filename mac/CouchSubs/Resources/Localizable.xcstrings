    "Translation from %@ to %@ is not available on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترجمة من %@ إلى %@ غير متاحة على جهاز Mac هذا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই Mac-এ %@ থেকে %@-তে অনুবাদ পাওয়া যায় না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translation from %@ to %@ is not available on this Mac."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi available sa Mac na ito ang pagsasalin mula %@ papuntang %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Mac पर %@ से %@ में अनुवाद उपलब्ध नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan dari %@ ke %@ tidak tersedia di Mac ini."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan daripada %@ ke %@ tidak tersedia pada Mac ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertalen van %@ naar %@ is niet beschikbaar op deze Mac."
