        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proses masuk Samsung tidak selesai. Coba lagi dan selesaikan proses masuk di halaman yang terbuka."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log masuk Samsung tidak selesai. Cuba lagi dan selesaikan log masuk pada halaman yang dibuka."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggen bij Samsung is niet voltooid. Probeer het opnieuw en rond het inloggen af op de pagina die opent."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลงชื่อเข้า Samsung ไม่สำเร็จ โปรดลองอีกครั้งและลงชื่อเข้าให้เสร็จในหน้าที่เปิดขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung girişi tamamlanmadı. Tekrar deneyin ve açılan sayfada girişi bitirin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung سائن اِن مکمل نہیں ہوا۔ دوبارہ کوشش کریں اور کھلنے والے صفحے پر سائن اِن مکمل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập Samsung chưa hoàn tất. Hãy thử lại và đăng nhập xong trên trang mở ra."
          }
        }
      }
    },
    "Samsung signs the app for your TV. Sign in with your Samsung account on the page that opened in your browser." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقّع Samsung التطبيق لتلفازك. سجّل الدخول بحساب Samsung في الصفحة التي فُتحت في متصفحك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung আপনার TV-র জন্য অ্যাপটি সাইন করে। আপনার ব্রাউজারে খোলা পেজে Samsung অ্যাকাউন্ট দিয়ে সাইন ইন করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung signs the app for your TV. Sign in with your Samsung account on the page that opened in your browser."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinipirmahan ng Samsung ang app para sa iyong TV. Mag-sign in gamit ang iyong Samsung account sa page na bumukas sa iyong browser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung आपके TV के लिए ऐप साइन करता है। आपके ब्राउज़र में खुले पेज पर अपने Samsung अकाउंट से साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung menandatangani aplikasi untuk TV Anda. Masuk dengan akun Samsung Anda di halaman yang terbuka di browser."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung menandatangani aplikasi untuk TV anda. Log masuk dengan akaun Samsung anda pada halaman yang dibuka dalam pelayar anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung ondertekent de app voor je TV. Log in met je Samsung-account op de pagina die in je browser is geopend."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung จะลงนามแอปสำหรับ TV ของคุณ โปรดลงชื่อเข้าด้วยบัญชี Samsung ในหน้าที่เปิดขึ้นในเบราว์เซอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung, uygulamayı TV'nize özel imzalar. Tarayıcıda açılan sayfada Samsung hesabınızla giriş yapın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung آپ کے TV کے لیے ایپ سائن کرتا ہے۔ براؤزر میں کھلے صفحے پر اپنے Samsung اکاؤنٹ سے سائن اِن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung ký ứng dụng cho TV của bạn. Hãy đăng nhập bằng tài khoản Samsung trên trang vừa mở trong trình duyệt."
          }
        }
      }
    },
