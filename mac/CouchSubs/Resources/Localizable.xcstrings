        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट से कनेक्ट नहीं हो सका। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat terhubung ke internet. Periksa koneksi Anda dan coba lagi."
