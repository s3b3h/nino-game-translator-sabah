          }
        }
      }
    },
    "Xbox: open Greenlight or xbox.com/play › My consoles in your browser and sign in with your Microsoft account. Nino reads that window and shows the translation on top." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: افتح Greenlight أو xbox.com/play › أجهزتي في المتصفح وسجّل الدخول بحساب Microsoft. يقرأ Nino تلك النافذة ويعرض الترجمة فوقها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: আপনার ব্রাউজারে Greenlight বা xbox.com/play › My consoles খুলুন এবং Microsoft অ্যাকাউন্ট দিয়ে সাইন ইন করুন। Nino সেই উইন্ডোটি পড়ে এবং ওপরে অনুবাদ দেখায়।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: buksan ang Greenlight o xbox.com/play › My consoles sa iyong browser at mag-sign in gamit ang iyong Microsoft account. Binabasa ng Nino ang window na iyon at ipinapakita ang salin sa ibabaw."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: अपने ब्राउज़र में Greenlight या xbox.com/play › My consoles खोलें और अपने Microsoft अकाउंट से साइन इन करें। Nino उस विंडो को पढ़ता है और ऊपर अनुवाद दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: buka Greenlight atau xbox.com/play › Konsol saya di browser Anda dan masuk dengan akun Microsoft Anda. Nino membaca jendela tersebut dan menampilkan terjemahan di atasnya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: buka Greenlight atau xbox.com/play › My consoles dalam pelayar anda dan log masuk dengan akaun Microsoft anda. Nino membaca tetingkap itu dan memaparkan terjemahan di atasnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: open Greenlight of xbox.com/play › Mijn consoles in je browser en log in met je Microsoft-account. Nino leest dat venster en toont de vertaling erbovenop."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: เปิด Greenlight หรือ xbox.com/play › คอนโซลของฉัน ในเบราว์เซอร์ แล้วลงชื่อเข้าด้วยบัญชี Microsoft ของคุณ Nino จะอ่านหน้าต่างนั้นและแสดงคำแปลซ้อนทับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: Greenlight'ı ya da tarayıcıda xbox.com/play › Konsollarım'ı açın ve Microsoft hesabınızla giriş yapın. Nino o pencereyi okur ve çeviriyi üstünde gösterir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: براؤزر میں Greenlight یا xbox.com/play › My consoles کھولیں اور اپنے Microsoft اکاؤنٹ سے سائن اِن کریں۔ Nino وہ ونڈو پڑھتا ہے اور ترجمہ اوپر دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox: mở Greenlight hoặc xbox.com/play › Bảng điều khiển của tôi trong trình duyệt và đăng nhập bằng tài khoản Microsoft. Nino đọc cửa sổ đó và hiển thị bản dịch phía trên."
          }
        }
      }
    },
