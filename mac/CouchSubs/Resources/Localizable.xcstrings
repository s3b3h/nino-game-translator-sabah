    "Lines that are not in a pack go to the shared pool with the game's name, so its ready translation comes sooner." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذهب السطور غير الموجودة في حزمة إلى المجموعة المشتركة باسم اللعبة، فتصل ترجمتها الجاهزة أسرع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যে লাইনগুলো কোনো প্যাকে নেই সেগুলো গেমের নামসহ শেয়ার্ড পুলে যায়, ফলে এর তৈরি অনুবাদ আরও তাড়াতাড়ি আসে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lines that are not in a pack go to the shared pool with the game's name, so its ready translation comes sooner."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napupunta sa shared pool, kasama ang pangalan ng laro, ang mga linyang wala sa isang pack, kaya mas maagang darating ang handang salin nito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो लाइनें किसी पैक में नहीं हैं, वे गेम के नाम के साथ साझा पूल में जाती हैं, ताकि उसका तैयार अनुवाद जल्दी आए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris yang tidak ada di paket masuk ke kumpulan bersama dengan nama game, jadi terjemahan siapnya datang lebih cepat."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris yang tiada dalam pek dihantar ke kumpulan kongsi dengan nama permainan, jadi terjemahan siapnya tiba lebih cepat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regels die niet in een pakket staan, gaan naar de gedeelde pool met de naam van de game, zodat de kant-en-klare vertaling sneller komt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บรรทัดที่ไม่มีในแพ็กจะส่งไปยังคลังกลางพร้อมชื่อเกม เพื่อให้มีคำแปลสำเร็จรูปของเกมนั้นเร็วขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakette olmayan satırlar oyunun adıyla ortak havuza gider; böylece oyunun hazır çevirisi daha çabuk çıkar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو لائنیں کسی پیک میں نہیں وہ گیم کے نام کے ساتھ مشترکہ پول میں جاتی ہیں، تاکہ اس کا تیار ترجمہ جلد آئے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các câu không có trong gói sẽ vào kho chung theo tên game, để bản dịch sẵn có đến sớm hơn."
          }
        }
      }
    },
