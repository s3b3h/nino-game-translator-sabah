        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাকাউন্ট আইডি নিজে লিখুন"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter account ID manually"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilagay nang mano-mano ang account ID"
          }
        },
