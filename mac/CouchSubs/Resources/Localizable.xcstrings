    "Nino connects to the PS5 with the second account. Sony's PS Remote Play can't be used at the same time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل Nino بـ PS5 عبر الحساب الثاني. لا يمكن استخدام PS Remote Play من Sony في الوقت نفسه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino দ্বিতীয় অ্যাকাউন্ট দিয়ে PS5-এ সংযোগ করে। একই সময়ে Sony-র PS Remote Play ব্যবহার করা যায় না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino connects to the PS5 with the second account. Sony's PS Remote Play can't be used at the same time."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumokonekta ang Nino sa PS5 gamit ang pangalawang account. Hindi puwedeng sabay na gamitin ang PS Remote Play ng Sony."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino दूसरे अकाउंट से PS5 से कनेक्ट होता है। Sony का PS Remote Play साथ-साथ इस्तेमाल नहीं हो सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino terhubung ke PS5 dengan akun kedua. PS Remote Play dari Sony tidak bisa dipakai bersamaan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino menyambung ke PS5 dengan akaun kedua. PS Remote Play Sony tidak boleh digunakan pada masa yang sama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino maakt verbinding met de PS5 via het tweede account. PS Remote Play van Sony kan niet tegelijk worden gebruikt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino เชื่อมต่อกับ PS5 ด้วยบัญชีที่สอง ใช้ PS Remote Play ของ Sony พร้อมกันไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino PS5'e ikinci hesapla kendisi bağlanır. Bu sırada Sony'nin PS Remote Play uygulaması kullanılamaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino دوسرے اکاؤنٹ سے PS5 سے جڑتا ہے۔ اس دوران Sony کا PS Remote Play استعمال نہیں ہو سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino kết nối với PS5 bằng tài khoản phụ. Không thể dùng PS Remote Play của Sony cùng lúc."
          }
        }
      }
    },
    "Allow Screen Recording for Nino in System Settings › Privacy & Security, then start again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بتسجيل الشاشة لـ Nino في إعدادات النظام › الخصوصية والأمان، ثم ابدأ من جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Settings › Privacy & Security-তে Nino-র জন্য Screen Recording-এর অনুমতি দিন, তারপর আবার শুরু করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Screen Recording for Nino in System Settings › Privacy & Security, then start again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang Screen Recording para sa Nino sa System Settings › Privacy & Security, saka magsimula ulit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्स › गोपनीयता और सुरक्षा में Nino के लिए स्क्रीन रिकॉर्डिंग की अनुमति दें, फिर से शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Perekaman Layar untuk Nino di Pengaturan Sistem › Privasi & Keamanan, lalu mulai lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan Rakaman Skrin untuk Nino dalam Tetapan Sistem › Privasi & Keselamatan, kemudian mulakan semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Schermopname toe voor Nino in Systeeminstellingen › Privacy en beveiliging en start opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตการบันทึกหน้าจอให้ Nino ใน การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย แล้วเริ่มใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları › Gizlilik ve Güvenlik › Ekran ve Sistem Ses Kaydı'nda Nino'ya izin ver, sonra yeniden başlat."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Settings › Privacy & Security میں Nino کے لیے Screen Recording کی اجازت دیں، پھر دوبارہ شروع کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho phép Ghi màn hình cho Nino trong Cài đặt hệ thống › Quyền riêng tư & Bảo mật, rồi bắt đầu lại."
          }
        }
      }
    },
