    "If no pack recognises the game, asked once two minutes after translation starts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم تتعرّف أي حزمة على اللعبة، يُطرح السؤال مرة واحدة بعد دقيقتين من بدء الترجمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো প্যাক গেমটি চিনতে না পারলে, অনুবাদ শুরুর দুই মিনিট পরে একবার জিজ্ঞেস করা হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If no pack recognises the game, asked once two minutes after translation starts."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung walang pack na nakakakilala sa laro, itatanong nang isang beses dalawang minuto pagkasimula ng pagsasalin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर कोई पैक गेम नहीं पहचानता, तो अनुवाद शुरू होने के दो मिनट बाद एक बार पूछा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tidak ada paket yang mengenali game, ditanyakan sekali dua menit setelah terjemahan dimulai."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tiada pek yang mengenali permainan, ditanya sekali dua minit selepas terjemahan bermula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als geen enkel pakket de game herkent, wordt het één keer gevraagd, twee minuten nadat het vertalen is gestart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่มีแพ็กใดรู้จักเกมนี้ จะถามหนึ่งครั้งหลังเริ่มแปลได้สองนาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyun paketle tanınmazsa çeviri başladıktan iki dakika sonra bir kez sorulur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر کوئی پیک گیم نہ پہچانے تو ترجمہ شروع ہونے کے دو منٹ بعد ایک بار پوچھا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không có gói nào nhận ra game, Nino sẽ hỏi một lần sau khi bắt đầu dịch hai phút."
          }
        }
      }
    },
