    "Local-network permission is ready for Nino on Private networks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذن الشبكة المحلية جاهز لـ Nino على الشبكات الخاصة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private নেটওয়ার্কে Nino-র জন্য লোকাল নেটওয়ার্ক অনুমতি প্রস্তুত।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local-network permission is ready for Nino on Private networks."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handa na ang pahintulot sa local network para sa Nino sa mga Private network."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्राइवेट नेटवर्क पर Nino के लिए लोकल नेटवर्क अनुमति तैयार है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin jaringan lokal siap untuk Nino di jaringan Pribadi."
          }
