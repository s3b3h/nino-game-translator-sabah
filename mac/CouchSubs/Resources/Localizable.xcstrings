          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुवाद धीमा है। इस Mac पर दूसरे भारी ऐप्स बंद करें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan lambat. Tutup aplikasi berat lainnya di Mac ini dan coba lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan perlahan. Tutup aplikasi berat lain pada Mac ini dan cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het vertalen gaat langzaam. Sluit andere zware apps op deze Mac en probeer het opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแปลช้า โปรดปิดแอปอื่นที่ใช้ทรัพยากรมากบน Mac เครื่องนี้แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çeviri yavaş. Bu Mac'te açık olan ağır uygulamaları kapatıp yeniden deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجمہ سست ہے۔ اس Mac پر دوسری بھاری ایپس بند کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch đang chậm. Hãy đóng các ứng dụng nặng khác trên máy Mac này và thử lại."
          }
        }
      }
    },
    "Nino reads the PS5's English subtitles and shows them in Turkish on your TV." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Nino النصوص الإنجليزية من PS5 ويعرضها مترجمةً على تلفازك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino PS5-এর ইংরেজি সাবটাইটেল পড়ে এবং আপনার TV-তে তুর্কিতে দেখায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino reads the PS5's English subtitles and shows them in Turkish on your TV."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabasa ng Nino ang mga English na subtitle ng PS5 at ipinapakita ang mga ito sa Turkish sa iyong TV."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, PS5 के अंग्रेज़ी सबटाइटल पढ़ता है और उन्हें आपके TV पर तुर्की में दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca subtitle bahasa Inggris dari PS5 dan menampilkannya dalam bahasa Turki di TV Anda."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca sari kata bahasa Inggeris PS5 dan memaparkannya dalam bahasa Turki pada TV anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino leest de Engelse ondertitels van de PS5 en toont ze in het Turks op je TV."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino อ่านคำบรรยายภาษาอังกฤษจาก PS5 แล้วแสดงเป็นภาษาตุรกีบน TV ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, PS5'teki İngilizce altyazıyı okur ve TV'nizde Türkçe gösterir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino، PS5 کے انگریزی سب ٹائٹلز پڑھتا ہے اور انہیں آپ کے TV پر ترکی میں دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino đọc phụ đề tiếng Anh của PS5 và hiển thị bằng tiếng Thổ Nhĩ Kỳ trên TV của bạn."
