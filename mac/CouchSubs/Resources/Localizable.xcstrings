    "Reset everything" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة تعيين كل شيء"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset everything"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şeyi sıfırla"
          }
        }
      }
    },
    "From the TV: your PS5 account and PS5 pairing stay; only the TV connection is set up again. Reset everything: the saved PS5, account and TV connection are removed and you sign in to PSN again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدءًا من التلفاز: يبقى حساب PS5 وإقران PS5، ويُعاد إعداد اتصال التلفاز فقط. إعادة تعيين كل شيء: يُحذف PS5 المحفوظ والحساب واتصال التلفاز، وتسجّل الدخول إلى PSN من جديد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From the TV: your PS5 account and PS5 pairing stay; only the TV connection is set up again. Reset everything: the saved PS5, account and TV connection are removed and you sign in to PSN again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV'den itibaren: PS5 hesabınız ve PS5 eşleşmesi kalır, yalnız TV bağlantısı yeniden kurulur. Her şeyi sıfırla: kayıtlı PS5, hesap ve TV bağlantısı silinir, PSN'e yeniden giriş yaparsınız."
          }
        }
      }
    },
    "Nino downloads the update, installs it and opens again. Your settings stay." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينزّل Nino التحديث ويثبّته ثم يُفتح من جديد. ستبقى إعداداتك كما هي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino downloads the update, installs it and opens again. Your settings stay."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino güncellemeyi indirir, kurar ve yeniden açılır. Ayarlarınız kalır."
          }
        }
      }
    },
    "Nino checks for new versions by itself and installs them in the background; the new version opens the next time you start Nino." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق Nino من الإصدارات الجديدة تلقائيًا ويثبّتها في الخلفية؛ ويُفتح الإصدار الجديد في المرة التالية التي تشغّل فيها Nino."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino checks for new versions by itself and installs them in the background; the new version opens the next time you start Nino."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino yeni sürümleri kendisi denetler ve arka planda kurar; yeni sürüm Nino'yu bir sonraki açışınızda gelir."
          }
        }
      }
    },
    "Game picture from" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
