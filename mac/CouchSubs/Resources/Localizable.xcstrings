    "Adjust the frame so it covers where the game shows its subtitles." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط الإطار ليغطي المكان الذي تعرض فيه اللعبة نصوصها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফ্রেমটি এমনভাবে ঠিক করুন যাতে গেম যেখানে সাবটাইটেল দেখায় সেই জায়গা ঢেকে যায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust the frame so it covers where the game shows its subtitles."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayusin ang frame para matakpan nito kung saan ipinapakita ng laro ang mga subtitle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्रेम को ऐसे सेट करें कि वह उस जगह को ढके जहाँ गेम अपने सबटाइटल दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan bingkai agar menutupi area tempat game menampilkan subtitlenya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laraskan bingkai supaya ia meliputi tempat permainan memaparkan sari katanya."
