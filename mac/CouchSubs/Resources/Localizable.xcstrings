            "value" : "Nino berfungsi dengan kedua-duanya. Anda boleh menukarnya kemudian dalam Tetapan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino werkt met allebei. Je kunt dit later wijzigen in Instellingen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino ใช้ได้กับทั้งสองแบบ คุณเปลี่ยนได้ภายหลังในการตั้งค่า"
          }
