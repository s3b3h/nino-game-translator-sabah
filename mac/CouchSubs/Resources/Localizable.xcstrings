    "Allow Nino in System Settings › Privacy & Security › Camera, then reopen Nino." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Nino في إعدادات النظام › الخصوصية والأمن › الكاميرا، ثم أعد فتح Nino."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Settings › Privacy & Security › Camera-তে Nino-কে অনুমতি দিন, তারপর Nino আবার খুলুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang Nino sa System Settings › Privacy & Security › Camera, saka buksan muli ang Nino."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्स › गोपनीयता और सुरक्षा › कैमरा में Nino को अनुमति दें, फिर Nino दोबारा खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Nino di Pengaturan Sistem › Privasi & Keamanan › Kamera, lalu buka ulang Nino."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan Nino dalam System Settings › Privacy & Security › Camera, kemudian buka semula Nino."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Nino toe in Systeeminstellingen › Privacy en beveiliging › Camera en open Nino dan opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาต Nino ใน การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › กล้อง แล้วเปิด Nino ใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları › Gizlilik ve Güvenlik › Kamera'da Nino'ya izin verin, sonra Nino'yu yeniden açın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Settings › Privacy & Security › Camera میں Nino کو اجازت دیں، پھر Nino دوبارہ کھولیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho phép Nino trong Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Camera, rồi mở lại Nino."
          }
        }
      }
    },
    "Plug in your capture card" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
