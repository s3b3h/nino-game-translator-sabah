    },
    "Nino reads your Xbox picture from a window on this Mac. You only set this up once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Nino صورة Xbox من نافذة على جهاز Mac هذا. تضبط ذلك مرة واحدة فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino এই Mac-এর একটি উইন্ডো থেকে আপনার Xbox-এর ছবি পড়ে। এটি আপনাকে একবারই সেট আপ করতে হবে।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabasa ng Nino ang larawan ng iyong Xbox mula sa isang window sa Mac na ito. Isang beses mo lang itong ise-set up."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino इस Mac की एक विंडो से आपके Xbox की तस्वीर पढ़ता है। यह सेटअप सिर्फ़ एक बार करना होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca gambar Xbox Anda dari sebuah jendela di Mac ini. Anda cukup menyiapkannya sekali."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca gambar Xbox anda daripada tetingkap pada Mac ini. Anda hanya perlu menyediakannya sekali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino leest het beeld van je Xbox uit een venster op deze Mac. Je stelt dit maar één keer in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino อ่านภาพจาก Xbox ผ่านหน้าต่างบน Mac เครื่องนี้ ตั้งค่าเพียงครั้งเดียวเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, Xbox görüntünüzü bu Mac'teki bir pencereden okur. Bunu yalnızca bir kez ayarlarsınız."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino اس Mac کی ایک ونڈو سے آپ کے Xbox کی تصویر پڑھتا ہے۔ یہ سیٹ اپ صرف ایک بار کرنا ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino đọc hình ảnh Xbox của bạn từ một cửa sổ trên máy Mac này. Bạn chỉ cần thiết lập một lần."
          }
        }
      }
    },
