    "The firewall rule was not added. Try again and choose Yes when Windows asks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُضَف قاعدة جدار الحماية. حاول مجددًا واختر «نعم» عندما يطلب Windows ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফায়ারওয়াল নিয়ম যোগ হয়নি। আবার চেষ্টা করুন এবং Windows জিজ্ঞেস করলে Yes বেছে নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The firewall rule was not added. Try again and choose Yes when Windows asks."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi naidagdag ang firewall rule. Subukang muli at piliin ang Yes kapag nagtanong ang Windows."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ायरवॉल नियम नहीं जुड़ा। फिर से कोशिश करें और जब Windows पूछे तो Yes चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aturan firewall tidak ditambahkan. Coba lagi dan pilih Ya saat Windows bertanya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peraturan tembok api tidak ditambah. Cuba lagi dan pilih Yes apabila Windows bertanya."
