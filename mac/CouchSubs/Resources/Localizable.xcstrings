    },
    "Nino works with both. You can change it later in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Nino مع كليهما، ويمكنك تغيير ذلك لاحقًا من الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino দুটোতেই কাজ করে। পরে Settings-এ এটি বদলাতে পারবেন।"
          }
        },
        "fil" : {
          "stringUnit" : {
