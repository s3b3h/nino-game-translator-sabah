    "Stream your Xbox to this computer with Greenlight or xbox.com/play. Nino reads that window and shows the translation on top." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بُثّ جهاز Xbox إلى هذا الحاسوب عبر Greenlight أو xbox.com/play. يقرأ Nino تلك النافذة ويعرض الترجمة فوقها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight বা xbox.com/play দিয়ে আপনার Xbox এই কম্পিউটারে স্ট্রিম করুন। Nino সেই উইন্ডোটি পড়ে এবং ওপরে অনুবাদ দেখায়।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-stream ang iyong Xbox sa computer na ito gamit ang Greenlight o xbox.com/play. Binabasa ng Nino ang window na iyon at ipinapakita ang salin sa ibabaw."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight या xbox.com/play से अपना Xbox इस कंप्यूटर पर स्ट्रीम करें। Nino उस विंडो को पढ़ता है और ऊपर अनुवाद दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming Xbox Anda ke komputer ini dengan Greenlight atau xbox.com/play. Nino membaca jendela tersebut dan menampilkan terjemahan di atasnya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strim Xbox anda ke komputer ini dengan Greenlight atau xbox.com/play. Nino membaca tetingkap itu dan memaparkan terjemahan di atasnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream je Xbox naar deze computer met Greenlight of xbox.com/play. Nino leest dat venster en toont de vertaling erbovenop."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สตรีม Xbox มาที่คอมพิวเตอร์เครื่องนี้ด้วย Greenlight หรือ xbox.com/play แล้ว Nino จะอ่านหน้าต่างนั้นและแสดงคำแปลซ้อนทับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox'ınızı Greenlight ya da xbox.com/play ile bu bilgisayara yayınlayın. Nino o pencereyi okur ve çeviriyi üstünde gösterir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greenlight یا xbox.com/play سے اپنا Xbox اس کمپیوٹر پر اسٹریم کریں۔ Nino وہ ونڈو پڑھتا ہے اور ترجمہ اوپر دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truyền Xbox tới máy tính này bằng Greenlight hoặc xbox.com/play. Nino đọc cửa sổ đó và hiển thị bản dịch phía trên."
          }
        }
      }
    },
    "%@ was damaged while downloading. Try again." : {
