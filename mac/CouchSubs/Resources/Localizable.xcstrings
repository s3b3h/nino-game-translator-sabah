    "Samsung did not issue the signing certificate. Try again in a few minutes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُصدر Samsung شهادة التوقيع. حاول مجددًا بعد بضع دقائق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung সাইনিং সার্টিফিকেট দেয়নি। কয়েক মিনিট পরে আবার চেষ্টা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung did not issue the signing certificate. Try again in a few minutes."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi naglabas ang Samsung ng signing certificate. Subukang muli pagkalipas ng ilang minuto."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung ने साइनिंग सर्टिफ़िकेट जारी नहीं किया। कुछ मिनट बाद फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung tidak menerbitkan sertifikat penandatanganan. Coba lagi dalam beberapa menit."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung tidak mengeluarkan sijil tandatangan. Cuba lagi dalam beberapa minit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung heeft het ondertekeningscertificaat niet uitgegeven. Probeer het over een paar minuten opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung ไม่ได้ออกใบรับรองการลงนาม โปรดลองอีกครั้งในอีกไม่กี่นาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung imza sertifikasını vermedi. Birkaç dakika sonra tekrar deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung نے سائننگ سرٹیفکیٹ جاری نہیں کیا۔ چند منٹ بعد دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung chưa cấp chứng chỉ ký. Vui lòng thử lại sau vài phút."
          }
        }
      }
    },
    "Samsung sign-in did not complete. Try again and finish signing in on the page that opens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكتمل تسجيل الدخول إلى Samsung. حاول مجددًا وأكمل تسجيل الدخول في الصفحة التي تُفتح."
          }
        },
        "bn" : {
          "stringUnit" : {
