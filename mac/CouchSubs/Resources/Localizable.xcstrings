    },
    "The TV is out of free space. Remove an app you do not use from the TV and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد مساحة فارغة على التلفاز. احذف تطبيقًا لا تستخدمه من التلفاز وحاول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV-তে খালি জায়গা নেই। TV থেকে ব্যবহার না করা একটি অ্যাপ সরিয়ে আবার চেষ্টা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV is out of free space. Remove an app you do not use from the TV and try again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala nang libreng espasyo ang TV. Mag-alis ng app na hindi mo ginagamit sa TV at subukang muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV में खाली जगह नहीं बची है। TV से कोई ऐसा ऐप हटाएँ जिसे आप इस्तेमाल नहीं करते और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang penyimpanan TV penuh. Hapus aplikasi yang tidak Anda gunakan dari TV dan coba lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang kosong TV telah habis. Alih keluar aplikasi yang tidak anda gunakan daripada TV dan cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De TV heeft geen vrije ruimte meer. Verwijder een app die je niet gebruikt van de TV en probeer het opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่ว่างบน TV เต็มแล้ว โปรดลบแอปที่ไม่ได้ใช้ออกจาก TV แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV'de boş alan kalmadı. Kullanmadığınız bir uygulamayı TV'den kaldırıp tekrar deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV میں جگہ ختم ہو گئی ہے۔ TV سے کوئی غیر استعمال شدہ ایپ ہٹائیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV đã hết dung lượng trống. Hãy gỡ một ứng dụng bạn không dùng khỏi TV và thử lại."
          }
        }
      }
    },
    "The TV app could not be installed. Try again; if it fails again, send us the reason below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تثبيت تطبيق التلفاز. حاول مجددًا؛ وإن فشل مرة أخرى، أرسل إلينا السبب أدناه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV অ্যাপ ইনস্টল করা যায়নি। আবার চেষ্টা করুন; আবারও ব্যর্থ হলে নিচের কারণটি আমাদের পাঠান।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV app could not be installed. Try again; if it fails again, send us the reason below."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ma-install ang TV app. Subukang muli; kung pumalya ulit, ipadala sa amin ang dahilan sa ibaba."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV ऐप इंस्टॉल नहीं हो सका। फिर से कोशिश करें; अगर फिर भी न हो, तो हमें नीचे दिया गया कारण भेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi TV tidak dapat diinstal. Coba lagi; jika gagal lagi, kirimkan alasan di bawah kepada kami."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi TV tidak dapat dipasang. Cuba lagi; jika gagal lagi, hantarkan sebab di bawah kepada kami."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de TV-app niet installeren. Probeer het opnieuw; lukt het weer niet, stuur ons dan de reden hieronder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถติดตั้งแอป TV ได้ โปรดลองอีกครั้ง หากยังไม่สำเร็จ โปรดส่งสาเหตุด้านล่างมาให้เรา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV uygulaması kurulamadı. Tekrar deneyin; yine olmazsa aşağıdaki nedeni bize gönderin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV ایپ انسٹال نہیں ہو سکی۔ دوبارہ کوشش کریں؛ اگر پھر ناکام ہو تو نیچے دی گئی وجہ ہمیں بھیجیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể cài ứng dụng TV. Hãy thử lại; nếu vẫn lỗi, hãy gửi cho chúng tôi lý do bên dưới."
          }
        }
      }
    },
    "The TV app is not installed. Nino can install it once Developer Mode is on." : {
