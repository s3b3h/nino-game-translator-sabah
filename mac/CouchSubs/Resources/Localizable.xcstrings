    "No TV or second account needed. Nino reads the Remote Play window and shows the translation on top of the game." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا حاجة إلى تلفاز أو حساب ثانٍ. يقرأ Nino نافذة Remote Play ويعرض الترجمة فوق اللعبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV বা দ্বিতীয় অ্যাকাউন্ট লাগবে না। Nino Remote Play উইন্ডো পড়ে এবং গেমের ওপরে অনুবাদ দেখায়।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi kailangan ng TV o pangalawang account. Binabasa ng Nino ang window ng Remote Play at ipinapakita ang salin sa ibabaw ng laro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV या दूसरे अकाउंट की ज़रूरत नहीं। Nino, Remote Play विंडो को पढ़ता है और गेम के ऊपर अनुवाद दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak perlu TV atau akun kedua. Nino membaca jendela Remote Play dan menampilkan terjemahan di atas game."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak perlu TV atau akaun kedua. Nino membaca tetingkap Remote Play dan memaparkan terjemahan di atas permainan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen TV of tweede account nodig. Nino leest het Remote Play-venster en toont de vertaling boven op de game."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องใช้ TV หรือบัญชีที่สอง Nino จะอ่านหน้าต่าง Remote Play และแสดงคำแปลซ้อนทับเกม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV ya da ikinci hesap gerekmez. Nino Remote Play penceresini okur ve çeviriyi oyunun üstünde gösterir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV یا دوسرے اکاؤنٹ کی ضرورت نہیں۔ Nino، Remote Play ونڈو پڑھتا ہے اور گیم کے اوپر ترجمہ دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần TV hay tài khoản thứ hai. Nino đọc cửa sổ Remote Play và hiển thị bản dịch trên game."
          }
        }
      }
    },
    "Nino reads the English subtitles of your PS5 games and shows an Arabic translation on your TV, on top of the game. You keep playing on the TV with your own controller." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Nino النصوص الإنجليزية في ألعاب PS5 ويعرض ترجمتها العربية على التلفاز فوق اللعبة، وتواصل اللعب على التلفاز بيد التحكم الخاصة بك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino আপনার PS5 গেমের ইংরেজি সাবটাইটেল পড়ে এবং গেমের ওপরে আপনার TV-তে আরবি অনুবাদ দেখায়। আপনি নিজের কন্ট্রোলার দিয়ে TV-তে খেলা চালিয়ে যান।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabasa ng Nino ang mga English na subtitle ng iyong mga PS5 game at ipinapakita ang Arabic na salin sa iyong TV, sa ibabaw ng laro. Patuloy kang naglalaro sa TV gamit ang sarili mong controller."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino आपके PS5 गेम्स के अंग्रेज़ी सबटाइटल पढ़ता है और गेम के ऊपर आपके TV पर अरबी अनुवाद दिखाता है। आप अपने कंट्रोलर से TV पर खेलते रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca subtitle bahasa Inggris dari game PS5 Anda dan menampilkan terjemahan bahasa Arab di TV Anda, di atas game. Anda tetap bermain di TV dengan kontroler Anda sendiri."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca sari kata bahasa Inggeris permainan PS5 anda dan memaparkan terjemahan bahasa Arab pada TV anda, di atas permainan. Anda terus bermain pada TV dengan alat kawalan anda sendiri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino leest de Engelse ondertitels van je PS5-games en toont een Arabische vertaling op je TV, boven op de game. Je blijft op de TV spelen met je eigen controller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino อ่านคำบรรยายภาษาอังกฤษจากเกม PS5 ของคุณ แล้วแสดงคำแปลภาษาอาหรับบน TV ซ้อนทับเกม คุณเล่นต่อบน TV ด้วยคอนโทรลเลอร์ของคุณเองได้ตามปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, PS5 oyunlarının İngilizce altyazılarını okur ve Arapça çevirisini TV'de oyunun üstünde gösterir. Siz de TV'de kendi joystick'inizle oynamaya devam edersiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino آپ کے PS5 گیمز کے انگریزی سب ٹائٹلز پڑھتا ہے اور گیم کے اوپر آپ کے TV پر عربی ترجمہ دکھاتا ہے۔ آپ اپنے کنٹرولر سے TV پر کھیلتے رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino đọc phụ đề tiếng Anh trong các game PS5 của bạn và hiển thị bản dịch tiếng Ả Rập trên TV, ngay trên game. Bạn vẫn chơi trên TV bằng tay cầm của mình."
          }
        }
      }
    },
