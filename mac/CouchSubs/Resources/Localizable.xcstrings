          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazlarınız, PSN hesabınız ve çeviri ayarlarınız burada."
          }
        }
      }
    },
    "Apple's free translation needs macOS 26 or later. Game packs, DeepL and AI translation (Settings › Translation) work on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب ترجمة Apple المجانية macOS 26 أو أحدث. تعمل حزم الألعاب وDeepL والترجمة بالذكاء الاصطناعي (الإعدادات › الترجمة) على جهاز Mac هذا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple's free translation needs macOS 26 or later. Game packs, DeepL and AI translation (Settings › Translation) work on this Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın ücretsiz çevirisi macOS 26 ve sonrasında çalışır. Oyun paketleri, DeepL ve yapay zekâ çevirisi (Ayarlar › Çeviri) bu Mac'te de çalışır."
          }
        }
      }
    },
    "Apple's free translation needs iOS 26 or later. Game packs, DeepL and AI translation work on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب ترجمة Apple المجانية iOS 26 أو أحدث. تعمل حزم الألعاب وDeepL والترجمة بالذكاء الاصطناعي على هذا الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple's free translation needs iOS 26 or later. Game packs, DeepL and AI translation work on this device."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın ücretsiz çevirisi iOS 26 ve sonrasında çalışır. Oyun paketleri, DeepL ve yapay zekâ çevirisi bu cihazda da çalışır."
          }
        }
      }
    },
    "If the Mac App Store version cannot install the TV app, install it once with the GitHub (DMG) version of Nino. After that, this version is enough." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تعذّر على إصدار Mac App Store تثبيت تطبيق التلفاز، فثبّته مرة واحدة بإصدار GitHub (DMG) من Nino. بعد ذلك يكفي هذا الإصدار."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the Mac App Store version cannot install the TV app, install it once with the GitHub (DMG) version of Nino. After that, this version is enough."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac App Store sürümü TV uygulamasını kuramıyorsa TV uygulamasını bir kez Nino'nun GitHub (DMG) sürümüyle kurun. Sonrasında bu sürüm yeterli."
          }
        }
      }
    },
    "Local model" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نموذج محلي"
          }
        },
        "en" : {
