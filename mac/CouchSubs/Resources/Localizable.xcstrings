    "Press Num 9 or Ctrl+Shift+9 while playing: every text on the screen is translated once and shown on the TV in its own place. Press again to remove the translations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط Num 9 أو Ctrl+Shift+9 أثناء اللعب: يُترجَم كل نص على الشاشة مرة واحدة ويظهر على التلفاز في مكانه. اضغط مجددًا لإزالة الترجمات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Num 9 or Ctrl+Shift+9 while playing: every text on the screen is translated once and shown on the TV in its own place. Press again to remove the translations."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynarken Num 9'a ya da Ctrl+Shift+9'a basın: ekrandaki bütün yazılar bir kez çevrilip TV'de kendi yerlerinde gösterilir. Çevirileri kaldırmak için yeniden basın."
          }
        }
      }
    },
