    "The disk is almost full (%.1f GB free). macOS needs free space to read text; free up a few GB and start the translation again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القرص ممتلئ تقريبًا (المساحة المتاحة %.1f GB). يحتاج macOS إلى مساحة فارغة لقراءة النص؛ حرّر بضعة GB وابدأ الترجمة من جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিস্ক প্রায় ভরে গেছে (%.1f GB খালি)। লেখা পড়তে macOS-এর খালি জায়গা দরকার; কয়েক GB খালি করে আবার অনুবাদ শুরু করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
