    "Windows' own Turkish voice: speaks at once, nothing to download. Sounds more mechanical." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صوت Windows التركي المدمج: ينطق فورًا ولا يحتاج إلى تنزيل، لكنه يبدو آليًا أكثر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows' own Turkish voice: speaks at once, nothing to download. Sounds more mechanical."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows'un kendi Türkçe sesi: hemen konuşur, indirme gerekmez. Daha mekanik duyulur."
          }
        }
      }
    },
    "Natural voices, downloaded once. Each line takes a moment to prepare, so the voice can come a little after the subtitle." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصوات طبيعية تُنزَّل مرة واحدة. يحتاج كل سطر إلى لحظة لتجهيزه، لذا قد يتأخر الصوت قليلًا عن الترجمة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural voices, downloaded once. Each line takes a moment to prepare, so the voice can come a little after the subtitle."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğal sesler, bir kez indirilir. Her satırın hazırlanması biraz sürer, bu yüzden ses altyazıdan biraz sonra gelebilir."
          }
        }
      }
    },
    "Online translation (DeepL)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترجمة عبر الإنترنت (DeepL)"
