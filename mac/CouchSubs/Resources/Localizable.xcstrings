    "Connect Your Xbox" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربط جهاز Xbox"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার Xbox সংযোগ করুন"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikonekta ang Iyong Xbox"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना Xbox कनेक्ट करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan Xbox Anda"
          }
        },
        "ms" : {
