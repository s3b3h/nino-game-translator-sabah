        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณกำลังเล่นเกมอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hangi oyunu oynuyorsunuz?"
          }
        },
        "ur" : {
