    "Switch back to your own user. You only do this once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على حسابك، أوقف الإشعارات من الإعدادات › الإشعارات حتى لا تظهر فوق الترجمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার নিজের ইউজারে ফিরে যান। এটি একবারই করতে হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch back to your own user. You only do this once."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bumalik sa sarili mong user. Isang beses mo lang ito gagawin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस अपने यूज़र पर स्विच करें। यह सिर्फ़ एक बार करना होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beralih kembali ke pengguna Anda sendiri. Anda cukup melakukan ini sekali."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukar kembali kepada pengguna anda sendiri. Anda hanya melakukan ini sekali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wissel terug naar je eigen gebruiker. Dit doe je maar één keer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สลับกลับไปเป็นผู้ใช้ของคุณเอง ทำเพียงครั้งเดียวเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi hesabınızda Ayarlar › Bildirimler'den bildirimleri kapatın, altyazının üstünde uyarı çıkmaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واپس اپنے یوزر پر جائیں۔ یہ صرف ایک بار کرنا ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển về người dùng của bạn. Bạn chỉ cần làm việc này một lần."
          }
        }
      }
    },
