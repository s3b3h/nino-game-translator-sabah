    "The PS5 did not accept this Mac. Pair the PS5 again from Settings › About Nino › Set up again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل PS5 جهاز Mac هذا. أقرِن PS5 من جديد من الإعدادات › حول Nino › الإعداد من جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 এই Mac-কে গ্রহণ করেনি। Settings › About Nino › Set up again থেকে PS5 আবার পেয়ার করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PS5 did not accept this Mac. Pair the PS5 again from Settings › About Nino › Set up again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi tinanggap ng PS5 ang Mac na ito. Ipares muli ang PS5 mula sa Mga Setting › Tungkol sa Nino › I-set up muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 ने इस Mac को स्वीकार नहीं किया। सेटिंग्स › Nino के बारे में › फिर से सेट अप करें से PS5 को फिर से पेयर करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 tidak menerima Mac ini. Pasangkan PS5 lagi dari Pengaturan › Tentang Nino › Siapkan ulang."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 tidak menerima Mac ini. Pasangkan PS5 semula daripada Tetapan › Perihal Nino › Sediakan semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De PS5 heeft deze Mac niet geaccepteerd. Koppel de PS5 opnieuw via Instellingen › Over Nino › Opnieuw instellen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 ไม่ยอมรับ Mac เครื่องนี้ โปรดจับคู่ PS5 อีกครั้งจาก การตั้งค่า › เกี่ยวกับ Nino › ตั้งค่าใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 bu Mac'i kabul etmedi. PS5'i Ayarlar › Nino Hakkında › Yeniden kur'dan yeniden eşleyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 نے اس Mac کو قبول نہیں کیا۔ Settings › About Nino › Set up again سے PS5 کو دوبارہ جوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 không chấp nhận máy Mac này. Hãy ghép nối lại PS5 trong Cài đặt › Giới thiệu về Nino › Thiết lập lại."
          }
        }
      }
    },
    "The PS5 is off or asleep. Turn it on, or turn on “Stay connected to the internet” in its rest mode settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 مطفأ أو في وضع الراحة. شغّله، أو فعّل «البقاء متصلًا بالإنترنت» في إعدادات وضع الراحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 বন্ধ বা ঘুমিয়ে আছে। এটি চালু করুন, অথবা এর রেস্ট মোড সেটিংসে “Stay connected to the internet” চালু করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PS5 is off or asleep. Turn it on, or turn on “Stay connected to the internet” in its rest mode settings."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-off o tulog ang PS5. I-on ito, o i-on ang “Stay connected to the internet” sa mga setting ng rest mode nito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 बंद है या स्लीप में है। उसे चालू करें, या उसकी रेस्ट मोड सेटिंग्स में “Stay connected to the internet” चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 mati atau dalam mode tidur. Nyalakan, atau aktifkan “Tetap terhubung ke internet” di pengaturan mode istirahatnya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 dimatikan atau sedang tidur. Hidupkannya, atau hidupkan “Stay connected to the internet” dalam tetapan mod rehatnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De PS5 staat uit of slaapt. Zet hem aan, of zet ‘Verbonden blijven met internet’ aan in de instellingen voor de rustmodus."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 ปิดอยู่หรืออยู่ในโหมดพัก โปรดเปิดเครื่อง หรือเปิด “เชื่อมต่ออินเทอร์เน็ตค้างไว้” ในการตั้งค่าโหมดพัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 kapalı ya da dinlenme modunda. Açın ya da dinlenme modu ayarlarında “İnternete bağlı kal”ı açın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 بند ہے یا سو رہا ہے۔ اسے آن کریں، یا اس کی rest mode سیٹنگز میں “Stay connected to the internet” آن کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 đang tắt hoặc ngủ. Hãy bật máy, hoặc bật “Duy trì kết nối Internet” trong cài đặt chế độ nghỉ."
          }
        }
      }
    },
    "The PS5 picture is losing data. Connect this Mac to the modem with a cable (a USB-C Ethernet adapter works). If that is not possible, move closer to the modem and use 5 GHz Wi-Fi." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفقد صورة PS5 بعض البيانات. وصّل جهاز Mac هذا بالمودم بكابل (يصلح محوّل USB-C إلى Ethernet). إن لم يكن ذلك ممكنًا، فاقترب من المودم واستخدم Wi-Fi بتردد 5 GHz."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5-এর ছবিতে ডেটা হারাচ্ছে। এই Mac-কে কেবল দিয়ে মডেমে সংযোগ করুন (USB-C Ethernet অ্যাডাপ্টারও চলবে)। তা সম্ভব না হলে মডেমের কাছে যান এবং 5 GHz Wi-Fi ব্যবহার করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PS5 picture is losing data. Connect this Mac to the modem with a cable (a USB-C Ethernet adapter works). If that is not possible, move closer to the modem and use 5 GHz Wi-Fi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawawalan ng data ang larawan ng PS5. Ikonekta ang Mac na ito sa modem gamit ang cable (gumagana ang USB-C Ethernet adapter). Kung hindi posible, lumapit sa modem at gumamit ng 5 GHz Wi-Fi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 की तस्वीर में डेटा खो रहा है। इस Mac को केबल से मॉडेम से जोड़ें (USB-C Ethernet एडैप्टर काम करता है)। अगर ऐसा मुमकिन न हो, तो मॉडेम के पास जाएँ और 5 GHz Wi-Fi इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar PS5 kehilangan data. Hubungkan Mac ini ke modem dengan kabel (adaptor Ethernet USB-C juga bisa). Jika tidak memungkinkan, mendekatlah ke modem dan gunakan Wi-Fi 5 GHz."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar PS5 kehilangan data. Sambungkan Mac ini ke modem dengan kabel (penyesuai Ethernet USB-C boleh digunakan). Jika tidak boleh, dekatkan diri dengan modem dan gunakan Wi-Fi 5 GHz."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het PS5-beeld verliest gegevens. Verbind deze Mac met een kabel met de modem (een USB-C-ethernetadapter werkt). Lukt dat niet, ga dan dichter bij de modem zitten en gebruik 5 GHz-wifi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพจาก PS5 สูญเสียข้อมูล โปรดเชื่อมต่อ Mac เครื่องนี้กับโมเด็มด้วยสาย LAN (ใช้อะแดปเตอร์ USB-C Ethernet ได้) หากทำไม่ได้ ให้ขยับเข้าใกล้โมเด็มและใช้ Wi-Fi 5 GHz"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 görüntüsü veri kaybediyor. Bu Mac'i modeme kabloyla bağlayın (USB-C Ethernet adaptörü olur). Olmuyorsa modeme yaklaşın ve 5 GHz Wi-Fi kullanın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 کی تصویر میں ڈیٹا ضائع ہو رہا ہے۔ اس Mac کو کیبل سے موڈیم سے جوڑیں (USB-C Ethernet اڈاپٹر کام کرتا ہے)۔ اگر ممکن نہ ہو تو موڈیم کے قریب جائیں اور 5 GHz Wi-Fi استعمال کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hình ảnh PS5 đang bị mất dữ liệu. Hãy nối máy Mac này với modem bằng cáp (bộ chuyển USB-C sang Ethernet cũng được). Nếu không thể, hãy đến gần modem hơn và dùng Wi-Fi 5 GHz."
          }
        }
      }
    },
    "The TV app is not connected. Open the Nino app on the TV and check that the TV is on the same network as this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق التلفاز غير متصل. افتح تطبيق Nino على التلفاز وتحقق من أن التلفاز على الشبكة نفسها التي عليها جهاز Mac هذا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV অ্যাপ সংযুক্ত নয়। TV-তে Nino অ্যাপ খুলুন এবং দেখুন TV এই Mac-এর মতো একই নেটওয়ার্কে আছে কিনা।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV app is not connected. Open the Nino app on the TV and check that the TV is on the same network as this Mac."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nakakonekta ang TV app. Buksan ang Nino app sa TV at tiyaking nasa parehong network ang TV gaya ng Mac na ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV ऐप कनेक्टेड नहीं है। TV पर Nino ऐप खोलें और जाँचें कि TV इस Mac वाले ही नेटवर्क पर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi TV tidak terhubung. Buka aplikasi Nino di TV dan pastikan TV berada di jaringan yang sama dengan Mac ini."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi TV tidak disambungkan. Buka aplikasi Nino pada TV dan pastikan TV berada pada rangkaian yang sama dengan Mac ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De TV-app is niet verbonden. Open de Nino-app op de TV en controleer of de TV op hetzelfde netwerk zit als deze Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอป TV ไม่ได้เชื่อมต่ออยู่ โปรดเปิดแอป Nino บน TV และตรวจสอบว่า TV อยู่ในเครือข่ายเดียวกับ Mac เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV uygulaması bağlı değil. TV'de Nino uygulamasını açın ve TV'nin bu Mac'le aynı ağda olduğunu kontrol edin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV ایپ جُڑی ہوئی نہیں۔ TV پر Nino ایپ کھولیں اور چیک کریں کہ TV اس Mac والے نیٹ ورک پر ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng TV chưa kết nối. Hãy mở ứng dụng Nino trên TV và kiểm tra TV có cùng mạng với máy Mac này không."
          }
        }
      }
    },
    "The connection to the PS5 keeps dropping. Connect both the PS5 and this Mac to the modem with a cable." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاتصال بـ PS5 ينقطع باستمرار. وصّل PS5 وجهاز Mac هذا كليهما بالمودم بكابل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5-এর সঙ্গে সংযোগ বারবার বিচ্ছিন্ন হচ্ছে। PS5 ও এই Mac দুটোকেই কেবল দিয়ে মডেমে সংযোগ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection to the PS5 keeps dropping. Connect both the PS5 and this Mac to the modem with a cable."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paulit-ulit na naputol ang koneksyon sa PS5. Ikonekta ang PS5 at ang Mac na ito sa modem gamit ang cable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 से कनेक्शन बार-बार टूट रहा है। PS5 और इस Mac दोनों को केबल से मॉडेम से जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi ke PS5 terus terputus. Hubungkan PS5 dan Mac ini ke modem dengan kabel."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungan ke PS5 terus terputus. Sambungkan PS5 dan Mac ini ke modem dengan kabel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding met de PS5 valt steeds weg. Verbind zowel de PS5 als deze Mac met een kabel met de modem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเชื่อมต่อกับ PS5 หลุดอยู่เรื่อยๆ โปรดเชื่อมต่อทั้ง PS5 และ Mac เครื่องนี้กับโมเด็มด้วยสาย LAN"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 bağlantısı sık kopuyor. PS5'i ve bu Mac'i modeme kabloyla bağlayın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 سے کنکشن بار بار ٹوٹ رہا ہے۔ PS5 اور اس Mac دونوں کو کیبل سے موڈیم سے جوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối với PS5 liên tục bị ngắt. Hãy nối cả PS5 và máy Mac này với modem bằng cáp."
          }
        }
      }
    },
    "The logs could not be saved." : {
