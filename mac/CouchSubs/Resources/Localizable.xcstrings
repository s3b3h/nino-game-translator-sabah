            "value" : "সবকিছু রিসেট করুন"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset everything"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-reset ang lahat"
          }
        },
        "hi" : {
