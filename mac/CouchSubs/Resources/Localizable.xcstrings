    "Connect PS5 → card HDMI in, card HDMI out → TV, and the card's USB → this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 ← مدخل HDMI في البطاقة، مخرج HDMI في البطاقة ← التلفاز، وUSB البطاقة ← هذا الـ Mac."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 → কার্ডের HDMI ইন, কার্ডের HDMI আউট → TV, এবং কার্ডের USB → এই Mac সংযোগ করুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikonekta ang PS5 → HDMI in ng card, HDMI out ng card → TV, at ang USB ng card → Mac na ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 → कार्ड का HDMI in, कार्ड का HDMI out → TV, और कार्ड का USB → यह Mac जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan PS5 → HDMI in pada card, HDMI out pada card → TV, dan USB card → Mac ini."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan PS5 → HDMI in kad, HDMI out kad → TV, dan USB kad → Mac ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind PS5 → HDMI-ingang van de kaart, HDMI-uitgang van de kaart → TV, en de USB van de kaart → deze Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อ PS5 → HDMI in ของการ์ด, HDMI out ของการ์ด → TV และ USB ของการ์ด → Mac เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 → Capture Card'ın HDMI girişi, HDMI çıkışı → TV, USB'si → bu Mac."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 → کارڈ کا HDMI in، کارڈ کا HDMI out → TV، اور کارڈ کا USB → یہ Mac جوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nối PS5 → HDMI in của card, HDMI out của card → TV, và USB của card → máy Mac này."
          }
        }
      }
    },
    "Connect PS5 → card HDMI in, and the card's USB → this Mac. Then connect this Mac to your screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 ← مدخل HDMI في البطاقة، وUSB البطاقة ← هذا الـ Mac. ثم وصّل هذا الـ Mac بشاشتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 → কার্ডের HDMI ইন, এবং কার্ডের USB → এই Mac সংযোগ করুন। তারপর এই Mac-কে আপনার স্ক্রিনে সংযোগ করুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikonekta ang PS5 → HDMI in ng card, at ang USB ng card → Mac na ito. Pagkatapos, ikonekta ang Mac na ito sa iyong screen."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 → कार्ड का HDMI in, और कार्ड का USB → यह Mac जोड़ें। फिर इस Mac को अपनी स्क्रीन से जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan PS5 → HDMI in pada card, dan USB card → Mac ini. Lalu hubungkan Mac ini ke layar Anda."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan PS5 → HDMI in kad, dan USB kad → Mac ini. Kemudian sambungkan Mac ini ke skrin anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind PS5 → HDMI-ingang van de kaart, en de USB van de kaart → deze Mac. Verbind deze Mac daarna met je scherm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อ PS5 → HDMI in ของการ์ด และ USB ของการ์ด → Mac เครื่องนี้ จากนั้นเชื่อมต่อ Mac เครื่องนี้กับหน้าจอของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 → Capture Card'ın HDMI girişi, USB'si → bu Mac. Sonra bu Mac'i ekranınıza bağlayın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 → کارڈ کا HDMI in، اور کارڈ کا USB → یہ Mac جوڑیں۔ پھر اس Mac کو اپنی اسکرین سے جوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nối PS5 → HDMI in của card, và USB của card → máy Mac này. Sau đó nối máy Mac này với màn hình của bạn."
          }
        }
      }
    },
