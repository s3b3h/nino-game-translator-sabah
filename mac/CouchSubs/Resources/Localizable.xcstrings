    },
    "Apple's free translation needs macOS 26 or later. Game packs, DeepL and AI translation (Settings › Translation) work on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب ترجمة Apple المجانية macOS 26 أو أحدث. تعمل حزم الألعاب وDeepL والترجمة بالذكاء الاصطناعي (الإعدادات › الترجمة) على جهاز Mac هذا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-এর বিনামূল্যের অনুবাদের জন্য macOS 26 বা নতুন দরকার। গেম প্যাক, DeepL ও AI অনুবাদ (Settings › Translation) এই Mac-এ কাজ করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple's free translation needs macOS 26 or later. Game packs, DeepL and AI translation (Settings › Translation) work on this Mac."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan ng libreng salin ng Apple ang macOS 26 o mas bago. Gumagana sa Mac na ito ang mga game pack, DeepL at AI na pagsasalin (Mga Setting › Pagsasalin)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple के मुफ़्त अनुवाद के लिए macOS 26 या नया चाहिए। गेम पैक, DeepL और AI अनुवाद (सेटिंग्स › अनुवाद) इस Mac पर काम करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan gratis Apple memerlukan macOS 26 atau lebih baru. Paket game, DeepL, dan terjemahan AI (Pengaturan › Terjemahan) berfungsi di Mac ini."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan percuma Apple memerlukan macOS 26 atau lebih baharu. Pek permainan, DeepL dan terjemahan AI (Tetapan › Terjemahan) berfungsi pada Mac ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gratis vertaling van Apple vereist macOS 26 of nieuwer. Gamepakketten, DeepL en AI-vertaling (Instellingen › Vertaling) werken op deze Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแปลฟรีของ Apple ต้องใช้ macOS 26 ขึ้นไป แพ็กเกม DeepL และการแปลด้วย AI (การตั้งค่า › การแปล) ใช้ได้บน Mac เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın ücretsiz çevirisi macOS 26 ve sonrasında çalışır. Oyun paketleri, DeepL ve yapay zekâ çevirisi (Ayarlar › Çeviri) bu Mac'te de çalışır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple کے مفت ترجمے کے لیے macOS 26 یا نیا ورژن درکار ہے۔ گیم پیکس، DeepL اور AI ترجمہ (Settings › Translation) اس Mac پر کام کرتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dịch miễn phí của Apple cần macOS 26 trở lên. Gói game, DeepL và dịch bằng AI (Cài đặt › Dịch) vẫn hoạt động trên máy Mac này."
          }
        }
      }
    },
    "Apple's free translation needs iOS 26 or later. Game packs, DeepL and AI translation work on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب ترجمة Apple المجانية iOS 26 أو أحدث. تعمل حزم الألعاب وDeepL والترجمة بالذكاء الاصطناعي على هذا الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-এর বিনামূল্যের অনুবাদের জন্য iOS 26 বা নতুন দরকার। গেম প্যাক, DeepL ও AI অনুবাদ এই ডিভাইসে কাজ করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple's free translation needs iOS 26 or later. Game packs, DeepL and AI translation work on this device."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan ng libreng salin ng Apple ang iOS 26 o mas bago. Gumagana sa device na ito ang mga game pack, DeepL at AI na pagsasalin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple के मुफ़्त अनुवाद के लिए iOS 26 या नया चाहिए। गेम पैक, DeepL और AI अनुवाद इस डिवाइस पर काम करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan gratis Apple memerlukan iOS 26 atau lebih baru. Paket game, DeepL, dan terjemahan AI berfungsi di perangkat ini."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan percuma Apple memerlukan iOS 26 atau lebih baharu. Pek permainan, DeepL dan terjemahan AI berfungsi pada peranti ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gratis vertaling van Apple vereist iOS 26 of nieuwer. Gamepakketten, DeepL en AI-vertaling werken op dit apparaat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแปลฟรีของ Apple ต้องใช้ iOS 26 ขึ้นไป แพ็กเกม DeepL และการแปลด้วย AI ใช้ได้บนอุปกรณ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın ücretsiz çevirisi iOS 26 ve sonrasında çalışır. Oyun paketleri, DeepL ve yapay zekâ çevirisi bu cihazda da çalışır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple کے مفت ترجمے کے لیے iOS 26 یا نیا ورژن درکار ہے۔ گیم پیکس، DeepL اور AI ترجمہ اس ڈیوائس پر کام کرتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dịch miễn phí của Apple cần iOS 26 trở lên. Gói game, DeepL và dịch bằng AI vẫn hoạt động trên thiết bị này."
          }
        }
      }
    },
    "If the Mac App Store version cannot install the TV app, install it once with the GitHub (DMG) version of Nino. After that, this version is enough." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تعذّر على إصدار Mac App Store تثبيت تطبيق التلفاز، فثبّته مرة واحدة بإصدار GitHub (DMG) من Nino. بعد ذلك يكفي هذا الإصدار."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac App Store সংস্করণ TV অ্যাপ ইনস্টল করতে না পারলে Nino-র GitHub (DMG) সংস্করণ দিয়ে একবার ইনস্টল করুন। এরপর এই সংস্করণই যথেষ্ট।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the Mac App Store version cannot install the TV app, install it once with the GitHub (DMG) version of Nino. After that, this version is enough."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung hindi ma-install ng bersyon mula sa Mac App Store ang TV app, i-install ito nang isang beses gamit ang GitHub (DMG) na bersyon ng Nino. Pagkatapos noon, sapat na ang bersyong ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर Mac App Store वर्ज़न TV ऐप इंस्टॉल नहीं कर पाता, तो उसे एक बार Nino के GitHub (DMG) वर्ज़न से इंस्टॉल करें। उसके बाद यह वर्ज़न ही काफ़ी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika versi Mac App Store tidak dapat menginstal aplikasi TV, instal sekali dengan Nino versi GitHub (DMG). Setelah itu, versi ini sudah cukup."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika versi Mac App Store tidak dapat memasang aplikasi TV, pasangnya sekali dengan versi GitHub (DMG) Nino. Selepas itu, versi ini sudah memadai."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de Mac App Store-versie de TV-app niet installeren, installeer hem dan één keer met de GitHub-versie (DMG) van Nino. Daarna is deze versie genoeg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หาก Nino เวอร์ชัน Mac App Store ติดตั้งแอป TV ไม่ได้ โปรดติดตั้งหนึ่งครั้งด้วย Nino เวอร์ชัน GitHub (DMG) หลังจากนั้นใช้เวอร์ชันนี้ก็พอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac App Store sürümü TV uygulamasını kuramıyorsa TV uygulamasını bir kez Nino'nun GitHub (DMG) sürümüyle kurun. Sonrasında bu sürüm yeterli."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر Mac App Store ورژن TV ایپ انسٹال نہ کر سکے تو ایک بار Nino کے GitHub (DMG) ورژن سے انسٹال کریں۔ اس کے بعد یہ ورژن کافی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu phiên bản Mac App Store không cài được ứng dụng TV, hãy cài một lần bằng phiên bản Nino trên GitHub (DMG). Sau đó, phiên bản này là đủ."
          }
        }
      }
    },
