    "When the subtitle area looks unchanged, read it again after 2 frames instead of 20. Uses more CPU." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تبدو منطقة الترجمة دون تغيير، أعِد قراءتها بعد إطارين بدلًا من 20. يستهلك CPU أكثر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাবটাইটেল এলাকা অপরিবর্তিত মনে হলে ২০টির বদলে ২টি ফ্রেম পরে আবার পড়ুন। বেশি CPU ব্যবহার করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the subtitle area looks unchanged, read it again after 2 frames instead of 20. Uses more CPU."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag mukhang hindi nagbago ang subtitle area, basahin ulit ito pagkalipas ng 2 frame sa halip na 20. Mas maraming CPU ang gagamitin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब सबटाइटल क्षेत्र बदला हुआ न लगे, तो 20 की जगह 2 फ़्रेम बाद फिर से पढ़ें। ज़्यादा CPU लगता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika area subtitle tampak tidak berubah, baca lagi setelah 2 frame, bukan 20. Memakai lebih banyak CPU."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila kawasan sari kata kelihatan tidak berubah, baca semula selepas 2 bingkai dan bukannya 20. Menggunakan lebih banyak CPU."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het ondertitelgebied onveranderd lijkt, lees het dan na 2 frames opnieuw in plaats van na 20. Gebruikt meer CPU."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อพื้นที่คำบรรยายดูเหมือนไม่เปลี่ยน ให้อ่านใหม่หลังผ่านไป 2 เฟรมแทน 20 เฟรม ใช้ CPU มากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazı alanı değişmemiş görünüyorsa 20 yerine 2 kare sonra yeniden oku. Daha fazla CPU kullanır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب سب ٹائٹل حصہ تبدیل نہ لگے تو اسے 20 کی بجائے 2 فریم بعد دوبارہ پڑھیں۔ زیادہ CPU استعمال ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi vùng phụ đề có vẻ không đổi, đọc lại sau 2 khung hình thay vì 20. Tốn CPU hơn."
          }
        }
      }
    },
