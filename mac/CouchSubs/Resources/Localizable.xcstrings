        }
      }
    },
    "PS5 not found at %@. Make sure it is on and on the same network. Reconnecting…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على PS5 في %@. تأكد من أنه يعمل وعلى الشبكة نفسها. جارٍ إعادة الاتصال…"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ PS5 পাওয়া যায়নি। নিশ্চিত করুন এটি চালু আছে এবং একই নেটওয়ার্কে আছে। আবার সংযোগ হচ্ছে…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 not found at %@. Make sure it is on and on the same network. Reconnecting…"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nahanap ang PS5 sa %@. Tiyaking naka-on ito at nasa parehong network. Kumokonekta muli…"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर PS5 नहीं मिला। पक्का करें कि वह चालू है और उसी नेटवर्क पर है। फिर से कनेक्ट हो रहा है…"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 tidak ditemukan di %@. Pastikan PS5 menyala dan berada di jaringan yang sama. Menghubungkan ulang…"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 tidak ditemui di %@. Pastikan ia dihidupkan dan berada pada rangkaian yang sama. Menyambung semula…"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5 niet gevonden op %@. Controleer of hij aan staat en op hetzelfde netwerk zit. Opnieuw verbinden…"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบ PS5 ที่ %@ โปรดตรวจสอบว่าเปิดอยู่และอยู่ในเครือข่ายเดียวกัน กำลังเชื่อมต่อใหม่…"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS5, %@ adresinde bulunamadı. Açık ve aynı ağda olduğundan emin olun. Yeniden bağlanılıyor…"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ پر PS5 نہیں ملا۔ یقینی بنائیں کہ وہ آن ہے اور اسی نیٹ ورک پر ہے۔ دوبارہ جوڑا جا رہا ہے…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy PS5 tại %@. Hãy đảm bảo máy đang bật và cùng mạng. Đang kết nối lại…"
          }
        }
      }
    },
