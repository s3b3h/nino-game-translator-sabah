    "Nino extends Developer Mode by itself each time you use it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمدّد Nino وضع المطوّر تلقائيًا في كل مرة تستخدمه فيها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিবার ব্যবহারের সময় Nino নিজে থেকেই Developer Mode বাড়িয়ে নেয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino extends Developer Mode by itself each time you use it."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusang pinahahaba ng Nino ang Developer Mode tuwing ginagamit mo ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब भी आप इसका इस्तेमाल करते हैं, Nino Developer Mode को अपने-आप बढ़ा देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino memperpanjang Developer Mode dengan sendirinya setiap kali Anda menggunakannya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino melanjutkan Developer Mode dengan sendirinya setiap kali anda menggunakannya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino verlengt Developer Mode zelf telkens als je het gebruikt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino จะขยายเวลา Developer Mode ให้เองทุกครั้งที่คุณใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, her kullandığınızda geliştirici modunun süresini kendisi uzatır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب بھی آپ Nino استعمال کرتے ہیں، یہ Developer Mode کی مدت خود بڑھا دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino tự gia hạn Developer Mode mỗi lần bạn sử dụng."
          }
        }
      }
    },
    "Nino is not affiliated with Sony Interactive Entertainment. PlayStation and PS5 are trademarks of Sony Interactive Entertainment Inc." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino غير تابع لشركة Sony Interactive Entertainment. ‏PlayStation و PS5 علامتان تجاريتان لشركة Sony Interactive Entertainment Inc."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, Sony Interactive Entertainment-এর সঙ্গে যুক্ত নয়। PlayStation ও PS5 হলো Sony Interactive Entertainment Inc.-এর ট্রেডমার্ক।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino is not affiliated with Sony Interactive Entertainment. PlayStation and PS5 are trademarks of Sony Interactive Entertainment Inc."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang Nino ay hindi kaanib ng Sony Interactive Entertainment. Ang PlayStation at PS5 ay mga trademark ng Sony Interactive Entertainment Inc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino का Sony Interactive Entertainment से कोई संबंध नहीं है। PlayStation और PS5, Sony Interactive Entertainment Inc. के ट्रेडमार्क हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino tidak berafiliasi dengan Sony Interactive Entertainment. PlayStation dan PS5 adalah merek dagang Sony Interactive Entertainment Inc."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino tidak bergabung dengan Sony Interactive Entertainment. PlayStation dan PS5 ialah tanda dagangan Sony Interactive Entertainment Inc."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino is niet verbonden aan Sony Interactive Entertainment. PlayStation en PS5 zijn handelsmerken van Sony Interactive Entertainment Inc."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino ไม่มีส่วนเกี่ยวข้องกับ Sony Interactive Entertainment PlayStation และ PS5 เป็นเครื่องหมายการค้าของ Sony Interactive Entertainment Inc."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, Sony Interactive Entertainment ile bağlantılı değildir. PlayStation ve PS5, Sony Interactive Entertainment Inc.'in ticari markalarıdır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino کا Sony Interactive Entertainment سے کوئی تعلق نہیں۔ PlayStation اور PS5، Sony Interactive Entertainment Inc. کے ٹریڈ مارکس ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino không liên kết với Sony Interactive Entertainment. PlayStation và PS5 là nhãn hiệu của Sony Interactive Entertainment Inc."
          }
        }
      }
    },
    "Nino reads the English subtitles of your PS5 games and shows a Turkish translation on your TV, on top of the game. You keep playing on the TV with your own controller." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Nino النصوص الإنجليزية في ألعاب PS5 ويعرض ترجمتها على التلفاز فوق اللعبة، وتواصل اللعب على التلفاز بيد التحكم الخاصة بك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino আপনার PS5 গেমের ইংরেজি সাবটাইটেল পড়ে এবং গেমের ওপরে আপনার TV-তে তুর্কি অনুবাদ দেখায়। আপনি নিজের কন্ট্রোলার দিয়ে TV-তে খেলা চালিয়ে যান।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino reads the English subtitles of your PS5 games and shows a Turkish translation on your TV, on top of the game. You keep playing on the TV with your own controller."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabasa ng Nino ang mga English na subtitle ng iyong mga PS5 game at ipinapakita ang Turkish na salin sa iyong TV, sa ibabaw ng laro. Patuloy kang naglalaro sa TV gamit ang sarili mong controller."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino आपके PS5 गेम्स के अंग्रेज़ी सबटाइटल पढ़ता है और गेम के ऊपर आपके TV पर तुर्की अनुवाद दिखाता है। आप अपने कंट्रोलर से TV पर खेलते रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca subtitle bahasa Inggris dari game PS5 Anda dan menampilkan terjemahan bahasa Turki di TV Anda, di atas game. Anda tetap bermain di TV dengan kontroler Anda sendiri."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino membaca sari kata bahasa Inggeris permainan PS5 anda dan memaparkan terjemahan bahasa Turki pada TV anda, di atas permainan. Anda terus bermain pada TV dengan alat kawalan anda sendiri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino leest de Engelse ondertitels van je PS5-games en toont een Turkse vertaling op je TV, boven op de game. Je blijft op de TV spelen met je eigen controller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino อ่านคำบรรยายภาษาอังกฤษจากเกม PS5 ของคุณ แล้วแสดงคำแปลภาษาตุรกีบน TV ซ้อนทับเกม คุณเล่นต่อบน TV ด้วยคอนโทรลเลอร์ของคุณเองได้ตามปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, PS5 oyunlarının İngilizce altyazılarını okur ve Türkçe çevirisini TV'de oyunun üstünde gösterir. Siz de TV'de kendi joystick'inizle oynamaya devam edersiniz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino آپ کے PS5 گیمز کے انگریزی سب ٹائٹلز پڑھتا ہے اور گیم کے اوپر آپ کے TV پر ترکی ترجمہ دکھاتا ہے۔ آپ اپنے کنٹرولر سے TV پر کھیلتے رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino đọc phụ đề tiếng Anh trong các game PS5 của bạn và hiển thị bản dịch tiếng Thổ Nhĩ Kỳ trên TV, ngay trên game. Bạn vẫn chơi trên TV bằng tay cầm của mình."
          }
        }
      }
    },
    "Nino translates on this computer, without the internet. The English–Turkish model (about 530 MB) is downloaded once and kept on this computer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يترجم Nino على هذا الكمبيوتر دون اتصال بالإنترنت. يُنزَّل نموذج الترجمة من الإنجليزية إلى التركية (نحو 530 MB) مرة واحدة ويُحفظ على هذا الكمبيوتر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino ইন্টারনেট ছাড়াই এই কম্পিউটারে অনুবাদ করে। ইংরেজি–তুর্কি মডেলটি (প্রায় 530 MB) একবার ডাউনলোড হয়ে এই কম্পিউটারে থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino translates on this computer, without the internet. The English–Turkish model (about 530 MB) is downloaded once and kept on this computer."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagsasalin ang Nino sa computer na ito, nang walang internet. Isang beses lang dina-download ang English–Turkish na model (mga 530 MB) at itinatago sa computer na ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino इस कंप्यूटर पर बिना इंटरनेट के अनुवाद करता है। अंग्रेज़ी–तुर्की मॉडल (लगभग 530 MB) एक बार डाउनलोड होता है और इसी कंप्यूटर पर रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino menerjemahkan di komputer ini, tanpa internet. Model Inggris–Turki (sekitar 530 MB) diunduh sekali dan disimpan di komputer ini."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino menterjemah pada komputer ini, tanpa internet. Model Inggeris–Turki (kira-kira 530 MB) dimuat turun sekali dan disimpan pada komputer ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino vertaalt op deze computer, zonder internet. Het Engels–Turkse model (ongeveer 530 MB) wordt één keer gedownload en op deze computer bewaard."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino แปลบนคอมพิวเตอร์เครื่องนี้โดยไม่ต้องใช้อินเทอร์เน็ต โมเดลภาษาอังกฤษ–ตุรกี (ประมาณ 530 MB) จะดาวน์โหลดเพียงครั้งเดียวและเก็บไว้ในคอมพิวเตอร์เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino çeviriyi bu bilgisayarda, internetsiz yapar. İngilizce–Türkçe model (yaklaşık 530 MB) bir kez indirilir ve bu bilgisayarda kalır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino اس کمپیوٹر پر انٹرنیٹ کے بغیر ترجمہ کرتا ہے۔ انگریزی–ترکی ماڈل (تقریباً 530 MB) ایک بار ڈاؤن لوڈ ہو کر اسی کمپیوٹر پر رہتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino dịch ngay trên máy tính này, không cần internet. Mô hình Anh–Thổ Nhĩ Kỳ (khoảng 530 MB) được tải xuống một lần và lưu trên máy tính này."
          }
        }
      }
    },
    "Nino watches the game through Remote Play. If it used your own account, the PS5 would turn off your controller. With a second account you keep playing undisturbed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Nino الترجمة بهذا الحساب، وتواصل اللعب بحسابك. يتم الإعداد مرة واحدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, Remote Play-র মাধ্যমে গেমটি দেখে। আপনার নিজের অ্যাকাউন্ট ব্যবহার করলে PS5 আপনার কন্ট্রোলার বন্ধ করে দিত। দ্বিতীয় অ্যাকাউন্ট থাকলে আপনি নির্বিঘ্নে খেলতে পারেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino watches the game through Remote Play. If it used your own account, the PS5 would turn off your controller. With a second account you keep playing undisturbed."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapanood ng Nino ang laro sa pamamagitan ng Remote Play. Kung sarili mong account ang gagamitin nito, papatayin ng PS5 ang iyong controller. Sa pangalawang account, tuloy-tuloy kang makakapaglaro nang walang abala."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino, Remote Play के ज़रिए गेम देखता है। अगर वह आपका अपना अकाउंट इस्तेमाल करता, तो PS5 आपका कंट्रोलर बंद कर देता। दूसरे अकाउंट से आप बिना रुकावट खेलते रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino menonton game melalui Remote Play. Jika memakai akun Anda sendiri, PS5 akan mematikan kontroler Anda. Dengan akun kedua, Anda tetap bermain tanpa gangguan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino menonton permainan melalui Remote Play. Jika ia menggunakan akaun anda sendiri, PS5 akan mematikan alat kawalan anda. Dengan akaun kedua, anda terus bermain tanpa gangguan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino kijkt mee met de game via Remote Play. Als het je eigen account zou gebruiken, zou de PS5 je controller uitschakelen. Met een tweede account speel je ongestoord verder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino ดูเกมผ่าน Remote Play หากใช้บัญชีของคุณเอง PS5 จะปิดคอนโทรลเลอร์ของคุณ แต่เมื่อใช้บัญชีที่สอง คุณจะเล่นต่อได้โดยไม่ถูกรบกวน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino altyazıyı bu hesapla okur, siz kendi hesabınızla oynamaya devam edersiniz. Kurulum bir kez yapılır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino گیم کو Remote Play کے ذریعے دیکھتا ہے۔ اگر یہ آپ کا اپنا اکاؤنٹ استعمال کرتا تو PS5 آپ کا کنٹرولر بند کر دیتا۔ دوسرے اکاؤنٹ کے ساتھ آپ بغیر رکاوٹ کھیلتے رہتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino theo dõi game qua Remote Play. Nếu dùng tài khoản của chính bạn, PS5 sẽ tắt tay cầm của bạn. Với tài khoản thứ hai, bạn vẫn chơi bình thường không bị gián đoạn."
          }
        }
      }
    },
    "Nino will send a sample subtitle to your TV. It should appear at the bottom of the screen, on top of the game." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيرسل Nino ترجمة تجريبية إلى التلفاز. يُفترض أن تظهر أسفل الشاشة فوق اللعبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino আপনার TV-তে একটি নমুনা সাবটাইটেল পাঠাবে। এটি স্ক্রিনের নিচে, গেমের ওপরে দেখা যাওয়ার কথা।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino will send a sample subtitle to your TV. It should appear at the bottom of the screen, on top of the game."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpapadala ang Nino ng sample na subtitle sa iyong TV. Dapat itong lumabas sa ibaba ng screen, sa ibabaw ng laro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino आपके TV पर एक सैंपल सबटाइटल भेजेगा। यह स्क्रीन के नीचे, गेम के ऊपर दिखना चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino akan mengirim contoh subtitle ke TV Anda. Subtitle seharusnya muncul di bagian bawah layar, di atas game."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino akan menghantar sari kata contoh ke TV anda. Ia sepatutnya muncul di bahagian bawah skrin, di atas permainan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino stuurt een voorbeeldondertitel naar je TV. Die hoort onderaan het scherm te verschijnen, boven op de game."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino จะส่งคำบรรยายตัวอย่างไปยัง TV ของคุณ ซึ่งควรแสดงที่ด้านล่างของหน้าจอ ซ้อนทับเกม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV'nize örnek bir altyazı gönderecek. Altyazı ekranın altında, oyunun üstünde görünmeli."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino آپ کے TV پر ایک نمونہ سب ٹائٹل بھیجے گا۔ یہ اسکرین کے نیچے، گیم کے اوپر دکھائی دینا چاہیے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino sẽ gửi một phụ đề mẫu tới TV của bạn. Phụ đề sẽ xuất hiện ở cuối màn hình, ngay trên game."
          }
        }
      }
    },
    "Could not download %@. Check the internet connection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تنزيل %@. تحقق من الاتصال بالإنترنت وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ডাউনলোড করা যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not download %@. Check the internet connection and try again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ma-download ang %@. Tingnan ang koneksyon sa internet at subukang muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ डाउनलोड नहीं हो सका। इंटरनेट कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat mengunduh %@. Periksa koneksi internet dan coba lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memuat turun %@. Semak sambungan internet dan cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan %@ niet downloaden. Controleer de internetverbinding en probeer het opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถดาวน์โหลด %@ ได้ โปรดตรวจสอบการเชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ indirilemedi. İnternet bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ڈاؤن لوڈ نہیں ہو سکا۔ انٹرنیٹ کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tải xuống %@. Hãy kiểm tra kết nối internet và thử lại."
          }
        }
      }
    },
    "Could not translate this area." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت ترجمة هذه المنطقة."
