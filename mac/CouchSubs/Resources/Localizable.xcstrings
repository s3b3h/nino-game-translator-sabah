    },
    "No PS5 found. Make sure it is on and on the same network, or enter its IP address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على PS5. تأكد من أنه يعمل ومتصل بالشبكة نفسها، أو أدخل عنوان IP الخاص به."
          }
