    "Allow Nino in System Settings › Privacy & Security › Screen Recording, then reopen Nino." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Nino من إعدادات النظام › الخصوصية والأمان › تسجيل الشاشة، ثم أعد فتح Nino."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Settings › Privacy & Security › Screen Recording-এ Nino-কে অনুমতি দিন, তারপর Nino আবার খুলুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang Nino sa System Settings › Privacy & Security › Screen Recording, saka buksan muli ang Nino."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्स › गोपनीयता और सुरक्षा › स्क्रीन रिकॉर्डिंग में Nino को अनुमति दें, फिर Nino दोबारा खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Nino di Pengaturan Sistem › Privasi & Keamanan › Perekaman Layar, lalu buka ulang Nino."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan Nino dalam System Settings › Privacy & Security › Screen Recording, kemudian buka semula Nino."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Nino toe in Systeeminstellingen › Privacy en beveiliging › Schermopname en open Nino dan opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาต Nino ใน การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › การบันทึกหน้าจอ แล้วเปิด Nino ใหม่"
