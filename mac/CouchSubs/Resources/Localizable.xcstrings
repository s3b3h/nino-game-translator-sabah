    },
    "1. Create a free LG developer account at webostv.developer.lge.com." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. أنشئ حساب مطوّر LG مجانيًا على webostv.developer.lge.com."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "১. webostv.developer.lge.com-এ একটি ফ্রি LG ডেভেলপার অ্যাকাউন্ট তৈরি করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Create a free LG developer account at webostv.developer.lge.com."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
