    "In games with a ready pack this engine only translates the missing lines." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الألعاب التي لها حزمة جاهزة، لا يترجم هذا المحرك إلا الأسطر الناقصة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তৈরি প্যাক থাকা গেমে এই ইঞ্জিন শুধু বাদ পড়া লাইনগুলো অনুবাদ করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In games with a ready pack this engine only translates the missing lines."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa mga larong may handang pack, ang mga nawawalang linya lang ang isinasalin ng engine na ito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन गेम्स का तैयार पैक है, उनमें यह इंजन सिर्फ़ छूटी हुई लाइनों का अनुवाद करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di game yang memiliki paket siap pakai, mesin ini hanya menerjemahkan baris yang belum ada."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam permainan yang mempunyai pek siap sedia, enjin ini hanya menterjemah baris yang tiada."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In games met een kant-en-klaar pakket vertaalt deze vertaalmachine alleen de ontbrekende regels."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในเกมที่มีแพ็กสำเร็จรูป เอนจินนี้จะแปลเฉพาะบรรทัดที่ขาดหายไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazır paketi olan oyunlarda bu motor yalnız eksik satırlar için çalışır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تیار پیک والی گیمز میں یہ انجن صرف رہ جانے والی لائنوں کا ترجمہ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong các game có gói sẵn, công cụ này chỉ dịch những dòng còn thiếu."
          }
        }
      }
