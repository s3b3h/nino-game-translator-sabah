    "For LM Studio or another model, type the model name as the server shows it. In LM Studio, load the model and start the local server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع LM Studio أو أي نموذج آخر، اكتب اسم النموذج كما يعرضه الخادم. في LM Studio، حمّل النموذج وشغّل الخادم المحلي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LM Studio বা অন্য মডেলের জন্য সার্ভার যেভাবে দেখায় সেভাবে মডেলের নাম লিখুন। LM Studio-তে মডেল লোড করুন এবং লোকাল সার্ভার চালু করুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para sa LM Studio o ibang model, i-type ang pangalan ng model ayon sa ipinapakita ng server. Sa LM Studio, i-load ang model at simulan ang lokal na server."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LM Studio या किसी दूसरे मॉडल के लिए, मॉडल का नाम वैसे ही टाइप करें जैसे सर्वर दिखाता है। LM Studio में मॉडल लोड करें और लोकल सर्वर शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk LM Studio atau model lain, ketik nama model persis seperti yang ditampilkan server. Di LM Studio, muat model dan mulai server lokal."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk LM Studio atau model lain, taipkan nama model seperti yang dipaparkan oleh pelayan. Dalam LM Studio, muatkan model dan mulakan pelayan setempat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor LM Studio of een ander model typ je de modelnaam zoals de server die toont. Laad in LM Studio het model en start de lokale server."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับ LM Studio หรือโมเดลอื่น ให้พิมพ์ชื่อโมเดลตามที่เซิร์ฟเวอร์แสดง ใน LM Studio ให้โหลดโมเดลแล้วเริ่มเซิร์ฟเวอร์ในเครื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LM Studio ya da başka bir model için model adını sunucunun gösterdiği gibi yazın. LM Studio'da modeli yükleyin ve yerel sunucuyu başlatın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LM Studio یا کسی دوسرے ماڈل کے لیے، ماڈل کا نام ویسا ہی لکھیں جیسا سرور دکھاتا ہے۔ LM Studio میں ماڈل لوڈ کریں اور لوکل سرور شروع کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với LM Studio hoặc mô hình khác, hãy nhập tên mô hình đúng như máy chủ hiển thị. Với LM Studio, hãy nạp mô hình và khởi động máy chủ cục bộ."
          }
        }
      }
    },
    "The download did not finish. Check your internet connection and that Ollama is open, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكتمل التنزيل. تحقق من اتصالك بالإنترنت ومن أن Ollama مفتوح، ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডাউনলোড শেষ হয়নি। ইন্টারনেট সংযোগ এবং Ollama খোলা আছে কিনা দেখুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi natapos ang download. Tingnan ang iyong koneksyon sa internet at kung bukas ang Ollama, saka subukang muli."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड पूरा नहीं हुआ। अपना इंटरनेट कनेक्शन जाँचें और देखें कि Ollama खुला है, फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduhan tidak selesai. Periksa koneksi internet Anda dan pastikan Ollama terbuka, lalu coba lagi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muat turun tidak selesai. Semak sambungan internet anda dan pastikan Ollama dibuka, kemudian cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het downloaden is niet voltooid. Controleer je internetverbinding en of Ollama open is, en probeer het opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดาวน์โหลดไม่เสร็จ โปรดตรวจสอบการเชื่อมต่ออินเทอร์เน็ตและดูว่า Ollama เปิดอยู่ แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirme tamamlanmadı. İnternet bağlantınızı ve Ollama'nın açık olduğunu kontrol edip yeniden deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈاؤن لوڈ مکمل نہیں ہوا۔ اپنا انٹرنیٹ کنکشن چیک کریں اور دیکھیں کہ Ollama کھلا ہے، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải xuống chưa xong. Hãy kiểm tra kết nối internet và đảm bảo Ollama đang mở, rồi thử lại."
          }
        }
      }
    },
