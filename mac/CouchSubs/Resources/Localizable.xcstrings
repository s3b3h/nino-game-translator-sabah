    "Could not check for updates. Check your internet connection." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحقق من وجود تحديثات. تحقق من اتصالك بالإنترنت."
