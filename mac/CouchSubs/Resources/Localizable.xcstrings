          }
        }
      }
    },
    "Ready-made Turkish translations for some games. A line found in a pack appears at once, without the translation engine." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجمات تركية جاهزة لبعض الألعاب. يظهر السطر الموجود في الحزمة فورًا، دون محرك الترجمة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ready-made Turkish translations for some games. A line found in a pack appears at once, without the translation engine."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı oyunlar için hazır Türkçe çeviriler. Pakette bulunan satır, çeviri motoruna gitmeden anında görünür."
          }
        }
      }
    },
    "No game pack is installed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
