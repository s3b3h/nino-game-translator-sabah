    "%@ is removed from this phone. To use it again, import the file again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال %@ من هذا الهاتف. لاستخدامها مجددًا، استورد الملف مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ এই ফোন থেকে সরানো হবে। আবার ব্যবহার করতে ফাইলটি আবার ইমপোর্ট করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is removed from this phone. To use it again, import the file again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inalis ang %@ sa phone na ito. Para magamit ulit, i-import ulit ang file."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इस फ़ोन से हटा दिया जाएगा। फिर से इस्तेमाल करने के लिए फ़ाइल दोबारा इंपोर्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dihapus dari ponsel ini. Untuk memakainya lagi, impor ulang filenya."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dibuang daripada telefon ini. Untuk menggunakannya semula, import fail itu sekali lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt van deze telefoon verwijderd. Wil je het weer gebruiken, importeer het bestand dan opnieuw."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ จะถูกนำออกจากโทรศัพท์เครื่องนี้ หากต้องการใช้อีก ให้นำเข้าไฟล์อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bu telefondan silinir. Yeniden kullanmak için dosyayı yeniden içe aktarmanız gerekir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ اس فون سے ہٹا دیا جائے گا۔ دوبارہ استعمال کے لیے فائل پھر سے امپورٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ bị xóa khỏi điện thoại này. Để dùng lại, hãy nhập lại tệp."
          }
        }
      }
    },
    "Nino TV on the TV is signed with another key (0.9.18 and earlier were signed with an old key) or is newer than this phone's, so this version cannot be installed over it. The button below removes the TV's copy and installs the new one; the TV app's settings are deleted. If that fails, on the TV go to Settings › Apps › Nino TV › Uninstall, then press Install and open here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق Nino TV على TV موقّع بمفتاح آخر (الإصدارات 0.9.18 وما قبلها وُقّعت بمفتاح قديم) أو أحدث من إصدار هذا الهاتف، لذا لا يمكن تثبيت هذا الإصدار فوقه. يزيل الزر أدناه نسخة TV ويثبّت النسخة الجديدة؛ وتُحذف إعدادات تطبيق TV. إذا فشل ذلك، فانتقل على TV إلى الإعدادات › التطبيقات › Nino TV › إلغاء التثبيت، ثم اضغط «التثبيت والفتح» هنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV-তে থাকা Nino TV অন্য একটি কী দিয়ে সাইন করা (0.9.18 ও আগের সংস্করণ পুরোনো কী দিয়ে সাইন করা ছিল) অথবা এই ফোনেরটির চেয়ে নতুন, তাই এই সংস্করণটি তার ওপরে ইনস্টল করা যায় না। নিচের বোতামটি TV-র কপি সরিয়ে নতুনটি ইনস্টল করে; TV অ্যাপের সেটিংস মুছে যায়। তা ব্যর্থ হলে TV-তে Settings › Apps › Nino TV › Uninstall-এ যান, তারপর এখানে ইনস্টল করে খুলুন চাপুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV on the TV is signed with another key (0.9.18 and earlier were signed with an old key) or is newer than this phone's, so this version cannot be installed over it. The button below removes the TV's copy and installs the new one; the TV app's settings are deleted. If that fails, on the TV go to Settings › Apps › Nino TV › Uninstall, then press Install and open here."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-sign gamit ang ibang key ang Nino TV sa TV (ang 0.9.18 at mas luma ay naka-sign gamit ang lumang key) o mas bago ito kaysa sa nasa phone na ito, kaya hindi ma-install ang bersyong ito sa ibabaw nito. Aalisin ng button sa ibaba ang kopya sa TV at ii-install ang bago; mabubura ang mga setting ng TV app. Kung pumalya iyon, sa TV pumunta sa Settings › Apps › Nino TV › Uninstall, saka pindutin ang I-install at buksan dito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV पर Nino TV किसी दूसरी कुंजी से साइन है (0.9.18 और पहले के वर्शन पुरानी कुंजी से साइन थे) या इस फ़ोन वाले से नया है, इसलिए यह वर्शन उसके ऊपर इंस्टॉल नहीं हो सकता। नीचे का बटन TV की कॉपी हटाकर नई इंस्टॉल करता है; TV ऐप की सेटिंग्स मिट जाएँगी। अगर यह न हो, तो TV पर सेटिंग्स › ऐप्स › Nino TV › अनइंस्टॉल पर जाएँ, फिर यहाँ इंस्टॉल करें और खोलें दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV di TV ditandatangani dengan kunci lain (versi 0.9.18 dan sebelumnya ditandatangani dengan kunci lama) atau lebih baru dari versi di ponsel ini, jadi versi ini tidak dapat dipasang di atasnya. Tombol di bawah menghapus salinan di TV dan memasang yang baru; pengaturan aplikasi TV akan dihapus. Jika gagal, di TV buka Settings › Apps › Nino TV › Uninstall, lalu tekan Pasang dan buka di sini."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV pada TV ditandatangani dengan kunci lain (0.9.18 dan lebih awal ditandatangani dengan kunci lama) atau lebih baharu daripada versi telefon ini, jadi versi ini tidak dapat dipasang di atasnya. Butang di bawah membuang salinan TV dan memasang yang baharu; tetapan apl TV akan dipadam. Jika gagal, pada TV pergi ke Settings › Apps › Nino TV › Uninstall, kemudian tekan Pasang dan buka di sini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV op de TV is ondertekend met een andere sleutel (0.9.18 en eerder zijn ondertekend met een oude sleutel) of is nieuwer dan die op deze telefoon, dus deze versie kan er niet overheen worden geïnstalleerd. De knop hieronder verwijdert de kopie op de TV en installeert de nieuwe; de instellingen van de TV-app worden gewist. Mislukt dat, ga dan op de TV naar Instellingen › Apps › Nino TV › Verwijderen en druk hier op Installeren en openen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV บน TV เซ็นด้วยคีย์อื่น (0.9.18 และก่อนหน้าเซ็นด้วยคีย์เก่า) หรือใหม่กว่าเวอร์ชันในโทรศัพท์เครื่องนี้ จึงติดตั้งเวอร์ชันนี้ทับไม่ได้ ปุ่มด้านล่างจะนำสำเนาบน TV ออกแล้วติดตั้งตัวใหม่ การตั้งค่าของแอป TV จะถูกลบ หากไม่สำเร็จ บน TV ให้ไปที่ การตั้งค่า › แอป › Nino TV › ถอนการติดตั้ง แล้วกด ติดตั้งและเปิด ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV'deki Nino TV başka bir anahtarla imzalı (0.9.18 ve önceki sürümler eski bir anahtarla imzalıydı) ya da bu telefondakinden yeni; bu sürüm onun üstüne kurulamıyor. Aşağıdaki düğme TV'deki kopyayı kaldırıp yenisini kurar; TV uygulamasının ayarları silinir. Olmazsa TV'de Ayarlar › Uygulamalar › Nino TV › Kaldır de, sonra burada Kur ve aç'a bas."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV پر موجود Nino TV کسی اور کی سے سائن ہے (0.9.18 اور اس سے پرانے ورژن پرانی کی سے سائن تھے) یا اس فون والے سے نیا ہے، اس لیے یہ ورژن اس کے اوپر انسٹال نہیں ہو سکتا۔ نیچے والا بٹن TV کی کاپی ہٹا کر نئی انسٹال کرتا ہے؛ TV ایپ کی سیٹنگز مٹ جائیں گی۔ اگر یہ ناکام ہو تو TV پر Settings › Apps › Nino TV › Uninstall پر جائیں، پھر یہاں انسٹال کریں اور کھولیں دبائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV trên TV được ký bằng khóa khác (bản 0.9.18 trở về trước được ký bằng khóa cũ) hoặc mới hơn bản trên điện thoại này, nên không thể cài phiên bản này đè lên. Nút bên dưới sẽ gỡ bản trên TV và cài bản mới; cài đặt của ứng dụng TV sẽ bị xóa. Nếu không được, trên TV hãy vào Cài đặt › Ứng dụng › Nino TV › Gỡ cài đặt, rồi nhấn Cài và mở ở đây."
          }
        }
      }
    },
    "The old Nino TV could not be removed from the TV, so the new one cannot be installed. Remove it on the TV yourself: Settings › Apps › See all apps › Nino TV › Uninstall. Then press Install and open here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إزالة Nino TV القديم من TV، لذا لا يمكن تثبيت الجديد. أزِله بنفسك على TV: الإعدادات › التطبيقات › عرض كل التطبيقات › Nino TV › إلغاء التثبيت. ثم اضغط «التثبيت والفتح» هنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরোনো Nino TV টিভি থেকে সরানো যায়নি, তাই নতুনটি ইনস্টল করা যাচ্ছে না। TV-তে নিজেই এটি সরান: Settings › Apps › See all apps › Nino TV › Uninstall। তারপর এখানে ইনস্টল করে খুলুন চাপুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old Nino TV could not be removed from the TV, so the new one cannot be installed. Remove it on the TV yourself: Settings › Apps › See all apps › Nino TV › Uninstall. Then press Install and open here."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi maalis sa TV ang lumang Nino TV, kaya hindi ma-install ang bago. Ikaw na ang mag-alis nito sa TV: Settings › Apps › See all apps › Nino TV › Uninstall. Saka pindutin ang I-install at buksan dito."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुराना Nino TV, TV से हटाया नहीं जा सका, इसलिए नया इंस्टॉल नहीं हो सकता। इसे TV पर खुद हटाएँ: सेटिंग्स › ऐप्स › सभी ऐप्स देखें › Nino TV › अनइंस्टॉल। फिर यहाँ इंस्टॉल करें और खोलें दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV lama tidak dapat dihapus dari TV, jadi yang baru tidak dapat dipasang. Hapus sendiri di TV: Settings › Apps › See all apps › Nino TV › Uninstall. Lalu tekan Pasang dan buka di sini."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV lama tidak dapat dibuang daripada TV, jadi yang baharu tidak dapat dipasang. Buangnya sendiri pada TV: Settings › Apps › See all apps › Nino TV › Uninstall. Kemudian tekan Pasang dan buka di sini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De oude Nino TV kon niet van de TV worden verwijderd, dus de nieuwe kan niet worden geïnstalleerd. Verwijder hem zelf op de TV: Instellingen › Apps › Alle apps bekijken › Nino TV › Verwijderen. Druk daarna hier op Installeren en openen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นำ Nino TV ตัวเก่าออกจาก TV ไม่ได้ จึงติดตั้งตัวใหม่ไม่ได้ โปรดนำออกบน TV ด้วยตัวเอง: การตั้งค่า › แอป › ดูแอปทั้งหมด › Nino TV › ถอนการติดตั้ง แล้วกด ติดตั้งและเปิด ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV'deki eski Nino TV kaldırılamadı, bu yüzden yenisi kurulamıyor. TV'de kendin kaldır: Ayarlar › Uygulamalar › Tüm uygulamalar › Nino TV › Kaldır. Sonra burada Kur ve aç'a bas."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرانا Nino TV، TV سے ہٹایا نہیں جا سکا، اس لیے نیا انسٹال نہیں ہو سکتا۔ اسے TV پر خود ہٹائیں: Settings › Apps › See all apps › Nino TV › Uninstall۔ پھر یہاں انسٹال کریں اور کھولیں دبائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gỡ được Nino TV cũ khỏi TV, nên không thể cài bản mới. Hãy tự gỡ trên TV: Cài đặt › Ứng dụng › Xem tất cả ứng dụng › Nino TV › Gỡ cài đặt. Sau đó nhấn Cài và mở ở đây."
          }
        }
      }
    },
    "Selected window" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
