        }
      }
    },
    "This Microsoft account has no Xbox profile. Sign in with the account you use on your Xbox." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد ملف Xbox في حساب Microsoft هذا. سجّل الدخول بالحساب الذي تستخدمه على Xbox."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই Microsoft অ্যাকাউন্টে কোনো Xbox প্রোফাইল নেই। Xbox-এ যে অ্যাকাউন্ট ব্যবহার করেন সেটি দিয়ে সাইন ইন করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Microsoft account has no Xbox profile. Sign in with the account you use on your Xbox."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang Xbox profile ang Microsoft account na ito. Mag-sign in gamit ang account na ginagamit mo sa Xbox."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Microsoft अकाउंट की कोई Xbox प्रोफ़ाइल नहीं है। उस अकाउंट से साइन इन करें जो आप अपने Xbox पर इस्तेमाल करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun Microsoft ini tidak punya profil Xbox. Masuk dengan akun yang Anda pakai di Xbox."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akaun Microsoft ini tiada profil Xbox. Log masuk dengan akaun yang anda gunakan pada Xbox."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit Microsoft-account heeft geen Xbox-profiel. Log in met het account dat je op je Xbox gebruikt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชี Microsoft นี้ไม่มีโปรไฟล์ Xbox ลงชื่อเข้าใช้ด้วยบัญชีที่คุณใช้บน Xbox"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Microsoft hesabının Xbox profili yok. Xbox'ta kullandığınız hesapla giriş yapın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس Microsoft اکاؤنٹ کا کوئی Xbox پروفائل نہیں۔ اس اکاؤنٹ سے سائن ان کریں جو آپ Xbox پر استعمال کرتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản Microsoft này không có hồ sơ Xbox. Hãy đăng nhập bằng tài khoản bạn dùng trên Xbox."
          }
        }
      }
    },
    "Couldn't connect to the internet. Check your connection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الاتصال بالإنترنت. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেটে সংযোগ করা যায়নি। আপনার সংযোগ পরীক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to the internet. Check your connection and try again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi makakonekta sa internet. Suriin ang iyong koneksyon at subukan ulit."
