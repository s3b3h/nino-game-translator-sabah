        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปสตรีมของคุณไม่รับ localhost (เช่น TikTok LIVE Studio) ใช่ไหม ใช้ที่อยู่นี้พร้อมที่อยู่เครือข่ายของคอมพิวเตอร์:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yayın programınız localhost'u kabul etmiyor mu (ör. TikTok LIVE Studio)? Bilgisayarın ağ adresiyle bu adresi kullanın:"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی اسٹریمنگ ایپ localhost قبول نہیں کرتی (مثلاً TikTok LIVE Studio)؟ یہ ایڈریس کمپیوٹر کے نیٹ ورک ایڈریس کے ساتھ استعمال کریں:"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng phát trực tiếp của bạn không chấp nhận localhost (ví dụ TikTok LIVE Studio)? Hãy dùng địa chỉ này với địa chỉ mạng của máy tính:"
          }
        }
      }
    },
