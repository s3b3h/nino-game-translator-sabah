    "The Remote Play window comes through black: this app may block screen capture. Try chiaki-ng." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر نافذة Remote Play سوداء: قد يمنع هذا التطبيق التقاط الشاشة. جرّب chiaki-ng."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Play উইন্ডোটি কালো আসছে: এই অ্যাপটি হয়তো স্ক্রিন ক্যাপচার আটকে দেয়। chiaki-ng চেষ্টা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Remote Play window comes through black: this app may block screen capture. Try chiaki-ng."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itim ang lumalabas sa Remote Play window: baka hinaharangan ng app na ito ang screen capture. Subukan ang chiaki-ng."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Play विंडो काली आ रही है: यह ऐप स्क्रीन कैप्चर रोक सकता है। chiaki-ng आज़माएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jendela Remote Play tampil hitam: aplikasi ini mungkin memblokir tangkapan layar. Coba chiaki-ng."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetingkap Remote Play kelihatan hitam: apl ini mungkin menyekat tangkapan skrin. Cuba chiaki-ng."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het Remote Play-venster komt zwart door: deze app blokkeert misschien schermopname. Probeer chiaki-ng."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าต่าง Remote Play เป็นภาพดำ: แอปนี้อาจบล็อกการจับภาพหน้าจอ ลองใช้ chiaki-ng"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Play penceresi siyah geliyor: bu uygulama ekran yakalamayı engelliyor olabilir. chiaki-ng'yi dene."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Play ونڈو سیاہ آ رہی ہے: یہ ایپ شاید اسکرین کیپچر روکتی ہے۔ chiaki-ng آزمائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ Remote Play hiện màu đen: ứng dụng này có thể chặn chụp màn hình. Hãy thử chiaki-ng."
          }
        }
      }
    },
