    "Add a community translation file (JSON, TXT or bilingual SRT) as a game pack. The file stays on this phone and is not sent anywhere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف ملف ترجمة من المجتمع (JSON أو TXT أو SRT ثنائي اللغة) بوصفه حزمة لعبة. يبقى الملف على هذا الهاتف ولا يُرسَل إلى أي مكان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি কমিউনিটি অনুবাদ ফাইল (JSON, TXT বা দ্বিভাষিক SRT) গেম প্যাক হিসেবে যোগ করুন। ফাইলটি এই ফোনেই থাকে এবং কোথাও পাঠানো হয় না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a community translation file (JSON, TXT or bilingual SRT) as a game pack. The file stays on this phone and is not sent anywhere."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng community translation file (JSON, TXT o bilingual na SRT) bilang game pack. Nananatili ang file sa phone na ito at hindi ipinapadala kahit saan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम्युनिटी की अनुवाद फ़ाइल (JSON, TXT या दो भाषाओं वाली SRT) गेम पैक के रूप में जोड़ें। फ़ाइल इसी फ़ोन पर रहती है और कहीं नहीं भेजी जाती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan file terjemahan komunitas (JSON, TXT, atau SRT dwibahasa) sebagai paket game. File tetap di ponsel ini dan tidak dikirim ke mana pun."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah fail terjemahan komuniti (JSON, TXT atau SRT dwibahasa) sebagai pek permainan. Fail kekal pada telefon ini dan tidak dihantar ke mana-mana."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een vertaalbestand uit de community (JSON, TXT of tweetalige SRT) toe als gamepakket. Het bestand blijft op deze telefoon en wordt nergens heen gestuurd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มไฟล์คำแปลจากชุมชน (JSON, TXT หรือ SRT สองภาษา) เป็นแพ็กเกม ไฟล์จะอยู่ในโทรศัพท์เครื่องนี้และไม่ถูกส่งไปที่ใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topluluk çeviri dosyasını (JSON, TXT ya da iki dilli SRT) oyun paketi olarak ekleyin. Dosya bu telefonda kalır, hiçbir yere gönderilmez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمیونٹی کی ترجمہ فائل (JSON، TXT یا دو لسانی SRT) کو گیم پیک کے طور پر شامل کریں۔ فائل اسی فون پر رہتی ہے اور کہیں نہیں بھیجی جاتی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm tệp bản dịch của cộng đồng (JSON, TXT hoặc SRT song ngữ) làm gói game. Tệp được giữ trên điện thoại này và không gửi đi đâu cả."
          }
        }
      }
    },
