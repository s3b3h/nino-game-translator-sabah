    "Installs the Nino TV app on your Samsung TV from this phone, without a computer. The phone and the TV must be on the same Wi-Fi." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يثبّت تطبيق Nino على Samsung TV من هذا الهاتف، دون كمبيوتر. يجب أن يكون الهاتف وTV على شبكة Wi‑Fi نفسها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কম্পিউটার ছাড়াই এই ফোন থেকে আপনার Samsung TV-তে Nino TV অ্যাপ ইনস্টল করে। ফোন ও TV একই Wi-Fi-তে থাকতে হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installs the Nino TV app on your Samsung TV from this phone, without a computer. The phone and the TV must be on the same Wi-Fi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini-install ang Nino TV app sa iyong Samsung TV mula sa phone na ito, nang walang computer. Dapat nasa parehong Wi-Fi ang phone at ang TV."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ोन से, बिना कंप्यूटर के, आपके Samsung TV पर Nino TV ऐप इंस्टॉल करता है। फ़ोन और TV एक ही Wi-Fi पर होने चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memasang aplikasi Nino TV di TV Samsung Anda dari ponsel ini, tanpa komputer. Ponsel dan TV harus berada di Wi-Fi yang sama."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memasang apl TV Nino pada TV Samsung anda daripada telefon ini, tanpa komputer. Telefon dan TV mesti berada pada Wi-Fi yang sama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeert de Nino TV-app op je Samsung-TV vanaf deze telefoon, zonder computer. De telefoon en de TV moeten op hetzelfde wifinetwerk zitten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตั้งแอป Nino บน TV Samsung จากโทรศัพท์เครื่องนี้ ไม่ต้องใช้คอมพิวเตอร์ โทรศัพท์และ TV ต้องอยู่ใน Wi-Fi เดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nino TV uygulamasını Samsung TV'nize bilgisayar olmadan, bu telefondan kurar. Telefon ve TV aynı Wi-Fi'da olmalı."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس فون سے، کمپیوٹر کے بغیر، آپ کے Samsung TV پر Nino TV ایپ انسٹال کرتا ہے۔ فون اور TV ایک ہی Wi-Fi پر ہونے چاہییں۔"
          }
        },
        "vi" : {
