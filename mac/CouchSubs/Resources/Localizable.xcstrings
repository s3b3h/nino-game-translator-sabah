    "Num 0 or Ctrl+Shift+0 pauses or resumes the live subtitle translation, which helps when you translate areas." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف Num 0 أو Ctrl+Shift+0 الترجمة المباشرة مؤقتًا أو يستأنفها، وهذا مفيد عند ترجمة المناطق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num 0 বা Ctrl+Shift+0 লাইভ সাবটাইটেল অনুবাদ থামায় বা আবার চালু করে, যা এলাকা অনুবাদের সময় কাজে আসে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num 0 or Ctrl+Shift+0 pauses or resumes the live subtitle translation, which helps when you translate areas."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang Num 0 o Ctrl+Shift+0 ay nagpapahinto o nagpapatuloy sa live na pagsasalin ng subtitle, na nakakatulong kapag nagsasalin ka ng mga area."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num 0 या Ctrl+Shift+0 लाइव सबटाइटल अनुवाद को रोकता या फिर से शुरू करता है, जो क्षेत्रों का अनुवाद करते समय मदद करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num 0 atau Ctrl+Shift+0 menjeda atau melanjutkan terjemahan subtitle langsung, berguna saat Anda menerjemahkan area."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num 0 atau Ctrl+Shift+0 menjeda atau menyambung semula terjemahan sari kata langsung, yang membantu semasa anda menterjemah kawasan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num 0 of Ctrl+Shift+0 pauzeert of hervat de live vertaling van ondertitels, wat handig is als je gebieden vertaalt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num 0 หรือ Ctrl+Shift+0 จะหยุดชั่วคราวหรือเล่นต่อการแปลคำบรรยายสด ซึ่งช่วยได้เมื่อคุณแปลพื้นที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num 0 ya da Ctrl+Shift+0 canlı altyazı çevirisini duraklatır veya sürdürür; alan çevirirken işe yarar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num 0 یا Ctrl+Shift+0 لائیو سب ٹائٹل ترجمہ روکتا یا دوبارہ شروع کرتا ہے، جو حصوں کا ترجمہ کرتے وقت مددگار ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num 0 hoặc Ctrl+Shift+0 tạm dừng hoặc tiếp tục dịch phụ đề trực tiếp, tiện khi bạn dịch các vùng."
          }
        }
      }
    },
