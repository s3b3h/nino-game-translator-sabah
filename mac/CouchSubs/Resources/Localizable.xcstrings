            "value" : "Geliştirici modu açık. TV uygulamasını kurmak için son bir adım kaldı:"
          }
        }
      }
    },
    "Developer Mode: %lld hours left. Nino extends it by itself each time you use it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع المطوّر: المدة المتبقية %lld ساعة. يمدّده Nino تلقائيًا في كل مرة تستخدمه فيها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Developer Mode: %lld hours left. Nino extends it by itself each time you use it."
