    "Ready-made Turkish translations for some games. A line found in a pack appears at once, without the translation engine." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجمات تركية جاهزة لبعض الألعاب. يظهر السطر الموجود في الحزمة فورًا، دون محرك الترجمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু গেমের জন্য তৈরি তুর্কি অনুবাদ। প্যাকে পাওয়া লাইন অনুবাদ ইঞ্জিন ছাড়াই সঙ্গে সঙ্গে দেখায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ready-made Turkish translations for some games. A line found in a pack appears at once, without the translation engine."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga handang Turkish na salin para sa ilang laro. Agad na lumalabas ang linyang nahanap sa isang pack, nang walang translation engine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ गेम्स के लिए तैयार तुर्की अनुवाद। पैक में मिली लाइन बिना अनुवाद इंजन के तुरंत दिखती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan bahasa Turki siap pakai untuk beberapa game. Baris yang ada di paket langsung muncul, tanpa mesin terjemahan."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan bahasa Turki siap sedia untuk sesetengah permainan. Baris yang ditemui dalam pek dipaparkan serta-merta, tanpa enjin terjemahan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kant-en-klare Turkse vertalingen voor sommige games. Een regel uit een pakket verschijnt meteen, zonder de vertaalmachine."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำแปลภาษาตุรกีสำเร็จรูปสำหรับบางเกม บรรทัดที่พบในแพ็กจะแสดงทันทีโดยไม่ต้องใช้เอนจินแปล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı oyunlar için hazır Türkçe çeviriler. Pakette bulunan satır, çeviri motoruna gitmeden anında görünür."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کچھ گیمز کے لیے تیار ترکی ترجمے۔ پیک میں ملنے والی لائن ترجمہ انجن کے بغیر فوراً دکھائی دیتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dịch tiếng Thổ Nhĩ Kỳ có sẵn cho một số game. Dòng có trong gói sẽ hiện ngay, không cần công cụ dịch."
          }
        }
      }
    },
