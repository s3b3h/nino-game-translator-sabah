            "state" : "translated",
            "value" : "Nag-expire na ang code. Subukan ulit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोड की अवधि खत्म हो गई। फिर से कोशिश करें।"
