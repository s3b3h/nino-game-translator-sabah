          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดฟีเจอร์ระยะไกลบน Xbox"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox'ta Uzak Özellikleri Açın"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox پر Remote Features آن کریں"
          }
