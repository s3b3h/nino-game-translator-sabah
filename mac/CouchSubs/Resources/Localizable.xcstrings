    },
    "The TV app is not installed. Nino installs it over the network once debugging is on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق التلفاز غير مثبّت. يثبّته Nino عبر الشبكة بعد تفعيل تصحيح الأخطاء."
          }
        },
