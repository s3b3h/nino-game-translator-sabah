    "ob.p1.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة عربية لألعاب PS5"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 গেমের জন্য সাবটাইটেল"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitles for PS5 Games"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga Subtitle para sa mga PS5 Game"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 गेम्स के लिए सबटाइटल"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitle untuk Game PS5"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sari Kata untuk Permainan PS5"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondertitels voor PS5-games"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำบรรยายสำหรับเกม PS5"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 Oyunlarına Türkçe Altyazı"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 گیمز کے لیے سب ٹائٹلز"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ đề cho game PS5"
          }
        }
      }
    },
    "ob.p1.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ هاتفك الترجمة الإنجليزية في اللعبة ويترجمها ويعرضها على التلفاز أو على شاشته، وتواصل اللعب دون أن تترك يد التحكم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফোন গেমের ইংরেজি সাবটাইটেল পড়ে, অনুবাদ করে এবং TV-তে বা নিজের স্ক্রিনে দেখায়। কন্ট্রোলার না নামিয়েই আপনি খেলা চালিয়ে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone reads the English subtitles in the game, translates them and shows them on the TV or on its own screen. You keep playing without putting the controller down."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binabasa ng iyong telepono ang mga English na subtitle sa laro, isinasalin ang mga ito at ipinapakita sa TV o sa sarili nitong screen. Patuloy kang naglalaro nang hindi binibitawan ang controller."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ोन गेम के अंग्रेज़ी सबटाइटल पढ़ता है, उनका अनुवाद करता है और उन्हें TV पर या अपनी स्क्रीन पर दिखाता है। आप कंट्रोलर छोड़े बिना खेलते रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel Anda membaca subtitle bahasa Inggris di game, menerjemahkannya, dan menampilkannya di TV atau di layarnya sendiri. Anda tetap bermain tanpa melepas kontroler."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon anda membaca sari kata bahasa Inggeris dalam permainan, menterjemahkannya dan memaparkannya pada TV atau pada skrinnya sendiri. Anda terus bermain tanpa meletakkan alat kawalan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon leest de Engelse ondertitels in de game, vertaalt ze en toont ze op de TV of op zijn eigen scherm. Je speelt verder zonder de controller neer te leggen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์ของคุณจะอ่านคำบรรยายภาษาอังกฤษในเกม แปล แล้วแสดงบน TV หรือบนหน้าจอโทรศัพท์เอง คุณเล่นต่อได้โดยไม่ต้องวางคอนโทรลเลอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz oyundaki İngilizce altyazıyı okur, çevirir ve TV'de ya da kendi ekranında gösterir. Siz kolu bırakmadan oynamaya devam edersiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا فون گیم کے انگریزی سب ٹائٹلز پڑھتا ہے، ان کا ترجمہ کرتا ہے اور انہیں TV یا اپنی اسکرین پر دکھاتا ہے۔ آپ کنٹرولر رکھے بغیر کھیلتے رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại của bạn đọc phụ đề tiếng Anh trong game, dịch và hiển thị trên TV hoặc trên chính màn hình điện thoại. Bạn vẫn chơi tiếp mà không cần đặt tay cầm xuống."
          }
        }
      }
    },
    "ob.p2.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
