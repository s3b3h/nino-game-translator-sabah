    "psn.whyBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام Remote Play بحسابك الخاص يستولي على يد التحكم ويوقف لعبتك. أما مع حساب ثانٍ مجاني فيسمح PS5 للهاتف بمشاهدة الصورة بينما تواصل اللعب على التلفاز. أنشئه على PS5 (إضافة مستخدم) أو في playstation.com."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজের অ্যাকাউন্টে Remote Play করলে তা আপনার কন্ট্রোলার দখল করে গেম থামিয়ে দিত। একটি বিনামূল্যের দ্বিতীয় অ্যাকাউন্ট থাকলে PS5 ফোনকে ছবি দেখতে দেয়, আর আপনি TV-তে খেলা চালিয়ে যান। এটি PS5-এ (Add User) বা playstation.com-এ খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play with your own account would take over your controller and stop your game. With a second, free account the PS5 lets the phone watch the picture while you keep playing on the TV. Create it on the PS5 (Add User) or at playstation.com."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung sarili mong account ang gagamitin sa Remote Play, aagawin nito ang iyong controller at ihihinto ang iyong laro. Sa pangalawa at libreng account, hinahayaan ng PS5 na panoorin ng telepono ang larawan habang patuloy kang naglalaro sa TV. Gawin ito sa PS5 (Add User) o sa playstation.com."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अपने अकाउंट से Remote Play आपके कंट्रोलर को अपने कब्ज़े में ले लेगा और आपका गेम रोक देगा। एक दूसरे, मुफ़्त अकाउंट के साथ PS5 फ़ोन को तस्वीर देखने देता है, जबकि आप TV पर खेलते रहते हैं। इसे PS5 पर (Add User) या playstation.com पर बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play dengan akun Anda sendiri akan mengambil alih kontroler dan menghentikan game Anda. Dengan akun kedua yang gratis, PS5 membiarkan ponsel melihat gambar sementara Anda tetap bermain di TV. Buat akun ini di PS5 (Tambahkan Pengguna) atau di playstation.com."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play dengan akaun anda sendiri akan mengambil alih alat kawalan anda dan menghentikan permainan anda. Dengan akaun kedua yang percuma, PS5 membenarkan telefon melihat gambar semasa anda terus bermain pada TV. Ciptanya pada PS5 (Add User) atau di playstation.com."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play met je eigen account zou je controller overnemen en je game stoppen. Met een tweede, gratis account laat de PS5 de telefoon het beeld bekijken terwijl jij verder speelt op de TV. Maak het aan op de PS5 (Voeg gebruiker toe) of op playstation.com."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้ Remote Play ด้วยบัญชีของคุณเองจะดึงคอนโทรลเลอร์ไปและหยุดเกมของคุณ เมื่อใช้บัญชีที่สองแบบฟรี PS5 จะให้โทรศัพท์ดูภาพได้ขณะที่คุณเล่นต่อบน TV สร้างบัญชีได้บน PS5 (เพิ่มผู้ใช้) หรือที่ playstation.com"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi hesabınızla Remote Play kolunuzu devralır ve oyununuzu durdurur. Ücretsiz ikinci bir hesapla PS5, siz TV'de oynarken telefonun görüntüyü izlemesine izin verir. Hesabı PS5'te (Kullanıcı Ekle) ya da playstation.com'da açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے اکاؤنٹ سے Remote Play آپ کا کنٹرولر سنبھال لیتا اور گیم روک دیتا۔ دوسرے مفت اکاؤنٹ کے ساتھ PS5 فون کو تصویر دیکھنے دیتا ہے جبکہ آپ TV پر کھیلتے رہتے ہیں۔ اسے PS5 پر (Add User) یا playstation.com پر بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng Remote Play bằng tài khoản của chính bạn sẽ chiếm tay cầm và dừng game của bạn. Với tài khoản thứ hai miễn phí, PS5 cho phép điện thoại xem hình ảnh trong khi bạn vẫn chơi trên TV. Hãy tạo tài khoản trên PS5 (Thêm người dùng) hoặc tại playstation.com."
          }
        }
      }
    },
