        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone connects to the PS5 with Remote Play. Sign in with a free second PSN account, separate from the one you play with."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon PS5'e Remote Play ile bağlanır. Oynadığınız hesaptan ayrı, ücretsiz ikinci bir PSN hesabıyla giriş yapın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل الهاتف بجهاز PS5 عبر Remote Play. سجّل الدخول بحساب PSN ثانٍ مجاني منفصل عن الحساب الذي تلعب به."
          }
        }
      }
    },
