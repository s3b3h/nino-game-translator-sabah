      }
    },
    "ob.p1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone reads the English subtitles in the game, translates them and shows them on the TV or on its own screen. You keep playing without putting the controller down."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz oyundaki İngilizce altyazıyı okur, çevirir ve TV'de ya da kendi ekranında gösterir. Siz kolu bırakmadan oynamaya devam edersiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ هاتفك الترجمة الإنجليزية في اللعبة ويترجمها ويعرضها على التلفاز أو على شاشته، وتواصل اللعب دون أن تترك يد التحكم."
          }
        }
      }
    },
    "ob.p2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantly With Ready Packs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır Paketlerle Anında"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فورًا مع الحزم الجاهزة"
          }
        }
      }
    },
    "ob.p2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole text of popular games is already translated. Subtitles come without waiting, even offline. In other games the free translation works."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popüler oyunların bütün metni önceden çevrildi. Altyazı beklemeden, internetsiz bile gelir. Diğer oyunlarda ücretsiz çeviri çalışır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصوص الألعاب الشهيرة مترجمة مسبقًا إلى التركية. وفي الألعاب الأخرى وفي العربية تعمل الترجمة المجانية."
          }
        }
      }
    },
