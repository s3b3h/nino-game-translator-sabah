    "psn.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل الهاتف بجهاز PS5 عبر Remote Play. سجّل الدخول بحساب PSN ثانٍ مجاني منفصل عن الحساب الذي تلعب به."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন Remote Play দিয়ে PS5-এ সংযোগ করে। আপনি যে অ্যাকাউন্টে খেলেন তা ছাড়া একটি বিনামূল্যের দ্বিতীয় PSN অ্যাকাউন্ট দিয়ে সাইন ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone connects to the PS5 with Remote Play. Sign in with a free second PSN account, separate from the one you play with."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumokonekta ang telepono sa PS5 gamit ang Remote Play. Mag-sign in gamit ang libreng pangalawang PSN account, hiwalay sa ginagamit mo sa paglalaro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन Remote Play से PS5 से कनेक्ट होता है। जिस अकाउंट से आप खेलते हैं, उससे अलग एक मुफ़्त दूसरे PSN अकाउंट से साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel terhubung ke PS5 dengan Remote Play. Masuk dengan akun PSN kedua yang gratis, terpisah dari akun yang Anda gunakan untuk bermain."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon menyambung ke PS5 dengan Remote Play. Log masuk dengan akaun PSN kedua yang percuma, berasingan daripada akaun yang anda gunakan untuk bermain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De telefoon verbindt met de PS5 via Remote Play. Log in met een gratis tweede PSN-account, los van het account waarmee je speelt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์จะเชื่อมต่อกับ PS5 ผ่าน Remote Play โปรดลงชื่อเข้าด้วยบัญชี PSN บัญชีที่สองแบบฟรี ซึ่งแยกจากบัญชีที่คุณใช้เล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon PS5'e Remote Play ile bağlanır. Oynadığınız hesaptan ayrı, ücretsiz ikinci bir PSN hesabıyla giriş yapın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون Remote Play کے ذریعے PS5 سے جڑتا ہے۔ ایک مفت دوسرے PSN اکاؤنٹ سے سائن اِن کریں، جو آپ کے کھیلنے والے اکاؤنٹ سے الگ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại kết nối với PS5 qua Remote Play. Hãy đăng nhập bằng một tài khoản PSN thứ hai miễn phí, khác với tài khoản bạn dùng để chơi."
          }
        }
      }
    },
