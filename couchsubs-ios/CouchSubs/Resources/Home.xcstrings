    "ob.p3.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض الترجمة على التلفاز فوق اللعبة أو بخط كبير على هاتفك. يستغرق الإعداد بضع دقائق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবটাইটেল গেমের ওপরে TV-তে দেখান, অথবা ফোনে বড় লেখায়। সেটআপে কয়েক মিনিট লাগে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the subtitles on the TV over the game, or in large text on your phone. Setup takes a few minutes."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipakita ang mga subtitle sa TV sa ibabaw ng laro, o nang malaki sa iyong telepono. Ilang minuto lang ang setup."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबटाइटल TV पर गेम के ऊपर दिखाएँ, या अपने फ़ोन पर बड़े टेक्स्ट में। सेटअप में कुछ मिनट लगते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan subtitle di TV di atas game, atau dengan teks besar di ponsel Anda. Penyiapan hanya butuh beberapa menit."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paparkan sari kata pada TV di atas permainan, atau dalam teks besar pada telefon anda. Persediaan mengambil masa beberapa minit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon de ondertitels op de TV over de game, of in grote tekst op je telefoon. De configuratie duurt een paar minuten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงคำบรรยายบน TV ซ้อนทับเกม หรือเป็นตัวอักษรขนาดใหญ่บนโทรศัพท์ การตั้งค่าใช้เวลาเพียงไม่กี่นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazıyı oyunun üstünde TV'de ya da telefonunuzda büyük yazıyla gösterin. Kurulum birkaç dakika sürer."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب ٹائٹلز TV پر گیم کے اوپر، یا اپنے فون پر بڑے متن میں دکھائیں۔ سیٹ اپ میں چند منٹ لگتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị phụ đề trên TV phía trên game, hoặc chữ lớn trên điện thoại. Thiết lập chỉ mất vài phút."
          }
        }
      }
    },
