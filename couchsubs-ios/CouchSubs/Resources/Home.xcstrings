    "pair.searching.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل PS5 أو اتركه في وضع الراحة على شبكة Wi-Fi نفسها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 চালু করুন বা রেস্ট মোডে রাখুন, একই Wi-Fi-তে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the PS5 on or leave it in rest mode, on the same Wi-Fi"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang PS5 o iwan itong naka-rest mode, sa parehong Wi-Fi"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 चालू करें या रेस्ट मोड में छोड़ दें, उसी Wi-Fi पर"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan PS5 atau biarkan dalam mode istirahat, di Wi-Fi yang sama"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan PS5 atau biarkan dalam mod rehat, pada Wi-Fi yang sama"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de PS5 aan of laat hem in de rustmodus, op hetzelfde wifinetwerk"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด PS5 หรือปล่อยไว้ในโหมดพัก โดยอยู่ใน Wi-Fi เดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'i açın ya da dinlenme modunda bırakın; aynı Wi-Fi'da olsun"
          }
