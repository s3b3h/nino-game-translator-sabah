    "ob.p1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitles for PS5 Games"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 Oyunlarına Türkçe Altyazı"
          }
        },
