            "value": "Direct met kant-en-klare pakketten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทันทีด้วยแพ็กสำเร็จรูป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır Paketlerle Anında"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
