    "pair.code.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمز صالح لمدة 5 دقائق. إذا حدثت مشكلة يظهر سببها هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোডটি ৫ মিনিট বৈধ থাকে। কোনো সমস্যা হলে কারণ এখানে দেখানো হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is valid for 5 minutes. If something goes wrong, the reason is shown here."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid ang code nang 5 minuto. Kung may magkamali, ipapakita rito ang dahilan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड 5 मिनट तक मान्य है। अगर कुछ ग़लत होता है, तो कारण यहाँ दिखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode berlaku selama 5 menit. Jika ada masalah, penyebabnya ditampilkan di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod sah selama 5 minit. Jika berlaku masalah, sebabnya dipaparkan di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code is 5 minuten geldig. Als er iets misgaat, zie je hier de reden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสใช้ได้ 5 นาที หากมีปัญหา สาเหตุจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod 5 dakika geçerlidir. Bir sorun olursa nedeni burada görünür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوڈ 5 منٹ تک درست رہتا ہے۔ اگر کچھ غلط ہو تو وجہ یہاں دکھائی جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã có hiệu lực trong 5 phút. Nếu có lỗi, lý do sẽ hiển thị ở đây."
          }
        }
      }
    },
    "pair.connecting": {
