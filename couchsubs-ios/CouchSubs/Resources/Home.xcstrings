          }
        }
      }
    },
    "ob.p2.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصوص الألعاب الشهيرة مترجمة مسبقًا إلى التركية. وفي الألعاب الأخرى وفي العربية تعمل الترجمة المجانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জনপ্রিয় গেমের পুরো লেখা আগে থেকেই অনুবাদ করা। সাবটাইটেল অপেক্ষা ছাড়াই আসে, অফলাইনেও। অন্য গেমে বিনামূল্যের অনুবাদ কাজ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole text of popular games is already translated. Subtitles come without waiting, even offline. In other games the free translation works."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naisalin na ang buong text ng mga sikat na laro. Dumarating ang mga subtitle nang walang paghihintay, kahit offline. Sa ibang laro, gumagana ang libreng salin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकप्रिय गेम्स का पूरा टेक्स्ट पहले से अनुवादित है। सबटाइटल बिना इंतज़ार के आते हैं, ऑफ़लाइन भी। दूसरे गेम्स में मुफ़्त अनुवाद काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh teks game populer sudah diterjemahkan. Subtitle muncul tanpa menunggu, bahkan saat offline. Di game lain, terjemahan gratis yang bekerja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keseluruhan teks permainan popular sudah diterjemah. Sari kata tiba tanpa menunggu, walaupun di luar talian. Dalam permainan lain, terjemahan percuma digunakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hele tekst van populaire games is al vertaald. Ondertitels komen zonder wachten, zelfs offline. In andere games werkt de gratis vertaling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความทั้งหมดของเกมยอดนิยมแปลไว้แล้ว คำบรรยายมาทันทีแม้ออฟไลน์ ในเกมอื่นๆ จะใช้การแปลฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popüler oyunların bütün metni önceden çevrildi. Altyazı beklemeden, internetsiz bile gelir. Diğer oyunlarda ücretsiz çeviri çalışır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقبول گیمز کا پورا متن پہلے سے ترجمہ شدہ ہے۔ سب ٹائٹلز بغیر انتظار کے آتے ہیں، آف لائن بھی۔ دوسری گیمز میں مفت ترجمہ کام کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ văn bản của các game phổ biến đã được dịch sẵn. Phụ đề đến ngay, kể cả khi ngoại tuyến. Với game khác, bản dịch miễn phí sẽ hoạt động."
          }
        }
      }
    },
