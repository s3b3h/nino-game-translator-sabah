    "ob.p3.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الشاشة التي تريدها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পছন্দের স্ক্রিনে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the Screen You Want"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Screen na Gusto Mo"
          }
        },
        "hi": {
          "stringUnit": {
