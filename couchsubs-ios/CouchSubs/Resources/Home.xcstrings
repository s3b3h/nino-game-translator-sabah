    "pair.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the PS5, with the second account, choose Settings › System › Remote Play › Pair Device and type the code on the screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'te ikinci hesapla Ayarlar › Sistem › Uzaktan Oynatma › Cihazı Eşle'yi seçin ve ekranda görünen kodu girin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على PS5 وبالحساب الثاني، اختر الإعدادات › النظام › التشغيل عن بُعد › إقران جهاز، ثم أدخل الرمز الظاهر على الشاشة."
          }
        }
      }
    },
