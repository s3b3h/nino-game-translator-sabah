    "ob.p3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the subtitles on the TV over the game, or in large text on your phone. Setup takes a few minutes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazıyı oyunun üstünde TV'de ya da telefonunuzda büyük yazıyla gösterin. Kurulum birkaç dakika sürer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض الترجمة على التلفاز فوق اللعبة أو بخط كبير على هاتفك. يستغرق الإعداد بضع دقائق."
          }
        }
      }
    },
