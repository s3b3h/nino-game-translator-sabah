    "pair.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على PS5 وبالحساب الثاني، اختر الإعدادات › النظام › التشغيل عن بُعد › إقران جهاز، ثم أدخل الرمز الظاهر على الشاشة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5-এ দ্বিতীয় অ্যাকাউন্টে Settings › System › Remote Play › Pair Device বেছে নিন এবং স্ক্রিনের কোডটি লিখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the PS5, with the second account, choose Settings › System › Remote Play › Pair Device and type the code on the screen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa PS5, gamit ang pangalawang account, piliin ang Settings › System › Remote Play › Pair Device at i-type ang code na nasa screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 पर, दूसरे अकाउंट से, Settings › System › Remote Play › Pair Device चुनें और स्क्रीन पर दिया कोड टाइप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di PS5, dengan akun kedua, pilih Pengaturan › Sistem › Remote Play › Pasangkan Perangkat dan ketik kode yang tampil di layar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada PS5, dengan akaun kedua, pilih Settings › System › Remote Play › Pair Device dan taipkan kod yang dipaparkan pada skrin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies op de PS5, met het tweede account, Instellingen › Systeem › Remote Play › Apparaat koppelen en typ de code van het scherm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน PS5 ด้วยบัญชีที่สอง ให้เลือก การตั้งค่า › ระบบ › Remote Play › จับคู่อุปกรณ์ แล้วพิมพ์รหัสที่แสดงบนหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'te ikinci hesapla Ayarlar › Sistem › Uzaktan Oynama › Cihazı Eşleştir'i seçin ve ekranda görünen kodu girin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 پر دوسرے اکاؤنٹ کے ساتھ Settings › System › Remote Play › Pair Device منتخب کریں اور اسکرین والا کوڈ لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên PS5, với tài khoản thứ hai, chọn Cài đặt › Hệ thống › Remote Play › Ghép nối thiết bị và nhập mã hiển thị trên màn hình."
          }
        }
      }
    },
