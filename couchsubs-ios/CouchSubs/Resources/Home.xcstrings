    "target.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تغيير ذلك لاحقًا من الشاشة الرئيسية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরে হোম স্ক্রিনে এটি বদলাতে পারবেন।"
