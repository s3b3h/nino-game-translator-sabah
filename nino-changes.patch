+// SPDX-License-Identifier: AGPL-3.0-only
+package com.couchsubs.mobile.core
+
+/** Nino: çevirinin [start, end) aralığı [ink] renginde yazılır (null: varsayılan beyaz). */
+data class InkSpan(val start: Int, val end: Int, val ink: Int?)
+
+/**
+ * Nino: satırın yalnız bir sözcüğü renkliyse (pembe bir ad), çeviride de yalnız o sözcük renkli olsun. Renkli öbek ayrıca
+ * çevrilir (kısa, önbellekli) ve tam çevirinin içinde aranır; bulunamazsa o öbek renklenmez (satır asıl renginde kalır).
+ */
+object ColorSpans {
+    private const val TRIM = ".,!?:;…\"'()[]،؛؟«»"
+
+    /** Renkli öbeklerin çevirisi: öbek metni → çevirisi. Harfsiz öbekler atlanır. */
+    fun translate(runs: List<InkRun>, translator: TextTranslator): Map<String, String> {
+        val texts = runs.map { it.text.trim() }.filter { text -> text.any { it.isLetter() } }.distinct()
+        if (texts.isEmpty()) return emptyMap()
+        val translated = translator.translateAll(texts)
+        val result = HashMap<String, String>()
+        texts.forEachIndexed { index, text -> translated.getOrNull(index)?.let { result[text] = it } }
+        return result
+    }
+
+    /** [text] içinde [runs] öbeklerinin çevirisinin (bkz. [translate]) yerleri; üst üste binenler atılır. */
+    fun spans(text: String, runs: List<InkRun>, translations: Map<String, String>): List<InkSpan> {
+        if (runs.isEmpty() || translations.isEmpty()) return emptyList()
+        // Satır sonu boşlukla değişir (uzunluk aynı kalır): çeviri yazıyı satırlara bölmüş olabilir.
+        val flat = text.replace('\n', ' ')
+        val result = mutableListOf<InkSpan>()
+        for (run in runs) {
+            val translated = translations[run.text.trim()] ?: continue
+            val range = locate(flat, translated) ?: continue
+            if (result.any { range.first < it.end && range.last + 1 > it.start }) continue
+            result.add(InkSpan(range.first, range.last + 1, run.ink))
+        }
+        return result.sortedBy { it.start }
+    }
+
+    private fun locate(text: String, target: String): IntRange? {
+        val phrase = target.trim().trim { it in TRIM || it.isWhitespace() }
+        if (phrase.length < 2) return null
+        val at = text.indexOf(phrase, ignoreCase = true)
+        if (at >= 0) return at until at + phrase.length
+        // Cümle içinde biçimi değişmişse öbeğin en uzun sözcüğü (yalnız metinde bir kez geçiyorsa) renklenir.
+        val word = phrase.split(' ').map { it.trim { c -> c in TRIM } }.filter { it.length >= 4 }.maxByOrNull { it.length } ?: return null
+        val first = text.indexOf(word, ignoreCase = true)
+        if (first < 0 || text.indexOf(word, first + 1, ignoreCase = true) >= 0) return null
+        return first until first + word.length
+    }
+}
