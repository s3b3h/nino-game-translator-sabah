@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+package com.couchsubs.mobile.core
+
+/**
+ * Nino: oyundaki yazının rengi. Oyun bir yazıyı pembe, sarı ya da kırmızı yazdıysa çeviri de aynı renkte çıkar.
+ * Renk, yazı satırının kutusundaki en uç (en parlak ya da en koyu) piksellerden alınır; zeminle karışan kenar
+ * pikselleri sayılmaz. Beyaz, gri ve siyah yazı "renksiz"dir (null): çeviri normal renginde kalır.
+ */
+object TextInk {
+    /** Doygunluk bunun altındaysa yazı renksiz sayılır. */
+    private const val MIN_SATURATION = 0.28
+    /** Siyah zeminde okunması için rengin en az parlaklığı (0–255); koyu renkler (lacivert) beyaza doğru açılır. */
+    private const val MIN_LUMA = 110.0
+
+    /**
+     * [luma] (width × height, Y düzlemi) ve yarım çözünürlüklü [u], [v] düzlemlerinden [box] içindeki yazının rengi
+     * (ARGB); renksizse ya da emin olunamıyorsa null.
+     */
+    fun sample(luma: ByteArray, width: Int, height: Int, u: ByteArray, v: ByteArray, box: TextBox): Int? {
+        if (width < 4 || height < 4) return null
+        val cw = width / 2
+        val ch = height / 2
+        if (luma.size < width * height || u.size < cw * ch || v.size < cw * ch) return null
+        val x0 = (box.left * width).toInt().coerceIn(0, width - 1)
+        val x1 = (box.right * width).toInt().coerceIn(x0 + 1, width)
+        val y0 = (box.top * height).toInt().coerceIn(0, height - 1)
+        val y1 = (box.bottom * height).toInt().coerceIn(y0 + 1, height)
+        if (x1 - x0 < 4 || y1 - y0 < 4) return null
+        val histogram = IntArray(256)
+        for (y in y0 until y1) {
+            val row = y * width
+            for (x in x0 until x1) histogram[luma[row + x].toInt() and 0xff]++
+        }
+        val total = (x1 - x0) * (y1 - y0)
+        fun percentile(p: Double): Int {
+            val target = (total * p).toInt()
+            var sum = 0
+            for (i in 0..255) {
+                sum += histogram[i]
+                if (sum > target) return i
+            }
+            return 255
+        }
+        val median = percentile(0.5)
+        val high = percentile(0.88)
+        val low = percentile(0.12)
+        // Yazı zeminden parlaksa (koyu zeminde açık yazı) üst uçtaki, koyuysa alt uçtaki pikseller yazıdır.
+        val bright = (high - median) >= (median - low)
+        val spread = if (bright) high - median else median - low
+        if (spread < 24) return null
+        var count = 0
+        var sumY = 0L
+        var sumU = 0L
+        var sumV = 0L
+        for (y in y0 until y1) {
+            val row = y * width
+            val chromaRow = minOf(y / 2, ch - 1) * cw
+            for (x in x0 until x1) {
+                val l = luma[row + x].toInt() and 0xff
+                val picked = if (bright) l >= high else l <= low
+                if (!picked) continue
+                val i = chromaRow + minOf(x / 2, cw - 1)
+                sumY += l
+                sumU += u[i].toInt() and 0xff
+                sumV += v[i].toInt() and 0xff
+                count++
+            }
+        }
+        if (count < 6) return null
+        // BT.601, sınırlı aralık (16–235): PS5 ve Xbox akışı böyledir (bkz. VideoFrame.rgb).
+        val y = (sumY.toDouble() / count - 16) * 1.164
+        val du = sumU.toDouble() / count - 128
+        val dv = sumV.toDouble() / count - 128
+        var r = (y + 1.596 * dv).coerceIn(0.0, 255.0)
+        var g = (y - 0.392 * du - 0.813 * dv).coerceIn(0.0, 255.0)
+        var b = (y + 2.017 * du).coerceIn(0.0, 255.0)
+        val top = maxOf(r, g, b)
+        val bottom = minOf(r, g, b)
+        if (top < 40 || (top - bottom) / top < MIN_SATURATION) return null
+        // Önce en parlak kanal 255'e çekilir (renk aynı kalır, yalnız parlar); yine de koyuysa (mavi) beyaza doğru açılır.
+        val boost = 255.0 / top
+        r = (r * boost).coerceAtMost(255.0)
+        g = (g * boost).coerceAtMost(255.0)
+        b = (b * boost).coerceAtMost(255.0)
+        val luminance = 0.299 * r + 0.587 * g + 0.114 * b
+        if (luminance < MIN_LUMA) {
+            val t = (MIN_LUMA - luminance) / (255 - luminance)
+            r += (255 - r) * t
+            g += (255 - g) * t
+            b += (255 - b) * t
+        }
+        return (0xFF shl 24) or (r.toInt() shl 16) or (g.toInt() shl 8) or b.toInt()
+    }
+
+    /** İki yazı aynı renkte sayılır mı (ikisi de renksiz ya da renkleri yakın). */
+    fun same(a: Int?, b: Int?): Boolean {
+        if (a == null || b == null) return a == b
+        val dr = ((a shr 16) and 0xff) - ((b shr 16) and 0xff)
+        val dg = ((a shr 8) and 0xff) - ((b shr 8) and 0xff)
+        val db = (a and 0xff) - (b and 0xff)
+        return dr * dr + dg * dg + db * db < 70 * 70
+    }
+}
