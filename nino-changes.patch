+        val tasks = passes.map { recognizer.process(it.input) }
+        val found = mutableListOf<TextLine>()
+        tasks.forEachIndexed { index, task ->
+            val pass = passes[index]
+            val text = if (index == 0) Tasks.await(task, 10, TimeUnit.SECONDS)
+            else runCatching { Tasks.await(task, 10, TimeUnit.SECONDS) }.getOrNull()
+            if (text != null) linesOf(text, pass.width, pass.height).forEach { line ->
+                val box = line.box ?: return@forEach
+                found.add(line.copy(box = box.placedIn(pass.area), words = line.words.map { it.copy(box = it.box.placedIn(pass.area)) }))
+            }
+        }
+        val merged = mutableListOf<TextLine>()
+        for (line in found) {
+            val box = line.box ?: continue
+            val same = merged.indexOfFirst { overlaps(it.box!!, box) }
+            if (same < 0) merged.add(line)
+            else if (line.text.trim().length > merged[same].text.trim().length) merged[same] = line
