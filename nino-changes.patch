+                                style = Tokens.Type.headline.copy(fontFamily = rememberPhoneFontFamily(option, font), fontWeight = FontWeight.SemiBold),
+                                color = if (selected) Tokens.Color.accentText else Tokens.Color.text)
+                        }
+                    }
+                }
+            }
+            // Seçilen yazı tipinin örneği (seçince hemen değişir).
+            Text(stringResource(R.string.phone_font_sample),
+                style = Tokens.Type.subtitleCurrent.copy(fontFamily = rememberPhoneFontFamily(phoneFont, font),
+                    fontWeight = if (settings.liveBold) FontWeight.Bold else FontWeight.Normal),
+                color = Tokens.Color.text, modifier = Modifier.fillMaxWidth())
+            // Nino: oyundaki renkli yazı çeviride de aynı renkte çıksın.
+            var matchColors by remember { mutableStateOf(settings.matchTextColors) }
+            RowItem(stringResource(R.string.match_colors)) { Switch(matchColors, { matchColors = it; settings.matchTextColors = it }) }
+            Text(stringResource(R.string.match_colors_note), style = Tokens.Type.caption, color = Tokens.Color.secondary)
diff --git a/couchsubs-android/app/src/main/java/com/couchsubs/mobile/ui/SubtitleFonts.kt b/couchsubs-android/app/src/main/java/com/couchsubs/mobile/ui/SubtitleFonts.kt
index 06bddd3..3940b14 100644
--- a/couchsubs-android/app/src/main/java/com/couchsubs/mobile/ui/SubtitleFonts.kt
+++ b/couchsubs-android/app/src/main/java/com/couchsubs/mobile/ui/SubtitleFonts.kt
@@ -55,0 +56,33 @@ fun rememberSubtitleFontFamily(font: SubtitleFont): FontFamily {
+
+/**
+ * Nino: telefon ekranındaki çeviri için Arapça yazı tipleri (yalnız telefon; TV'ye gitmez). Dosyalar derlemede indirilir
+ * (app/src/main/assets/fonts; hepsi SIL OFL). [AUTO]: Ayarlar'daki altyazı yazı tipi, Arapça harfler sistemin yazı tipinden.
+ */
+enum class PhoneFont(val wire: String, val label: String?, private val regular: String?, private val bold: String?) {
+    AUTO("auto", null, null, null),
+    TAJAWAL("tajawal", "Tajawal", "fonts/Tajawal-Regular.ttf", "fonts/Tajawal-Bold.ttf"),
+    ALMARAI("almarai", "Almarai", "fonts/Almarai-Regular.ttf", "fonts/Almarai-Bold.ttf"),
+    PLEX("plex", "IBM Plex Sans Arabic", "fonts/IBMPlexSansArabic-Regular.ttf", "fonts/IBMPlexSansArabic-Bold.ttf"),
+    AMIRI("amiri", "Amiri", "fonts/Amiri-Regular.ttf", "fonts/Amiri-Bold.ttf"),
+    SCHEHERAZADE("scheherazade", "Scheherazade New", "fonts/ScheherazadeNew-Regular.ttf", "fonts/ScheherazadeNew-Bold.ttf");
+
+    /** Yazı tipi ailesi; dosya yoksa (indirilememişse) null: çağıran varsayılana döner. */
+    fun family(assets: AssetManager): FontFamily? {
+        val normal = regular ?: return null
+        val heavy = bold ?: return null
+        val present = runCatching { assets.open(normal).close(); assets.open(heavy).close(); true }.getOrDefault(false)
+        if (!present) return null
+        return FontFamily(Font(normal, assets, FontWeight.Normal), Font(heavy, assets, FontWeight.Bold))
+    }
+
+    companion object {
+        fun from(raw: String?): PhoneFont = entries.firstOrNull { it.wire == raw } ?: AUTO
+    }
+}
+
+/** Telefondaki çeviri yazı tipi: seçilen Arapça yazı tipi, yoksa ya da "otomatik"se Ayarlar'daki altyazı yazı tipi. */
+@Composable
+fun rememberPhoneFontFamily(choice: PhoneFont, fallback: SubtitleFont): FontFamily {
+    val assets = LocalContext.current.assets
+    return remember(choice, fallback) { choice.family(assets) ?: SubtitleFonts.family(fallback, assets) }
+}
