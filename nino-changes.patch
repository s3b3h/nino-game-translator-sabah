+    /** Gri düzlemin [x0],[y0],[w]×[h] parçası, [factor] kat büyütülmüş (iki doğrusal ara değerleme); renk düzlemi nötr. */
+    private fun cropScaled(source: RegionPixels, x0: Int, y0: Int, w: Int, h: Int, factor: Int): RegionPixels {
+        val outWidth = w * factor
+        val outHeight = h * factor
+        val out = ByteArray(outWidth * outHeight * 3 / 2)
+        val luma = source.nv21
+        if (factor == 1) {
+            for (y in 0 until h) System.arraycopy(luma, (y0 + y) * source.width + x0, out, y * w, w)
+        } else {
+            val leftIndex = IntArray(outWidth)
+            val leftWeight = IntArray(outWidth)
+            for (dx in 0 until outWidth) {
+                val position = maxOf(0f, (dx + 0.5f) / factor - 0.5f)
+                val index = minOf(position.toInt(), w - 1)
+                leftIndex[dx] = index
+                leftWeight[dx] = if (index >= w - 1) 0 else ((position - index) * 256).toInt()
+            }
+            for (dy in 0 until outHeight) {
+                val position = maxOf(0f, (dy + 0.5f) / factor - 0.5f)
+                val index = minOf(position.toInt(), h - 1)
+                val weightY = if (index >= h - 1) 0 else ((position - index) * 256).toInt()
+                val upper = (y0 + index) * source.width + x0
+                val lower = (y0 + minOf(index + 1, h - 1)) * source.width + x0
+                val base = dy * outWidth
+                for (dx in 0 until outWidth) {
+                    val i = leftIndex[dx]
+                    val j = minOf(i + 1, w - 1)
+                    val wx = leftWeight[dx]
+                    val top = (luma[upper + i].toInt() and 0xff) * (256 - wx) + (luma[upper + j].toInt() and 0xff) * wx
+                    val bottom = (luma[lower + i].toInt() and 0xff) * (256 - wx) + (luma[lower + j].toInt() and 0xff) * wx
+                    out[base + dx] = ((top * (256 - weightY) + bottom * weightY) shr 16).toByte()
+                }
+            }
+        }
+        java.util.Arrays.fill(out, outWidth * outHeight, out.size, 128.toByte())
