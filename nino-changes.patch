+    private fun cropScaled(source: RegionPixels, x0: Int, y0: Int, w: Int, h: Int, factor: Int): RegionPixels {
+        val outWidth = w * factor
+        val outHeight = h * factor
+        val out = ByteArray(outWidth * outHeight * 3 / 2)
+        val luma = source.nv21
+        if (factor == 1) {
+            for (y in 0 until h) System.arraycopy(luma, (y0 + y) * source.width + x0, out, y * w, w)
