+    }
+}
+
+private class Slot(val left: Float, val top: Float, val right: Float, val bottom: Float)
+
+/**
+ * Nino: yazının (genişliği [w], yüksekliği [h]) dikey yeri. Tercih edilen yer boşsa o; değilse ya bir engelin hemen altı
+ * ya da hemen üstü (hangisi tercih edilene yakınsa). Hepsi doluysa en az üst üste binen yer. Ekranın dışına çıkmaz.
+ */
+private fun freeY(x: Float, w: Float, h: Float, preferred: Float, maxY: Float, gap: Float, obstacles: List<Slot>): Float {
+    fun overlap(y: Float): Float {
+        var total = 0f
+        for (o in obstacles) {
+            val across = minOf(x + w, o.right) - maxOf(x, o.left)
+            val down = minOf(y + h, o.bottom) - maxOf(y, o.top)
+            if (across > 0f && down > 0f) total += across * down
+        }
+        return total
+    }
+    var best = preferred
+    var bestOverlap = overlap(preferred)
+    if (bestOverlap <= 0f) return preferred
+    var bestShift = 0f
+    for (o in obstacles) {
+        for (candidate in floatArrayOf(o.bottom + gap, o.top - h - gap)) {
+            val y = candidate.coerceIn(0f, maxY)
+            val covered = overlap(y)
+            val shift = abs(y - preferred)
+            if (covered < bestOverlap - 0.5f || (abs(covered - bestOverlap) <= 0.5f && shift < bestShift)) {
+                best = y
+                bestOverlap = covered
+                bestShift = shift
+            }
+        }
+    }
+    return best
+}
+
+/**
+ * "Ekranı çevir" sonuçları: her çeviri oyundaki yazının yerinde, kendi kenarına yaslı (solda kalan sola, sağdaki sağa;
+ * Arapçada da yer değişmez). Çeviriler birbirinin ve [avoid] alanının (canlı çeviri) üstüne binmez, ekrandan taşmaz.
+ */
+@Composable
+private fun ScreenOverlay(
+    items: List<ScreenTranslation.Item>, scale: Int, bold: Boolean, family: FontFamily, matchColors: Boolean, avoid: TextBox,
+) {
+    // Nino: yön hep soldan sağa (konumlar asla aynalanmaz); Arapça metin yine içeriğine göre sağdan sola dizilir.
+    CompositionLocalProvider(LocalLayoutDirection provides LayoutDirection.Ltr) {
+    BoxWithConstraints(Modifier.fillMaxSize().clipToBounds()) {
+        val screenHeight = maxHeight
+        val factor = scale / 100f
+        Layout(
+            content = {
+                items.forEach { item ->
+                    val size = ((screenHeight.value * item.lineHeight * 0.8).coerceIn(10.0, 28.0) * factor).toFloat()
+                    val ink = if (matchColors) item.textColor else null
+                    Text(coloredText(item.translation, if (matchColors) item.spans else emptyList()),
+                        color = ink?.let { Color(it) } ?: SUBTITLE_WHITE, fontFamily = family,
+                        fontWeight = if (bold) FontWeight.Bold else FontWeight.Normal,
+                        fontSize = size.sp, lineHeight = (size * 1.3f).sp,
+                        textAlign = when (anchorOf(item.box)) { Anchor.LEFT -> TextAlign.Left; Anchor.RIGHT -> TextAlign.Right; Anchor.CENTER -> TextAlign.Center },
+                        // Nino: zemin hep siyah; renkli yazı (açıldığında) siyah üstünde okunur ([TextInk] koyu renkleri açar).
+                        modifier = Modifier.background(Color.Black.copy(alpha = 0.9f), RoundedCornerShape(4.dp)).padding(4.dp))
+                }
+            },
+            modifier = Modifier.fillMaxSize(),
+        ) { measurables, constraints ->
+            val width = constraints.maxWidth
+            val height = constraints.maxHeight
+            val minWidth = 90.dp.roundToPx().coerceAtMost(width)
+            val gap = 3.dp.toPx()
+            val placeables = measurables.mapIndexed { index, measurable ->
+                val box = items[index].box
+                val left = (box.left.coerceIn(0.0, 1.0) * width).toFloat()
+                val right = (box.right.coerceIn(0.0, 1.0) * width).toFloat()
+                val middle = (left + right) / 2
+                val available = when (anchorOf(box)) {
+                    Anchor.LEFT -> width - left
+                    Anchor.RIGHT -> right
+                    Anchor.CENTER -> 2 * minOf(middle, width - middle)
+                }
+                // Yazı büyüdükçe kutu da genişler; ama oyundaki yazının olduğu yandan ekranın dışına taşmaz.
+                val wanted = maxOf((right - left) * 1.25f * maxOf(1f, factor), minWidth.toFloat())
+                val cap = minOf(available, wanted).toInt().coerceIn(minWidth, width)
+                measurable.measure(Constraints(maxWidth = cap))
+            }
+            // Canlı çevirinin alanı engeldir (biraz içeriden: azıcık değmek sorun değil).
+            val inset = height * 0.02f
+            val obstacles = mutableListOf(Slot(
+                (avoid.left * width).toFloat(), (avoid.top * height).toFloat() + inset,
+                (avoid.right * width).toFloat(), (avoid.bottom * height).toFloat() - inset))
+            val xs = FloatArray(placeables.size)
+            val ys = FloatArray(placeables.size)
+            // Yukarıdakiler önce yerleşir; aşağıdakiler onlara göre kayar.
+            for (index in items.indices.sortedBy { items[it].box.top }) {
+                if (index >= placeables.size) continue
+                val placeable = placeables[index]
+                val box = items[index].box
+                val middle = ((box.left + box.right) / 2).coerceIn(0.0, 1.0).toFloat() * width
+                var x = when (anchorOf(box)) {
+                    Anchor.LEFT -> (box.left.coerceIn(0.0, 1.0) * width).toFloat()
+                    Anchor.RIGHT -> (box.right.coerceIn(0.0, 1.0) * width).toFloat() - placeable.width
+                    Anchor.CENTER -> middle - placeable.width / 2f
+                }
+                x = x.coerceIn(0f, (width - placeable.width).toFloat().coerceAtLeast(0f))
+                val maxY = (height - placeable.height).toFloat().coerceAtLeast(0f)
+                val preferred = ((box.top * height).toFloat() - gap).coerceIn(0f, maxY)
+                val y = freeY(x, placeable.width.toFloat(), placeable.height.toFloat(), preferred, maxY, gap, obstacles)
+                obstacles.add(Slot(x, y, x + placeable.width, y + placeable.height))
+                xs[index] = x
+                ys[index] = y
+            }
+            layout(width, height) {
+                // place (placeRelative değil): sağdan sola dilde konum aynalanmaz.
+                placeables.forEachIndexed { index, placeable -> placeable.place(xs[index].toInt(), ys[index].toInt()) }
+            }
+        }
+    }
+    }
+}
